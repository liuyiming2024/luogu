 "code_blocks": [
  "#include<bits/stdc++.h>\nusing namespace std;\nlong long n;\nstring zhuan(long long ans)\n{\n    string a=\"\";\n    while(ans)\n    {\n        a=char(ans%2+48)+a;\n        ans/=2;\n    }\n    for(int i=1;a.size()<32;i++)\n    {\n        a='0'+a;\n    }\n    return a;\n} \nstring huan(string a)\n{\n    string b=\"\";\n    for(int i=16;i<32;i++)\n    {\n        b+=a[i];\n    }\n    for(int i=0;i<16;i++)\n    {\n        b+=a[i];\n    }\n    return b;\n}\nlong long jieguo(string a)\n{\n    long long k=1,sum=0;\n    for(int i=a.size()-1;i>=0;i--)\n    {\n        sum+=(int(a[i])-48)*k;\n        k*=2;\n    }\n    return sum;\n}\nint main()\n{\n    cin>>n;\n    cout<<jieguo(huan(zhuan(n)));\n    return 0;\n}"
