tring a=\\u0022\\u0022;\\n\\twhile(ans)\\n\\t{\\n\\t\\ta=char(ans%2+48)+a;\\n\\t\\tans\\/=2;\\n\\t}\\n\\tfor(int i=1;a.size()\\u003C32;i++)\\n\\t{\\n\\t\\ta=\\u00270\\u0027+a;\\n\\t}\\n\\treturn a;\\n} \\nstring huan(string a)\\n{\\n\\tstring b=\\u0022\\u0022;\\n\\tfor(int i=16;i\\u003C32;i++)\\n\\t{\\n\\t\\tb+=a[i];\\n\\t}\\n\\tfor(int i=0;i\\u003C16;i++)\\n\\t{\\n\\t\\tb+=a[i];\\n\\t}\\n\\treturn b;\\n}\\nlong long jieguo(string a)\\n{\\n\\tlong long k=1,sum=0;\\n\\tfor(int i=a.size()-1;i\\u003E=0;i--)\\n\\t{\\n\\t\\tsum+=(int(a[i])-48)*k;\\n\\t\\tk*=2;\\n\\t}\\n\\treturn sum;\\n}\\nint main()\\n{\\n\\tcin\\u003E\\u003En;\\n\\tcout\\u003C\\u003Cjieguo(huan(zhuan(n)));\\n\\treturn 0;\\n}\\n```\\n## \\u9898\\u76ee\\u53cd\\u601d\\n\\u8fd9\\u9053\\u9898\\u662f\\u4e00\\u9053\\u6a21\\u62df\\u9898\\uff0c\\u53ef\\u4ee5\\u7528\\u81ea\\u5b9a\\u4e49\\u51fd\\u6570\\u6765\\u89e3\\u51b3\\u3002\\u628a\\u9898\\u76ee\\u5206\\u6210\\u4e09\\u4e2a\\u90e8\\u5206\\u6765\\u89e3\\u51b3\\u3002\\uff081\\uff09\\u521d\\u59cb\\u6574\\u6570\\u8f6c\\u4e3a\\u4e8c\\u8fdb\\u5236\\u3002\\uff082\\uff09\\u628a\\u9ad8\\u4f4e\\u4f4d\\u8f6c\\u6362\\u3002\\uff083\\uff09\\u8f6c\\u4e3a\\u5341\\u8fdb\\u5236\\u3002\\u7528\\u81ea\\u5b9a\\u4e49\\u51fd\\u6570\\u6765\\u5b9e\\u73b0\\uff0c\\u7136\\u540e\\u76f4\\u63a5\\u8f93\\u51fa\\u5c31\\u597d\\u4e86\\u3002\",\"categoryOld\":\"\\u9898\\u76ee\\u53cd\\u601d\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795629514.836864}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/qle49r7h\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"P1100 \\u9ad8\\u4f4e\\u4f4d\\u4ea4\\u6362\",\"description\":\"\\u9898\\u76ee\\u63cf\\u8ff0\\n\\u7ed9\\u51fa\\u4e00\\u4e2a\\u5c0f\\u4e8e2^32\\n\\u7684\\u6b63\\u6574\\u6570\\u3002\\u8fd9\\u4e2a\\u6570\\u53ef\\u4ee5\\u7528\\u4e00\\u4e2a32\\u4f4d\\u7684\\u4e8c\\u8fdb\\u5236\\u6570\\u8868\\u793a\\uff08\\u4e0d\\u8db332\\u4f4d\\u75280\\u8865\\u8db3\\uff09\\u3002\\u6211\\u4eec\\u79f0\\u8fd9\\u4e2a\\u4e8c\\u8fdb\\u5236\\u6570\\u7684\\u524d16\\u4f4d\\u4e3a\\u201c\\u9ad8\\u4f4d\\u201d\\uff0c\\u540e16\\u4f4d\\u4e3a\\u201c\\u4f4e\\u4f4d\\u201d\\u3002\\u5c06\\u5b83\\u7684\\u9ad8\\u4f4e\\u4f4d\\u4ea4\\u6362\\uff0c\\u6211\\u4eec\\u53ef\\u4ee5\\u5f97\\u5230\\u4e00\\u4e2a\\u65b0\\u7684\\u6570\\u3002\\u8bd5\\u95ee\\u8fd9\\u4e2a\\u65b0\\u7684\\u6570\\u662f\\u591a\\u5c11\\uff08\\u7528\\u5341\\u8fdb\\u5236\\u8868\\u793a\\uff09\\u3002\\u2026\",\"genre\":\"\\u4e2a\\u4eba\\u8bb0\\u5f55\",\"author\":{\"@type\":\"Person\",\"name\":\"ElderFour\"},\"datePublished\":\"2022-04-13T18:22:54+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"P1100 高低位交换\" />\n    <meta property=\"og:description\" content=\"题目描述\n给出一个小于2^32\n的正整数。这个数可以用一个32位的二进制数表示（不足32位用0补足）。我们称这个二进制数的前16位为“高位”，后16位为“低位”。将它的高低位交换，我们可以得到一个新的数。试问这个新的数是多少（用十进制表示）。…\" />\n    <meta property=\"article:section\" content=\"个人记录\" />\n    <meta property=\"article:author\" content=\"ElderFour\" />\n    <meta property=\"article:published_time\" content=\"2022-04-13T18:22:54+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/qle49r7h\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>P1100 高低位交换</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">ElderFour</a>\n            ·\n            <time datetime=\"2022-04-13T18:22:54+08:00\">2022-04-13 18:22:54</time>\n            ·\n            <a href=\"/article?category=1\">个人记录</a>\n        </p>\n\n        <h1>题目描述</h1>\n<p>给出一个小于2^32\n的正整数。这个数可以用一个32位的二进制数表示（不足32位用0补足）。我们称这个二进制数的前16位为“高位”，后16位为“低位”。将它的高低位交换，我们可以得到一个新的数。试问这个新的数是多少（用十进制表示）。</p>\n<p>例如，数1314520用二进制表示00000000000101000000111011011000（添加了11个前导0补足为32位），其中前16位为高位，即0000 0000 0001 0100；后16位为低位，即0000 1110 1101 1000。将它的高低位进行交换，我们得到了一个新的二进制数0000 1110 1101 1000 0000 0000 0001 0100。它即是十进制的249036820。</p>\n<pre><code>#include&lt;bits/stdc++.h&gt;\nusing namespace std;\nlong long n;\nstring zhuan(long long ans)\n{\n    string a=\"\";\n    while(ans)\n    {\n        a=char(ans%2+48)+a;\n        ans/=2;\n    }\n    for(int i=1;a.size()&lt;32;i++)\n    {\n        a='0'+a;\n    }\n    return a;\n} \nstring huan(string a)\n{\n    string b=\"\";\n    for(int i=16;i&lt;32;i++)\n    {\n        b+=a[i];\n    }\n    for(int i=0;i&lt;16;i++)\n    {\n        b+=a[i];\n    }\n    return b;\n}\nlong long jieguo(string a)\n{\n    long long k=1,sum=0;\n    for(int i=a.size()-1;i&gt;=0;i--)\n    {\n        sum+=(int(a[i])-48)*k;\n        k*=2;\n    }\n    return sum;\n}\nint main()\n{\n    cin&gt;&gt;n;\n    cout&lt;&lt;jieguo(huan(zhuan(n)));\n    return 0;\n}</code></pre>\n<h2>题目反思</h2>\n<p>这道题是一道模拟题，可以用自定义函数来解决。把题目分成三个部分来解决。（1）初始整数转为二进制。（2）把高低位转换。（3）转为十进制。用自定义函数来实现，然后直接输出就好了。</p>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6028ad2994fcf1b',t:'MTc5NTYyOTUxNA=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6028ad2994fcf1b',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
