 "code_blocks": [
  "#include<bits/stdc++.h>\nusing namespace std;\nint n,a[3010],sum=0;\nint main(){\n    cin>>n;\n    for(int i=1;i<=n;i++)cin>>a[i];//输入输出不用讲吧。\n    for(int i=1;i<=n;i++)\n    {\n        for(int j=i-1;j>=1;j--)//嵌套。\n        {\n            if(a[i]>a[j])sum++;//不如自己可爱的数量+1。\n        }\n        cout<<sum<<' ';\n        sum=0;//注意归零。\n    }\n\n    return 0;//完结撒花。\n}"
