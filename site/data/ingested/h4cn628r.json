 $n$ \\u4ef6\\u4ef7\\u503c\\u4e3a $v[i]$ ,\\u4f53\\u79ef\\u4e3a $w[i]$ \\u7684\\u7269\\u54c1\\uff08\\u6bcf\\u4ef6\\u7269\\u54c1\\u53ea\\u80fd\\u88c5\\u4e00\\u6b21\\uff09\\uff0c\\u8ba9\\u4f60\\u7f16\\u7a0b\\u8ba1\\u7b97\\u80cc\\u5305\\u88c5\\u4e0b\\u7684\\u7269\\u54c1\\u4ef7\\u503c\\u6700\\u591a\\u662f\\u591a\\u5c11\\u3002\\n## \\u8fdb\\u5165\\u6b63\\u9898\\n#### \\u8bb2\\u4e86\\u8fd9\\u4e48\\u591a\\uff0c\\u6211\\u4eec\\u5230\\u5e95\\u600e\\u4e48\\u6c42\\u80cc\\u5305\\u95ee\\u9898\\u5462\\uff1f  \\n\\u6211\\u5b66\\u52a8\\u89c4\\u7684\\u65f6\\u5019\\u88ab\\u8fd9\\u4e2a\\u95ee\\u9898\\u5361\\u4e86\\u5f88\\u4e45\\uff0c\\u56e0\\u4e3a\\u6211\\u4e0d\\u77e5\\u9053 $f[i]$ \\u5230\\u5e95\\u6307\\u7684\\u662f\\u4ec0\\u4e48\\uff0c\\u4ee5\\u81f3\\u4e8e\\u5b8c\\u5168\\u770b\\u4e0d\\u61c2\\u522b\\u4eba\\u8bb2\\u7684\\u3002  \\n\\u9996\\u5148\\u6211\\u4eec\\u5f15\\u5165\\u4e00\\u4e2a\\u6982\\u5ff5\\uff1a\\u8bbe $f[i]$ \\u8868\\u793a\\u5bb9\\u91cf\\u4e3a $i$ \\u7684\\u80cc\\u5305\\u80fd\\u83b7\\u5f97\\u7684\\u4ef7\\u503c\\u6700\\u591a\\u662f\\u591a\\u5c11\\u3002\\u90a3\\u4e48\\uff0c$f[0]$ \\u5f88\\u660e\\u663e\\u662f $0$ \\uff0c\\u56e0\\u4e3a\\u4e00\\u4ef6\\u7269\\u54c1\\u90fd\\u88c5\\u4e0d\\u4e0b\\u3002\\u800c\\u6211\\u4eec\\u8981\\u6c42\\u7684\\u5c31\\u662f\\u5f53\\u5bb9\\u91cf\\u4e3a $t$ \\u65f6\\u53ef\\u83b7\\u5f97\\u7684\\u6700\\u5927\\u4ef7\\u503c\\uff0c\\u4e5f\\u5c31\\u662f $f[t]$ \\u3002  \\n#### \\u7136\\u540e\\u6211\\u4eec\\u5982\\u4f55\\u6c42$f[i]$\\u53ef\\u83b7\\u5f97\\u7684\\u4ef7\\u503c\\uff1f \\n\\u6211\\u4eec\\u90fd\\u77e5\\u9053\\uff0c\\u53ea\\u6709\\u80cc\\u5305\\u5269\\u4f59\\u7684\\u5bb9\\u91cf\\u5927\\u4e8e\\u7b49\\u4e8e\\u4e00\\u4ef6\\u7269\\u54c1\\u7684\\u4f53\\u79ef\\u65f6\\uff0c\\u624d\\u80fd\\u88c5\\u5f97\\u4e0b\\u8fd9\\u4ef6\\u7269\\u54c1\\uff0c\\u83b7\\u5f97\\u8fd9\\u4ef6\\u7269\\u54c1\\u7684\\u4ef7\\u503c\\u3002\\u90a3\\u4e48\\u6211\\u4eec\\u5c31\\u53ef\\u4ee5\\u4ece\\u6bcf\\u4ef6\\u7269\\u54c1\\u51fa\\u53d1\\uff1a  \\n```cpp\\nfor(int i=1;i\\u003C=n;i++){\\n\\t\\n}\\n```\\n\\u7136\\u540e\\u6211\\u4eec\\u5229\\u7528\\u4e0a\\u9762\\u8bf4\\u7684\\u6027\\u8d28\\uff0c\\u679a\\u4e3e\\u53ef\\u4ee5\\u88c5\\u5f97\\u4e0b\\u7b2c $i$ \\u4ef6\\u7269\\u54c1\\u7684\\u5269\\u4f59\\u5bb9\\u91cf\\uff08$f[i]$\\uff09\\uff1a\\n```cpp\\nfor(int i=1;i\\u003C=n;i++){\\n\\tfor(int j=t;j\\u003E=w[i];j--){ \\/\\/t\\u4e3a\\u80cc\\u5305\\u603b\\u5bb9\\u91cf\\n\\t\\t\\n\\t}\\n}\\n```\\n\\u4e3a\\u4ec0\\u4e48\\u8981\\u4ece $t$ \\u5f00\\u59cb\\u679a\\u4e3e\\u5462\\uff1f  \\n\\u56e0\\u4e3a\\u6211\\u4eec\\u7684\\u6bcf\\u4e2a\\u7269\\u54c1\\u53ea\\u80fd\\u653e\\u4e00\\u6b21\\uff0c\\u800c $f[j]$ \\u8981\\u9760 $f[j-w[j]]$ \\u7684\\u4ef7\\u503c\\u6c42\\u51fa\\u6765\\uff0c\\u5982\\u679c\\u6211\\u4eec\\u5148\\u679a\\u4e3e $f[j]$ \\u518d\\u679a\\u4e3e $f[j]$ \\u4ee5\\u540e\\u7684\\u5185\\u5bb9\\uff0c\\u5c31\\u4f1a\\u88ab $f[j]$ \\u5f71\\u54cd\\u5230\\uff0c\\u4e5f\\u5c31\\u76f8\\u5f53\\u4e8e\\u7b2c $i$ \\u4ef6\\u7269\\u54c1\\u653e\\u4e86\\u4e24\\u6b21\\u6216\\u4ee5\\u4e0a\\uff08\\u8fd9\\u6d89\\u53ca\\u5230\\u5b8c\\u5168\\u80cc\\u5305\\u95ee\\u9898\\uff0c\\u9700\\u8981\\u4e86\\u89e3\\u7684\\u53ef\\u4ee5\\u53bb\\u767e\\u5ea6\\u4e00\\u4e0b\\uff0c\\u6216\\u8005\\u505a\\u4e00\\u4e0bP1616\\uff09\\u3002\\u6240\\u4ee5\\u6211\\u4eec\\u4ece $t$ \\u5f00\\u59cb\\u679a\\u4e3e\\uff0c\\u4ee5\\u514d\\u5f71\\u54cd\\u5230\\u4e4b\\u524d\\u7684 $f[i]$ \\u3002\\n#### \\u7136\\u540e\\u6211\\u4eec\\u5c31\\u53ef\\u4ee5\\u901a\\u8fc7\\u52a8\\u89c4\\u7684\\u6027\\u8d28\\uff08\\u4e0d\\u4f1a\\u5f71\\u54cd\\u5230\\u679a\\u4e3e\\u8fc7\\u7684\\u5185\\u5bb9\\uff09\\u6765\\u6c42$f[t]$\\u4e86\\u3002\\n\\u7531\\u4e8e\\u4e0d\\u4f1a\\u5f71\\u54cd\\u5230\\u4e4b\\u524d\\u679a\\u4e3e\\u8fc7\\u7684\\u5185\\u5bb9\\uff0c\\u6240\\u4ee5\\u6211\\u4eec\\u53ef\\u4ee5\\u653e\\u5fc3\\u7684\\u8d2a\\u5fc3\\uff1a\\n```cpp\\nfor(int i=1;i\\u003C=n;i++){\\n\\tfor(int j=t;j\\u003E=w[i];j--){\\n\\t\\tf[j]=max(f[j-w[i]]+v[i],f[j]); \\/\\/w[i]\\u662f\\u7b2ci\\u4ef6\\u7269\\u54c1\\u7684\\u4f53\\u79ef\\uff0cv[i]\\u662f\\u7b2ci\\u4ef6\\u7269\\u54c1\\u7684\\u4ef7\\u503c\\u3002\\n\\t}\\n}\\n```\\n\\u7531\\u4e8e\\u6bcf\\u4ef6\\u7269\\u54c1\\u53ea\\u80fd\\u653e\\u4e00\\u6b21\\uff0c\\u6240\\u4ee5\\u53ea\\u6709\\u4e24\\u4e2a\\u9009\\u62e9\\uff1a\\u653e\\u548c\\u4e0d\\u653e\\uff08\\u8fd9\\u4e5f\\u662f0\\/1\\u80cc\\u5305\\u540d\\u5b57\\u7684\\u6765\\u6e90\\uff09\\u3002  \\n\\u4e0d\\u653e\\u7684\\u8bdd\\uff0c $f[j]$ \\u8fd8\\u662f $f[j]$ \\uff0c\\u6ca1\\u6709\\u4efb\\u4f55\\u53d8\\u5316\\uff1b  \\n\\u653e\\u7684\\u8bdd\\uff0c\\u80cc\\u5305\\u7684\\u5bb9\\u91cf\\u5c31\\u5c11\\u4e86 $w[i]$ \\uff0c\\u53ea\\u80fd\\u83b7\\u5f97 $f[j-w[i]]+v[i]$ \\u7684\\u4ef7\\u503c\\u3002  \\n\\u8fd9\\u4e24\\u8005\\u7684\\u6700\\u5927\\u503c\\uff0c\\u5c31\\u662f\\u6211\\u4eec\\u8981\\u6c42\\u7684 $f[j]$ \\u3002  \\n\\u6700\\u540e\\u7684\\u7b54\\u6848\\u5c31\\u662f\\u5bb9\\u91cf\\u4e3a $t$ \\u65f6\\u83b7\\u5f97\\u7684\\u6700\\u5927\\u4ef7\\u503c\\uff0c\\u4e5f\\u5c31\\u662f $f[t]$ \\u3002  \\n\\u4ee3\\u7801\\u5982\\u4e0b\\uff1a  \\n```cpp\\n#include\\u003Ciostream\\u003E\\n#include\\u003Ccmath\\u003E\\nusing namespace std;\\nint f[1001],n,t,v[101],w[101];\\nint main(){\\n\\tcin\\u003E\\u003Et\\u003E\\u003En;\\n\\tfor(int i=1;i\\u003C=n;i++){\\n\\t\\tcin\\u003E\\u003Ew[i]\\u003E\\u003Ev[i];\\n\\t}\\n\\tfor(int i=1;i\\u003C=n;i++){\\n\\t\\tfor(int j=t;j\\u003E=w[i];j--) {\\n            f[j]=max(f[j-w[i]]+v[i], f[j]);\\n        }\\n\\t}\\n\\tcout\\u003C\\u003Cf[t];\\n\\treturn 0;\\n}\\n```\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795593114.317444}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/h4cn628r\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1048 \\u3010\\u91c7\\u836f\\u3011\",\"description\":\"\\u8fd9\\u662f\\u9053\\u80cc\\u5305\\u52a8\\u89c4\\u7684\\u6a21\\u677f\\u9898\\u3002\\n\\u57fa\\u7840\\uff08\\u5df2\\u7ecf\\u4e86\\u89e3\\u7684\\u53ef\\u4ee5\\u8df3\\u8fc7\\uff09\\n\\u9996\\u5148\\uff0c\\u4ec0\\u4e48\\u662f\\u52a8\\u89c4\\u5462\\uff1f\\n\\u52a8\\u6001\\u89c4\\u5212\\uff0c\\u7b80\\u79f0\\u52a8\\u89c4\\uff0c\\u662f\\u9012\\u63a8\\u7684\\u4e00\\u79cd\\u3002\\n\\u548c\\u9012\\u63a8\\u5dee\\u4e0d\\u591a\\uff0c\\u4e00\\u822c\\u901a\\u8fc7\\u53cc\\u91cd\\u5faa\\u73af\\uff0c\\u9010\\u6b65\\u63a8\\u51fa\\u7ed3\\u679c\\u3002\\n\\u9700\\u8981\\u6ce8\\u610f\\u7684\\u662f\\uff0c\\u8981\\u901a\\u8fc7\\u52a8\\u89c4\\u63a8\\u51fa\\u7ed3\\u679c\\uff0c\\u5fc5\\u987b\\u4fdd\\u8bc1\\u6bcf\\u4e00\\u6b65\\u7684\\u7ed3\\u679c\\u90fd\\u4e0d\\u4f1a\\u5f71\\u54cd\\u5230\\u524d\\u9762\\u7b97\\u597d\\u7684\\u7ed3\\u679c\\uff0c\\u4ee5\\u81f4\\u53cd\\u590d\\u5f71\\u54cd\\u3002\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"lenfrey\"},\"datePublished\":\"2018-08-18T18:20:52+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1048 【采药】\" />\n    <meta property=\"og:description\" content=\"这是道背包动规的模板题。\n基础（已经了解的可以跳过）\n首先，什么是动规呢？\n动态规划，简称动规，是递推的一种。\n和递推差不多，一般通过双重循环，逐步推出结果。\n需要注意的是，要通过动规推出结果，必须保证每一步的结果都不会影响到前面算好的结果，以致反复影响。…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"lenfrey\" />\n    <meta property=\"article:published_time\" content=\"2018-08-18T18:20:52+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/h4cn628r\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1048 【采药】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">lenfrey</a>\n            ·\n            <time datetime=\"2018-08-18T18:20:52+08:00\">2018-08-18 18:20:52</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>这是道背包动规的模板题。</p>\n<h2>基础（已经了解的可以跳过）</h2>\n<h3>首先，什么是动规呢？</h3>\n<p>动态规划，简称动规，是递推的一种。<br />\n和递推差不多，一般通过双重循环，逐步推出结果。<br />\n需要注意的是，要通过动规推出结果，必须保证每一步的结果都不会影响到前面算好的结果，以致反复影响。</p>\n<h3>什么是背包问题？</h3>\n<p>背包问题是动规的经典题，大致分为简单背包，0/1背包，完全背包，多重背包等。这一题是0/1背包问题，也就是：   给你一个容量为 <la-tex display=\"inline\">t</la-tex> 的背包和 <la-tex display=\"inline\">n</la-tex> 件价值为 <la-tex display=\"inline\">v[i]</la-tex> ,体积为 <la-tex display=\"inline\">w[i]</la-tex> 的物品（每件物品只能装一次），让你编程计算背包装下的物品价值最多是多少。</p>\n<h2>进入正题</h2>\n<h4>讲了这么多，我们到底怎么求背包问题呢？</h4>\n<p>我学动规的时候被这个问题卡了很久，因为我不知道 <la-tex display=\"inline\">f[i]</la-tex> 到底指的是什么，以至于完全看不懂别人讲的。<br />\n首先我们引入一个概念：设 <la-tex display=\"inline\">f[i]</la-tex> 表示容量为 <la-tex display=\"inline\">i</la-tex> 的背包能获得的价值最多是多少。那么，<la-tex display=\"inline\">f[0]</la-tex> 很明显是 <la-tex display=\"inline\">0</la-tex> ，因为一件物品都装不下。而我们要求的就是当容量为 <la-tex display=\"inline\">t</la-tex> 时可获得的最大价值，也就是 <la-tex display=\"inline\">f[t]</la-tex> 。  </p>\n<h4>然后我们如何求<la-tex display=\"inline\">f[i]</la-tex>可获得的价值？</h4>\n<p>我们都知道，只有背包剩余的容量大于等于一件物品的体积时，才能装得下这件物品，获得这件物品的价值。那么我们就可以从每件物品出发：  </p>\n<pre><code class=\"language-cpp\">for(int i=1;i&lt;=n;i++){\n\n}</code></pre>\n<p>然后我们利用上面说的性质，枚举可以装得下第 <la-tex display=\"inline\">i</la-tex> 件物品的剩余容量（<la-tex display=\"inline\">f[i]</la-tex>）：</p>\n<pre><code class=\"language-cpp\">for(int i=1;i&lt;=n;i++){\n    for(int j=t;j&gt;=w[i];j--){ //t为背包总容量\n\n    }\n}</code></pre>\n<p>为什么要从 <la-tex display=\"inline\">t</la-tex> 开始枚举呢？<br />\n因为我们的每个物品只能放一次，而 <la-tex display=\"inline\">f[j]</la-tex> 要靠 <la-tex display=\"inline\">f[j-w[j]]</la-tex> 的价值求出来，如果我们先枚举 <la-tex display=\"inline\">f[j]</la-tex> 再枚举 <la-tex display=\"inline\">f[j]</la-tex> 以后的内容，就会被 <la-tex display=\"inline\">f[j]</la-tex> 影响到，也就相当于第 <la-tex display=\"inline\">i</la-tex> 件物品放了两次或以上（这涉及到完全背包问题，需要了解的可以去百度一下，或者做一下P1616）。所以我们从 <la-tex display=\"inline\">t</la-tex> 开始枚举，以免影响到之前的 <la-tex display=\"inline\">f[i]</la-tex> 。</p>\n<h4>然后我们就可以通过动规的性质（不会影响到枚举过的内容）来求<la-tex display=\"inline\">f[t]</la-tex>了。</h4>\n<p>由于不会影响到之前枚举过的内容，所以我们可以放心的贪心：</p>\n<pre><code class=\"language-cpp\">for(int i=1;i&lt;=n;i++){\n    for(int j=t;j&gt;=w[i];j--){\n        f[j]=max(f[j-w[i]]+v[i],f[j]); //w[i]是第i件物品的体积，v[i]是第i件物品的价值。\n    }\n}</code></pre>\n<p>由于每件物品只能放一次，所以只有两个选择：放和不放（这也是0/1背包名字的来源）。<br />\n不放的话， <la-tex display=\"inline\">f[j]</la-tex> 还是 <la-tex display=\"inline\">f[j]</la-tex> ，没有任何变化；<br />\n放的话，背包的容量就少了 <la-tex display=\"inline\">w[i]</la-tex> ，只能获得 <la-tex display=\"inline\">f[j-w[i]]+v[i]</la-tex> 的价值。<br />\n这两者的最大值，就是我们要求的 <la-tex display=\"inline\">f[j]</la-tex> 。<br />\n最后的答案就是容量为 <la-tex display=\"inline\">t</la-tex> 时获得的最大价值，也就是 <la-tex display=\"inline\">f[t]</la-tex> 。<br />\n代码如下：  </p>\n<pre><code class=\"language-cpp\">#include&lt;iostream&gt;\n#include&lt;cmath&gt;\nusing namespace std;\nint f[1001],n,t,v[101],w[101];\nint main(){\n    cin&gt;&gt;t&gt;&gt;n;\n    for(int i=1;i&lt;=n;i++){\n        cin&gt;&gt;w[i]&gt;&gt;v[i];\n    }\n    for(int i=1;i&lt;=n;i++){\n        for(int j=t;j&gt;=w[i];j--) {\n            f[j]=max(f[j-w[i]]+v[i], f[j]);\n        }\n    }\n    cout&lt;&lt;f[t];\n    return 0;\n}</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a5ff12238f500d0f',t:'MTc5NTU5MzExNA=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a5ff12238f500d0f',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
