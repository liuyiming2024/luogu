  "#include<iostream>\n#include<cmath>\nusing namespace std;\nint f[1001],n,t,v[101],w[101];\nint main(){\n    cin>>t>>n;\n    for(int i=1;i<=n;i++){\n        cin>>w[i]>>v[i];\n    }\n    for(int i=1;i<=n;i++){\n        for(int j=t;j>=w[i];j--) {\n            f[j]=max(f[j-w[i]]+v[i], f[j]);\n        }\n    }\n    cout<<f[t];\n    return 0;\n}"
