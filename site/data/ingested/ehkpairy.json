 "code_blocks": [
  "void red(void) {\n    if (a == 1) return;\n    for (int i = a; i > 1; --i) {\n        while (!(a % i) && !(b % i) && !(c % i))\n            a /= i, b /= i, c /= i;\n        if (a == 1) return;\n    }\n}",
  "bool finish (int i, int j, int k) {\n    bool ret = true, used[10];\n    memset(used, 0, sizeof(used));\n    used[i % 10] = used[i / 100] = used[i / 10 % 10] = true;\n    used[j % 10] = used[j / 100] = used[j / 10 % 10] = true;\n    used[k % 10] = used[k / 100] = used[k / 10 % 10] = true;\n    for (int i = 1; i < 10; ++i)\n        if (!used[i]) {\n            ret = false;\n            break;\n        }\n    return ret;\n}",
  "#include <cstdio>\n#include <cstring>\nint a, b, c;\nvoid red(void); //约分 \nbool finish(int i, int j, int k);\nint main() {\n    bool no = true;\n    scanf(\"%d%d%d\", &a, &b, &c);\n    red();\n    for (int i = 100 + a - 100 % a; i <= 999; i += a) {\n        int j, k;\n        //printf(\"%d\\n\", i);\n        if (i / a * c > 999) break;\n        j = i / a * b; k = i / a * c;\n        if (finish(i, j, k)) {\n            printf(\"%d %d %d\\n\", i, j, k);\n            no = false;\n        }\n    } \n    if (no) printf(\"No!!!\");\n    return 0;\n}\nvoid red(void) {\n    if (a == 1) return;\n    for (int i = a; i > 1; --i) {\n        while (!(a % i) && !(b % i) && !(c % i))\n            a /= i, b /= i, c /= i;\n        if (a == 1) return;\n    }\n}\nbool finish (int i, int j, int k) {\n    bool ret = true, used[10];\n    memset(used, 0, sizeof(used));\n    used[i % 10] = used[i / 100] = used[i / 10 % 10] = true;\n    used[j % 10] = used[j / 100] = used[j / 10 % 10] = true;\n    used[k % 10] = used[k / 100] = used[k / 10 % 10] = true;\n    for (int i = 1; i < 10; ++i)\n        if (!used[i]) {\n            ret = false;\n            break;\n        }\n    return ret;\n}"
 ],
