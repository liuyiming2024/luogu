21,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/80921.png\",\"name\":\"Sikiru\",\"slogan\":\"\\u4e94\\u5206\\u5148\\u751f\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Green\",\"ccfLevel\":6,\"xcpcLevel\":0,\"background\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/image_hosting\\/g7lkk0hs.png\"},\"upvote\":0,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1618\",\"type\":\"P\",\"name\":\"\\u4e09\\u8fde\\u51fb\\uff08\\u5347\\u7ea7\\u7248\\uff09\",\"difficulty\":2,\"fullScore\":100},\"promoteStatus\":3,\"collection\":null,\"content\":\"\\u8fd9\\u9053\\u9898\\u7684\\u8bdd\\uff0c\\u4e00\\u4e2a\\u679a\\u4e3e\\u5c31\\u53ef\\u4ee5\\u89e3\\u51b3\\u7684\\uff0c\\u4f46\\u662f\\u6700\\u91cd\\u8981\\u7684\\u662f\\u600e\\u4e48\\u679a\\u4e3e\\uff01\\uff01\\uff01\\u4e0b\\u9762\\u732e\\u4e0a\\u672c\\u849f\\u84bb\\u7684\\u65b9\\u6cd5\\uff1a\\u5176\\u5b9e\\u53ef\\u4ee5\\u53ea\\u679a\\u4e3e\\u7b2c\\u4e00\\u4e2a\\u6570\\uff0c\\u4e0d\\u59a8\\u5047\\u8bbe\\u4e09\\u4e2a\\u6570\\u5206\\u522b\\u4e3ai\\u3001j\\u3001k\\uff0c\\u5e76\\u4e14\\u8fd9\\u4e2a\\u6bd4\\u4f8b\\u662f\\u6700\\u7b80\\u7684\\uff1b\\u90a3\\u4e48\\u5c31\\u4f1a\\u6709j = i \\u00f7 a \\u00d7 b\\u548ck = i \\u00f7 a \\u00d7 c\\uff1b\\u518d\\u5224\\u65ad\\u662f\\u4e0d\\u662f1~9\\u90fd\\u7528\\u4e0a\\u4e86\\u3002\\u5148\\u8bf4\\u5316\\u7b80\\u6bd4\\u4f8b\\u7684\\u4ee3\\u7801\\uff1a\\r\\n```cpp\\r\\nvoid red(void) {\\r\\n\\tif (a == 1) return;\\r\\n\\tfor (int i = a; i \\u003E 1; --i) {\\r\\n\\t\\twhile (!(a % i) \\u0026\\u0026 !(b % i) \\u0026\\u0026 !(c % i))\\r\\n\\t\\t\\ta \\/= i, b \\/= i, c \\/= i;\\r\\n\\t\\tif (a == 1) return;\\r\\n\\t}\\r\\n}\\r\\n```\\r\\n\\u8fd9\\u662f\\u5224\\u65ad\\u662f\\u5426\\u90fd\\u7528\\u4e0a\\u7684\\u4ee3\\u7801\\uff1a\\r\\n```cpp\\r\\nbool finish (int i, int j, int k) {\\r\\n\\tbool ret = true, used[10];\\r\\n\\tmemset(used, 0, sizeof(used));\\r\\n\\tused[i % 10] = used[i \\/ 100] = used[i \\/ 10 % 10] = true;\\r\\n\\tused[j % 10] = used[j \\/ 100] = used[j \\/ 10 % 10] = true;\\r\\n\\tused[k % 10] = used[k \\/ 100] = used[k \\/ 10 % 10] = true;\\r\\n\\tfor (int i = 1; i \\u003C 10; ++i)\\r\\n\\t\\tif (!used[i]) {\\r\\n\\t\\t\\tret = false;\\r\\n\\t\\t\\tbreak;\\r\\n\\t\\t}\\r\\n\\treturn ret;\\r\\n}\\r\\n```\\r\\n\\u90a3\\u4e48\\u518d\\u52a0\\u4e0a\\u5224\\u65ad\\u6ca1\\u6709\\u7684\\u4ee3\\u7801\\u5c31\\u597d\\u4e86\\uff0c\\u8fd9\\u662f\\u672c\\u9898\\u4ee3\\u7801\\uff1a\\r\\n```cpp\\r\\n#include \\u003Ccstdio\\u003E\\r\\n#include \\u003Ccstring\\u003E\\r\\nint a, b, c;\\r\\nvoid red(void);\\t\\/\\/\\u7ea6\\u5206 \\r\\nbool finish(int i, int j, int k);\\r\\nint main() {\\r\\n\\tbool no = true;\\r\\n\\tscanf(\\u0022%d%d%d\\u0022, \\u0026a, \\u0026b, \\u0026c);\\r\\n\\tred();\\r\\n\\tfor (int i = 100 + a - 100 % a; i \\u003C= 999; i += a) {\\r\\n\\t\\tint j, k;\\r\\n\\t\\t\\/\\/printf(\\u0022%d\\\\n\\u0022, i);\\r\\n\\t\\tif (i \\/ a * c \\u003E 999) break;\\r\\n\\t\\tj = i \\/ a * b; k = i \\/ a * c;\\r\\n\\t\\tif (finish(i, j, k)) {\\r\\n\\t\\t\\tprintf(\\u0022%d %d %d\\\\n\\u0022, i, j, k);\\r\\n\\t\\t\\tno = false;\\r\\n\\t\\t}\\r\\n\\t} \\r\\n\\tif (no) printf(\\u0022No!!!\\u0022);\\r\\n\\treturn 0;\\r\\n}\\r\\nvoid red(void) {\\r\\n\\tif (a == 1) return;\\r\\n\\tfor (int i = a; i \\u003E 1; --i) {\\r\\n\\t\\twhile (!(a % i) \\u0026\\u0026 !(b % i) \\u0026\\u0026 !(c % i))\\r\\n\\t\\t\\ta \\/= i, b \\/= i, c \\/= i;\\r\\n\\t\\tif (a == 1) return;\\r\\n\\t}\\r\\n}\\r\\nbool finish (int i, int j, int k) {\\r\\n\\tbool ret = true, used[10];\\r\\n\\tmemset(used, 0, sizeof(used));\\r\\n\\tused[i % 10] = used[i \\/ 100] = used[i \\/ 10 % 10] = true;\\r\\n\\tused[j % 10] = used[j \\/ 100] = used[j \\/ 10 % 10] = true;\\r\\n\\tused[k % 10] = used[k \\/ 100] = used[k \\/ 10 % 10] = true;\\r\\n\\tfor (int i = 1; i \\u003C 10; ++i)\\r\\n\\t\\tif (!used[i]) {\\r\\n\\t\\t\\tret = false;\\r\\n\\t\\t\\tbreak;\\r\\n\\t\\t}\\r\\n\\treturn ret;\\r\\n}\\r\\n```\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795659216.39352}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/ehkpairy\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1618 \\u3010\\u4e09\\u8fde\\u51fb\\uff08\\u5347\\u7ea7\\u7248\\uff09\\u3011\",\"description\":\"\\u8fd9\\u9053\\u9898\\u7684\\u8bdd\\uff0c\\u4e00\\u4e2a\\u679a\\u4e3e\\u5c31\\u53ef\\u4ee5\\u89e3\\u51b3\\u7684\\uff0c\\u4f46\\u662f\\u6700\\u91cd\\u8981\\u7684\\u662f\\u600e\\u4e48\\u679a\\u4e3e\\uff01\\uff01\\uff01\\u4e0b\\u9762\\u732e\\u4e0a\\u672c\\u849f\\u84bb\\u7684\\u65b9\\u6cd5\\uff1a\\u5176\\u5b9e\\u53ef\\u4ee5\\u53ea\\u679a\\u4e3e\\u7b2c\\u4e00\\u4e2a\\u6570\\uff0c\\u4e0d\\u59a8\\u5047\\u8bbe\\u4e09\\u4e2a\\u6570\\u5206\\u522b\\u4e3ai\\u3001j\\u3001k\\uff0c\\u5e76\\u4e14\\u8fd9\\u4e2a\\u6bd4\\u4f8b\\u662f\\u6700\\u7b80\\u7684\\uff1b\\u90a3\\u4e48\\u5c31\\u4f1a\\u6709j = i \\u00f7 a \\u00d7 b\\u548ck = i \\u00f7 a \\u00d7 c\\uff1b\\u518d\\u5224\\u65ad\\u662f\\u4e0d\\u662f1~9\\u90fd\\u7528\\u4e0a\\u4e86\\u3002\\u5148\\u8bf4\\u5316\\u7b80\\u6bd4\\u4f8b\\u7684\\u4ee3\\u7801\\uff1a\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"Sikiru\"},\"datePublished\":\"2018-04-19T22:17:59+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1618 【三连击（升级版）】\" />\n    <meta property=\"og:description\" content=\"这道题的话，一个枚举就可以解决的，但是最重要的是怎么枚举！！！下面献上本蒟蒻的方法：其实可以只枚举第一个数，不妨假设三个数分别为i、j、k，并且这个比例是最简的；那么就会有j = i ÷ a × b和k = i ÷ a × c；再判断是不是1~9都用上了。先说化简比例的代码：…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"Sikiru\" />\n    <meta property=\"article:published_time\" content=\"2018-04-19T22:17:59+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/ehkpairy\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1618 【三连击（升级版）】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">Sikiru</a>\n            ·\n            <time datetime=\"2018-04-19T22:17:59+08:00\">2018-04-19 22:17:59</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>这道题的话，一个枚举就可以解决的，但是最重要的是怎么枚举！！！下面献上本蒟蒻的方法：其实可以只枚举第一个数，不妨假设三个数分别为i、j、k，并且这个比例是最简的；那么就会有j = i ÷ a × b和k = i ÷ a × c；再判断是不是1~9都用上了。先说化简比例的代码：</p>\n<pre><code class=\"language-cpp\">void red(void) {\n    if (a == 1) return;\n    for (int i = a; i &gt; 1; --i) {\n        while (!(a % i) &amp;&amp; !(b % i) &amp;&amp; !(c % i))\n            a /= i, b /= i, c /= i;\n        if (a == 1) return;\n    }\n}</code></pre>\n<p>这是判断是否都用上的代码：</p>\n<pre><code class=\"language-cpp\">bool finish (int i, int j, int k) {\n    bool ret = true, used[10];\n    memset(used, 0, sizeof(used));\n    used[i % 10] = used[i / 100] = used[i / 10 % 10] = true;\n    used[j % 10] = used[j / 100] = used[j / 10 % 10] = true;\n    used[k % 10] = used[k / 100] = used[k / 10 % 10] = true;\n    for (int i = 1; i &lt; 10; ++i)\n        if (!used[i]) {\n            ret = false;\n            break;\n        }\n    return ret;\n}</code></pre>\n<p>那么再加上判断没有的代码就好了，这是本题代码：</p>\n<pre><code class=\"language-cpp\">#include &lt;cstdio&gt;\n#include &lt;cstring&gt;\nint a, b, c;\nvoid red(void); //约分 \nbool finish(int i, int j, int k);\nint main() {\n    bool no = true;\n    scanf(\"%d%d%d\", &amp;a, &amp;b, &amp;c);\n    red();\n    for (int i = 100 + a - 100 % a; i &lt;= 999; i += a) {\n        int j, k;\n        //printf(\"%d\\n\", i);\n        if (i / a * c &gt; 999) break;\n        j = i / a * b; k = i / a * c;\n        if (finish(i, j, k)) {\n            printf(\"%d %d %d\\n\", i, j, k);\n            no = false;\n        }\n    } \n    if (no) printf(\"No!!!\");\n    return 0;\n}\nvoid red(void) {\n    if (a == 1) return;\n    for (int i = a; i &gt; 1; --i) {\n        while (!(a % i) &amp;&amp; !(b % i) &amp;&amp; !(c % i))\n            a /= i, b /= i, c /= i;\n        if (a == 1) return;\n    }\n}\nbool finish (int i, int j, int k) {\n    bool ret = true, used[10];\n    memset(used, 0, sizeof(used));\n    used[i % 10] = used[i / 100] = used[i / 10 % 10] = true;\n    used[j % 10] = used[j / 100] = used[j / 10 % 10] = true;\n    used[k % 10] = used[k / 100] = used[k / 10 % 10] = true;\n    for (int i = 1; i &lt; 10; ++i)\n        if (!used[i]) {\n            ret = false;\n            break;\n        }\n    return ret;\n}</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6055ff53c62e3ae',t:'MTc5NTY1OTIxNg=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6055ff53c62e3ae',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
