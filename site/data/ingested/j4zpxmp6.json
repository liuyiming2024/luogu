\nbool check1(int n) {\\n\\tstring a = to_string(n);\\n\\tif (a.size() != 3) return 0;\\n\\tfor (int i = 0; i \\u003C a.size(); i++)\\n\\t\\tfor (int j = 0; j \\u003C a.size(); j++) {\\n\\t\\t\\tif (i != j) \\n\\t\\t\\t\\tif (a[i] == a[j])\\n\\t\\t\\t\\t\\treturn 0;\\n\\t\\t\\tif (a[i] == \\u00270\\u0027 || a[j] == \\u00270\\u0027) \\n\\t\\t\\t\\treturn 0;\\n\\t\\t}\\n\\treturn 1;\\n}\\n```\\n```cpp\\n\\/\\/\\u5224\\u65ad\\u4e24\\u4e2a\\u6570\\u662f\\u5426\\u542b\\u6709\\u76f8\\u540c\\u6570\\u5b57\\nbool check2(int n, int m) {\\n\\tstring a = to_string(n), b = to_string(m);\\n\\tfor (int i = 0; i \\u003C a.size(); i++) \\n\\t\\tfor (int j = 0; j \\u003C b.size(); j++) \\n\\t\\t\\tif (a[i] == b[j]) return 0;\\n\\treturn 1;\\n}\\n```\\n### \\u4e3b\\u8981\\u4ee3\\u7801\\u90e8\\u5206\\n```cpp\\n\\tcin \\u003E\\u003E a \\u003E\\u003E b \\u003E\\u003E c;\\n\\tint cnt = 0;\\n\\tif (a == 0 || b == 0 || c == 0) {\\n\\t\\tcout \\u003C\\u003C \\u0022No!!!\\u0022;\\n\\t\\treturn 0;\\n\\t}\\n\\tfor (int i = 1; i \\u003C= 9; i++) {\\n\\t\\tfor (int j = 1; j \\u003C= 9; j++) {\\n\\t\\t\\tif (i == j) continue;\\n\\t\\t\\tfor (int k = 1; k \\u003C= 9; k++) {\\n\\t\\t\\t\\tif(i == k || j == k) continue;\\n\\t\\t\\t\\tint num1 = i * 100 + j * 10 + k;\\n\\t\\t\\t\\tif (num1 % a) continue;\\n\\t\\t\\t\\tint num2 = num1 \\/ a * b;\\n\\t\\t\\t\\tif (num2 % b || !check1(num2) || !check2(num1, num2))\\n\\t\\t\\t\\t\\tcontinue;\\n\\t\\t\\t\\tint num3 = num2 \\/ b * c;\\n\\t\\t\\t\\tif (num3 % c || !check1(num3) || !check2(num1, num3) || !check2(num2, num3))\\n\\t\\t\\t\\t\\tcontinue;\\n\\t\\t\\t\\tcnt++;\\n\\t\\t\\t\\tcout \\u003C\\u003C num1 \\u003C\\u003C \\u0022 \\u0022 \\u003C\\u003C num2 \\u003C\\u003C \\u0022 \\u0022 \\u003C\\u003C num3 \\u003C\\u003C \\u0022\\\\n\\u0022;\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\tif (cnt == 0) cout \\u003C\\u003C \\u0022No!!!\\u0022;\\n```\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795659219.81245}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/j4zpxmp6\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"P1618 \\u4e09\\u8fde\\u51fb\\uff08\\u5347\\u7ea7\\u7248\\uff09\",\"description\":\"\\u9898\\u76ee\\u5927\\u610f\\n\\u672c\\u9898\\u975e\\u5e38\\u7b80\\u6d01\\uff0c\\u4e0d\\u9700\\u8981\\u603b\\u7ed3\\u9898\\u610f\\u3002\\n\\u94fe\\u63a5\\u5728\\u8fd9\\u513f\\u2192 P1618 \\u4e09\\u8fde\\u51fb\\uff08\\u5347\\u7ea7\\u7248\\uff09\\n\\u89e3\\u9898\\u601d\\u8def\\n\\n\\u679a\\u4e3e\\u7b2c\\u4e00\\u4e2a\\u6570\\u53ef\\u80fd\\u7684\\u6570\\u5b57\\u6784\\u6210\\u65b9\\u5f0f\\uff0c\\u5e76\\u7b97\\u51fa\\u8fd9\\u4e2a\\u6570\\u3002\\/\\/\\u7b80\\u6613\\u4f2a\\u4ee3\\u7801\\nf (i : 1 ~ 9) \\nf (j : 1 ~ 9) \\n f (k : 1\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"Lachiva\"},\"datePublished\":\"2025-06-20T18:27:58+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"P1618 三连击（升级版）\" />\n    <meta property=\"og:description\" content=\"题目大意\n本题非常简洁，不需要总结题意。\n链接在这儿→ P1618 三连击（升级版）\n解题思路\n\n枚举第一个数可能的数字构成方式，并算出这个数。//简易伪代码\nf (i : 1 ~ 9) \nf (j : 1 ~ 9) \n f (k : 1…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"Lachiva\" />\n    <meta property=\"article:published_time\" content=\"2025-06-20T18:27:58+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/j4zpxmp6\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>P1618 三连击（升级版）</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">Lachiva</a>\n            ·\n            <time datetime=\"2025-06-20T18:27:58+08:00\">2025-06-20 18:27:58</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <h3>题目大意</h3>\n<p>本题非常简洁，不需要总结题意。<br />\n链接在这儿→ P1618 三连击（升级版）</p>\n<h3>解题思路</h3>\n<ol>\n<li>枚举第一个数可能的数字构成方式，并算出这个数。<pre><code>//简易伪代码\nf (i : 1 ~ 9) \nf (j : 1 ~ 9) \n f (k : 1 ~ 9) \n   num1 = i * 100 + j * 10 + k;</code></pre>\n</li>\n<li>算出第二个数，并判断是否合法。</li>\n<li>同理，算出第三个数，并判断是否合法。<h3>关键点</h3>\n<p>A：判断是否合法如何判断？<br />\nB：遍历，看是否有相同数字，并且要是三位数。</p>\n<pre><code class=\"language-cpp\">//判断一个数是否为题目要求的数\nbool check1(int n) {\n string a = to_string(n);\n if (a.size() != 3) return 0;\n for (int i = 0; i &lt; a.size(); i++)\n     for (int j = 0; j &lt; a.size(); j++) {\n         if (i != j) \n             if (a[i] == a[j])\n                 return 0;\n         if (a[i] == '0' || a[j] == '0') \n             return 0;\n     }\n return 1;\n}</code></pre>\n<pre><code class=\"language-cpp\">//判断两个数是否含有相同数字\nbool check2(int n, int m) {\n string a = to_string(n), b = to_string(m);\n for (int i = 0; i &lt; a.size(); i++) \n     for (int j = 0; j &lt; b.size(); j++) \n         if (a[i] == b[j]) return 0;\n return 1;\n}</code></pre>\n<h3>主要代码部分</h3>\n<pre><code class=\"language-cpp\"> cin &gt;&gt; a &gt;&gt; b &gt;&gt; c;\n int cnt = 0;\n if (a == 0 || b == 0 || c == 0) {\n     cout &lt;&lt; \"No!!!\";\n     return 0;\n }\n for (int i = 1; i &lt;= 9; i++) {\n     for (int j = 1; j &lt;= 9; j++) {\n         if (i == j) continue;\n         for (int k = 1; k &lt;= 9; k++) {\n             if(i == k || j == k) continue;\n             int num1 = i * 100 + j * 10 + k;\n             if (num1 % a) continue;\n             int num2 = num1 / a * b;\n             if (num2 % b || !check1(num2) || !check2(num1, num2))\n                 continue;\n             int num3 = num2 / b * c;\n             if (num3 % c || !check1(num3) || !check2(num1, num3) || !check2(num2, num3))\n                 continue;\n             cnt++;\n             cout &lt;&lt; num1 &lt;&lt; \" \" &lt;&lt; num2 &lt;&lt; \" \" &lt;&lt; num3 &lt;&lt; \"\\n\";\n         }\n     }\n }\n if (cnt == 0) cout &lt;&lt; \"No!!!\";</code></pre>\n</li>\n</ol>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6056007bb8288bd',t:'MTc5NTY1OTIxOQ=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6056007bb8288bd',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventL