 "code_blocks": [
  "//判断一个数是否为题目要求的数\nbool check1(int n) {\n string a = to_string(n);\n if (a.size() != 3) return 0;\n for (int i = 0; i < a.size(); i++)\n     for (int j = 0; j < a.size(); j++) {\n         if (i != j) \n             if (a[i] == a[j])\n                 return 0;\n         if (a[i] == '0' || a[j] == '0') \n             return 0;\n     }\n return 1;\n}",
  "//判断两个数是否含有相同数字\nbool check2(int n, int m) {\n string a = to_string(n), b = to_string(m);\n for (int i = 0; i < a.size(); i++) \n     for (int j = 0; j < b.size(); j++) \n         if (a[i] == b[j]) return 0;\n return 1;\n}",
  "cin >> a >> b >> c;\n int cnt = 0;\n if (a == 0 || b == 0 || c == 0) {\n     cout << \"No!!!\";\n     return 0;\n }\n for (int i = 1; i <= 9; i++) {\n     for (int j = 1; j <= 9; j++) {\n         if (i == j) continue;\n         for (int k = 1; k <= 9; k++) {\n             if(i == k || j == k) continue;\n             int num1 = i * 100 + j * 10 + k;\n             if (num1 % a) continue;\n             int num2 = num1 / a * b;\n             if (num2 % b || !check1(num2) || !check2(num1, num2))\n                 continue;\n             int num3 = num2 / b * c;\n             if (num3 % c || !check1(num3) || !check2(num1, num3) || !check2(num2, num3))\n                 continue;\n             cnt++;\n             cout << num1 << \" \" << num2 << \" \" << num3 << \"\\n\";\n         }\n     }\n }\n if (cnt == 0) cout << \"No!!!\";"
 ],
