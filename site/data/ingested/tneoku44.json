  "#include <bits/stdc++.h>\nusing namespace std;\n\nint a[1001][1001],n;\nint g[1001][1001];\n\nint main(){\n    cin>>n;\n    for(int i=0;i<n;i++){\n        for(int j=0;j<=i;j++){\n            cin>>a[i][j];\n        }\n    }\n    for(int i=n-1;i>0;i--){\n        for(int j=0;j<i;j++){\n            g[i-1][j]+=max(g[i][j],g[i][j+1])+a[i][j];\n        }\n    }\n    cout<<a[0][0];\n}",
  "#include <bits/stdc++.h>\nusing namespace std;\n\nint a[1001][1001],n;\n\nint main(){\n    cin>>n;\n    for(int i=0;i<n;i++){\n        for(int j=0;j<=i;j++){\n            cin>>a[i][j];\n        }\n    }\n    for(int i=n-1;i>0;i--){\n        for(int j=0;j<i;j++){\n            a[i-1][j]+=max(a[i][j],a[i][j+1]);\n        }\n    }\n    cout<<a[0][0];\n}"
