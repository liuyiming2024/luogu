  "#include <bits/stdc++.h>\nusing namespace std;\nint main() {\n    int n;\n    cin >> n;\n    for (int i = n - 1; i >= 2; i--) if (n % i == 0) { \n        cout << i;\n        break;\n    }\n    return 0;\n}",
  "#include <bits/stdc++.h>\nusing namespace std;\nint main() {\n    int n;\n    cin >> n;\n    for (int i = n - 1; i > sqrt(n); i--) if (n % i == 0) { \n        cout << i;\n        break;\n    }\n    return 0;\n}",
  "#include <bits/stdc++.h>\nusing namespace std;\nint main() {\n    int n;\n    cin >> n;\n    for (int i = 2; i <= n; i++) if (n % i == 0) { \n        cout << n / i;\n        break;\n    }\n    return 0;\n}"
