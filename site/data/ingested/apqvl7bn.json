c\\u4e3a1\\u3002\\n\\n\\n\\u5bf9\\u7167\\u4ee3\\u7801\\u597d\\u7406\\u89e3\\uff1a\\n\\n        \\n        \\n```cpp\\n#include\\u003Ccstdio\\u003E\\nint main()\\n{\\n    int n,k,s=0;\\/\\/\\u5468n\\u5f00\\u59cb\\u6e38\\uff0c\\u8fc7\\u4e86k\\u5929\\uff0c\\u6e38\\u4e86s\\u516c\\u91cc\\n    scanf(\\u0022%d %d\\u0022,\\u0026n,\\u0026k);\\n    for(int i=1;i\\u003C=k;i++)\\/\\/\\u8981\\u6e38k\\u5929\\uff0c\\u6240\\u4ee5\\u7528\\u5faa\\u73af\\n    {\\n        if(n!=6 \\u0026\\u0026 n!=7) s+=250;\\/\\/\\u5982\\u679c\\u4e0d\\u662f\\u5468\\u672b\\u5219\\u52a0250\\n        if(n==7) n=1;\\/\\/\\u5982\\u679c\\u662f\\u54687\\uff0c\\u90a3\\u4e48\\u8d4b\\u503c\\u4e3a1\\n        else n++;\\/\\/\\u5426\\u5219n+1\\n    }\\n    printf(\\u0022%d\\u0022,s);\\/\\/\\u8f93\\u51fa\\u6e38\\u4e86\\u591a\\u5c11\\u516c\\u91cc\\n    return 0;\\n}\\n```\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795629598.734714}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/apqvl7bn\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1424 \\u3010\\u5c0f\\u9c7c\\u7684\\u822a\\u7a0b(\\u6539\\u8fdb\\u7248)\\u3011\",\"description\":\"\\u8fd9\\u9898\\u770b\\u8d77\\u6765\\u597d\\u96be\\uff0c\\u4e0d\\u8fc7\\u505a\\u8d77\\u6765\\u662f\\u771f\\u7684\\u7b80\\u5355\\u3002\\n\\u9996\\u5148\\uff0c\\u4e0a\\u5348\\u6e38\\u6cf3150\\u516c\\u91cc\\uff0c\\u4e0b\\u5348\\u6e38\\u6cf3100\\u516c\\u91cc\\uff0c\\u665a\\u4e0a\\u548c\\u5468\\u672b\\u4f11\\u606f\\uff0c\\u8fd9\\u4e9b\\u6761\\u4ef6\\u53ef\\u4ee5\\u5408\\u5e76\\u6210\\u4e00\\u6761\\uff1a\\u9664\\u4e86\\u5468\\u672b\\uff0c\\u5176\\u4ed6\\u65f6\\u95f4\\u6bcf\\u5929\\u6e38\\u6cf3250\\u516c\\u91cc\\u3002\\uff08\\u8fd9\\u6837\\u4e00\\u8bf4\\u5c31\\u5f88\\u7b80\\u5355\\u660e\\u4e86\\u4e86\\u5427\\u3002\\uff09\\n\\u5982\\u4f55\\u5224\\u65ad\\u662f\\u5468\\u672b\\u5462\\uff1f\\u5047\\u8bbe\\u5c0f\\u9c7c\\u4ece\\u5468n\\u5f00\\u59cb\\u6e38\\uff0c\\u6bcf\\u6e38\\u4e00\\u5929\\u5c31\\u662fn+1\\uff0c\\u90a3\\u5982\\u679cn\\u662f6\\u6216\\u80057\\uff0c\\u90a3\\u5c31\\u8bc1\\u660e\\u662f\\u5468\\u672b\\uff0c\\u53cd\\u4e4b\\u5982\\u679c\\u4e0d\\u662f6\\u6216\\u80057\\uff0c\\u90a3\\u4e48\\u5c31\\u4e0d\\u662f\\u5468\\u672b\\uff0c\\u90a3\\u5c31\\u8981\\u52a0\\u4e0a250\\u3002\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"CYYC\"},\"datePublished\":\"2018-01-21T10:37:12+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1424 【小鱼的航程(改进版)】\" />\n    <meta property=\"og:description\" content=\"这题看起来好难，不过做起来是真的简单。\n首先，上午游泳150公里，下午游泳100公里，晚上和周末休息，这些条件可以合并成一条：除了周末，其他时间每天游泳250公里。（这样一说就很简单明了了吧。）\n如何判断是周末呢？假设小鱼从周n开始游，每游一天就是n+1，那如果n是6或者7，那就证明是周末，反之如果不是6或者7，那么就不是周末，那就要加上250。…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"CYYC\" />\n    <meta property=\"article:published_time\" content=\"2018-01-21T10:37:12+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/apqvl7bn\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1424 【小鱼的航程(改进版)】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">CYYC</a>\n            ·\n            <time datetime=\"2018-01-21T10:37:12+08:00\">2018-01-21 10:37:12</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>这题看起来好难，不过做起来是真的简单。</p>\n<p>首先，上午游泳150公里，下午游泳100公里，晚上和周末休息，这些条件可以合并成一条：除了周末，其他时间每天游泳250公里。（这样一说就很简单明了了吧。）</p>\n<p>如何判断是周末呢？假设小鱼从周n开始游，每游一天就是n+1，那如果n是6或者7，那就证明是周末，反之如果不是6或者7，那么就不是周末，那就要加上250。</p>\n<p>最后是最重要的一点，如果现在是周7，那明天就不能是周8了，而是周1，所以当n==7的时候，n应该赋值为1。</p>\n<p>对照代码好理解：</p>\n<pre><code class=\"language-cpp\">#include&lt;cstdio&gt;\nint main()\n{\n    int n,k,s=0;//周n开始游，过了k天，游了s公里\n    scanf(\"%d %d\",&amp;n,&amp;k);\n    for(int i=1;i&lt;=k;i++)//要游k天，所以用循环\n    {\n        if(n!=6 &amp;&amp; n!=7) s+=250;//如果不是周末则加250\n        if(n==7) n=1;//如果是周7，那么赋值为1\n        else n++;//否则n+1\n    }\n    printf(\"%d\",s);//输出游了多少公里\n    return 0;\n}</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6028cdf3dda5b6a',t:'MTc5NTYyOTU5OA=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6028cdf3dda5b6a',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
