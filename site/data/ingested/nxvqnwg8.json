{
 "id": "nxvqnwg8",
 "kind": "article",
 "verdict": "题解",
 "source": "https://www.luogu.com/article/nxvqnwg8",
 "problem": "",
 "is_article": "是",
 "code_blocks": [
  "#include<iostream>\n#include<cstring>\n#include<cstdio>\nusing namespace std;\nchar a[200];//存储读入数据\nint len=0;//读入数据长度\nvoid reversef(int fro,int to)//本函数用于计算整数翻转或小数点前的整数翻转（全拼：reverse front）",
  "bool is_ok=false;//用来判断是否去完“0”\n    for(int i=to;i>=fro;i--)\n    {\n        if(is_ok==false)\n        {\n            if(a[i]!='0')//扫描到非0整数，表明去0成功\n            {\n                is_ok=true;\n                cout<<a[i];\n            } \n        }\n        else cout<<a[i];//如果已经完成去0，则直接输出被反转字符\n        if(is_ok==false&&i==fro) cout<<\"0\";//整个字符串没有非0整数，即“0”或“0000000”情况，直接输出0\n    }\n}\nvoid reverseb(int fro,int to)//用于小数点后面的整数反转，即去前翻转。（全拼：reverse behind）\n{\n    bool is_ok=false;\n    for(int i=fro;i<=to;i++)//这是为了去掉前面的0\n    {\n        if(a[i]!='0')\n        {\n            fro=i;\n            is_ok=true;\n            break;\n        }\n    }\n    if(is_ok==false)//如果前面没扫描到0，就说明是“0”或“0000000”情况，直接输出0\n    {\n        cout<<\"0\";\n        return;\n    }\n    else\n    {\n        for(int i=to;i>=fro;i--) cout<<a[i];//正常情况直接进行翻转\n    }\n}\nint main()//主程序\n{\n    cin>>a;\n    len=strlen(a);//读入数据\n    for(int i=0;i<len;i++)//开始分辨数据的情况\n    {\n        if(a[i]=='.')//小数点情况\n        {\n            reversef(0,i-1);\n            cout<<a[i];\n            reverseb(i+1,len-1);\n            return 0;\n        }\n        if(a[i]=='/')//分数情况，注意前后都用了reversef\n        {\n            reversef(0,i-1);\n            cout<<a[i];\n            reversef(i+1,len-1);\n            return 0;\n        }\n        if(a[i]=='%')//白分数情况\n        {\n            reversef(0,i-1);\n            cout<<\"%\";\n            return 0;\n        }\n    }\n    reversef(0,len-1);//以上情况都没遇到，则数据是整数，直接翻转整数就行了。\n    return 0;\n}"
 ],
 "sha256": "584ea7d6e454858a",
 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <!-- 匿名页面令牌已移除（公开归档不保留） -->\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112609'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>题解 P1553 【数字反转（升级版）】 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"nxvqnwg8\",\"title\":\"\\u9898\\u89e3 P1553 \\u3010\\u6570\\u5b57\\u53cd\\u8f6c\\uff08\\u5347\\u7ea7\\u7248\\uff09\\u3011\",\"category\":2,\"time\":1474546952,\"author\":{\"uid\":19027,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/19027.png\",\"name\":\"rentenglong\",\"slogan\":\"\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Green\",\"ccfLevel\":6,\"xcpcLevel\":0,\"background\":\"\"},\"upvote\":10,\"replyCount\":1,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1553\",\"type\":\"P\",\"name\":\"\\u6570\\u5b57\\u53cd\\u8f6c\\uff08\\u5347\\u7ea7\\u7248\\uff09\",\"difficulty\":2,\"fullScore\":100},\"promoteStatus\":0,\"collection\":null,\"content\":\"\\u5176\\u5b9e\\u8fd9\\u4e2a\\u9898\\u4e3b\\u8981\\u5728\\u4e8e\\u9898\\u610f\\u7406\\u89e3\\u3002\\n\\n\\u5982\\u679c\\u8fc7\\u4e86\\u7b80\\u5355\\u7684\\u6570\\u5b57\\u7ffb\\u8f6c\\uff0c\\u4f46\\u662f\\u8fd9\\u4e2a\\u6ca1\\u8fc7\\uff0c\\u5e94\\u8be5\\u53c2\\u89c1\\u4ee5\\u4e0b\\u6761\\u76ee\\uff1a\\n\\n- \\u5173\\u4e8e\\u6574\\u6570\\n\\n\\u540e\\u9762\\u76840\\u4e0d\\u8981\\n\\n\\u9047\\u5230\\u201c0\\u201d\\u6216\\u201c000000000000\\u201d\\u53ea\\u8f93\\u51fa0\\n\\n- \\u5173\\u4e8e\\u5c0f\\u6570\\n\\n\\u5c0f\\u6570\\u70b9\\u524d\\u7684\\u6574\\u6570\\uff1a\\u540e\\u9762\\u76840\\u4e0d\\u8981\\n\\n\\u5c0f\\u6570\\u70b9\\u540e\\u7684\\u6574\\u6570\\uff1a\\u524d\\u9762\\u76840\\u4e0d\\u8981\\n\\n\\u9047\\u5230\\u201c0\\u201d\\u6216\\u201c000000000000\\u201d\\u53ea\\u8f93\\u51fa0\\n\\n\\u5c0f\\u6570\\u70b9\\u7684\\u6b63\\u786e\\u8f93\\u51fa\\n\\n- \\u5173\\u4e8e\\u5206\\u6570\\n\\n\\u5206\\u6570\\u524d\\u7684\\u6574\\u6570\\uff1a\\u540e\\u9762\\u76840\\u4e0d\\u8981\\n\\n\\u5206\\u6570\\u540e\\u7684\\u6574\\u6570\\uff1a\\u540e\\u9762\\u76840\\u4e0d\\u8981\\n\\n\\u9047\\u5230\\u201c0\\u201d\\u6216\\u201c000000000000\\u201d\\u53ea\\u8f93\\u51fa0\\n\\n\\u5206\\u6570\\u7684\\u6b63\\u786e\\u8f93\\u51fa\\n\\n- \\u5173\\u4e8e\\u767e\\u5206\\u6570\\n\\n\\u767e\\u5206\\u6570\\u524d\\u7684\\u6574\\u6570\\uff1a\\u540e\\u9762\\u76840\\u4e0d\\u8981\\n\\n\\u9047\\u5230\\u201c0\\u201d\\u6216\\u201c000000000000\\u201d\\u53ea\\u8f93\\u51fa0\\n\\n\\u767e\\u5206\\u53f7\\u7684\\u6b63\\u786e\\u8f93\\u51fa\\n\\n```cpp\\n#include\\u003Ciostream\\u003E\\n#include\\u003Ccstring\\u003E\\n#include\\u003Ccstdio\\u003E\\nusing namespace std;\\nchar a[200];\\/\\/\\u5b58\\u50a8\\u8bfb\\u5165\\u6570\\u636e\\nint len=0;\\/\\/\\u8bfb\\u5165\\u6570\\u636e\\u957f\\u5ea6\\nvoid reversef(int fro,int to)\\/\\/\\u672c\\u51fd\\u6570\\u7528\\u4e8e\\u8ba1\\u7b97\\u6574\\u6570\\u7ffb\\u8f6c\\u6216\\u5c0f\\u6570\\u70b9\\u524d\\u7684\\u6574\\u6570\\u7ffb\\u8f6c\\uff08\\u5168\\u62fc\\uff1areverse front\\uff09\\n```\\n{\\/\\/\\u51fd\\u6570\\u662f\\u6a21\\u5757\\u5316\\u51fd\\u6570\\uff0c\\u76f4\\u63a5\\u4ecea\\u5708\\u5b9a\\u8303\\u56f4a[fro...to]\\u8fdb\\u884c\\u53cd\\u8f6c\\u3002\\n```cpp\\n    bool is_ok=false;\\/\\/\\u7528\\u6765\\u5224\\u65ad\\u662f\\u5426\\u53bb\\u5b8c\\u201c0\\u201d\\n    for(int i=to;i\\u003E=fro;i--)\\n    {\\n        if(is_ok==false)\\n        {\\n            if(a[i]!=\\u00270\\u0027)\\/\\/\\u626b\\u63cf\\u5230\\u975e0\\u6574\\u6570\\uff0c\\u8868\\u660e\\u53bb0\\u6210\\u529f\\n            {\\n                is_ok=true;\\n                cout\\u003C\\u003Ca[i];\\n            } \\n        }\\n        else cout\\u003C\\u003Ca[i];\\/\\/\\u5982\\u679c\\u5df2\\u7ecf\\u5b8c\\u6210\\u53bb0\\uff0c\\u5219\\u76f4\\u63a5\\u8f93\\u51fa\\u88ab\\u53cd\\u8f6c\\u5b57\\u7b26\\n        if(is_ok==false\\u0026\\u0026i==fro) cout\\u003C\\u003C\\u00220\\u0022;\\/\\/\\u6574\\u4e2a\\u5b57\\u7b26\\u4e32\\u6ca1\\u6709\\u975e0\\u6574\\u6570\\uff0c\\u5373\\u201c0\\u201d\\u6216\\u201c0000000\\u201d\\u60c5\\u51b5\\uff0c\\u76f4\\u63a5\\u8f93\\u51fa0\\n    }\\n}\\nvoid reverseb(int fro,int to)\\/\\/\\u7528\\u4e8e\\u5c0f\\u6570\\u70b9\\u540e\\u9762\\u7684\\u6574\\u6570\\u53cd\\u8f6c\\uff0c\\u5373\\u53bb\\u524d\\u7ffb\\u8f6c\\u3002\\uff08\\u5168\\u62fc\\uff1areverse behind\\uff09\\n{\\n    bool is_ok=false;\\n    for(int i=fro;i\\u003C=to;i++)\\/\\/\\u8fd9\\u662f\\u4e3a\\u4e86\\u53bb\\u6389\\u524d\\u9762\\u76840\\n    {\\n        if(a[i]!=\\u00270\\u0027)\\n        {\\n            fro=i;\\n            is_ok=true;\\n            break;\\n        }\\n    }\\n    if(is_ok==false)\\/\\/\\u5982\\u679c\\u524d\\u9762\\u6ca1\\u626b\\u63cf\\u52300\\uff0c\\u5c31\\u8bf4\\u660e\\u662f\\u201c0\\u201d\\u6216\\u201c0000000\\u201d\\u60c5\\u51b5\\uff0c\\u76f4\\u63a5\\u8f93\\u51fa0\\n    {\\n        cout\\u003C\\u003C\\u00220\\u0022;\\n        return;\\n    }\\n    else\\n    {\\n        for(int i=to;i\\u003E=fro;i--) cout\\u003C\\u003Ca[i];\\/\\/\\u6b63\\u5e38\\u60c5\\u51b5\\u76f4\\u63a5\\u8fdb\\u884c\\u7ffb\\u8f6c\\n    }\\n}\\nint main()\\/\\/\\u4e3b\\u7a0b\\u5e8f\\n{\\n    cin\\u003E\\u003Ea;\\n    len=strlen(a);\\/\\/\\u8bfb\\u5165\\u6570\\u636e\\n    for(int i=0;i\\u003Clen;i++)\\/\\/\\u5f00\\u59cb\\u5206\\u8fa8\\u6570\\u636e\\u7684\\u60c5\\u51b5\\n    {\\n        if(a[i]==\\u0027.\\u0027)\\/\\/\\u5c0f\\u6570\\u70b9\\u60c5\\u51b5\\n        {\\n            reversef(0,i-1);\\n            cout\\u003C\\u003Ca[i];\\n            reverseb(i+1,len-1);\\n            return 0;\\n        }\\n        if(a[i]==\\u0027\\/\\u0027)\\/\\/\\u5206\\u6570\\u60c5\\u51b5\\uff0c\\u6ce8\\u610f\\u524d\\u540e\\u90fd\\u7528\\u4e86reversef\\n        {\\n            reversef(0,i-1);\\n            cout\\u003C\\u003Ca[i];\\n            reversef(i+1,len-1);\\n            return 0;\\n        }\\n        if(a[i]==\\u0027%\\u0027)\\/\\/\\u767d\\u5206\\u6570\\u60c5\\u51b5\\n        {\\n            reversef(0,i-1);\\n            cout\\u003C\\u003C\\u0022%\\u0022;\\n            return 0;\\n        }\\n    }\\n    reversef(0,len-1);\\/\\/\\u4ee5\\u4e0a\\u60c5\\u51b5\\u90fd\\u6ca1\\u9047\\u5230\\uff0c\\u5219\\u6570\\u636e\\u662f\\u6574\\u6570\\uff0c\\u76f4\\u63a5\\u7ffb\\u8f6c\\u6574\\u6570\\u5c31\\u884c\\u4e86\\u3002\\n    return 0;\\n}\\n```\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795659204.254099}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/nxvqnwg8\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1553 \\u3010\\u6570\\u5b57\\u53cd\\u8f6c\\uff08\\u5347\\u7ea7\\u7248\\uff09\\u3011\",\"description\":\"\\u5176\\u5b9e\\u8fd9\\u4e2a\\u9898\\u4e3b\\u8981\\u5728\\u4e8e\\u9898\\u610f\\u7406\\u89e3\\u3002\\n\\u5982\\u679c\\u8fc7\\u4e86\\u7b80\\u5355\\u7684\\u6570\\u5b57\\u7ffb\\u8f6c\\uff0c\\u4f46\\u662f\\u8fd9\\u4e2a\\u6ca1\\u8fc7\\uff0c\\u5e94\\u8be5\\u53c2\\u89c1\\u4ee5\\u4e0b\\u6761\\u76ee\\uff1a\\n\\n\\u5173\\u4e8e\\u6574\\u6570\\n\\n\\u540e\\u9762\\u76840\\u4e0d\\u8981\\n\\u9047\\u5230\\u201c0\\u201d\\u6216\\u201c000000000000\\u201d\\u53ea\\u8f93\\u51fa0\\n\\n\\u5173\\u4e8e\\u5c0f\\u6570\\n\\n\\u5c0f\\u6570\\u70b9\\u524d\\u7684\\u6574\\u6570\\uff1a\\u540e\\u9762\\u76840\\u4e0d\\u8981\\n\\u5c0f\\u6570\\u70b9\\u540e\\u7684\\u6574\\u6570\\uff1a\\u524d\\u9762\\u76840\\u4e0d\\u8981\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"rentenglong\"},\"datePublished\":\"2016-09-22T20:22:32+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1553 【数字反转（升级版）】\" />\n    <meta property=\"og:description\" content=\"其实这个题主要在于题意理解。\n如果过了简单的数字翻转，但是这个没过，应该参见以下条目：\n\n关于整数\n\n后面的0不要\n遇到“0”或“000000000000”只输出0\n\n关于小数\n\n小数点前的整数：后面的0不要\n小数点后的整数：前面的0不要…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"rentenglong\" />\n    <meta property=\"article:published_time\" content=\"2016-09-22T20:22:32+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/nxvqnwg8\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1553 【数字反转（升级版）】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">rentenglong</a>\n            ·\n            <time datetime=\"2016-09-22T20:22:32+08:00\">2016-09-22 20:22:32</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>其实这个题主要在于题意理解。</p>\n<p>如果过了简单的数字翻转，但是这个没过，应该参见以下条目：</p>\n<ul>\n<li>关于整数</li>\n</ul>\n<p>后面的0不要</p>\n<p>遇到“0”或“000000000000”只输出0</p>\n<ul>\n<li>关于小数</li>\n</ul>\n<p>小数点前的整数：后面的0不要</p>\n<p>小数点后的整数：前面的0不要</p>\n<p>遇到“0”或“000000000000”只输出0</p>\n<p>小数点的正确输出</p>\n<ul>\n<li>关于分数</li>\n</ul>\n<p>分数前的整数：后面的0不要</p>\n<p>分数后的整数：后面的0不要</p>\n<p>遇到“0”或“000000000000”只输出0</p>\n<p>分数的正确输出</p>\n<ul>\n<li>关于百分数</li>\n</ul>\n<p>百分数前的整数：后面的0不要</p>\n<p>遇到“0”或“000000000000”只输出0</p>\n<p>百分号的正确输出</p>\n<pre><code class=\"language-cpp\">#include&lt;iostream&gt;\n#include&lt;cstring&gt;\n#include&lt;cstdio&gt;\nusing namespace std;\nchar a[200];//存储读入数据\nint len=0;//读入数据长度\nvoid reversef(int fro,int to)//本函数用于计算整数翻转或小数点前的整数翻转（全拼：reverse front）</code></pre>\n<p>{//函数是模块化函数，直接从a圈定范围a[fro...to]进行反转。</p>\n<pre><code class=\"language-cpp\">    bool is_ok=false;//用来判断是否去完“0”\n    for(int i=to;i&gt;=fro;i--)\n    {\n        if(is_ok==false)\n        {\n            if(a[i]!='0')//扫描到非0整数，表明去0成功\n            {\n                is_ok=true;\n                cout&lt;&lt;a[i];\n            } \n        }\n        else cout&lt;&lt;a[i];//如果已经完成去0，则直接输出被反转字符\n        if(is_ok==false&amp;&amp;i==fro) cout&lt;&lt;\"0\";//整个字符串没有非0整数，即“0”或“0000000”情况，直接输出0\n    }\n}\nvoid reverseb(int fro,int to)//用于小数点后面的整数反转，即去前翻转。（全拼：reverse behind）\n{\n    bool is_ok=false;\n    for(int i=fro;i&lt;=to;i++)//这是为了去掉前面的0\n    {\n        if(a[i]!='0')\n        {\n            fro=i;\n            is_ok=true;\n            break;\n        }\n    }\n    if(is_ok==false)//如果前面没扫描到0，就说明是“0”或“0000000”情况，直接输出0\n    {\n        cout&lt;&lt;\"0\";\n        return;\n    }\n    else\n    {\n        for(int i=to;i&gt;=fro;i--) cout&lt;&lt;a[i];//正常情况直接进行翻转\n    }\n}\nint main()//主程序\n{\n    cin&gt;&gt;a;\n    len=strlen(a);//读入数据\n    for(int i=0;i&lt;len;i++)//开始分辨数据的情况\n    {\n        if(a[i]=='.')//小数点情况\n        {\n            reversef(0,i-1);\n            cout&lt;&lt;a[i];\n            reverseb(i+1,len-1);\n            return 0;\n        }\n        if(a[i]=='/')//分数情况，注意前后都用了reversef\n        {\n            reversef(0,i-1);\n            cout&lt;&lt;a[i];\n            reversef(i+1,len-1);\n            return 0;\n        }\n        if(a[i]=='%')//白分数情况\n        {\n            reversef(0,i-1);\n            cout&lt;&lt;\"%\";\n            return 0;\n        }\n    }\n    reversef(0,len-1);//以上情况都没遇到，则数据是整数，直接翻转整数就行了。\n    return 0;\n}</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6055fa95a959ab6',t:'MTc5NTY1OTIwNA=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6055fa95a959ab6',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
