 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <!-- 匿名页面令牌已移除（公开归档不保留） -->\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112601'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>题解 P1116 【车厢重组】 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"vt4bqm6v\",\"title\":\"\\u9898\\u89e3 P1116 \\u3010\\u8f66\\u53a2\\u91cd\\u7ec4\\u3011\",\"category\":2,\"time\":1553268795,\"author\":{\"uid\":160877,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/160877.png\",\"name\":\"Leo_Jiang\",\"slogan\":\"\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Green\",\"ccfLevel\":5,\"xcpcLevel\":0,\"background\":\"\"},\"upvote\":0,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1116\",\"type\":\"P\",\"name\":\"\\u8f66\\u53a2\\u91cd\\u7ec4\",\"difficulty\":2,\"fullScore\":100},\"promoteStatus\":3,\"collection\":null,\"content\":\"**\\u5f52\\u5e76\\u6392\\u5e8f\\uff1a**\\n\\n\\u7b80\\u5355\\u7684\\u6765\\u8bf4\\uff0c\\u5c31\\u662f\\u8fd0\\u7528\\u5206\\u652f\\u601d\\u60f3\\uff1a\\u201c\\u5206\\u800c\\u6cbb\\u4e4b\\u201d\\u3002\\n\\n\\u867d\\u7136\\u672c\\u9898\\u4e0d\\u9700\\u8981\\u8fdb\\u884c\\u6392\\u5e8f\\uff0c\\u53ea\\u9700\\u8981\\u627e\\u51fa\\u9006\\u5e8f\\u5bf9\\u7684\\u4e2a\\u6570\\uff0c\\u4f46\\u662f\\u8fd9\\u79cdnlog(n)\\u7684\\u7a33\\u5b9a\\u7a0b\\u5e8f\\u53ea\\u9700\\u8981\\u5728\\u539f\\u57fa\\u7840\\u6a21\\u677f\\u4e0a\\u52a0\\u90a3\\u4e48\\u4e00\\u70b9\\u70b9\\u5c31\\u80fd\\u5b8c\\u6210\\u3002\\n\\n```cpp\\n#include\\u003Ciostream\\u003E\\nusing namespace std;\\n\\nlong long t[500005],ans = 0;         \\/\\/t\\u7528\\u6765\\u4e34\\u65f6\\u5b58\\u653e\\u6392\\u5e8f\\uff0cans\\u7528\\u6765\\u8ba1\\u6570\\n\\nvoid merge(int a[],int l,int r){      \\/\\/\\u6570\\u7ec4\\uff0c\\u5de6\\u8d77\\u70b9\\uff0c\\u53f3\\u7ec8\\u70b9\\n\\tif(l == r) return;      \\/\\/\\u5de6\\u53f3\\u91cd\\u5408\\uff0c\\u8fd4\\u56de\\n\\tint mid = (l+r)\\/2;      \\/\\/\\u5206\\u5c31\\u662f\\u4e8c\\u5206\\uff0c\\u627e\\u5230\\u4e2d\\u70b9\\n\\tmerge(a,l,mid);        \\/\\/\\u5148\\u5206\\n\\tmerge(a,mid+1,r);\\n\\tint i = l,j = mid + 1,k = l;  \\/\\/\\u4e09\\u4e2a\\u6307\\u9488\\n\\twhile(i\\u003C=mid\\u0026\\u0026j\\u003C=r){       \\/\\/\\u4e0d\\u80fd\\u51fa\\u754c\\n\\t\\tif(a[i]\\u003Ea[j]){\\t\\t\\t \\/\\/\\u5982\\u679c\\u524d\\u9762\\u7684\\u6bd4\\u540e\\u9762\\u7684\\u5927\\uff0c\\u5fc5\\u5b9a\\u51fa\\u73b0\\u9006\\u5e8f\\u5bf9\\n\\t\\t\\tt[k++] = a[j++];    \\/\\/\\u8f83\\u5c0f\\u6570\\u5148\\u50a8\\u5b58\\n\\t\\t\\tans += mid - i + 1;  \\/\\/\\u6572\\u9ed1\\u677f\\uff1a\\u8fd9\\u91cc\\u9700\\u8981\\u91cd\\u70b9\\u7406\\u89e3\\u3002\\n                                               \\u56e0\\u4e3a\\u5df2\\u7ecf\\u662f\\u4e24\\u8fb9\\u4ece\\u5c0f\\u5230\\u5927\\u6392\\u597d\\u4e86\\uff0c\\u6240\\u4ee5\\u4e00\\u65e6\\u5de6\\u8fb9\\u6570\\u6bd4\\u53f3\\u8fb9\\u6570\\u5927\\uff0c\\u90a3\\u4e48\\u53f3\\u8fb9\\u6570\\u540e\\u9762\\u7684\\u6570\\u90fd\\u80fd\\u4e0e\\u5de6\\u8fb9\\u6570\\u6784\\u6210\\u9006\\u5e8f\\u5bf9\\n\\t\\t}\\n\\t\\telse t[k++] = a[i++];  \\/\\/\\u5982\\u679c\\u662f\\u6709\\u5e8f\\u7684\\uff0c\\u76f4\\u63a5\\u653e\\u8fdb\\u53bb\\n\\t}\\n\\t\\n\\twhile(i\\u003C=mid) t[k++] = a[i++];\\n\\twhile(j\\u003C=r) t[k++] = a[j++];    \\/\\/\\u591a\\u4f59\\u7684\\u5168\\u653e\\u8fdb\\u53bb\\n\\tfor(i = l;i\\u003C=r;i++) a[i] = t[i]; \\/\\/\\u518d\\u628a\\u4e34\\u65f6\\u5b58\\u653e\\u7684\\u8fd8\\u539f\\n}\\n\\nint main(){\\n\\tint n,a[500005];\\n\\tcin\\u003E\\u003En;\\n\\tfor(int i = 1;i\\u003C=n;i++) cin\\u003E\\u003Ea[i];\\n\\tmerge(a,1,n);\\n\\tcout\\u003C\\u003Cans\\u003C\\u003Cendl;\\n\\treturn 0;\\n}\\n\\/\\/\\u4e3b\\u7a0b\\u5e8f\\u6ca1\\u4ec0\\u4e48\\u597d\\u8bb2\\u7684\\u5427\\n```\\n\\n~~\\u5bf9\\u4e0d\\u8d77\\u6211\\u4e0d\\u4f1a\\u63d2\\u56fe\\u7247~~\\uff0c\\u8fd9\\u4e2a\\u4ee3\\u7801\\u91cd\\u5728\\u7406\\u89e3\\uff0c\\u5199\\u5bb9\\u6613\\u3002\\u5e0c\\u671b\\u5bf9\\u5927\\u5bb6\\u6709\\u5e2e\\u52a9\\uff01\\n\\n \\n  \\n \\n _\\u7eaa\\u5ff5\\u4e00\\u4e0b\\u7b2c\\u4e00\\u6b21\\u5199\\u9898\\u89e3_ \",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795629521.555336}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/vt4bqm6v\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1116 \\u3010\\u8f66\\u53a2\\u91cd\\u7ec4\\u3011\",\"description\":\"\\u5f52\\u5e76\\u6392\\u5e8f\\uff1a\\n\\u7b80\\u5355\\u7684\\u6765\\u8bf4\\uff0c\\u5c31\\u662f\\u8fd0\\u7528\\u5206\\u652f\\u601d\\u60f3\\uff1a\\u201c\\u5206\\u800c\\u6cbb\\u4e4b\\u201d\\u3002\\n\\u867d\\u7136\\u672c\\u9898\\u4e0d\\u9700\\u8981\\u8fdb\\u884c\\u6392\\u5e8f\\uff0c\\u53ea\\u9700\\u8981\\u627e\\u51fa\\u9006\\u5e8f\\u5bf9\\u7684\\u4e2a\\u6570\\uff0c\\u4f46\\u662f\\u8fd9\\u79cdnlog(n)\\u7684\\u7a33\\u5b9a\\u7a0b\\u5e8f\\u53ea\\u9700\\u8981\\u5728\\u539f\\u57fa\\u7840\\u6a21\\u677f\\u4e0a\\u52a0\\u90a3\\u4e48\\u4e00\\u70b9\\u70b9\\u5c31\\u80fd\\u5b8c\\u6210\\u3002\\n#include&lt;iostream&gt;\\nusing\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"Leo_Jiang\"},\"datePublished\":\"2019-03-22T23:33:15+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1116 【车厢重组】\" />\n    <meta property=\"og:description\" content=\"归并排序：\n简单的来说，就是运用分支思想：“分而治之”。\n虽然本题不需要进行排序，只需要找出逆序对的个数，但是这种nlog(n)的稳定程序只需要在原基础模板上加那么一点点就能完成。\n#include&amp;lt;iostream&amp;gt;\nusing…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"Leo_Jiang\" />\n    <meta property=\"article:published_time\" content=\"2019-03-22T23:33:15+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/vt4bqm6v\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1116 【车厢重组】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">Leo_Jiang</a>\n            ·\n            <time datetime=\"2019-03-22T23:33:15+08:00\">2019-03-22 23:33:15</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p><strong>归并排序：</strong></p>\n<p>简单的来说，就是运用分支思想：“分而治之”。</p>\n<p>虽然本题不需要进行排序，只需要找出逆序对的个数，但是这种nlog(n)的稳定程序只需要在原基础模板上加那么一点点就能完成。</p>\n<pre><code class=\"language-cpp\">#include&lt;iostream&gt;\nusing namespace std;\n\nlong long t[500005],ans = 0;         //t用来临时存放排序，ans用来计数\n\nvoid merge(int a[],int l,int r){      //数组，左起点，右终点\n    if(l == r) return;      //左右重合，返回\n    int mid = (l+r)/2;      //分就是二分，找到中点\n    merge(a,l,mid);        //先分\n    merge(a,mid+1,r);\n    int i = l,j = mid + 1,k = l;  //三个指针\n    while(i&lt;=mid&amp;&amp;j&lt;=r){       //不能出界\n        if(a[i]&gt;a[j]){           //如果前面的比后面的大，必定出现逆序对\n            t[k++] = a[j++];    //较小数先储存\n            ans += mid - i + 1;  //敲黑板：这里需要重点理解。\n                                               因为已经是两边从小到大排好了，所以一旦左边数比右边数大，那么右边数后面的数都能与左边数构成逆序对\n        }\n        else t[k++] = a[i++];  //如果是有序的，直接放进去\n    }\n\n    while(i&lt;=mid) t[k++] = a[i++];\n    while(j&lt;=r) t[k++] = a[j++];    //多余的全放进去\n    for(i = l;i&lt;=r;i++) a[i] = t[i]; //再把临时存放的还原\n}\n\nint main(){\n    int n,a[500005];\n    cin&gt;&gt;n;\n    for(int i = 1;i&lt;=n;i++) cin&gt;&gt;a[i];\n    merge(a,1,n);\n    cout&lt;&lt;ans&lt;&lt;endl;\n    return 0;\n}\n//主程序没什么好讲的吧</code></pre>\n<p><del>对不起我不会插图片</del>，这个代码重在理解，写容易。希望对大家有帮助！</p>\n<p><em>纪念一下第一次写题解</em> </p>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6028afa5a75face',t:'MTc5NTYyOTUyMQ=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6028afa5a75face',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
