 "code_blocks": [
  "#include<iostream>\nusing namespace std;\n\nlong long t[500005],ans = 0;         //t用来临时存放排序，ans用来计数\n\nvoid merge(int a[],int l,int r){      //数组，左起点，右终点\n    if(l == r) return;      //左右重合，返回\n    int mid = (l+r)/2;      //分就是二分，找到中点\n    merge(a,l,mid);        //先分\n    merge(a,mid+1,r);\n    int i = l,j = mid + 1,k = l;  //三个指针\n    while(i<=mid&&j<=r){       //不能出界\n        if(a[i]>a[j]){           //如果前面的比后面的大，必定出现逆序对\n            t[k++] = a[j++];    //较小数先储存\n            ans += mid - i + 1;  //敲黑板：这里需要重点理解。\n                                               因为已经是两边从小到大排好了，所以一旦左边数比右边数大，那么右边数后面的数都能与左边数构成逆序对\n        }\n        else t[k++] = a[i++];  //如果是有序的，直接放进去\n    }\n\n    while(i<=mid) t[k++] = a[i++];\n    while(j<=r) t[k++] = a[j++];    //多余的全放进去\n    for(i = l;i<=r;i++) a[i] = t[i]; //再把临时存放的还原\n}\n\nint main(){\n    int n,a[500005];\n    cin>>n;\n    for(int i = 1;i<=n;i++) cin>>a[i];\n    merge(a,1,n);\n    cout<<ans<<endl;\n    return 0;\n}\n//主程序没什么好讲的吧"
 ],
