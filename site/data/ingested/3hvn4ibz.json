 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <meta name=\"csrf-token\" content=\"1795679564:JXwxROIz/jwy2f5/3ouGMLpNkaCBPyg978Afusz/1o4=\">\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112514'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>P1085题解 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"3hvn4ibz\",\"title\":\"P1085\\u9898\\u89e3\",\"category\":2,\"time\":1739239202,\"author\":{\"uid\":937252,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/937252.png\",\"name\":\"Gohldg\",\"slogan\":\"\\u6709\\u9650\\u8bd7\\u610f\\uff0c\\u65e0\\u9650\\u5915\\u9633\\u3002\\u89c2\\u5176\\u843d\\u65e5\\uff0c\\u9ec4\\u660f\\u4e43\\u81f3\\u3002|| \\u4f60\\u8c37\\u6700\\u84bb || \\u6211\\u8981\\u5237\\u9898! ||\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Green\",\"ccfLevel\":0,\"xcpcLevel\":0,\"background\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/image_hosting\\/dqcyqxl2.png\"},\"upvote\":0,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1085\",\"type\":\"P\",\"name\":\"[NOIP 2004 \\u666e\\u53ca\\u7ec4] \\u4e0d\\u9ad8\\u5174\\u7684\\u6d25\\u6d25\",\"difficulty\":1,\"fullScore\":100},\"promoteStatus\":0,\"collection\":null,\"content\":\"## $\\u9898\\u76ee:$\\n\\n# P1085 [NOIP 2004 \\u666e\\u53ca\\u7ec4] \\u4e0d\\u9ad8\\u5174\\u7684\\u6d25\\u6d25\\n\\n## \\u9898\\u76ee\\u63cf\\u8ff0\\n\\n\\u6d25\\u6d25\\u4e0a\\u521d\\u4e2d\\u4e86\\u3002\\u5988\\u5988\\u8ba4\\u4e3a\\u6d25\\u6d25\\u5e94\\u8be5\\u66f4\\u52a0\\u7528\\u529f\\u5b66\\u4e60\\uff0c\\u6240\\u4ee5\\u6d25\\u6d25\\u9664\\u4e86\\u4e0a\\u5b66\\u4e4b\\u5916\\uff0c\\u8fd8\\u8981\\u53c2\\u52a0\\u5988\\u5988\\u4e3a\\u5979\\u62a5\\u540d\\u7684\\u5404\\u79d1\\u590d\\u4e60\\u73ed\\u3002\\u53e6\\u5916\\u6bcf\\u5468\\u5988\\u5988\\u8fd8\\u4f1a\\u9001\\u5979\\u53bb\\u5b66\\u4e60\\u6717\\u8bf5\\u3001\\u821e\\u8e48\\u548c\\u94a2\\u7434\\u3002\\u4f46\\u662f\\u6d25\\u6d25\\u5982\\u679c\\u4e00\\u5929\\u4e0a\\u8bfe\\u8d85\\u8fc7\\u516b\\u4e2a\\u5c0f\\u65f6\\u5c31\\u4f1a\\u4e0d\\u9ad8\\u5174\\uff0c\\u800c\\u4e14\\u4e0a\\u5f97\\u8d8a\\u4e45\\u5c31\\u4f1a\\u8d8a\\u4e0d\\u9ad8\\u5174\\u3002\\u5047\\u8bbe\\u6d25\\u6d25\\u4e0d\\u4f1a\\u56e0\\u4e3a\\u5176\\u5b83\\u4e8b\\u4e0d\\u9ad8\\u5174\\uff0c\\u5e76\\u4e14\\u5979\\u7684\\u4e0d\\u9ad8\\u5174\\u4e0d\\u4f1a\\u6301\\u7eed\\u5230\\u7b2c\\u4e8c\\u5929\\u3002\\u8bf7\\u4f60\\u5e2e\\u5fd9\\u68c0\\u67e5\\u4e00\\u4e0b\\u6d25\\u6d25\\u4e0b\\u5468\\u7684\\u65e5\\u7a0b\\u5b89\\u6392\\uff0c\\u770b\\u770b\\u4e0b\\u5468\\u5979\\u4f1a\\u4e0d\\u4f1a\\u4e0d\\u9ad8\\u5174\\uff1b\\u5982\\u679c\\u4f1a\\u7684\\u8bdd\\uff0c\\u54ea\\u5929\\u6700\\u4e0d\\u9ad8\\u5174\\u3002\\n\\n## \\u8f93\\u5165\\u683c\\u5f0f\\n\\n\\u8f93\\u5165\\u5305\\u62ec $7$ \\u884c\\u6570\\u636e\\uff0c\\u5206\\u522b\\u8868\\u793a\\u5468\\u4e00\\u5230\\u5468\\u65e5\\u7684\\u65e5\\u7a0b\\u5b89\\u6392\\u3002\\u6bcf\\u884c\\u5305\\u62ec\\u4e24\\u4e2a\\u5c0f\\u4e8e $10$ \\u7684\\u975e\\u8d1f\\u6574\\u6570\\uff0c\\u7528\\u7a7a\\u683c\\u9694\\u5f00\\uff0c\\u5206\\u522b\\u8868\\u793a\\u6d25\\u6d25\\u5728\\u5b66\\u6821\\u4e0a\\u8bfe\\u7684\\u65f6\\u95f4\\u548c\\u5988\\u5988\\u5b89\\u6392\\u5979\\u4e0a\\u8bfe\\u7684\\u65f6\\u95f4\\u3002\\n\\n## \\u8f93\\u51fa\\u683c\\u5f0f\\n\\n\\u4e00\\u4e2a\\u6570\\u5b57\\u3002\\u5982\\u679c\\u4e0d\\u4f1a\\u4e0d\\u9ad8\\u5174\\u5219\\u8f93\\u51fa $0$\\uff0c\\u5982\\u679c\\u4f1a\\u5219\\u8f93\\u51fa\\u6700\\u4e0d\\u9ad8\\u5174\\u7684\\u662f\\u5468\\u51e0\\uff08\\u7528 $1, 2, 3, 4, 5, 6, 7$ \\u5206\\u522b\\u8868\\u793a\\u5468\\u4e00\\uff0c\\u5468\\u4e8c\\uff0c\\u5468\\u4e09\\uff0c\\u5468\\u56db\\uff0c\\u5468\\u4e94\\uff0c\\u5468\\u516d\\uff0c\\u5468\\u65e5\\uff09\\u3002\\u5982\\u679c\\u6709\\u4e24\\u5929\\u6216\\u4e24\\u5929\\u4ee5\\u4e0a\\u4e0d\\u9ad8\\u5174\\u7684\\u7a0b\\u5ea6\\u76f8\\u5f53\\uff0c\\u5219\\u8f93\\u51fa\\u65f6\\u95f4\\u6700\\u9760\\u524d\\u7684\\u4e00\\u5929\\u3002\\n\\n## \\u8f93\\u5165\\u8f93\\u51fa\\u6837\\u4f8b #1\\n\\n### \\u8f93\\u5165 #1\\n\\n```\\n5 3\\n6 2\\n7 2\\n5 3\\n5 4\\n0 4\\n0 6\\n```\\n\\n### \\u8f93\\u51fa #1\\n\\n```\\n3\\n```\\n\\n## \\u8bf4\\u660e\\/\\u63d0\\u793a\\n\\nNOIP2004 \\u666e\\u53ca\\u7ec4\\u7b2c 1 \\u9898\\n\\n- 2021-10-27\\uff1a\\u589e\\u52a0\\u4e00\\u7ec4 hack \\u6570\\u636e\\n- 2022-06-05\\uff1a\\u53c8\\u589e\\u52a0\\u4e00\\u7ec4 hack \\u6570\\u636e\\n\\n### [$\\u9898\\u76ee\\u4f20\\u9001\\u95e8$](https:\\/\\/www.luogu.com.cn\\/problem\\/P1085)\\n\\n## $\\u8981\\u6c42:$\\n- \\u8ba1\\u7b97\\u6d25\\u6d25\\u6bcf\\u5929\\u4e0a\\u8bfe\\u7684\\u65f6\\u95f4,\\u6c42\\u4e0a\\u8bfe\\u65f6\\u95f4\\u6700\\u591a\\u4e14\\u5927\\u4e8e$8h$\\u7684\\u4e00\\u5929\\n- \\u4f18\\u5148\\u9009\\u62e9\\u65f6\\u95f4\\u9760\\u524d\\u7684\\u4e00\\u5929\\u8f93\\u51fa,\\u82e5\\u6ca1\\u6709\\u5927\\u4e8e$8h$\\u7684\\u8f93\\u51fa$0$\\n## $\\u505a\\u6cd5:$\\n- \\u76f4\\u63a5\\u628a\\u4e0a\\u8bfe\\u65f6\\u95f4\\u548c\\u5b89\\u6392\\u7684\\u4e0a\\u8bfe\\u65f6\\u95f4\\u52a0\\u8d77\\u6765$-8$,\\u4f5c\\u4e3a\\u4e0d\\u5f00\\u5fc3\\u6307\\u6570\\n- \\u5faa\\u73af$7$\\u6b21\\u6328\\u4e2a\\u6bd4\\u8f83\\u6307\\u6570\\u5927\\u5c0f,\\u6ee1\\u8db3\\u6761\\u4ef6\\u505a\\u4e00\\u6b21\\u66f4\\u66ff\\n## $\\u4ee3\\u7801:$\\n```cpp\\n#include \\u003Ciostream\\u003E\\nusing namespace std;\\nint main(){\\n    int MAX=-30,day=0;\\/\\/day\\u8d4b\\u503c0\\u5982\\u679c\\u6ca1\\u6709\\u76f4\\u63a5\\u8f93\\u51fa0\\n\\/\\/MAX\\u503c\\u8981\\u8d4b\\u5c0f\\u7528\\u6765\\u6bd4\\u8f83\\n    for(int i=1;i\\u003C=7;i++){\\n        int a,b;\\n        cin\\u003E\\u003Ea\\u003E\\u003Eb;\\n        if(a+b-8\\u003EMAX\\u0026\\u0026a+b-8\\u003E0){\\n\\/\\/\\u8fd9\\u91cc\\u76f4\\u63a5\\u653e\\u5230if\\u91cc\\u8ba1\\u7b97\\n\\/\\/\\u6ce8\\u610f\\u662f\\u003E\\u4e0d\\u662f\\u003E=\\n            MAX=a+b-8;\\/\\/\\u66f4\\u66ff\\u6700\\u5927\\u4e0d\\u5f00\\u5fc3\\u503c\\n            day=i;\\/\\/\\u66f4\\u66ff\\u65e5\\u671f\\n        }\\n    }\\n    cout \\u003C\\u003Cday;\\n    return 0;\\n}\\n```\\n## $\\u611f\\u8c22$[$MoonCake2011$](https:\\/\\/www.luogu.com.cn\\/user\\/886055)$\\u5e2e\\u52a9\\u8c03\\u8bd5$\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795593164.902669}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/3hvn4ibz\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"P1085\\u9898\\u89e3\",\"description\":\"\\u9898\\u76ee:\\nP1085 [NOIP 2004 \\u666e\\u53ca\\u7ec4] \\u4e0d\\u9ad8\\u5174\\u7684\\u6d25\\u6d25\\n\\u9898\\u76ee\\u63cf\\u8ff0\\n\\u6d25\\u6d25\\u4e0a\\u521d\\u4e2d\\u4e86\\u3002\\u5988\\u5988\\u8ba4\\u4e3a\\u6d25\\u6d25\\u5e94\\u8be5\\u66f4\\u52a0\\u7528\\u529f\\u5b66\\u4e60\\uff0c\\u6240\\u4ee5\\u6d25\\u6d25\\u9664\\u4e86\\u4e0a\\u5b66\\u4e4b\\u5916\\uff0c\\u8fd8\\u8981\\u53c2\\u52a0\\u5988\\u5988\\u4e3a\\u5979\\u62a5\\u540d\\u7684\\u5404\\u79d1\\u590d\\u4e60\\u73ed\\u3002\\u53e6\\u5916\\u6bcf\\u5468\\u5988\\u5988\\u8fd8\\u4f1a\\u9001\\u5979\\u53bb\\u5b66\\u4e60\\u6717\\u8bf5\\u3001\\u821e\\u8e48\\u548c\\u94a2\\u7434\\u3002\\u4f46\\u662f\\u6d25\\u6d25\\u5982\\u679c\\u4e00\\u5929\\u4e0a\\u8bfe\\u8d85\\u8fc7\\u516b\\u4e2a\\u5c0f\\u65f6\\u5c31\\u4f1a\\u4e0d\\u9ad8\\u5174\\uff0c\\u800c\\u4e14\\u4e0a\\u5f97\\u8d8a\\u4e45\\u5c31\\u4f1a\\u8d8a\\u4e0d\\u9ad8\\u5174\\u3002\\u5047\\u8bbe\\u6d25\\u6d25\\u4e0d\\u4f1a\\u56e0\\u4e3a\\u5176\\u5b83\\u4e8b\\u4e0d\\u9ad8\\u5174\\uff0c\\u5e76\\u4e14\\u5979\\u7684\\u4e0d\\u9ad8\\u5174\\u4e0d\\u4f1a\\u6301\\u7eed\\u5230\\u7b2c\\u4e8c\\u5929\\u3002\\u8bf7\\u4f60\\u5e2e\\u5fd9\\u68c0\\u67e5\\u4e00\\u4e0b\\u6d25\\u6d25\\u4e0b\\u5468\\u7684\\u65e5\\u7a0b\\u5b89\\u6392\\uff0c\\u770b\\u770b\\u4e0b\\u5468\\u5979\\u4f1a\\u4e0d\\u4f1a\\u4e0d\\u9ad8\\u5174\\uff1b\\u5982\\u679c\\u4f1a\\u7684\\u8bdd\\uff0c\\u54ea\\u5929\\u6700\\u4e0d\\u9ad8\\u5174\\u3002\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"Gohldg\"},\"datePublished\":\"2025-02-11T10:00:02+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"P1085题解\" />\n    <meta property=\"og:description\" content=\"题目:\nP1085 [NOIP 2004 普及组] 不高兴的津津\n题目描述\n津津上初中了。妈妈认为津津应该更加用功学习，所以津津除了上学之外，还要参加妈妈为她报名的各科复习班。另外每周妈妈还会送她去学习朗诵、舞蹈和钢琴。但是津津如果一天上课超过八个小时就会不高兴，而且上得越久就会越不高兴。假设津津不会因为其它事不高兴，并且她的不高兴不会持续到第二天。请你帮忙检查一下津津下周的日程安排，看看下周她会不会不高兴；如果会的话，哪天最不高兴。…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"Gohldg\" />\n    <meta property=\"article:published_time\" content=\"2025-02-11T10:00:02+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/3hvn4ibz\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>P1085题解</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">Gohldg</a>\n            ·\n            <time datetime=\"2025-02-11T10:00:02+08:00\">2025-02-11 10:00:02</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <h2><la-tex display=\"inline\">题目:</la-tex></h2>\n<h1>P1085 [NOIP 2004 普及组] 不高兴的津津</h1>\n<h2>题目描述</h2>\n<p>津津上初中了。妈妈认为津津应该更加用功学习，所以津津除了上学之外，还要参加妈妈为她报名的各科复习班。另外每周妈妈还会送她去学习朗诵、舞蹈和钢琴。但是津津如果一天上课超过八个小时就会不高兴，而且上得越久就会越不高兴。假设津津不会因为其它事不高兴，并且她的不高兴不会持续到第二天。请你帮忙检查一下津津下周的日程安排，看看下周她会不会不高兴；如果会的话，哪天最不高兴。</p>\n<h2>输入格式</h2>\n<p>输入包括 <la-tex display=\"inline\">7</la-tex> 行数据，分别表示周一到周日的日程安排。每行包括两个小于 <la-tex display=\"inline\">10</la-tex> 的非负整数，用空格隔开，分别表示津津在学校上课的时间和妈妈安排她上课的时间。</p>\n<h2>输出格式</h2>\n<p>一个数字。如果不会不高兴则输出 <la-tex display=\"inline\">0</la-tex>，如果会则输出最不高兴的是周几（用 <la-tex display=\"inline\">1, 2, 3, 4, 5, 6, 7</la-tex> 分别表示周一，周二，周三，周四，周五，周六，周日）。如果有两天或两天以上不高兴的程度相当，则输出时间最靠前的一天。</p>\n<h2>输入输出样例 #1</h2>\n<h3>输入 #1</h3>\n<pre><code>5 3\n6 2\n7 2\n5 3\n5 4\n0 4\n0 6</code></pre>\n<h3>输出 #1</h3>\n<pre><code>3</code></pre>\n<h2>说明/提示</h2>\n<p>NOIP2004 普及组第 1 题</p>\n<ul>\n<li>2021-10-27：增加一组 hack 数据</li>\n<li>2022-06-05：又增加一组 hack 数据</li>\n</ul>\n<h3><la-tex display=\"inline\">题目传送门</la-tex></h3>\n<h2><la-tex display=\"inline\">要求:</la-tex></h2>\n<ul>\n<li>计算津津每天上课的时间,求上课时间最多且大于<la-tex display=\"inline\">8h</la-tex>的一天</li>\n<li>优先选择时间靠前的一天输出,若没有大于<la-tex display=\"inline\">8h</la-tex>的输出<la-tex display=\"inline\">0</la-tex><h2><la-tex display=\"inline\">做法:</la-tex></h2>\n</li>\n<li>直接把上课时间和安排的上课时间加起来<la-tex display=\"inline\">-8</la-tex>,作为不开心指数</li>\n<li>循环<la-tex display=\"inline\">7</la-tex>次挨个比较指数大小,满足条件做一次更替<h2><la-tex display=\"inline\">代码:</la-tex></h2>\n<pre><code class=\"language-cpp\">#include &lt;iostream&gt;\nusing namespace std;\nint main(){\n  int MAX=-30,day=0;//day赋值0如果没有直接输出0\n//MAX值要赋小用来比较\n  for(int i=1;i&lt;=7;i++){\n      int a,b;\n      cin&gt;&gt;a&gt;&gt;b;\n      if(a+b-8&gt;MAX&amp;&amp;a+b-8&gt;0){\n//这里直接放到if里计算\n//注意是&gt;不是&gt;=\n          MAX=a+b-8;//更替最大不开心值\n          day=i;//更替日期\n      }\n  }\n  cout &lt;&lt;day;\n  return 0;\n}</code></pre>\n<h2><la-tex display=\"inline\">感谢</la-tex><la-tex display=\"inline\">MoonCake2011</la-tex><la-tex display=\"inline\">帮助调试</la-tex></h2>\n</li>\n</ul>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a5ff135fcd72f7ff',t:'MTc5NTU5MzE2NA=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a5ff135fcd72f7ff',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
