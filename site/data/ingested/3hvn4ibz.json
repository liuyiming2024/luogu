 "code_blocks": [
  "#include <iostream>\nusing namespace std;\nint main(){\n  int MAX=-30,day=0;//day赋值0如果没有直接输出0\n//MAX值要赋小用来比较\n  for(int i=1;i<=7;i++){\n      int a,b;\n      cin>>a>>b;\n      if(a+b-8>MAX&&a+b-8>0){\n//这里直接放到if里计算\n//注意是>不是>=\n          MAX=a+b-8;//更替最大不开心值\n          day=i;//更替日期\n      }\n  }\n  cout <<day;\n  return 0;\n}"
