 "is_article": "是",
 "code_blocks": [
  "#include<iostream>\n#include<cstdio>\nusing namespace std;\nint n,m,b[30000+5],i,j,v,p;\nint main(){\n    scanf(\"%d %d\",&n,&m);\n    for(i=1;i<=m;i++){\n        scanf(\"%d %d\",&v,&p);\n        for(j=n;j>=v;j--)//j表示耗钱量，b[j]表示在j耗钱量下，当前最大的获益是多少，注意这是从上往下的，若从下往上的话，下部分数据更改会影响上部分数据的\n            if(b[j-v]+v*p>b[j])b[j]=b[j-v]+v*p;//从这里可以看出，数据的更改依赖此数据v个单位下的数据\n    }\n    printf(\"%d\",b[n]); //直接输出在最大耗钱量n下，的最大获益就行了\n}",
  "#include<iostream>\n#include<cstdio>\nusing namespace std;\nint n,m,b[25+1][30000+5]={0},i,j,v[25+1],p[25+1];\nint main(){\n    scanf(\"%d %d\",&n,&m);\n    for(i=1;i<=m;i++){\n        scanf(\"%d %d\",&v[i],&p[i]);//实际上这里不用数组存也没问题，和一维一样不断用新的替换旧的也行\n        for(j=n;j>=1;j--){//不得不说，数据真的有点水，我这里贪图省事，一维改二维的时候，没把j>=v[i]改成j>=1，结果有一个数据点没过，讲道理，这里应该算致命错误的\n            b[i][j]=b[i-1][j];//二维不同于一维，二维需要把上一方法的数组复制下来，从这里可以看出，这就是上面为什么j>=1不能改为j>=v[i]的原因，也是二维时间复杂度高于一维的原因\n            if(j>=v[i]&&b[i-1][j-v[i]]+v[i]*p[i]>b[i][j])b[i][j]=b[i-1][j-v[i]]+v[i]*p[i];\n        }    \n    }\n    printf(\"%d\",b[m][n]); \n} \n\n感觉话语很不专业，解释可能有点啰嗦还不够清晰，见谅"
 ],
 "sha256": "87495643f99aaee8",
 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <meta name=\"csrf-token\" content=\"1795679554:KUFCxO6uxs0uRoEXRB4elZ1C+cvjRlFfmeNy/sL+DiE=\">\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112514'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>题解 P1060 【开心的金明】 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"0hps6y5z\",\"title\":\"\\u9898\\u89e3 P1060 \\u3010\\u5f00\\u5fc3\\u7684\\u91d1\\u660e\\u3011\",\"category\":2,\"time\":1500711552,\"author\":{\"uid\":50063,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/50063.png\",\"name\":\"Famous_Talent\",\"slogan\":\"\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Blue\",\"ccfLevel\":0,\"xcpcLevel\":0,\"background\":\"\"},\"upvote\":0,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1060\",\"type\":\"P\",\"name\":\"[NOIP 2006 \\u666e\\u53ca\\u7ec4] \\u5f00\\u5fc3\\u7684\\u91d1\\u660e\",\"difficulty\":2,\"fullScore\":100},\"promoteStatus\":0,\"collection\":null,\"content\":\"\\u57fa\\u672c\\u80cc\\u5305\\u578bDP\\u9898\\u89e3\\n\\n\\u4e00\\u7ef4\\u7684\\n\\n```cpp\\n#include\\u003Ciostream\\u003E\\n#include\\u003Ccstdio\\u003E\\nusing namespace std;\\nint n,m,b[30000+5],i,j,v,p;\\nint main(){\\n    scanf(\\u0022%d %d\\u0022,\\u0026n,\\u0026m);\\n    for(i=1;i\\u003C=m;i++){\\n        scanf(\\u0022%d %d\\u0022,\\u0026v,\\u0026p);\\n        for(j=n;j\\u003E=v;j--)\\/\\/j\\u8868\\u793a\\u8017\\u94b1\\u91cf\\uff0cb[j]\\u8868\\u793a\\u5728j\\u8017\\u94b1\\u91cf\\u4e0b\\uff0c\\u5f53\\u524d\\u6700\\u5927\\u7684\\u83b7\\u76ca\\u662f\\u591a\\u5c11\\uff0c\\u6ce8\\u610f\\u8fd9\\u662f\\u4ece\\u4e0a\\u5f80\\u4e0b\\u7684\\uff0c\\u82e5\\u4ece\\u4e0b\\u5f80\\u4e0a\\u7684\\u8bdd\\uff0c\\u4e0b\\u90e8\\u5206\\u6570\\u636e\\u66f4\\u6539\\u4f1a\\u5f71\\u54cd\\u4e0a\\u90e8\\u5206\\u6570\\u636e\\u7684\\n            if(b[j-v]+v*p\\u003Eb[j])b[j]=b[j-v]+v*p;\\/\\/\\u4ece\\u8fd9\\u91cc\\u53ef\\u4ee5\\u770b\\u51fa\\uff0c\\u6570\\u636e\\u7684\\u66f4\\u6539\\u4f9d\\u8d56\\u6b64\\u6570\\u636ev\\u4e2a\\u5355\\u4f4d\\u4e0b\\u7684\\u6570\\u636e\\n    }\\n    printf(\\u0022%d\\u0022,b[n]); \\/\\/\\u76f4\\u63a5\\u8f93\\u51fa\\u5728\\u6700\\u5927\\u8017\\u94b1\\u91cfn\\u4e0b\\uff0c\\u7684\\u6700\\u5927\\u83b7\\u76ca\\u5c31\\u884c\\u4e86\\n} \\n```\\n\\u4e8c\\u7ef4\\u7684\\u65f6\\u95f4\\u590d\\u6742\\u5ea6\\u8981\\u6bd4\\u4e00\\u7ef4\\u9ad8\\uff08\\u0398(\\u4e00\\u7ef4)\\u003C\\u0398(\\u4e8c\\u7ef4)=n\\\\*m\\uff09\\uff0c\\u6211\\u4e00\\u7ef4\\u901a\\u8fc7\\u65f6\\u95f44ms\\uff0c\\u4e8c\\u7ef444ms\\uff0c\\u4f46\\u4e8c\\u7ef4\\u7ec3\\u4e00\\u7ec3\\u603b\\u662f\\u6ca1\\u9519\\u7684\\uff0c\\u4e07\\u4e00\\u54ea\\u9053\\u9898\\u53ea\\u80fd\\u7528\\u4e8c\\u7ef4\\u4e0d\\u80fd\\u7528\\u4e00\\u7ef4\\u5462\\uff1f\\n```cpp\\n#include\\u003Ciostream\\u003E\\n#include\\u003Ccstdio\\u003E\\nusing namespace std;\\nint n,m,b[25+1][30000+5]={0},i,j,v[25+1],p[25+1];\\nint main(){\\n    scanf(\\u0022%d %d\\u0022,\\u0026n,\\u0026m);\\n    for(i=1;i\\u003C=m;i++){\\n        scanf(\\u0022%d %d\\u0022,\\u0026v[i],\\u0026p[i]);\\/\\/\\u5b9e\\u9645\\u4e0a\\u8fd9\\u91cc\\u4e0d\\u7528\\u6570\\u7ec4\\u5b58\\u4e5f\\u6ca1\\u95ee\\u9898\\uff0c\\u548c\\u4e00\\u7ef4\\u4e00\\u6837\\u4e0d\\u65ad\\u7528\\u65b0\\u7684\\u66ff\\u6362\\u65e7\\u7684\\u4e5f\\u884c\\n        for(j=n;j\\u003E=1;j--){\\/\\/\\u4e0d\\u5f97\\u4e0d\\u8bf4\\uff0c\\u6570\\u636e\\u771f\\u7684\\u6709\\u70b9\\u6c34\\uff0c\\u6211\\u8fd9\\u91cc\\u8d2a\\u56fe\\u7701\\u4e8b\\uff0c\\u4e00\\u7ef4\\u6539\\u4e8c\\u7ef4\\u7684\\u65f6\\u5019\\uff0c\\u6ca1\\u628aj\\u003E=v[i]\\u6539\\u6210j\\u003E=1\\uff0c\\u7ed3\\u679c\\u6709\\u4e00\\u4e2a\\u6570\\u636e\\u70b9\\u6ca1\\u8fc7\\uff0c\\u8bb2\\u9053\\u7406\\uff0c\\u8fd9\\u91cc\\u5e94\\u8be5\\u7b97\\u81f4\\u547d\\u9519\\u8bef\\u7684\\n            b[i][j]=b[i-1][j];\\/\\/\\u4e8c\\u7ef4\\u4e0d\\u540c\\u4e8e\\u4e00\\u7ef4\\uff0c\\u4e8c\\u7ef4\\u9700\\u8981\\u628a\\u4e0a\\u4e00\\u65b9\\u6cd5\\u7684\\u6570\\u7ec4\\u590d\\u5236\\u4e0b\\u6765\\uff0c\\u4ece\\u8fd9\\u91cc\\u53ef\\u4ee5\\u770b\\u51fa\\uff0c\\u8fd9\\u5c31\\u662f\\u4e0a\\u9762\\u4e3a\\u4ec0\\u4e48j\\u003E=1\\u4e0d\\u80fd\\u6539\\u4e3aj\\u003E=v[i]\\u7684\\u539f\\u56e0\\uff0c\\u4e5f\\u662f\\u4e8c\\u7ef4\\u65f6\\u95f4\\u590d\\u6742\\u5ea6\\u9ad8\\u4e8e\\u4e00\\u7ef4\\u7684\\u539f\\u56e0\\n            if(j\\u003E=v[i]\\u0026\\u0026b[i-1][j-v[i]]+v[i]*p[i]\\u003Eb[i][j])b[i][j]=b[i-1][j-v[i]]+v[i]*p[i];\\n        }    \\n    }\\n    printf(\\u0022%d\\u0022,b[m][n]); \\n} \\n\\n\\u611f\\u89c9\\u8bdd\\u8bed\\u5f88\\u4e0d\\u4e13\\u4e1a\\uff0c\\u89e3\\u91ca\\u53ef\\u80fd\\u6709\\u70b9\\u5570\\u55e6\\u8fd8\\u4e0d\\u591f\\u6e05\\u6670\\uff0c\\u89c1\\u8c05\\n```\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795593154.153641}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/0hps6y5z\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1060 \\u3010\\u5f00\\u5fc3\\u7684\\u91d1\\u660e\\u3011\",\"description\":\"\\u57fa\\u672c\\u80cc\\u5305\\u578bDP\\u9898\\u89e3\\n\\u4e00\\u7ef4\\u7684\\n#include&lt;iostream&gt;\\n#include&lt;cstdio&gt;\\nusing namespace std;\\nint n,m,b[30000+5],i,j,v,p;\\nint main(){\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"Famous_Talent\"},\"datePublished\":\"2017-07-22T16:19:12+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1060 【开心的金明】\" />\n    <meta property=\"og:description\" content=\"基本背包型DP题解\n一维的\n#include&amp;lt;iostream&amp;gt;\n#include&amp;lt;cstdio&amp;gt;\nusing namespace std;\nint n,m,b[30000+5],i,j,v,p;\nint main(){…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"Famous_Talent\" />\n    <meta property=\"article:published_time\" content=\"2017-07-22T16:19:12+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/0hps6y5z\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1060 【开心的金明】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">Famous_Talent</a>\n            ·\n            <time datetime=\"2017-07-22T16:19:12+08:00\">2017-07-22 16:19:12</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>基本背包型DP题解</p>\n<p>一维的</p>\n<pre><code class=\"language-cpp\">#include&lt;iostream&gt;\n#include&lt;cstdio&gt;\nusing namespace std;\nint n,m,b[30000+5],i,j,v,p;\nint main(){\n    scanf(\"%d %d\",&amp;n,&amp;m);\n    for(i=1;i&lt;=m;i++){\n        scanf(\"%d %d\",&amp;v,&amp;p);\n        for(j=n;j&gt;=v;j--)//j表示耗钱量，b[j]表示在j耗钱量下，当前最大的获益是多少，注意这是从上往下的，若从下往上的话，下部分数据更改会影响上部分数据的\n            if(b[j-v]+v*p&gt;b[j])b[j]=b[j-v]+v*p;//从这里可以看出，数据的更改依赖此数据v个单位下的数据\n    }\n    printf(\"%d\",b[n]); //直接输出在最大耗钱量n下，的最大获益就行了\n} </code></pre>\n<p>二维的时间复杂度要比一维高（Θ(一维)&lt;Θ(二维)=n*m），我一维通过时间4ms，二维44ms，但二维练一练总是没错的，万一哪道题只能用二维不能用一维呢？</p>\n<pre><code class=\"language-cpp\">#include&lt;iostream&gt;\n#include&lt;cstdio&gt;\nusing namespace std;\nint n,m,b[25+1][30000+5]={0},i,j,v[25+1],p[25+1];\nint main(){\n    scanf(\"%d %d\",&amp;n,&amp;m);\n    for(i=1;i&lt;=m;i++){\n        scanf(\"%d %d\",&amp;v[i],&amp;p[i]);//实际上这里不用数组存也没问题，和一维一样不断用新的替换旧的也行\n        for(j=n;j&gt;=1;j--){//不得不说，数据真的有点水，我这里贪图省事，一维改二维的时候，没把j&gt;=v[i]改成j&gt;=1，结果有一个数据点没过，讲道理，这里应该算致命错误的\n            b[i][j]=b[i-1][j];//二维不同于一维，二维需要把上一方法的数组复制下来，从这里可以看出，这就是上面为什么j&gt;=1不能改为j&gt;=v[i]的原因，也是二维时间复杂度高于一维的原因\n            if(j&gt;=v[i]&amp;&amp;b[i-1][j-v[i]]+v[i]*p[i]&gt;b[i][j])b[i][j]=b[i-1][j-v[i]]+v[i]*p[i];\n        }    \n    }\n    printf(\"%d\",b[m][n]); \n} \n\n感觉话语很不专业，解释可能有点啰嗦还不够清晰，见谅</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a5ff131c89179013',t:'MTc5NTU5MzE1NA=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a5ff131c89179013',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
 "fetched_at": "2026-11-25 07:52:34"
