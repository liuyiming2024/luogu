/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/47093.png\",\"name\":\"RainShalder\",\"slogan\":\"\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Gray\",\"ccfLevel\":4,\"xcpcLevel\":0,\"background\":\"\"},\"upvote\":17,\"replyCount\":15,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1423\",\"type\":\"P\",\"name\":\"\\u5c0f\\u7389\\u5728\\u6e38\\u6cf3\",\"difficulty\":1,\"fullScore\":100},\"promoteStatus\":2,\"collection\":null,\"content\":\"-\\u521a\\u62ff\\u5230\\u8fd9\\u9053\\u9898\\uff0c\\u6700\\u5148\\u60f3\\u5230\\u7684\\u662f\\u4e8c\\u5206\\uff0c\\u7136\\u540e\\u5f88\\u987a\\u5229\\u7684\\u7528\\u4e8c\\u5206\\u8fc7\\u4e86\\n\\n-\\u770b\\u5230\\u9898\\u89e3\\u91cc\\u9762\\u6ca1\\u6709\\u7528\\u4e8c\\u5206\\u505a\\u7684\\uff0c\\u90a3\\u6211\\u6765\\u4e00\\u53d1\\u4e8c\\u5206\\u9898\\u89e3\\n\\n-\\u5927\\u4f53\\u601d\\u8def\\uff1a\\u4e8c\\u5206\\u6e38\\u6cf3\\u6b65\\u6570\\uff0c\\u6bcf\\u4e8c\\u5206\\u4e00\\u4e2a\\u7b54\\u6848\\u5c31\\u6a21\\u62df\\u4e00\\u6b21\\u3002\\n\\n-\\u53ef\\u4ee5\\u901a\\u8fc7\\u4e00\\u6b21\\u526a\\u679d\\u6765\\u8fdb\\u884c\\u7b80\\u5316\\uff1a\\u5f53\\u6a21\\u62df\\u51fa\\u7684\\u8ddd\\u79bb\\u5927\\u4e8e\\u76ee\\u6807\\u8ddd\\u79bb\\u5c31\\u76f4\\u63a5break;\\n\\n-AC\\u4ee3\\u7801\\u5982\\u4e0b\\uff1a\\n\\n```cpp\\n#include\\u003Ciostream\\u003E\\n#include\\u003Climits.h\\u003E       \\/\\/\\u4e3a\\u4e86\\u4f7f\\u7528INT_MAX\\nusing namespace std;\\nint L,R=INT_MAX,mid;    \\/\\/\\u5de6\\u7aef\\u70b9\\u4e3a0\\uff0c\\u53f3\\u7aef\\u70b9\\u4e3aINT\\u7684\\u6700\\u5927\\u503c\\ndouble target,dist,per=2;   \\/\\/\\u4e09\\u4e2a\\u53d8\\u91cf\\u5206\\u522b\\u662f\\u76ee\\u6807\\u3001\\u6bcf\\u6b21\\u6a21\\u62df\\u7684\\u603b\\u8ddd\\u79bb\\u548c\\u6bcf\\u6b65\\u7684\\u957f\\u5ea6\\u3002\\nint main()\\n{\\n    cin\\u003E\\u003Etarget;\\n    while(R\\u003E=L)   \\/\\/\\u4ee5\\u4e0b\\u5c31\\u662f\\u4e00\\u4e9b\\u6a21\\u677f\\u5316\\u7684\\u5185\\u5bb9\\u4e86\\n    {\\n        mid=(L+R)\\/2;     \\/\\/\\u53d6\\u4e2d\\u95f4\\u503c\\n        for(int i=1;i\\u003C=mid;i++)    \\/\\/\\u5f00\\u59cb\\u4e00\\u6b65\\u6b65\\u5730\\u6a21\\u62df\\n        {\\n            dist+=per;\\n            per*=0.98;\\n            if(dist\\u003Etarget)     \\/\\/\\u526a\\u679d\\u3002\\u5982\\u679c\\u6a21\\u62df\\u51fa\\u7684\\u8ddd\\u79bb\\u5927\\u4e8e\\u76ee\\u6807\\uff0c\\u76f4\\u63a5break;\\n                break;\\n        }\\n        if(dist\\u003Etarget)\\n            R=mid-1;\\n        else\\n            L=mid+1;       \\/\\/\\u4e4b\\u6240\\u4ee5-1\\/+1\\u662f\\u4e3a\\u4e86\\u907f\\u514d\\u51fa\\u73b0\\u7cbe\\u5ea6\\u9519\\u8bef\\n        dist=0;\\n        per=2;           \\/\\/\\u8fd8\\u539f\\u521d\\u59cb\\u503c\\u3002\\u8fd9\\u4e00\\u6b65\\u4e00\\u5b9a\\u522b\\u5fd8\\u4e86\\n    }\\n    cout\\u003C\\u003CL;\\n} \\n```\\n-\\u4e8c\\u5206\\u5b9e\\u65bd\\u4e0b\\u6765\\u8fd8\\u662f\\u5f88\\u7b80\\u5355\\u7684\\uff0c\\u8bb0\\u4f4f\\u90a3\\u51e0\\u4e2a\\u5bb9\\u6613\\u51fa\\u9519\\u7684\\u70b9\\u5c31\\u597d\\u4e86\\u3002\\u5b9e\\u6d4b0ms\\uff0c\\u5c0f\\u6570\\u636e\\u53ef\\u80fd\\u6bd4\\u679a\\u4e3e\\u6162\\uff0c\\u5927\\u6570\\u636e\\u5c31\\u8981\\u5feb\\u5f97\\u591a\\u3002\\n\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795629596.11781}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/4fj37pww\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1423 \\u3010\\u5c0f\\u7389\\u5728\\u6e38\\u6cf3\\u3011\",\"description\":\"-\\u521a\\u62ff\\u5230\\u8fd9\\u9053\\u9898\\uff0c\\u6700\\u5148\\u60f3\\u5230\\u7684\\u662f\\u4e8c\\u5206\\uff0c\\u7136\\u540e\\u5f88\\u987a\\u5229\\u7684\\u7528\\u4e8c\\u5206\\u8fc7\\u4e86\\n-\\u770b\\u5230\\u9898\\u89e3\\u91cc\\u9762\\u6ca1\\u6709\\u7528\\u4e8c\\u5206\\u505a\\u7684\\uff0c\\u90a3\\u6211\\u6765\\u4e00\\u53d1\\u4e8c\\u5206\\u9898\\u89e3\\n-\\u5927\\u4f53\\u601d\\u8def\\uff1a\\u4e8c\\u5206\\u6e38\\u6cf3\\u6b65\\u6570\\uff0c\\u6bcf\\u4e8c\\u5206\\u4e00\\u4e2a\\u7b54\\u6848\\u5c31\\u6a21\\u62df\\u4e00\\u6b21\\u3002\\n-\\u53ef\\u4ee5\\u901a\\u8fc7\\u4e00\\u6b21\\u526a\\u679d\\u6765\\u8fdb\\u884c\\u7b80\\u5316\\uff1a\\u5f53\\u6a21\\u62df\\u51fa\\u7684\\u8ddd\\u79bb\\u5927\\u4e8e\\u76ee\\u6807\\u8ddd\\u79bb\\u5c31\\u76f4\\u63a5break;\\n-AC\\u4ee3\\u7801\\u5982\\u4e0b\\uff1a\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"RainShalder\"},\"datePublished\":\"2017-08-23T16:26:03+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1423 【小玉在游泳】\" />\n    <meta property=\"og:description\" content=\"-刚拿到这道题，最先想到的是二分，然后很顺利的用二分过了\n-看到题解里面没有用二分做的，那我来一发二分题解\n-大体思路：二分游泳步数，每二分一个答案就模拟一次。\n-可以通过一次剪枝来进行简化：当模拟出的距离大于目标距离就直接break;\n-AC代码如下：…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"RainShalder\" />\n    <meta property=\"article:published_time\" content=\"2017-08-23T16:26:03+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/4fj37pww\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1423 【小玉在游泳】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">RainShalder</a>\n            ·\n            <time datetime=\"2017-08-23T16:26:03+08:00\">2017-08-23 16:26:03</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>-刚拿到这道题，最先想到的是二分，然后很顺利的用二分过了</p>\n<p>-看到题解里面没有用二分做的，那我来一发二分题解</p>\n<p>-大体思路：二分游泳步数，每二分一个答案就模拟一次。</p>\n<p>-可以通过一次剪枝来进行简化：当模拟出的距离大于目标距离就直接break;</p>\n<p>-AC代码如下：</p>\n<pre><code class=\"language-cpp\">#include&lt;iostream&gt;\n#include&lt;limits.h&gt;       //为了使用INT_MAX\nusing namespace std;\nint L,R=INT_MAX,mid;    //左端点为0，右端点为INT的最大值\ndouble target,dist,per=2;   //三个变量分别是目标、每次模拟的总距离和每步的长度。\nint main()\n{\n    cin&gt;&gt;target;\n    while(R&gt;=L)   //以下就是一些模板化的内容了\n    {\n        mid=(L+R)/2;     //取中间值\n        for(int i=1;i&lt;=mid;i++)    //开始一步步地模拟\n        {\n            dist+=per;\n            per*=0.98;\n            if(dist&gt;target)     //剪枝。如果模拟出的距离大于目标，直接break;\n                break;\n        }\n        if(dist&gt;target)\n            R=mid-1;\n        else\n            L=mid+1;       //之所以-1/+1是为了避免出现精度错误\n        dist=0;\n        per=2;           //还原初始值。这一步一定别忘了\n    }\n    cout&lt;&lt;L;\n} </code></pre>\n<p>-二分实施下来还是很简单的，记住那几个容易出错的点就好了。实测0ms，小数据可能比枚举慢，大数据就要快得多。</p>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6028ccc4c0df963',t:'MTc5NTYyOTU5NQ=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6028ccc4c0df963',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
