nNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795659290.13165}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/g8gclrnk\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3\\uff1aP5015 [NOIP2018 \\u666e\\u53ca\\u7ec4] \\u6807\\u9898\\u7edf\\u8ba1\",\"description\":\"\\u8fd9\\u9053\\u9898\\u9898\\u76ee\\u672c\\u610f\\u5c31\\u662f\\uff1a\\u7ed9\\u7a0b\\u5e8f\\u4e00\\u4e2a\\u5b57\\u7b26\\u4e32\\uff0c\\u95ee\\u8fd9\\u4e2a\\u5b57\\u7b26\\u4e32\\u91cc\\u9762\\u6709\\u591a\\u5c11\\u4e2a\\u5b57\\u7b26\\u3002\\n\\u7edf\\u8ba1\\u5b8c\\u5b57\\u7b26\\u4ee5\\u540e\\u518d\\u6765\\u51cf\\u6389\\u7a7a\\u683c\\u597d\\u6362\\u884c\\u7b26\\uff08\\u201c\\\\n\\u201dor\\u201cendl\\u201d\\uff09\\u4f46\\u56e0\\u4e3ac++\\u5728\\u8ba1\\u7b97\\u5b57\\u7b26\\u65f6\\u662f\\u4e0d\\u4f1a\\u8ba1\\u7b97\\u6362\\u884c\\u7b26\\u7684\\uff0c\\u6240\\u4ee5\\u53ea\\u9700\\u8981\\u8ba1\\u7b97\\u7a7a\\u683c\\u5c31\\u884c\\u4e86\\u3002\\n\\u4f46\\u662f\\u5728\\u7528\\u666e\\u901a\\u7684cin\\u662f\\u662f\\u4e0d\\u4f1a\\u5c06\\u7a7a\\u683c\\u8ba1\\u7b97\\u4e3a\\u5b57\\u7b26\\u7684\\uff0c\\u6240\\u4ee5\\u9700\\u8981\\u7528\\u4ee5\\u4e0b\\u4ee3\\u7801\\uff1a\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"Engle\"},\"datePublished\":\"2024-12-25T13:47:39+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解：P5015 [NOIP2018 普及组] 标题统计\" />\n    <meta property=\"og:description\" content=\"这道题题目本意就是：给程序一个字符串，问这个字符串里面有多少个字符。\n统计完字符以后再来减掉空格好换行符（“\\n”or“endl”）但因为c++在计算字符时是不会计算换行符的，所以只需要计算空格就行了。\n但是在用普通的cin是是不会将空格计算为字符的，所以需要用以下代码：…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"Engle\" />\n    <meta property=\"article:published_time\" content=\"2024-12-25T13:47:39+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/g8gclrnk\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解：P5015 [NOIP2018 普及组] 标题统计</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">Engle</a>\n            ·\n            <time datetime=\"2024-12-25T13:47:39+08:00\">2024-12-25 13:47:39</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>这道题题目本意就是：给程序一个字符串，问这个字符串里面有多少个字符。</p>\n<p>统计完字符以后再来减掉空格好换行符（“\\n”or“endl”）但因为c++在计算字符时是不会计算换行符的，所以只需要计算空格就行了。</p>\n<p>但是在用普通的cin是是不会将空格计算为字符的，所以需要用以下代码：</p>\n<pre><code class=\"language-cpp\">getline(cin,s);</code></pre>\n<p>这段代码的作用就是让空格变成一个字符  </p>\n<p>最终代码如下：</p>\n<pre><code class=\"language-cpp\">\n#include&lt;bits/stdc++.h&gt;\nusing namespace std;\nstring s;\nint cnt=0;\nint main(){\n    getline(cin,s);\n    for(char c:s)\n        if(c!=' '&amp;&amp;c!='\\n') cnt++;\n    cout&lt;&lt;cnt;\n    return 0;\n}</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a60561c239f8d7ac',t:'MTc5NTY1OTI4OQ=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a60561c239f8d7ac',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
