 "code_blocks": [
  "#include <iostream>\n#include <algorithm>\nusing namespace std;\nbool cmp(string a, string b) {\n    return a + b > b + a;\n}\nint main() {\n    int n;\n    string a[21];\n    cin >> n;\n    for (int i = 1; i <= n; i++)\n        cin >> a[i];\n    sort(a + 1, a + n + 1, cmp);\n    for (int i = 1; i <= n; i++)\n        cout << a[i];\n    return 0;\n}"
