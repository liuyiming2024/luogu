 "code_blocks": [
  "#include <stdio.h>\nint main()\n{\n    int me = 0, mom = 0, spend, i;\n    for (i = 1; i <= 12; i++)\n    {\n        me += 300; // 每个月多300元\n        scanf(\"%d\", &spend);\n        me -= spend; // 减去预算\n        if (me < 0) // 如果超支\n        {\n            me = -i; // me变为-月份\n            break; // 退出循环，无需再计算\n        }\n        mom += me / 100 * 100; // 整百存给妈妈\n        me %= 100; // 自己留下零钱\n    }\n    if (me < 0) printf(\"%d\", me); // 如果me<0，说明超支\n    else printf(\"%g\", me + mom * 1.2); // 否则输出手上的钱\n    return 0;\n}"
 ],
