tream\\u003E\\nusing namespace std;\\nint w_time(int sh,int sm,int eh,int em)\\n{\\n\\tint startm,endm,usem;\\n\\tstartm=sh*60+sm;\\n\\tendm=eh*60+em;\\n\\tusem=endm-startm;\\n\\treturn usem;\\n}\\nint main()\\n{\\n\\tint sh,sm,eh,em,uset,useh,usem;\\n\\tcin\\u003E\\u003Esh\\u003E\\u003Esm\\u003E\\u003Eeh\\u003E\\u003Eem;\\n\\tuset=w_time(sh,sm,eh,em);\\n\\tuseh=uset\\/60;\\n\\tusem=uset%60;\\n\\tcout\\u003C\\u003Cuseh\\u003C\\u003C\\u0022 \\u0022\\u003C\\u003Cusem;\\n\\treturn 0;\\n}\\n```\\n\\u6700\\u540e\\uff0c\\u9644\\u56fe\\u4e00\\u5f20\\uff1a\\n![AC\\u5566\\uff01](C:\\\\Users\\\\Administrator\\\\Desktop\\\\1.png)\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795629608.936553}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/nobyk23w\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1425 \\u3010\\u5c0f\\u9c7c\\u7684\\u6e38\\u6cf3\\u65f6\\u95f4\\u3011\",\"description\":\"P1425 \\u3010\\u5c0f\\u9c7c\\u7684\\u6e38\\u6cf3\\u65f6\\u95f4\\u3011  \\u9898\\u89e3\\n\\u8fd9\\u9053\\u9898\\u76f4\\u63a5\\u7528\\u5c0f\\u65f6\\u4e0e\\u5206\\u949f\\u76f8\\u95f4\\u7684\\u8bdd\\uff0c\\u8981\\u7528\\u4e00\\u9053\\u5faa\\u73af\\uff0c\\u624d\\u53ef\\u4ee5\\u907f\\u514d\\u51fa\\u73b0\\u5206\\u949f\\u4e0d\\u591f\\u7684\\u60c5\\u51b5\\uff0c\\u6240\\u4ee5\\uff0c\\u6700\\u597d\\u7684\\u65b9\\u6cd5\\u5c31\\u662f\\u5c06\\u5176\\u5168\\u8f6c\\u6362\\u6210\\u5206\\u949f\\u7b97\\uff0c\\u8fd9\\u6837\\uff0c\\u53ef\\u4ee5\\u603b\\u7ed3\\u51fa\\u4e24\\u4e2a\\u8868\\u8fbe\\u5f0f\\uff1a\\n\\u5f00\\u59cb\\u65f6\\u95f4=\\u5f00\\u59cb\\u5206\\u949f+\\u5f00\\u59cb\\u5c0f\\u65f6\\u00d760\\uff1b\\n\\u7ed3\\u675f\\u65f6\\u95f4=\\u7ed3\\u675f\\u5206\\u949f+\\u7ed3\\u675f\\u5c0f\\u65f6\\u00d760\\uff1b\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"yanbowen\"},\"datePublished\":\"2019-04-20T13:30:22+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1425 【小鱼的游泳时间】\" />\n    <meta property=\"og:description\" content=\"P1425 【小鱼的游泳时间】  题解\n这道题直接用小时与分钟相间的话，要用一道循环，才可以避免出现分钟不够的情况，所以，最好的方法就是将其全转换成分钟算，这样，可以总结出两个表达式：\n开始时间=开始分钟+开始小时×60；\n结束时间=结束分钟+结束小时×60；…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"yanbowen\" />\n    <meta property=\"article:published_time\" content=\"2019-04-20T13:30:22+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/nobyk23w\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1425 【小鱼的游泳时间】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">yanbowen</a>\n            ·\n            <time datetime=\"2019-04-20T13:30:22+08:00\">2019-04-20 13:30:22</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <h1>P1425 【小鱼的游泳时间】  题解</h1>\n<p>这道题直接用小时与分钟相间的话，要用一道循环，才可以避免出现分钟不够的情况，所以，最好的方法就是将其全转换成分钟算，这样，可以总结出两个表达式：</p>\n<h3>开始时间=开始分钟+开始小时×60；</h3>\n<h3>结束时间=结束分钟+结束小时×60；</h3>\n<p>所以，可以写出一下代码：</p>\n<h2><strong>C：</strong></h2>\n<pre><code class=\"language-c\">#include&lt;stdio.h&gt;\nint w_time(int sh,int sm,int eh,int em)\n{\n    int startm,endm,usem;\n    startm=sh*60+sm;\n    endm=eh*60+em;\n    usem=endm-startm;\n    return usem;\n}\nint main()\n{\n    int sh,sm,eh,em,uset,useh,usem;\n    scanf(\"%d%d%d%d\",&amp;sh,&amp;sm,&amp;eh,&amp;em);\n    uset=w_time(sh,sm,eh,em);\n    useh=uset/60;\n    usem=uset%60;\n    printf(\"%d %d\",useh,usem);\n    return 0;\n}</code></pre>\n<h2><strong>C++:</strong></h2>\n<pre><code class=\"language-cpp\">#include&lt;iostream&gt;\nusing namespace std;\nint w_time(int sh,int sm,int eh,int em)\n{\n    int startm,endm,usem;\n    startm=sh*60+sm;\n    endm=eh*60+em;\n    usem=endm-startm;\n    return usem;\n}\nint main()\n{\n    int sh,sm,eh,em,uset,useh,usem;\n    cin&gt;&gt;sh&gt;&gt;sm&gt;&gt;eh&gt;&gt;em;\n    uset=w_time(sh,sm,eh,em);\n    useh=uset/60;\n    usem=uset%60;\n    cout&lt;&lt;useh&lt;&lt;\" \"&lt;&lt;usem;\n    return 0;\n}</code></pre>\n<p>最后，附图一张：\n</p>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6028d1c9d39face',t:'MTc5NTYyOTYwOA=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6028d1c9d39face',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
