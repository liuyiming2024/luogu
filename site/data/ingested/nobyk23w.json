 "code_blocks": [
  "#include<stdio.h>\nint w_time(int sh,int sm,int eh,int em)\n{\n    int startm,endm,usem;\n    startm=sh*60+sm;\n    endm=eh*60+em;\n    usem=endm-startm;\n    return usem;\n}\nint main()\n{\n    int sh,sm,eh,em,uset,useh,usem;\n    scanf(\"%d%d%d%d\",&sh,&sm,&eh,&em);\n    uset=w_time(sh,sm,eh,em);\n    useh=uset/60;\n    usem=uset%60;\n    printf(\"%d %d\",useh,usem);\n    return 0;\n}",
  "#include<iostream>\nusing namespace std;\nint w_time(int sh,int sm,int eh,int em)\n{\n    int startm,endm,usem;\n    startm=sh*60+sm;\n    endm=eh*60+em;\n    usem=endm-startm;\n    return usem;\n}\nint main()\n{\n    int sh,sm,eh,em,uset,useh,usem;\n    cin>>sh>>sm>>eh>>em;\n    uset=w_time(sh,sm,eh,em);\n    useh=uset/60;\n    usem=uset%60;\n    cout<<useh<<\" \"<<usem;\n    return 0;\n}"
