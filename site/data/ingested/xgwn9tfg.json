  "#include <stdio.h>\nint main()\n{\n    char a[1001]; \n    int n, i; \n    scanf(\"%d%s\", &n, a); //输入\n    for(i = 0; a[i] != '\\0'; i++)\n        putchar((a[i]-'a'+n)%26+'a'); \n    //读入中对应字母加上转移位数得到的字母的对应位置。\n    //取余26是防止移动位数超过26导致爆零\n    //再加上'a'，将对应位置还原成字母，输出 \n}"
