\u4ef6\\u8bed\\u53e5 \\u6211\\u4eec\\u53ea\\u9700\\u8981\\u5c06\\u8fd9\\u56db\\u53e5\\u8bdd\\u7528 \\u4ee3\\u7801 \\u201c\\u7ffb\\u8bd1\\u201d\\u4e00\\u4e0b \\u5c31\\u597d\\u4e86  \\uff08\\u5f53\\u6210\\u6587\\u8a00\\u6587\\u7ffb\\u8bd1\\u505a\\u54c8\\u54c8\\u54c8\\n\\n```cpp\\n1. if(x==1\\u0026\\u0026y!=n)xx=n;yy=y+1;\\n2.else if(y==n\\u0026\\u0026x!=1) yy=1;xx=x-1;\\n3.else if(x==1\\u0026\\u0026y==n) xx=x+1;yy=y;\\n4.  else if(x!=1\\u0026\\u0026y!=n){ if(!a[x-1][y+1])xx=x-1,yy=y+1;   else xx=x+1,yy=y; }       \\n```\\n\\u6838\\u5fc3\\u90e8\\u5206\\u5b8c\\u4e86\\u4e4b\\u540e\\u5c31\\u662f\\u8f93\\u51fa \\u6ce8\\u610f\\u8f93\\u51fa\\u7684\\u683c\\u5f0f\\n\\u5177\\u4f53\\u4fe1\\u606f\\u8bf7\\u770b\\u6211\\u7684\\u6e23\\u6e23\\u535a\\u5ba2\\u2193\\n\\nhttp:\\/\\/blog.csdn.net\\/qq\\\\_36303472\\/article\\/details\\/68489551\\n\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795659253.15864}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/0dhpwlt6\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P2615 \\u3010\\u795e\\u5947\\u7684\\u5e7b\\u65b9\\u3011\",\"description\":\"\\u8fd9\\u4e2a\\u9898\\u7684\\u5173\\u952e\\u5728\\u4e8e \\u6761\\u4ef6\\u8bed\\u53e5\\u7684\\u4f7f\\u7528\\n\\u5f53\\u6211\\u4eec\\u660e\\u767d\\u9898\\u610f\\u540e \\u9996\\u5148\\u628a1\\u653e\\u5230\\u4e8c\\u7ef4\\u6570\\u7ec4\\u4e2d\\u7b2c\\u4e00\\u884c\\u7684\\u6b63\\u4e2d\\u95f4\\n\\u7136\\u540e\\u770b\\u4e0b\\u9762\\u56db\\u53e5\\u8bdd\\n1.\\u82e5(K\\u22121)\\u5728\\u7b2c\\u4e00\\u884c\\u4f46\\u4e0d\\u5728\\u6700\\u540e\\u4e00\\u5217\\uff0c\\u5219\\u5c06K\\u586b\\u5728\\u6700\\u540e\\u4e00\\u884c\\uff0c(K\\u22121)\\u6240\\u5728\\u5217\\u7684\\u53f3\\u4e00\\u5217\\uff1b\\n2.\\u82e5(K\\u22121)\\u5728\\u6700\\u540e\\u4e00\\u5217\\u4f46\\u4e0d\\u5728\\u7b2c\\u4e00\\u884c\\uff0c\\u5219\\u5c06K\\u586b\\u5728\\u7b2c\\u4e00\\u5217\\uff0c(K\\u22121)\\u6240\\u5728\\u884c\\u7684\\u4e0a\\u4e00\\u884c\\uff1b\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"ars4me\"},\"datePublished\":\"2017-04-05T15:12:40+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P2615 【神奇的幻方】\" />\n    <meta property=\"og:description\" content=\"这个题的关键在于 条件语句的使用\n当我们明白题意后 首先把1放到二维数组中第一行的正中间\n然后看下面四句话\n1.若(K−1)在第一行但不在最后一列，则将K填在最后一行，(K−1)所在列的右一列；\n2.若(K−1)在最后一列但不在第一行，则将K填在第一列，(K−1)所在行的上一行；…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"ars4me\" />\n    <meta property=\"article:published_time\" content=\"2017-04-05T15:12:40+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/0dhpwlt6\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P2615 【神奇的幻方】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">ars4me</a>\n            ·\n            <time datetime=\"2017-04-05T15:12:40+08:00\">2017-04-05 15:12:40</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>这个题的关键在于 条件语句的使用</p>\n<p>当我们明白题意后 首先把1放到二维数组中第一行的正中间</p>\n<p>然后看下面四句话</p>\n<p>1.若(K−1)在第一行但不在最后一列，则将K填在最后一行，(K−1)所在列的右一列；</p>\n<p>2.若(K−1)在最后一列但不在第一行，则将K填在第一列，(K−1)所在行的上一行；</p>\n<p>3.若(K−1)在第一行最后一列，则将K填在(K−1)的正下方；</p>\n<p>4.若(K−1)既不在第一行，也不在最后一列，如果(K−1)的右上方还未填数，则将K填在(K−1)的右上方，否则将K填在(K−1)的正下方。</p>\n<p>这便是本题的四个条件语句 我们只需要将这四句话用 代码 “翻译”一下 就好了  （当成文言文翻译做哈哈哈</p>\n<pre><code class=\"language-cpp\">1. if(x==1&amp;&amp;y!=n)xx=n;yy=y+1;\n2.else if(y==n&amp;&amp;x!=1) yy=1;xx=x-1;\n3.else if(x==1&amp;&amp;y==n) xx=x+1;yy=y;\n4.  else if(x!=1&amp;&amp;y!=n){ if(!a[x-1][y+1])xx=x-1,yy=y+1;   else xx=x+1,yy=y; }       </code></pre>\n<p>核心部分完了之后就是输出 注意输出的格式\n具体信息请看我的渣渣博客↓</p>\n<p>http://blog.csdn.net/qq\\_36303472/article/details/68489551</p>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a60560d83db8d7ac',t:'MTc5NTY1OTI1Mg=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a60560d83db8d7ac',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
