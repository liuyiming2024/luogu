 "code_blocks": [
  "#include<bits/stdc++.h>\nusing namespace std;\nint n,x,y,a[1000010],b[1000010];//a数组用于记录语文成绩，b数组用于记录组成的数\nint main(){\n    cin>>n;\n    for(int i=1;i<=n;i++){\n        cin>>a[i]>>x>>y;//x和y用于辅助\n        b[i]=(a[i]+x+y)*1000000+a[i]*1000+n-i;//详细解释看上面\n    }\n    sort(b+1,b+n+1);//排序，注意是从小到大\n    for(int i=n;i>n-5;i--){//注意是逆序输出5个\n        cout<<n-b[i]%1000<<\" \"<<b[i]/1000000<<endl;\n    }\n    return 0;\n}"
 ],
 "sha256": "95914bbf65063243",
 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <meta name=\"csrf-token\" content=\"1795679573:C/YS1eZ2iyIc/9aUy0j+wdD82WXWqhUs8vpRsijXzuM=\">\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112514'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>题解：P1093 [NOIP 2007 普及组] 奖学金（@Arthur2024） - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"tehqdnw3\",\"title\":\"\\u9898\\u89e3\\uff1aP1093 [NOIP 2007 \\u666e\\u53ca\\u7ec4] \\u5956\\u5b66\\u91d1\\uff08@Arthur2024\\uff09\",\"category\":2,\"time\":1747539734,\"author\":{\"uid\":1350289,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/1350289.png\",\"name\":\"Arthur2024\",\"slogan\":\"\\u5927\\u5bb6\\u597d\\uff01\\u6211\\u53eb\\u4efb\\u6653\\u7b1b\\uff0cP11698\\u548cP11908\\u7684\\u9898\\u89e3\\u90fd\\u662f\\u6211\\u7684\\uff0c\\u5728\\u4e0a\\u9762\\u53d1\\u8bc4\\u8bba\\u7684\\u4eba\\u6211\\u90fd\\u4f1a\\u5173\\u6ce8ta\\u7684~\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Blue\",\"ccfLevel\":0,\"xcpcLevel\":0,\"background\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/image_hosting\\/2kd6lfja.png\"},\"upvote\":1,\"replyCount\":1,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1093\",\"type\":\"P\",\"name\":\"[NOIP 2007 \\u666e\\u53ca\\u7ec4] \\u5956\\u5b66\\u91d1\",\"difficulty\":2,\"fullScore\":100},\"promoteStatus\":0,\"collection\":null,\"content\":\"# \\u9898\\u76ee\\u610f\\u601d\\n[\\u9898\\u76ee\\u4f20\\u9001\\u95e8](https:\\/\\/www.luogu.com.cn\\/problem\\/P1093)\\n\\n\\u9898\\u76ee\\u8ba9\\u6211\\u4eec\\u5c06 $n$ \\u540d\\u5b66\\u751f\\u7684\\u6210\\u7ee9\\u6392\\u5e8f\\uff0c\\u8f93\\u51fa\\u524d $5$ \\u540d\\u7684\\u5b66\\u751f\\u7684\\u5b66\\u53f7\\u548c\\u6210\\u7ee9\\uff0c\\u6392\\u5e8f\\u6cd5\\u5219\\u662f\\u8bed\\u6587\\u3001\\u6570\\u5b66\\u548c\\u82f1\\u8bed\\u7684\\u603b\\u5206\\u8f83\\u5927\\u7684\\u6392\\u5728\\u524d\\uff0c\\u8f83\\u5c0f\\u7684\\u6392\\u5728\\u540e\\uff0c\\u76f8\\u7b49\\u7684\\u518d\\u6309\\u8bed\\u6587\\u6210\\u7ee9\\u7684\\u9ad8\\u4f4e\\u6392\\u5e8f\\uff0c\\u5982\\u679c\\u8fd8\\u76f8\\u7b49\\uff0c\\u5c31\\u6309\\u5b66\\u53f7\\u5c0f\\u7684\\u5728\\u524d\\uff0c\\u5927\\u7684\\u5728\\u540e\\uff0c\\u5b66\\u53f7\\u6309\\u8f93\\u5165\\u987a\\u5e8f\\u4e3a\\u51c6\\uff0c\\u4fdd\\u8bc1\\u4e0d\\u4f1a\\u6709\\u6392\\u540d\\u76f8\\u7b49\\u3002\\n# \\u601d\\u8def\\n\\u6b64\\u9898\\u5c31\\u662f\\u8ba9\\u6211\\u4eec\\u5c06\\u5b66\\u751f\\u6210\\u7ee9\\u6392\\u5e8f\\uff0c\\u5176\\u4e2d\\u603b\\u5206\\u4f18\\u5148\\u7ea7\\u6700\\u9ad8\\uff0c\\u7b2c\\u4e8c\\u662f\\u8bed\\u6587\\u6210\\u7ee9\\uff0c\\u6700\\u4f4e\\u7684\\u662f\\u5b66\\u53f7\\uff0c\\u90a3\\u6211\\u4eec\\u5c31\\u53ef\\u4ee5\\u7528\\u4e00\\u4e2a\\u6570\\u6765\\u8868\\u793a\\u8fd9\\u4e09\\u4e2a\\u6570\\uff0c\\u7528\\u8fd9\\u4e2a\\u6570\\u76f4\\u63a5\\u6392\\u5e8f\\u5c31\\u53ef\\u4ee5\\u5f97\\u51fa\\u6392\\u540d\\u3002\\u7531\\u4e8e\\u9898\\u76ee\\u4e2d\\u603b\\u5206\\u3001\\u8bed\\u6587\\u6210\\u7ee9\\u548c\\u5b66\\u53f7\\u7684\\u6570\\u503c\\u90fd\\u5c0f\\u4e8e $1000$\\uff0c\\u90a3\\u4e48\\u5982\\u679c\\u5206\\u522b\\u8ba9\\u5b83\\u4eec\\u5360\\u7528\\u4e00\\u4e2a\\u6570\\u7684\\u4e00\\u90e8\\u5206\\u6570\\u4f4d\\uff0c\\u603b\\u5206\\u7684\\u6570\\u4f4d\\u6700\\u5927\\uff0c\\u8bed\\u6587\\u6210\\u7ee9\\u5728\\u4e2d\\uff0c\\u5b66\\u53f7\\u7684\\u6570\\u4f4d\\u6700\\u5c0f\\uff0c\\u90a3\\u4e48\\u6392\\u5e8f\\u65f6\\u5c31\\u80fd\\u6309\\u7167\\u4f18\\u5148\\u7ea7\\u6392\\u5e8f\\u3002\\n\\n\\u4f8b\\u5982\\u603b\\u5206\\u4e3a $256$\\uff0c\\u8bed\\u6587\\u6210\\u7ee9\\u4e3a $91$\\uff0c\\u5b66\\u53f7\\u4e3a $32$\\uff0c$n$ \\u4e3a $50$\\uff0c\\u90a3\\u4e48\\u7ec4\\u6210\\u7684\\u6570\\u5c31\\u662f $256\\\\times1000000+91\\\\times1000+50-32$\\uff0c\\u7b49\\u4e8e $256091028$\\u3002\\uff08\\u4e0d\\u7528 $n$ \\u53bb\\u51cf\\u5b66\\u53f7\\u5c31\\u4f1a\\u6309\\u7167\\u5b66\\u53f7\\u5927\\u7684\\u5728\\u524d\\uff0c\\u5c0f\\u7684\\u5728\\u540e\\uff09\\n\\n\\u6700\\u540e\\u7528 $n$ \\u51cf\\u53bb\\uff08\\u8f6c\\u6362\\u4e3a\\u539f\\u6765\\u7684\\u5b66\\u53f7\\uff09\\u7ec4\\u6210\\u7684\\u6570\\u518d\\u5bf9 $1000$ \\u53d6\\u6a21\\u63d0\\u53d6\\u5b66\\u53f7\\uff0c\\u7528\\u7ec4\\u6210\\u7684\\u6570\\u9664\\u4ee5 $1000000$ \\u63d0\\u53d6\\u603b\\u5206\\uff0c\\u6ce8\\u610f\\u6309\\u7167\\u6392\\u5e8f\\u540e\\u9006\\u5e8f\\u8f93\\u51fa $5$ \\u4e2a\\u5b66\\u751f\\u7684\\u5b66\\u53f7\\u4e0e\\u6210\\u7ee9\\u5373\\u53ef\\u3002\\n# [AC](https:\\/\\/www.luogu.com.cn\\/record\\/217615646)\\u4ee3\\u7801\\n\\n```cpp\\n#include\\u003Cbits\\/stdc++.h\\u003E\\nusing namespace std;\\nint n,x,y,a[1000010],b[1000010];\\/\\/a\\u6570\\u7ec4\\u7528\\u4e8e\\u8bb0\\u5f55\\u8bed\\u6587\\u6210\\u7ee9\\uff0cb\\u6570\\u7ec4\\u7528\\u4e8e\\u8bb0\\u5f55\\u7ec4\\u6210\\u7684\\u6570\\nint main(){\\n\\tcin\\u003E\\u003En;\\n\\tfor(int i=1;i\\u003C=n;i++){\\n\\t\\tcin\\u003E\\u003Ea[i]\\u003E\\u003Ex\\u003E\\u003Ey;\\/\\/x\\u548cy\\u7528\\u4e8e\\u8f85\\u52a9\\n\\t\\tb[i]=(a[i]+x+y)*1000000+a[i]*1000+n-i;\\/\\/\\u8be6\\u7ec6\\u89e3\\u91ca\\u770b\\u4e0a\\u9762\\n\\t}\\n\\tsort(b+1,b+n+1);\\/\\/\\u6392\\u5e8f\\uff0c\\u6ce8\\u610f\\u662f\\u4ece\\u5c0f\\u5230\\u5927\\n\\tfor(int i=n;i\\u003En-5;i--){\\/\\/\\u6ce8\\u610f\\u662f\\u9006\\u5e8f\\u8f93\\u51fa5\\u4e2a\\n\\t\\tcout\\u003C\\u003Cn-b[i]%1000\\u003C\\u003C\\u0022 \\u0022\\u003C\\u003Cb[i]\\/1000000\\u003C\\u003Cendl;\\n\\t}\\n\\treturn 0;\\n}\\n```\\n**\\u8c22\\u8c22\\u89c2\\u770b\\uff01**\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795593173.810938}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/tehqdnw3\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3\\uff1aP1093 [NOIP 2007 \\u666e\\u53ca\\u7ec4] \\u5956\\u5b66\\u91d1\\uff08@Arthur2024\\uff09\",\"description\":\"\\u9898\\u76ee\\u610f\\u601d\\n\\u9898\\u76ee\\u4f20\\u9001\\u95e8\\n\\u9898\\u76ee\\u8ba9\\u6211\\u4eec\\u5c06 n \\u540d\\u5b66\\u751f\\u7684\\u6210\\u7ee9\\u6392\\u5e8f\\uff0c\\u8f93\\u51fa\\u524d 5 \\u540d\\u7684\\u5b66\\u751f\\u7684\\u5b66\\u53f7\\u548c\\u6210\\u7ee9\\uff0c\\u6392\\u5e8f\\u6cd5\\u5219\\u662f\\u8bed\\u6587\\u3001\\u6570\\u5b66\\u548c\\u82f1\\u8bed\\u7684\\u603b\\u5206\\u8f83\\u5927\\u7684\\u6392\\u5728\\u524d\\uff0c\\u8f83\\u5c0f\\u7684\\u6392\\u5728\\u540e\\uff0c\\u76f8\\u7b49\\u7684\\u518d\\u6309\\u8bed\\u6587\\u6210\\u7ee9\\u7684\\u9ad8\\u4f4e\\u6392\\u5e8f\\uff0c\\u5982\\u679c\\u8fd8\\u76f8\\u7b49\\uff0c\\u5c31\\u6309\\u5b66\\u53f7\\u5c0f\\u7684\\u5728\\u524d\\uff0c\\u5927\\u7684\\u5728\\u540e\\uff0c\\u5b66\\u53f7\\u6309\\u8f93\\u5165\\u987a\\u5e8f\\u4e3a\\u51c6\\uff0c\\u4fdd\\u8bc1\\u4e0d\\u4f1a\\u6709\\u6392\\u540d\\u76f8\\u7b49\\u3002\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"Arthur2024\"},\"datePublished\":\"2025-05-18T11:42:14+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解：P1093 [NOIP 2007 普及组] 奖学金（@Arthur2024）\" />\n    <meta property=\"og:description\" content=\"题目意思\n题目传送门\n题目让我们将 n 名学生的成绩排序，输出前 5 名的学生的学号和成绩，排序法则是语文、数学和英语的总分较大的排在前，较小的排在后，相等的再按语文成绩的高低排序，如果还相等，就按学号小的在前，大的在后，学号按输入顺序为准，保证不会有排名相等。…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"Arthur2024\" />\n    <meta property=\"article:published_time\" content=\"2025-05-18T11:42:14+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/tehqdnw3\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解：P1093 [NOIP 2007 普及组] 奖学金（@Arthur2024）</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">Arthur2024</a>\n            ·\n            <time datetime=\"2025-05-18T11:42:14+08:00\">2025-05-18 11:42:14</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <h1>题目意思</h1>\n<p>题目传送门</p>\n<p>题目让我们将 <la-tex display=\"inline\">n</la-tex> 名学生的成绩排序，输出前 <la-tex display=\"inline\">5</la-tex> 名的学生的学号和成绩，排序法则是语文、数学和英语的总分较大的排在前，较小的排在后，相等的再按语文成绩的高低排序，如果还相等，就按学号小的在前，大的在后，学号按输入顺序为准，保证不会有排名相等。</p>\n<h1>思路</h1>\n<p>此题就是让我们将学生成绩排序，其中总分优先级最高，第二是语文成绩，最低的是学号，那我们就可以用一个数来表示这三个数，用这个数直接排序就可以得出排名。由于题目中总分、语文成绩和学号的数值都小于 <la-tex display=\"inline\">1000</la-tex>，那么如果分别让它们占用一个数的一部分数位，总分的数位最大，语文成绩在中，学号的数位最小，那么排序时就能按照优先级排序。</p>\n<p>例如总分为 <la-tex display=\"inline\">256</la-tex>，语文成绩为 <la-tex display=\"inline\">91</la-tex>，学号为 <la-tex display=\"inline\">32</la-tex>，<la-tex display=\"inline\">n</la-tex> 为 <la-tex display=\"inline\">50</la-tex>，那么组成的数就是 <la-tex display=\"inline\">256\\times1000000+91\\times1000+50-32</la-tex>，等于 <la-tex display=\"inline\">256091028</la-tex>。（不用 <la-tex display=\"inline\">n</la-tex> 去减学号就会按照学号大的在前，小的在后）</p>\n<p>最后用 <la-tex display=\"inline\">n</la-tex> 减去（转换为原来的学号）组成的数再对 <la-tex display=\"inline\">1000</la-tex> 取模提取学号，用组成的数除以 <la-tex display=\"inline\">1000000</la-tex> 提取总分，注意按照排序后逆序输出 <la-tex display=\"inline\">5</la-tex> 个学生的学号与成绩即可。</p>\n<h1>AC代码</h1>\n<pre><code class=\"language-cpp\">#include&lt;bits/stdc++.h&gt;\nusing namespace std;\nint n,x,y,a[1000010],b[1000010];//a数组用于记录语文成绩，b数组用于记录组成的数\nint main(){\n    cin&gt;&gt;n;\n    for(int i=1;i&lt;=n;i++){\n        cin&gt;&gt;a[i]&gt;&gt;x&gt;&gt;y;//x和y用于辅助\n        b[i]=(a[i]+x+y)*1000000+a[i]*1000+n-i;//详细解释看上面\n    }\n    sort(b+1,b+n+1);//排序，注意是从小到大\n    for(int i=n;i&gt;n-5;i--){//注意是逆序输出5个\n        cout&lt;&lt;n-b[i]%1000&lt;&lt;\" \"&lt;&lt;b[i]/1000000&lt;&lt;endl;\n    }\n    return 0;\n}</code></pre>\n<p><strong>谢谢观看！</strong></p>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a5ff13977c1cf7ff',t:'MTc5NTU5MzE3Mw=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a5ff13977c1cf7ff',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
