om.cn\\/upload\\/usericon\\/411122.png\",\"name\":\"GuoPC\",\"slogan\":\"Just be yourself.\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Gray\",\"ccfLevel\":0,\"xcpcLevel\":0,\"background\":\"\"},\"upvote\":0,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":null,\"promoteStatus\":0,\"collection\":null,\"content\":\"**Python 3**\\n\\n[\\u9898\\u76ee\\u94fe\\u63a5](https:\\/\\/www.luogu.com.cn\\/problem\\/P1598)\\n\\n\\u597d\\u50cf\\u6ca1\\u770b\\u5230\\u6709\\u4eba\\u5199 Python 3 \\u7684\\u9898\\u89e3\\uff0c\\u672c\\u849f\\u84bb\\u5c31\\u6765\\u732e\\u4e11\\u4e86\\u3002\\n\\n\\u6a21\\u62df\\uff0c\\u55ef\\u3002\\u4e3b\\u8981\\u7528\\u5230\\u5217\\u8868\\u548c\\u5b57\\u5178\\u3002\\n\\n\\u76f4\\u63a5\\u4e0a\\u4ee3\\u7801\\uff1a\\n\\n```python\\nletters = [chr(i) for i in range(65, 91)] # \\u521b\\u5efa\\u5b57\\u7b26 A~Z \\u7684\\u5217\\u8868\\nstaDic = dict(zip(letters, [0] * 26)) # \\u4ee5\\u5b57\\u6bcd\\u4e3a\\u952e\\u521b\\u5efa\\u7edf\\u8ba1\\u6bcf\\u4e2a\\u5b57\\u6bcd\\u51fa\\u73b0\\u6b21\\u6570\\u7684\\u5b57\\u5178\\nins = [j for i in range(4) for j in input()] # \\u8bfb\\u5165\\u8f93\\u5165\\uff0c\\u540c\\u65f6\\u5c06\\u8f93\\u5165\\u62c6\\u6210\\u5355\\u4e2a\\u5b57\\u7b26\\u5b58\\u5165\\u5217\\u8868\\nfor k in ins:\\n    if k in letters: \\n        staDic[k] += 1 # \\u904d\\u5386\\u8f93\\u5165\\u7684\\u6bcf\\u4e00\\u4e2a\\u5b57\\u7b26\\uff0c\\u8fc7\\u6ee4\\u51fa A~Z\\uff0c\\u540c\\u65f6\\u7edf\\u8ba1\\u51fa\\u73b0\\u6b21\\u6570\\nmaxValue = max(staDic.values()) # \\u83b7\\u53d6\\u6700\\u5927\\u51fa\\u73b0\\u6b21\\u6570\\nZDic = {\\u0027Z\\u0027: staDic.pop(\\u0027Z\\u0027)} # \\u5c06 Z \\u7684\\u952e\\u503c\\u5bf9\\u62ff\\u51fa\\u6765\\u7528\\u4e8e\\u5355\\u72ec\\u5904\\u7406\\uff0c\\u6b64\\u65f6\\u7edf\\u8ba1\\u5b57\\u5178 staDic \\u91cc\\u53ea\\u6709 A~Y \\u7684\\u952e\\u503c\\u5bf9\\u4e86\\nwhile maxValue \\u003E 0:\\n# \\u8fd9\\u91cc\\u8003\\u8651\\u7684\\u662f\\uff0c\\u56e0\\u4e3a\\u9898\\u76ee\\u8981\\u6c42\\u7684\\u201c\\u67f1\\u72b6\\u56fe\\u201d\\u662f\\u5e95\\u90e8\\u5bf9\\u9f50\\u7684\\uff0c\\u6240\\u4ee5\\u5e94\\u5f53\\u5c06\\u503c\\u4ece\\u5927\\u5230\\u5c0f\\u5c42\\u5c42\\u8fc7\\u6ee4\\u3002\\n# \\u6ca1\\u7406\\u89e3\\u7684\\u8bdd\\u53ef\\u4ee5\\u7167\\u7740\\u8f93\\u51fa\\u6837\\u4f8b\\uff0c\\u5728\\u5de6\\u4fa7\\u4ece\\u5e95\\u90e8\\u5f80\\u4e0a\\u6807\\u6ce8 1\\u30012\\u30013\\u3001\\u2026\\uff08\\u4e5f\\u5c31\\u662f\\u624b\\u52a8\\u52a0\\u4e2a\\u7eb5\\u8f74\\uff09\\u3002\\u73b0\\u5728\\u5c31\\u662f\\u4ece\\u9876\\u90e8\\u5411\\u4e0b\\u8fdb\\u884c\\u8f93\\u51fa\\n    for value in staDic.values(): # \\u904d\\u5386\\u7edf\\u8ba1\\u5b57\\u5178\\u91cc\\uff08\\u73b0\\u5728\\u53ea\\u6709 A~Y\\uff09\\u7684\\u5404\\u503c\\n        if value \\u003E= maxValue:\\n            print(\\u0027*\\u0027, end=\\u0027 \\u0027) # \\u5bf9\\u5e94\\u7684\\u952e\\u80fd\\u8fbe\\u5230\\u8fd9\\u4e2a\\u51fa\\u73b0\\u6b21\\u6570\\uff0c\\u8f93\\u51fa * \\u52a0\\u4e2a\\u7a7a\\u683c\\n        else:\\n            print(\\u0027 \\u0027, end=\\u0027 \\u0027) # \\u5bf9\\u5e94\\u7684\\u952e\\u8fbe\\u4e0d\\u5230\\u8fd9\\u4e2a\\u51fa\\u73b0\\u6b21\\u6570\\uff0c\\u8f93\\u51fa 2 \\u4e2a\\u7a7a\\u683c\\n    if ZDic[\\u0027Z\\u0027] \\u003E= maxValue: # \\u5355\\u72ec\\u5904\\u7406 Z\\uff0c\\u56e0\\u4e3a Z \\u540e\\u9762\\u5c31\\u8981\\u6362\\u884c\\u4e86\\u561b\\n        print(\\u0027*\\u0027)\\n    else:\\n        print(\\u0027 \\u0027)\\n    maxValue -= 1 # \\u4e00\\u884c\\u8f93\\u51fa\\u5b8c\\u4e4b\\u540e\\u51fa\\u73b0\\u6b21\\u6570\\u81ea\\u51cf\\uff0c\\u5230\\u4e0b\\u4e00\\u884c\\u8fdb\\u884c\\u8f93\\u51fa\\uff08\\u7ee7\\u7eed\\u5faa\\u73af\\uff09\\nprint(\\u0027 \\u0027.join(letters)) # \\u8f93\\u51fa\\u6a2a\\u8f74\\n\\n```\\n\\n\\u8bed\\u8a00\\u8868\\u8fbe\\u82e6\\u624bqwq\\uff0c\\u5982\\u679c\\u80fd\\u770b\\u61c2\\u6211\\u5199\\u7684\\u6ce8\\u91ca\\u7684\\u8bdd\\u90a3\\u518d\\u597d\\u4e0d\\u8fc7\\u4e86\\uff08\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795659209.6916}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/biep97vd\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"P1598 \\u5782\\u76f4\\u67f1\\u72b6\\u56fe \\u9898\\u89e3\",\"description\":\"Python 3\\n\\u9898\\u76ee\\u94fe\\u63a5\\n\\u597d\\u50cf\\u6ca1\\u770b\\u5230\\u6709\\u4eba\\u5199 Python 3 \\u7684\\u9898\\u89e3\\uff0c\\u672c\\u849f\\u84bb\\u5c31\\u6765\\u732e\\u4e11\\u4e86\\u3002\\n\\u6a21\\u62df\\uff0c\\u55ef\\u3002\\u4e3b\\u8981\\u7528\\u5230\\u5217\\u8868\\u548c\\u5b57\\u5178\\u3002\\n\\u76f4\\u63a5\\u4e0a\\u4ee3\\u7801\\uff1a\\nletters = [chr(i) for i in range(65, 91)] # \\u521b\\u5efa\\u5b57\\u7b26 A~Z\\u2026\",\"genre\":\"\\u4e2a\\u4eba\\u8bb0\\u5f55\",\"author\":{\"@type\":\"Person\",\"name\":\"GuoPC\"},\"datePublished\":\"2022-02-15T13:09:50+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"P1598 垂直柱状图 题解\" />\n    <meta property=\"og:description\" content=\"Python 3\n题目链接\n好像没看到有人写 Python 3 的题解，本蒟蒻就来献丑了。\n模拟，嗯。主要用到列表和字典。\n直接上代码：\nletters = [chr(i) for i in range(65, 91)] # 创建字符 A~Z…\" />\n    <meta property=\"article:section\" content=\"个人记录\" />\n    <meta property=\"article:author\" content=\"GuoPC\" />\n    <meta property=\"article:published_time\" content=\"2022-02-15T13:09:50+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/biep97vd\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>P1598 垂直柱状图 题解</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">GuoPC</a>\n            ·\n            <time datetime=\"2022-02-15T13:09:50+08:00\">2022-02-15 13:09:50</time>\n            ·\n            <a href=\"/article?category=1\">个人记录</a>\n        </p>\n\n        <p><strong>Python 3</strong></p>\n<p>题目链接</p>\n<p>好像没看到有人写 Python 3 的题解，本蒟蒻就来献丑了。</p>\n<p>模拟，嗯。主要用到列表和字典。</p>\n<p>直接上代码：</p>\n<pre><code class=\"language-python\">letters = [chr(i) for i in range(65, 91)] # 创建字符 A~Z 的列表\nstaDic = dict(zip(letters, [0] * 26)) # 以字母为键创建统计每个字母出现次数的字典\nins = [j for i in range(4) for j in input()] # 读入输入，同时将输入拆成单个字符存入列表\nfor k in ins:\n    if k in letters: \n        staDic[k] += 1 # 遍历输入的每一个字符，过滤出 A~Z，同时统计出现次数\nmaxValue = max(staDic.values()) # 获取最大出现次数\nZDic = {'Z': staDic.pop('Z')} # 将 Z 的键值对拿出来用于单独处理，此时统计字典 staDic 里只有 A~Y 的键值对了\nwhile maxValue &gt; 0:\n# 这里考虑的是，因为题目要求的“柱状图”是底部对齐的，所以应当将值从大到小层层过滤。\n# 没理解的话可以照着输出样例，在左侧从底部往上标注 1、2、3、…（也就是手动加个纵轴）。现在就是从顶部向下进行输出\n    for value in staDic.values(): # 遍历统计字典里（现在只有 A~Y）的各值\n        if value &gt;= maxValue:\n            print('*', end=' ') # 对应的键能达到这个出现次数，输出 * 加个空格\n        else:\n            print(' ', end=' ') # 对应的键达不到这个出现次数，输出 2 个空格\n    if ZDic['Z'] &gt;= maxValue: # 单独处理 Z，因为 Z 后面就要换行了嘛\n        print('*')\n    else:\n        print(' ')\n    maxValue -= 1 # 一行输出完之后出现次数自减，到下一行进行输出（继续循环）\nprint(' '.join(letters)) # 输出横轴\n</code></pre>\n<p>语言表达苦手qwq，如果能看懂我写的注释的话那再好不过了（</p>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6055fcb5da0e3ae',t:'MTc5NTY1OTIwOQ=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6055fcb5da0e3ae',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
