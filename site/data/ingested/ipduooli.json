 "sha256": "b49e8eb53d79e65a",
 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <!-- 匿名页面令牌已移除（公开归档不保留） -->\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112601'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>P1164 小A点菜 题解 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"ipduooli\",\"title\":\"P1164 \\u5c0fA\\u70b9\\u83dc \\u9898\\u89e3\",\"category\":4,\"time\":1736850123,\"author\":{\"uid\":1641619,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/1641619.png\",\"name\":\"lyqIQhugaohudi\",\"slogan\":\"\\u751f\\u547d\\uff0c\\u5728\\u4e8eDP||\\u6211\\u83dc\\u6211\\u9a84\\u50b2\\uff0c\\u505a\\u9898\\u6c14\\u7684\\u55f7\\u55f7\\u53eb\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Blue\",\"ccfLevel\":0,\"xcpcLevel\":0,\"background\":\"\"},\"upvote\":1,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":null,\"promoteStatus\":0,\"collection\":null,\"content\":\"## P1164 \\u5c0fA\\u70b9\\u83dc\\n### [\\u9898\\u76ee](https:\\/\\/www.luogu.com.cn\\/problem\\/P1164)\\n### \\u9898\\u578b\\n\\u8fd9\\u4e2a\\u9898\\u5f88\\u660e\\u663e\\u662f\\u4e2a `01\\u80cc\\u5305`  \\n\\u6211\\u4eec\\u53ef\\u4ee5\\u4f7f\\u7528 `DP` \\u6765\\u5b9e\\u73b0\\uff08\\u8fd9\\u660e\\u660e\\u672c\\u6765\\u5c31\\u662f `\\u80cc\\u5305DP` \\u597d\\u5427\\uff09\\n### \\u601d\\u8def\\n\\u65e2\\u7136\\u6211\\u4eec\\u7528\\u4e86 `DP`\\uff0c\\u90a3\\u4e48\\uff0c\\u6765\\u4e00\\u624b `DP\\u56db\\u90e8\\u66f2`\\n\\n1.\\u5b9a\\u4e49\\n\\u003E \\u6211\\u4eec\\u5b9a\\u4e49 ${dp}_{i, j}$ \\uff1a\\u8003\\u8651\\u524d $i$ \\u9053\\u83dc\\uff0c\\u4ef7\\u683c**\\u6070\\u597d**\\u4e3a $j$ \\u7684\\u65b9\\u6848\\u6570\\n\\n2.\\u8f6c\\u79fb\\n\\u003E (1) $j \\\\ge a_i$\\n\\u003E \\u003E ${dp}_{i,j} = {dp}_{i - 1,j - a_i} + {dp}_{i - 1,j}$\\n\\u003E\\n\\u003E (2) $j \\u003C a_i$\\n\\u003E \\u003E ${dp}_{i,j} = {dp}_{i - 1,j}$\\n\\n3.\\u521d\\u59cb\\u503c\\n\\u003E \\u7531\\u4e8e\\u70b9 $0$ \\u9053\\u83dc\\u4ef7\\u683c\\u53ea\\u80fd\\u4e3a $0$\\uff0c\\u6240\\u4ee5 ${dp}_{0,0} = 1$ \\uff0c ${dp}_{0,1 - m} = 0$\\n\\n4.\\u7b54\\u6848\\n\\u003E \\u6839\\u636e\\u5b9a\\u4e49\\uff0c\\u7b54\\u6848\\u4e3a ${dp}_{n,m}$\\n### \\u4ee3\\u7801\\n```cpp\\n#include \\u003Ciostream\\u003E\\n#include \\u003Cstring\\u003E\\n#include \\u003Ccstring\\u003E\\n#include \\u003Calgorithm\\u003E\\n#include \\u003Cstack\\u003E\\n#include \\u003Cqueue\\u003E\\n#include \\u003Cvector\\u003E\\n#include \\u003Cdeque\\u003E\\n#include \\u003Cset\\u003E\\n#include \\u003Cmap\\u003E\\n#include \\u003Ciomanip\\u003E\\n#include \\u003Ccmath\\u003E\\n\\nusing namespace std;\\n\\nconst int inf = 1061109567;\\nconst int N = 1e4 + 10;\\n\\nint n, m, a[N], dp[N][N]; \\/\\/\\u5b9a\\u4e49\\uff1adp[i][j] \\u8003\\u8651\\u524di\\u9053\\u83dc\\uff0c\\u4ef7\\u683c\\u6070\\u597d\\u4e3aj\\u7684\\u65b9\\u6848\\u6570\\n\\nsigned main()\\n{\\n    cin \\u003E\\u003E n \\u003E\\u003E m;\\n    for (int i = 1; i \\u003C= n; ++ i) cin \\u003E\\u003E a[i];\\n    \\/\\/\\u521d\\u59cb\\u503c\\n    dp[0][0] = 1; \\/\\/\\u7531\\u4e8edp\\u662f\\u5168\\u5c40\\u53d8\\u91cf\\uff0c\\u6240\\u4ee5\\u521d\\u59cb\\u503c\\u4e3a0\\n    for (int i = 1; i \\u003C= n; ++ i) dp[i][0] = 1;\\n    for (int i = 1; i \\u003C= n; ++ i)\\n    {\\n        for (int j = m; j \\u003E= 1; -- j)\\n        {\\n            \\/\\/\\u72b6\\u6001\\u8f6c\\u79fb\\n            if (j \\u003E= a[i]) dp[i][j] = dp[i - 1][j - a[i]] + dp[i - 1][j];\\n            else dp[i][j] = dp[i - 1][j];\\n        }\\n    }\\n    \\/\\/\\u7b54\\u6848\\n    cout \\u003C\\u003C dp[n][m] \\u003C\\u003C endl; \\/\\/\\u517b\\u6210\\u597d\\u4e60\\u60ef\\uff1a\\u52a0\\u4e00\\u4e2a\\u6362\\u884c\\n\\n    return 0; \\/\\/\\u5343\\u4e07\\u522b\\u5fd8\\u8bb0\\n}\\n```\\n### \\u9644\\u6ce8\\n$dp$ \\u6570\\u7ec4\\u53ef\\u538b\\u7f29\\u6210\\u4e00\\u7ef4\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795629534.725231}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/ipduooli\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"P1164 \\u5c0fA\\u70b9\\u83dc \\u9898\\u89e3\",\"description\":\"P1164 \\u5c0fA\\u70b9\\u83dc\\n\\u9898\\u76ee\\n\\u9898\\u578b\\n\\u8fd9\\u4e2a\\u9898\\u5f88\\u660e\\u663e\\u662f\\u4e2a 01\\u80cc\\u5305\\n\\u6211\\u4eec\\u53ef\\u4ee5\\u4f7f\\u7528 DP \\u6765\\u5b9e\\u73b0\\uff08\\u8fd9\\u660e\\u660e\\u672c\\u6765\\u5c31\\u662f \\u80cc\\u5305DP \\u597d\\u5427\\uff09\\n\\u601d\\u8def\\n\\u65e2\\u7136\\u6211\\u4eec\\u7528\\u4e86 DP\\uff0c\\u90a3\\u4e48\\uff0c\\u6765\\u4e00\\u624b DP\\u56db\\u90e8\\u66f2\\n1.\\u5b9a\\u4e49\\n\\n\\u6211\\u4eec\\u5b9a\\u4e49 {dp}_{i, j} \\uff1a\\u8003\\u8651\\u524d i \\u9053\\u83dc\\uff0c\\u4ef7\\u683c\\u6070\\u597d\\u4e3a\\u2026\",\"genre\":\"\\u7b97\\u6cd5\\u00b7\\u7406\\u8bba\",\"author\":{\"@type\":\"Person\",\"name\":\"lyqIQhugaohudi\"},\"datePublished\":\"2025-01-14T18:22:03+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"P1164 小A点菜 题解\" />\n    <meta property=\"og:description\" content=\"P1164 小A点菜\n题目\n题型\n这个题很明显是个 01背包\n我们可以使用 DP 来实现（这明明本来就是 背包DP 好吧）\n思路\n既然我们用了 DP，那么，来一手 DP四部曲\n1.定义\n\n我们定义 {dp}_{i, j} ：考虑前 i 道菜，价格恰好为…\" />\n    <meta property=\"article:section\" content=\"算法·理论\" />\n    <meta property=\"article:author\" content=\"lyqIQhugaohudi\" />\n    <meta property=\"article:published_time\" content=\"2025-01-14T18:22:03+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/ipduooli\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>P1164 小A点菜 题解</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">lyqIQhugaohudi</a>\n            ·\n            <time datetime=\"2025-01-14T18:22:03+08:00\">2025-01-14 18:22:03</time>\n            ·\n            <a href=\"/article?category=4\">算法·理论</a>\n        </p>\n\n        <h2>P1164 小A点菜</h2>\n<h3>题目</h3>\n<h3>题型</h3>\n<p>这个题很明显是个 <code>01背包</code><br />\n我们可以使用 <code>DP</code> 来实现（这明明本来就是 <code>背包DP</code> 好吧）</p>\n<h3>思路</h3>\n<p>既然我们用了 <code>DP</code>，那么，来一手 <code>DP四部曲</code></p>\n<p>1.定义</p>\n<blockquote>\n<p>我们定义 <la-tex display=\"inline\">{dp}_{i, j}</la-tex> ：考虑前 <la-tex display=\"inline\">i</la-tex> 道菜，价格<strong>恰好</strong>为 <la-tex display=\"inline\">j</la-tex> 的方案数</p>\n</blockquote>\n<p>2.转移</p>\n<blockquote>\n<p>(1) <la-tex display=\"inline\">j \\ge a_i</la-tex></p>\n<blockquote>\n<la-tex display=\"block\">{dp}_{i,j} = {dp}_{i - 1,j - a_i} + {dp}_{i - 1,j}</la-tex>\n</blockquote>\n<p>(2) <la-tex display=\"inline\">j &lt; a_i</la-tex></p>\n<blockquote>\n<la-tex display=\"block\">{dp}_{i,j} = {dp}_{i - 1,j}</la-tex>\n</blockquote>\n</blockquote>\n<p>3.初始值</p>\n<blockquote>\n<p>由于点 <la-tex display=\"inline\">0</la-tex> 道菜价格只能为 <la-tex display=\"inline\">0</la-tex>，所以 <la-tex display=\"inline\">{dp}_{0,0} = 1</la-tex> ， <la-tex display=\"inline\">{dp}_{0,1 - m} = 0</la-tex></p>\n</blockquote>\n<p>4.答案</p>\n<blockquote>\n<p>根据定义，答案为 <la-tex display=\"inline\">{dp}_{n,m}</la-tex></p>\n<h3>代码</h3>\n<pre><code class=\"language-cpp\">\n#include &lt;iostream&gt;\n#include &lt;string&gt;\n#include &lt;cstring&gt;\n#include &lt;algorithm&gt;\n#include &lt;stack&gt;\n#include &lt;queue&gt;\n#include &lt;vector&gt;\n#include &lt;deque&gt;\n#include &lt;set&gt;\n#include &lt;map&gt;\n#include &lt;iomanip&gt;\n#include &lt;cmath&gt;</code></pre>\n</blockquote>\n<p>using namespace std;</p>\n<p>const int inf = 1061109567;\nconst int N = 1e4 + 10;</p>\n<p>int n, m, a[N], dp[N][N]; //定义：dp[i][j] 考虑前i道菜，价格恰好为j的方案数</p>\n<p>signed main()\n{\ncin &gt;&gt; n &gt;&gt; m;\nfor (int i = 1; i &lt;= n; ++ i) cin &gt;&gt; a[i];\n//初始值\ndp[0][0] = 1; //由于dp是全局变量，所以初始值为0\nfor (int i = 1; i &lt;= n; ++ i) dp[i][0] = 1;\nfor (int i = 1; i &lt;= n; ++ i)\n{\nfor (int j = m; j &gt;= 1; -- j)\n{\n//状态转移\nif (j &gt;= a[i]) dp[i][j] = dp[i - 1][j - a[i]] + dp[i - 1][j];\nelse dp[i][j] = dp[i - 1][j];\n}\n}\n//答案\ncout &lt;&lt; dp[n][m] &lt;&lt; endl; //养成好习惯：加一个换行</p>\n<pre><code>return 0; //千万别忘记</code></pre>\n<p>}</p>\n<pre><code>\n### 附注\n$dp$ 数组可压缩成一维</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6028b4f2e40cf26',t:'MTc5NTYyOTUzNA=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6028b4f2e40cf26',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
