on/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P2615 【神奇的幻方】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">Konnyaku</a>\n            ·\n            <time datetime=\"2016-11-14T16:25:03+08:00\">2016-11-14 16:25:03</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>先初始化x=n/2+1,y=1；</p>\n<p>即1的位置</p>\n<p>然后for循环判定下一个的位置</p>\n<p>不说废话上代码</p>\n<pre><code class=\"language-cpp\">#include&lt;iostream&gt;\n#include&lt;cstdio&gt;\n#include&lt;cstring&gt;\nusing namespace std;\nint main()\n{\n    int n,a[40][40];\n    memset(a,0,sizeof(a));//初始化x,y\n    a[x][y]=1;\n    for(int i=2;i&lt;=n*n;i++)//for判定\n    {\n        if(x==1&amp;&amp;y!=n)\n        {\n            x=n;\n            y++;\n        }\n        else if(y==n&amp;&amp;x!=1)\n        {\n            y=1;\n            x--;\n        }\n        else if(x==1&amp;&amp;y==n)\n        {\n            x++;\n            y=y;\n        }\n        else if(x!=1&amp;&amp;y!=n)\n        {\n            if(a[x-1][y+1]==0)\n            {\n                x--;\n                y++;\n            }\n            else \n            {\n                x++;\n                y=y;\n            }</code></pre>\n<p>}//以上为所有的情况</p>\n<pre><code class=\"language-cpp\">        a[x][y]=i;//记录\n    }\n    for(int i=1;i&lt;=n;i++)\n    {\n        for(int j=1;j&lt;=n;j++)\n        cout&lt;&lt;a[i][j]&lt;&lt;\" \";\n        cout&lt;&lt;endl;</code></pre>\n<p>}//输出\nreturn 0;</p>\n<p>}</p>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a605615b193d9ab6',t:'MTc5NTY1OTI3Mw=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a605615b193d9ab6',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
