  "#include<bits/stdc++.h>\nusing namespace std;\nint main(){\n    int a,b,c,d;\n    cin>>a>>b>>c>>d;\n    int x,y;//用时\n    if(d>=b){//不需要借位 \n         y=d-b;\n    } \n    else{//需要借位 \n        d+=60;\n        y=d-b;\n        c--;\n    }\n    x=c-a;//最终时间一定大于开始时间 \n    cout<<x<<\" \"<<y;//输出 \n    return 0;\n}"
