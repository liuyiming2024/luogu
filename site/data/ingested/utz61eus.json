  "#include <iostream>\n#include <cstdio>\n#include <cstring>     //这些就够了\nusing namespace std;\nlong long n,k;\nint a[100000005];     //数据范围较大，不大会RE\nint main()\n{\n    cin>>n;\n    for(int i=1;i<=n;i++)\n    {\n        cin>>k;\n        a[k]++;//记录快子\n        if(a[k]==2)\n        {\n            a[k]=0;       //如果它没有落单就···\n        }\n    }\n    for(int i=1;i<=10000000;i++)\n    {\n        if(a[i]==1)\n        {\n            cout<<i;       //落单就找出它\n            break;\n        }\n    }\n    return 0;\n}"
