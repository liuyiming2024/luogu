\\u5b83\\n            break;\\n        }\\n    }\\n    return 0;\\n}\\n```\\n\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795629620.715014}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/utz61eus\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1469 \\u3010\\u627e\\u7b77\\u5b50\\u3011\",\"description\":\"\\u6570\\u7ec4\\uff0c\\u5faa\\u73af\\u5c31\\u53ef\\u89e3\\u51b3\\n\\u770b\\u5230\\u5927\\u4f6c\\u90fd\\u5199\\u6392\\u5e8f\\uff08\\u4ec0\\u4e48sort,\\u6876\\u6392\\u7b49\\uff09\\n\\u4f5c\\u4e3a\\u849f\\u84bb\\u600e\\u80fd\\u6253\\u90a3\\u4e2a\\n\\u601d\\u8def\\uff1a\\n1.\\u6210\\u5bf9\\uff1aif\\u6210\\u5bf9\\u5b58\\u5728\\uff08520\\uff09\\u5c31\\u4e0d\\u7ba1\\uff0c\\n2.\\u6210\\u5355\\uff1abut\\u5982\\u679c\\u843d\\u5355\\u5c31cout\\n\\u4ee3\\u7801\\u5982\\u4e0b\\uff1a\\n#include &lt;iostream&gt;\\n#include\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"\\u7f16\\u7a0b\\u840c\\u65b0or\\u5927\\u795e\"},\"datePublished\":\"2019-08-20T14:36:58+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1469 【找筷子】\" />\n    <meta property=\"og:description\" content=\"数组，循环就可解决\n看到大佬都写排序（什么sort,桶排等）\n作为蒟蒻怎能打那个\n思路：\n1.成对：if成对存在（520）就不管，\n2.成单：but如果落单就cout\n代码如下：\n#include &amp;lt;iostream&amp;gt;\n#include…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"编程萌新or大神\" />\n    <meta property=\"article:published_time\" content=\"2019-08-20T14:36:58+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/utz61eus\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1469 【找筷子】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">编程萌新or大神</a>\n            ·\n            <time datetime=\"2019-08-20T14:36:58+08:00\">2019-08-20 14:36:58</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <h1><del>数组，循环就可解决</del></h1>\n<p>看到大佬都写排序（什么<del>sort</del>,<del>桶排</del>等）\n<del>作为蒟蒻</del>怎能打那个\n思路：\n1.成对：if成对存在（520）就不管，\n2.成单：but如果落单就cout</p>\n<p>代码如下：</p>\n<pre><code>#include &lt;iostream&gt;\n#include &lt;cstdio&gt;\n#include &lt;cstring&gt;     //这些就够了\nusing namespace std;\nlong long n,k;\nint a[100000005];     //数据范围较大，不大会RE\nint main()\n{\n    cin&gt;&gt;n;\n    for(int i=1;i&lt;=n;i++)\n    {\n        cin&gt;&gt;k;\n        a[k]++;//记录快子\n        if(a[k]==2)\n        {\n            a[k]=0;       //如果它没有落单就···\n        }\n    }\n    for(int i=1;i&lt;=10000000;i++)\n    {\n        if(a[i]==1)\n        {\n            cout&lt;&lt;i;       //落单就找出它\n            break;\n        }\n    }\n    return 0;\n}</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6028d689e0ec8bd',t:'MTc5NTYyOTYyMA=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6028d689e0ec8bd',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
