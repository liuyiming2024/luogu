ory\":2,\"time\":1573266309,\"author\":{\"uid\":238408,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/238408.png\",\"name\":\"vectorwyx\",\"slogan\":\"\\u6253 OI \\u5c31\\u50cf\\u5fc3\\u8df3\\u4e00\\u6837\\u81ea\\u7136\\uff0c\\u9000\\u5f79\\u5c31\\u50cf\\u53bb\\u4e16\\u4e00\\u6837\\u5fc5\\u7136\\u3002\",\"badge\":\"SD\\u7701\\u9009\\u52a0\\u6cb9\",\"isAdmin\":false,\"isBanned\":false,\"color\":\"Orange\",\"ccfLevel\":8,\"xcpcLevel\":0,\"background\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/image_hosting\\/fskw9496.png\"},\"upvote\":0,\"replyCount\":2,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1098\",\"type\":\"P\",\"name\":\"[NOIP 2007 \\u63d0\\u9ad8\\u7ec4] \\u5b57\\u7b26\\u4e32\\u7684\\u5c55\\u5f00\",\"difficulty\":2,\"fullScore\":100},\"promoteStatus\":3,\"collection\":null,\"content\":\"\\u7531\\u4e8e\\u8fd9\\u9053\\u9898\\u662f\\u7531\\u521d\\u8d5b\\u7684\\u4e00\\u9053\\u9898\\u6f14\\u5316\\u51fa\\u6765\\u7684\\uff0c\\u6240\\u4ee5\\u5927\\u4f53\\u601d\\u8def\\u548c\\u67b6\\u6784\\u5df2\\u7ecf\\u786e\\u5b9a\\uff1a\\u904d\\u5386\\u5b57\\u7b26\\u4e32\\uff0c\\u5982\\u679c\\u5f53\\u524d\\u5b57\\u7b26\\u4e3a\\u2018-\\u2019\\uff0c\\u5f00\\u59cb\\u5faa\\u73af\\u8f93\\u51fa\\n\\n\\u67b6\\u6784\\u5982\\u4e0b\\uff1a\\n\\n------------\\n\\nfor(int i=0;i\\u003Cs.size();++i){\\n\\n    \\tif(s[i]==\\u0027-\\u0027){\\n          \\t\\tfor(char x=s[i-1]+1;x\\u003Cs[i+1];++x){\\n\\t\\t\\t\\tcout\\u003C\\u003Cx;\\n\\t\\t\\t}\\n\\t\\t}\\n}\\n```\\n\\u8fd9\\u662f\\u4e0d\\u52a0\\u4efb\\u4f55\\u53c2\\u6570\\u65f6\\u7684\\u6838\\u5fc3\\u4ee3\\u7801\\uff0c\\u6682\\u4e14\\u79f0\\u4e4b\\u4e3a\\u539f\\u4ee3\\u7801\\uff0c\\u6211\\u4eec\\u5c31\\u4ece\\u8fd9\\u5f00\\u59cb\\uff0c\\u4e00\\u6b65\\u6b65\\u6269\\u5c55\\u6210\\u6709\\u53c2\\u6570\\u7684\\u4ee3\\u7801\\n\\u9996\\u5148\\u770b\\u53c2\\u6570p2\\uff0c\\u5b83\\u51b3\\u5b9a\\u4e86\\u8f93\\u51fa\\u7684\\u91cd\\u590d\\u6b21\\u6570\\uff0c\\u663e\\u7136\\u6211\\u4eec\\u53ea\\u9700\\u8981\\u5728\\u539f\\u4ee3\\u7801\\u7684\\u57fa\\u7840\\u4e0a\\u518d\\u5d4c\\u5957\\u4e00\\u4e2a\\u5faa\\u73af\\u5373\\u53ef\\uff1a\\n```\\nfor(int i=0;i\\u003Cs.size();++i){\\n\\n    \\tif(s[i]==\\u0027-\\u0027){\\n          \\t\\tfor(char x=s[i-1]+1;x\\u003Cs[i+1];++x){\\n\\t\\t\\t\\t\\tfor(int i=1;i\\u003C=p2;++i) cout\\u003C\\u003Cx;\\n\\t\\t\\t}\\n\\t\\t}\\n}\\n```\\n\\n------------\\n\\n\\u7ee7\\u7eed\\u770bp1\\uff0c\\u5b83\\u51b3\\u5b9a\\u4e86\\u5c55\\u5f00\\u7684\\u65b9\\u5f0f\\u3002\\u6211\\u4eec\\u53ef\\u4ee5\\u5206\\u4e3a\\u4e09\\u79cd\\u60c5\\u51b5\\uff1a\\n\\u201c-\\u201d\\u53f7\\u4e24\\u7aef\\u4e3a\\u5b57\\u6bcd\\uff0c\\u6216\\u4e24\\u7aef\\u4e3a\\u6570\\u5b57\\uff0c\\u6216\\u524d\\u4e24\\u79cd\\u90fd\\u4e0d\\u7b26\\u5408\\n\\u5bf9\\u4e8e\\u7b2c\\u4e00\\u79cd\\uff0c\\u6211\\u4eec\\u9700\\u8981\\u5bf9p1\\u8fdb\\u884c\\u4e09\\u6b21\\u5224\\u65ad\\uff0c\\u4e3a1\\u5219\\u539f\\u6837\\u8f93\\u51fa\\uff0c\\u4e3a2\\u8f6c\\u4e3a\\u5927\\u5199\\u5b57\\u6bcd\\uff0c\\u4e3a3\\u8f6c\\u4e3a*\\u8f93\\u51fa\\n\\u5bf9\\u4e8e\\u7b2c\\u4e8c\\u79cd\\uff0c\\u6211\\u4eec\\u53ea\\u9700\\u8981\\u4e00\\u6b21\\u5224\\u65ad\\uff0c\\u4e3a3\\u8f6c\\u4e3a*\\u8f93\\u51fa\\uff0c\\u4e0d\\u4e3a3\\u539f\\u6837\\u8f93\\u51fa\\n\\u5bf9\\u4e8e\\u7b2c\\u4e09\\u79cd\\uff0c\\u4e0d\\u9700\\u5c55\\u5f00\\uff0c\\u76f4\\u63a5\\u8f93\\u51fa\\u201c-\\u201d\\uff0c\\u8fdb\\u884c\\u4e0b\\u4e00\\u6b21\\u5faa\\u73af\\u5373\\u53ef\\n\\u4ee3\\u7801\\u7565\\n\\n------------\\n\\n\\u91cd\\u70b9\\u5728p3\\u4e0a\\uff0c\\u5b83\\u51b3\\u5b9a\\u4e86\\u662f\\u5426\\u9006\\u5e8f\\u3002\\u6211\\u4eec\\u90fd\\u77e5\\u9053\\u5bf9\\u4e8e\\u5b57\\u7b26\\u4e32\\u6709reverse\\u51fd\\u6570\\uff0c\\u53ef\\u60dc\\u5728\\u8fd9\\u91cc\\u4f7f\\u7528\\u7684\\u8bdd\\u4e0d\\u592a\\u73b0\\u5b9e\\u3002\\u5982\\u679c\\u7ee7\\u7eed\\u6dfb\\u52a0\\u5bf9p3\\u7684\\u5224\\u65ad\\uff0c\\u7a0b\\u5e8f\\u53c8\\u4f1a\\u53d8\\u5f97\\u5f88\\u7e41\\u7410\\u3002\\u80fd\\u5426\\u7b80\\u5316\\u5462\\uff1f\\n\\u8ba9\\u6211\\u4eec\\u5148\\u770b\\u4e00\\u4e0b\\u987a\\u5e8f\\u8f93\\u51fa\\u548c\\u9006\\u5e8f\\u8f93\\u51fa\\u7684\\u6838\\u5fc3\\u4ee3\\u7801\\uff1a\\n\\u987a\\u5e8f\\u8f93\\u51fa\\uff1a\\n```\\nfor(char x=s[i-1]+1;x\\u003Cs[i+1];++x){\\n\\n\\t\\t\\t\\tfor(int i=1;i\\u003C=p2;++i) cout\\u003C\\u003Cx;\\n\\t\\t}\\n```\\n\\u9006\\u5e8f\\u8f93\\u51fa\\uff1a```\\nfor(char x=s[i+1]-1;x\\u003Es[i-1];--x){\\n\\t\\t\\tfor(int i=1;i\\u003C=p2;++i) cout\\u003C\\u003Cx;\\n\\t}\\n```\\n\\u4ed4\\u7ec6\\u89c2\\u5bdf\\uff0c\\u5b83\\u4eec\\u662f\\u53ef\\u4ee5\\u5408\\u5e76\\u7684\\uff0c\\u6211\\u4eec\\u7528\\u4e00\\u4e2a\\u5b57\\u7b26\\u7c7b\\u578b\\u7684\\u53d8\\u91cfa1\\u6765\\u8868\\u793a\\u5faa\\u73af\\u53d8\\u91cf\\u7684\\u521d\\u59cb\\u503c\\uff0c\\u7528\\u53e6\\u4e00\\u4e2a\\u5b57\\u7b26\\u7c7b\\u578b\\u7684\\u53d8\\u91cfa2\\u6765\\u8868\\u793a\\u5faa\\u73af\\u53d8\\u91cf\\u7684\\u7ec8\\u6b62\\u503c\\uff0c\\u518d\\u7528\\u4e00\\u4e2a\\u6574\\u578bk\\u8868\\u793a\\u6bcf\\u6b21i\\u7684\\u589e\\u91cf\\/\\u51cf\\u91cf\\uff0c\\u90a3\\u4e48\\u5c31\\u5408\\u5e76\\u6210\\u4e86\\u5982\\u4e0b\\u7684\\u4ee3\\u7801\\uff1a\\n```\\nif(p3==1){\\n    a1=s[i-1]+1;\\n    a2=s[i+1];\\n    k=1;\\n}\\nelse{\\n    a1=s[i+1]-1;\\n    a2=s[i-1];\\n    k=-1\\n}\\nfor(char x=a1;x\\u003Cs[i+1]\\u0026\\u0026k==1||x\\u003Es[i-1]\\u0026\\u0026k===-1;x+=k){\\n\\t  for(int i=1;i\\u003C=p2;++i) cout\\u003C\\u003Cx;\\n\\t}\\n\\n------------\\n\\u597d\\u4e86\\uff0c\\u6240\\u6709\\u7684\\u53c2\\u6570\\u90fd\\u5df2\\u7ecf\\u5206\\u6790\\u5b8c\\u4e86\\uff0c\\u4f46\\u6709\\u4e00\\u70b9\\u8981\\u6ce8\\u610f\\uff1a\\u5bf9\\u4e8e\\u5b57\\u7b26\\u4e32s\\uff0c\\u8981\\u4ece\\u4e0b\\u68071\\u5f00\\u59cb\\u904d\\u5386\\uff0c\\u4e00\\u76f4\\u5230\\u5012\\u6570\\u7b2c\\u4e8c\\u4e2a\\u5b57\\u7b26\\uff0c\\u5bf9\\u4e8es[0]\\u548cs[s.size()-1],\\u76f4\\u63a5\\u8f93\\u51fa\\u5373\\u53ef\\uff0c\\u5426\\u5219\\u4f1a\\u8d8a\\u754c\\n```\\n\\u6574\\u4f53\\u4ee3\\u7801\\uff08\\u53d8\\u91cf\\u540d\\u548c\\u4e00\\u4e9b\\u7ec6\\u8282\\u53ef\\u80fd\\u4e0d\\u4e00\\u6837\\uff09\\uff1a\\n#include\\u003Cbits\\/stdc++.h\\u003E\\n\\nusing namespace std;\\n\\nint main(){\\n\\tint p1,p2,p3,l,k;\\/\\/\\u5c55\\u5f00\\u65b9\\u5f0f\\u3001\\u91cd\\u590d\\u4e2a\\u6570\\u3001\\u662f\\u5426\\u9006\\u5e8f\\uff1b \\n\\t\\n    string s;\\n\\tchar x,y;\\/\\/x\\u4e3a\\u5faa\\u73af\\u53d8\\u91cf\\u521d\\u59cb\\u503c\\uff0cy\\u4e3a\\u7ec8\\u6b62\\u503c \\n\\tcin\\u003E\\u003Ep1\\u003E\\u003Ep2\\u003E\\u003Ep3; \\n\\tcin\\u003E\\u003Es;\\n\\tl=s.size();\\n\\tcout\\u003C\\u003Cs[0];\\/\\/ \\u76f4\\u63a5\\u8f93\\u51fa\\u7b2c\\u4e00\\u4e2a\\u5b57\\u7b26 \\n\\tfor(int t=1;t\\u003Cl-1;++t){\\/\\/\\u4ece\\u4e0b\\u68071\\u5f00\\u59cb\\u904d\\u5386\\uff0c\\u4e00\\u76f4\\u5230\\u4e0b\\u6807l-2\\u7ed3\\u675f \\n\\t\\tchar a=s[t-1],b=s[t+1];\\/\\/a,b\\u4e3a\\u0027-\\u0027 \\u524d\\u540e\\u7684\\u5b57\\u7b26 \\n\\t\\tif(p3==2){\\/\\/\\u5982\\u679c\\u9006\\u5e8f\\uff0c\\u5faa\\u73af\\u53d8\\u91cf\\u4ece\\u540e\\u5f80\\u524d \\uff0c\\u5faa\\u73af\\u53d8\\u91cf\\u81ea\\u51cf \\n\\t\\t\\tx=b-1;\\n\\t\\t\\ty=a;\\n\\t\\t\\tk=-1;\\n\\t\\t}\\n\\t\\telse{\\/\\/\\u5982\\u679c\\u987a\\u5e8f\\uff0c\\u5faa\\u73af\\u53d8\\u91cf\\u4ece\\u524d\\u5f80\\u540e\\uff0c\\u5faa\\u73af\\u53d8\\u91cf\\u81ea\\u52a0 \\n\\t\\t\\tx=a+1;\\n\\t\\t\\ty=b;\\n\\t\\t\\tk=1;\\n\\t\\t}\\n\\t\\tif(s[t]==\\u0027-\\u0027\\u0026\\u0026s[t-1]\\u003Cs[t+1]){\\/\\/\\u5f53\\u524d\\u5b57\\u7b26\\u4e3a\\u0027-\\u0027\\u4e14\\u524d\\u4e00\\u4e2a\\u7684ASCII\\u7801\\u503c\\u5c0f\\u4e8e\\u540e\\u4e00\\u4e2a \\n\\t\\t\\tif(a\\u003E=\\u0027a\\u0027\\u0026\\u0026a\\u003C=\\u0027z\\u0027\\u0026\\u0026b\\u003E=\\u0027a\\u0027\\u0026\\u0026b\\u003C=\\u0027z\\u0027){\\/\\/\\u524d\\u540e\\u4e3a\\u5b57\\u6bcd \\n\\t\\t\\t\\tif(p1==1){\\n\\t\\t\\t\\t\\tfor(char i=x;i\\u003Cy\\u0026\\u0026k==1||i\\u003Ey\\u0026\\u0026k==-1;i+=k){\\/\\/ i\\u003Cy\\u0026\\u0026k==1||i\\u003Ey\\u0026\\u0026k==-1 \\u7684\\u610f\\u601d\\u662f\\uff0ck\\u4e3a1\\u65f6\\u4ece\\u524d\\u5f80\\u540e\\uff0ck\\u4e3a-1\\u65f6\\u4ece\\u540e\\u5f80\\u524d \\n\\t\\t\\t\\t\\t\\tfor(int j=1;j\\u003C=p2;++j) cout\\u003C\\u003Cchar(i);\\/\\/\\u907f\\u514di\\u8f6c\\u4e3a\\u6574\\u578b \\n\\t\\t\\t\\t\\t}\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\telse if(p1==2){\\n\\t\\t\\t\\t\\tfor(char i=x;i\\u003Cy\\u0026\\u0026k==1||i\\u003Ey\\u0026\\u0026k==-1;i+=k){\\n\\t\\t\\t\\t\\t\\tfor(int j=1;j\\u003C=p2;++j) cout\\u003C\\u003Cchar(i-\\u0027a\\u0027+\\u0027A\\u0027);\\n\\t\\t\\t\\t\\t}\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\telse if(p1==3){\\n\\t\\t\\t\\t\\tfor(char i=x;i\\u003Cy\\u0026\\u0026k==1||i\\u003Ey\\u0026\\u0026k==-1;i+=k){\\n\\t\\t\\t\\t\\t\\tfor(int j=1;j\\u003C=p2;++j) cout\\u003C\\u003C\\u0022*\\u0022;\\n\\t\\t\\t\\t\\t}\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t\\telse if(a\\u003E=\\u00270\\u0027\\u0026\\u0026a\\u003C=\\u00279\\u0027\\u0026\\u0026b\\u003E=\\u00270\\u0027\\u0026\\u0026b\\u003C=\\u00279\\u0027){\\n\\t\\t\\t\\tif(p1==3){\\n\\t\\t\\t\\t\\tfor(char i=x;i\\u003Cy\\u0026\\u0026k==1||i\\u003Ey\\u0026\\u0026k==-1;i+=k){\\n\\t\\t\\t\\t\\t\\tfor(int j=1;j\\u003C=p2;++j) cout\\u003C\\u003C\\u0022*\\u0022;\\n\\t\\t\\t\\t\\t}\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\telse{\\n\\t\\t\\t\\t\\tfor(char i=x;i\\u003Cy\\u0026\\u0026k==1||i\\u003Ey\\u0026\\u0026k==-1;i+=k){\\n\\t\\t\\t\\t\\t\\tfor(int j=1;j\\u003C=p2;++j) cout\\u003C\\u003Cchar(i);\\n\\t\\t\\t\\t\\t}\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t\\telse cout\\u003C\\u003C\\u0022-\\u0022;\\/\\/\\u4e24\\u79cd\\u90fd\\u4e0d\\u7b26\\u5408\\uff0c\\u539f\\u6837\\u8f93\\u51fa\\u0027-\\u0027\\n\\t\\t}\\n\\t\\telse cout\\u003C\\u003Cs[t];\\/\\/\\u4e0d\\u662f\\u0027-\\u0027,\\u76f4\\u63a5\\u8f93\\u51fa \\n\\t}\\n\\tcout\\u003C\\u003Cs[l-1];\\n\\treturn 0;\\n} \\n\\n\\n------------\\n\\u7b2c\\u4e00\\u6b21\\u53d1\\u9898\\u89e3\\uff0c\\u5982\\u6709\\u4e0d\\u8db3\\u656c\\u8bf7\\u6307\\u6b63\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795593179.354501}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/l9bmtvor\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1098 \\u3010\\u5b57\\u7b26\\u4e32\\u7684\\u5c55\\u5f00\\u3011\",\"description\":\"\\u7531\\u4e8e\\u8fd9\\u9053\\u9898\\u662f\\u7531\\u521d\\u8d5b\\u7684\\u4e00\\u9053\\u9898\\u6f14\\u5316\\u51fa\\u6765\\u7684\\uff0c\\u6240\\u4ee5\\u5927\\u4f53\\u601d\\u8def\\u548c\\u67b6\\u6784\\u5df2\\u7ecf\\u786e\\u5b9a\\uff1a\\u904d\\u5386\\u5b57\\u7b26\\u4e32\\uff0c\\u5982\\u679c\\u5f53\\u524d\\u5b57\\u7b26\\u4e3a\\u2018-\\u2019\\uff0c\\u5f00\\u59cb\\u5faa\\u73af\\u8f93\\u51fa\\n\\u67b6\\u6784\\u5982\\u4e0b\\uff1a\\n\\nfor(int i=0;i&lt;s.size();++i){\\n    if(s[i]=='-'){\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"vectorwyx\"},\"datePublished\":\"2019-11-09T10:25:09+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1098 【字符串的展开】\" />\n    <meta property=\"og:description\" content=\"由于这道题是由初赛的一道题演化出来的，所以大体思路和架构已经确定：遍历字符串，如果当前字符为‘-’，开始循环输出\n架构如下：\n\nfor(int i=0;i&amp;lt;s.size();++i){\n    if(s[i]==&#039;-&#039;){…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"vectorwyx\" />\n    <meta property=\"article:published_time\" content=\"2019-11-09T10:25:09+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/l9bmtvor\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1098 【字符串的展开】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">vectorwyx</a>\n            ·\n            <time datetime=\"2019-11-09T10:25:09+08:00\">2019-11-09 10:25:09</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>由于这道题是由初赛的一道题演化出来的，所以大体思路和架构已经确定：遍历字符串，如果当前字符为‘-’，开始循环输出</p>\n<p>架构如下：</p>\n\n<p>for(int i=0;i&lt;s.size();++i){</p>\n<pre><code>    if(s[i]=='-'){\n            for(char x=s[i-1]+1;x&lt;s[i+1];++x){\n            cout&lt;&lt;x;\n        }\n    }</code></pre>\n<p>}</p>\n<pre><code>这是不加任何参数时的核心代码，暂且称之为原代码，我们就从这开始，一步步扩展成有参数的代码\n首先看参数p2，它决定了输出的重复次数，显然我们只需要在原代码的基础上再嵌套一个循环即可：</code></pre>\n<p>for(int i=0;i&lt;s.size();++i){</p>\n<pre><code>    if(s[i]=='-'){\n            for(char x=s[i-1]+1;x&lt;s[i+1];++x){\n                for(int i=1;i&lt;=p2;++i) cout&lt;&lt;x;\n        }\n    }</code></pre>\n<p>}</p>\n<pre><code>\n------------\n\n继续看p1，它决定了展开的方式。我们可以分为三种情况：\n“-”号两端为字母，或两端为数字，或前两种都不符合\n对于第一种，我们需要对p1进行三次判断，为1则原样输出，为2转为大写字母，为3转为*输出\n对于第二种，我们只需要一次判断，为3转为*输出，不为3原样输出\n对于第三种，不需展开，直接输出“-”，进行下一次循环即可\n代码略\n\n------------\n\n重点在p3上，它决定了是否逆序。我们都知道对于字符串有reverse函数，可惜在这里使用的话不太现实。如果继续添加对p3的判断，程序又会变得很繁琐。能否简化呢？\n让我们先看一下顺序输出和逆序输出的核心代码：\n顺序输出：</code></pre>\n<p>for(char x=s[i-1]+1;x&lt;s[i+1];++x){</p>\n<pre><code>            for(int i=1;i&lt;=p2;++i) cout&lt;&lt;x;\n    }</code></pre>\n<pre><code>逆序输出：```\nfor(char x=s[i+1]-1;x&gt;s[i-1];--x){\n            for(int i=1;i&lt;=p2;++i) cout&lt;&lt;x;\n    }</code></pre>\n<p>仔细观察，它们是可以合并的，我们用一个字符类型的变量a1来表示循环变量的初始值，用另一个字符类型的变量a2来表示循环变量的终止值，再用一个整型k表示每次i的增量/减量，那么就合并成了如下的代码：</p>\n<pre><code>if(p3==1){\n    a1=s[i-1]+1;\n    a2=s[i+1];\n    k=1;\n}\nelse{\n    a1=s[i+1]-1;\n    a2=s[i-1];\n    k=-1\n}\nfor(char x=a1;x&lt;s[i+1]&amp;&amp;k==1||x&gt;s[i-1]&amp;&amp;k===-1;x+=k){\n      for(int i=1;i&lt;=p2;++i) cout&lt;&lt;x;\n    }\n\n------------\n好了，所有的参数都已经分析完了，但有一点要注意：对于字符串s，要从下标1开始遍历，一直到倒数第二个字符，对于s[0]和s[s.size()-1],直接输出即可，否则会越界</code></pre>\n<p>整体代码（变量名和一些细节可能不一样）：</p>\n<h1>include&lt;bits/stdc++.h&gt;</h1>\n<p>using namespace std;</p>\n<p>int main(){\nint p1,p2,p3,l,k;//展开方式、重复个数、是否逆序； </p>\n<pre><code>string s;\nchar x,y;//x为循环变量初始值，y为终止值 \ncin&gt;&gt;p1&gt;&gt;p2&gt;&gt;p3; \ncin&gt;&gt;s;\nl=s.size();\ncout&lt;&lt;s[0];// 直接输出第一个字符 \nfor(int t=1;t&lt;l-1;++t){//从下标1开始遍历，一直到下标l-2结束 \n    char a=s[t-1],b=s[t+1];//a,b为'-' 前后的字符 \n    if(p3==2){//如果逆序，循环变量从后往前 ，循环变量自减 \n        x=b-1;\n        y=a;\n        k=-1;\n    }\n    else{//如果顺序，循环变量从前往后，循环变量自加 \n        x=a+1;\n        y=b;\n        k=1;\n    }\n    if(s[t]=='-'&amp;&amp;s[t-1]&lt;s[t+1]){//当前字符为'-'且前一个的ASCII码值小于后一个 \n        if(a&gt;='a'&amp;&amp;a&lt;='z'&amp;&amp;b&gt;='a'&amp;&amp;b&lt;='z'){//前后为字母 \n            if(p1==1){\n                for(char i=x;i&lt;y&amp;&amp;k==1||i&gt;y&amp;&amp;k==-1;i+=k){// i&lt;y&amp;&amp;k==1||i&gt;y&amp;&amp;k==-1 的意思是，k为1时从前往后，k为-1时从后往前 \n                    for(int j=1;j&lt;=p2;++j) cout&lt;&lt;char(i);//避免i转为整型 \n                }\n            }\n            else if(p1==2){\n                for(char i=x;i&lt;y&amp;&amp;k==1||i&gt;y&amp;&amp;k==-1;i+=k){\n                    for(int j=1;j&lt;=p2;++j) cout&lt;&lt;char(i-'a'+'A');\n                }\n            }\n            else if(p1==3){\n                for(char i=x;i&lt;y&amp;&amp;k==1||i&gt;y&amp;&amp;k==-1;i+=k){\n                    for(int j=1;j&lt;=p2;++j) cout&lt;&lt;\"*\";\n                }\n            }\n        }\n        else if(a&gt;='0'&amp;&amp;a&lt;='9'&amp;&amp;b&gt;='0'&amp;&amp;b&lt;='9'){\n            if(p1==3){\n                for(char i=x;i&lt;y&amp;&amp;k==1||i&gt;y&amp;&amp;k==-1;i+=k){\n                    for(int j=1;j&lt;=p2;++j) cout&lt;&lt;\"*\";\n                }\n            }\n            else{\n                for(char i=x;i&lt;y&amp;&amp;k==1||i&gt;y&amp;&amp;k==-1;i+=k){\n                    for(int j=1;j&lt;=p2;++j) cout&lt;&lt;char(i);\n                }\n            }\n        }\n        else cout&lt;&lt;\"-\";//两种都不符合，原样输出'-'\n    }\n    else cout&lt;&lt;s[t];//不是'-',直接输出 \n}\ncout&lt;&lt;s[l-1];\nreturn 0;</code></pre>\n<p>} </p>\n\n<p>第一次发题解，如有不足敬请指正</p>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a5ff13b7d9eff29d',t:'MTc5NTU5MzE3OA=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a5ff13b7d9eff29d',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
