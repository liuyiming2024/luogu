  "#include<iostream>\n    #include<cmath>\n    using namespace std;\n    int main(){\n        long long l=1,r,mid,n,a;\n        cin>>n;\n        r=n;\n        while(l<r){\n            mid=(l+r)/2;\n            if(mid*(mid+1)/2<n)l=mid+1;\n            else r=mid;\n        }\n        a=n-l*(l-1)/2;\n        if(l%2==0)cout<<a<<'/'<<l+1-a;\n        else cout<<l+1-a<<'/'<<a;\n        return 0;\n}"
