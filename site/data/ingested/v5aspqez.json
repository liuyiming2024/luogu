4e48\\u4e0d\\u80fd\\u63d0\\u4ea4\\u5462\\uff09\",\"category\":1,\"time\":1571828076,\"author\":{\"uid\":51301,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/51301.png\",\"name\":\"Y15BeTa\",\"slogan\":\"\\u6211\\u4eec\\u90fd\\u6709\\u5149\\u660e\\u7684\\u524d\\u9014 \\u2014\\u2014\\u300a\\u65b0\\u534e\\u5b57\\u5178\\u300b\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Green\",\"ccfLevel\":4,\"xcpcLevel\":0,\"background\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/image_hosting\\/txt17xw2.png\"},\"upvote\":0,\"replyCount\":1,\"favorCount\":0,\"status\":2,\"solutionFor\":null,\"promoteStatus\":0,\"collection\":null,\"content\":\"# \\u5373\\u4f7f\\u4e0d\\u7528ceil\\uff0c\\u4e5f\\u53ef\\u4ee5\\u8f7b\\u677e\\u4f7f\\u7528800kb\\u7684\\u4ee3\\u7801\\n\\n```\\n#include\\u003Ccstdio\\u003E\\n\\ninline int min(int x,int y){return x\\u003Cy?x:y;}\\n\\nint n,ans=2147483647;\\n\\nint main(){\\n\\tscanf(\\u0022%d\\u0022,\\u0026n);\\n\\tfor(int i=1;i\\u003C=3;i++){\\n\\t\\tint a,b;\\n\\t\\tscanf(\\u0022%d%d\\u0022,\\u0026a,\\u0026b);\\n\\t\\tans=min(ans,b*((n+a-1)\\/a));\\n\\t}\\n\\tprintf(\\u0022%d\\\\n\\u0022,ans);\\n}\\n```\\n\\n### \\u539f\\u7406\\uff1a\\n\\n\\u5176\\u5b9e\\u5f88\\u5bb9\\u6613\\u7406\\u89e3\\u5566\\uff0c\\u5982\\u679c $n$ \\u662f\\u8981\\u4e70\\u7684\\u94c5\\u7b14\\u603b\\u6570\\uff0c$a$ \\u662f\\u5f53\\u524d\\u8fd9\\u79cd\\u94c5\\u7b14\\u6bcf\\u4e00\\u76d2\\u7684\\u6839\\u6570\\uff0c $(n+a-1)\\/a$ \\u5c31\\u8868\\u793a\\u5982\\u679c\\u4e70\\u8fd9\\u79cd\\u94c5\\u7b14\\uff0c\\u81f3\\u5c11\\u8981\\u4e70\\u7684\\u76d2\\u6570\\uff08~~\\u4f17\\u6240\\u5468\\u77e5~~\\uff09\\n\\n\\u56e0\\u4e3a\\u60a8\\u60f3\\u4e00\\u60f3\\uff0c\\u5982\\u679c $n$ \\u6b63\\u597d\\u662f $a$ \\u7684\\u500d\\u6570\\uff0c\\u52a0\\u4e0a $a-1$ \\u540e\\u518d\\u6574\\u9664 $a$ \\uff0c\\u7ed3\\u679c\\u4e0d\\u53d8\\u3002\\n\\n\\u5982\\u679c\\u4e0d\\u662f\\u500d\\u6570\\uff0c\\u52a0\\u4e0a $a-1$ \\u540e\\u518d\\u6574\\u9664 $a$ \\uff0c\\u5c31\\u6bd4\\u76f4\\u63a5\\u6574\\u9664\\u7684\\u7ed3\\u679c\\u5927 $1$ \\uff0c\\u5373\\u5411\\u4e0a\\u53d6\\u6574\\u3002\\u800c\\u6211\\u4eec\\u5c31\\u662f\\u9700\\u8981\\u6c42\\u8fd9\\u79cd\\u5411\\u4e0a\\u53d6\\u6574\\u7684\\u7ed3\\u679c\\u3002\\n\\n\\u8fd9\\u4e2a\\u5176\\u5b9e\\u53ef\\u4ee5\\u7528 $ceil(n * 1.0\\/a)$ \\u66ff\\u4ee3\\uff0c\\u5f88\\u591a\\u9898\\u89e3\\u90fd\\u662f\\u8fd9\\u6837\\u5199\\u7684qvq\\uff0c\\u4f46\\u662f\\u6ce8\\u610f\\u4e00\\u5b9a\\u8981\\u4e58\\u4e0a $1.0$\\n\\n### \\u5982\\u679c\\u4f60\\u662f\\u65b0\\u624b\\u8bf7\\u7559\\u610f\\uff1a\\n\\n* ```inline int min(int x,int y){return x\\u003Cy?x:y;}``` \\u662f\\u81ea\\u5df1\\u5199\\u7684min\\u51fd\\u6570\\uff0c\\u5f53\\u7136\\u60a8\\u53ef\\u4ee5\\u8c03\\u7528algorithm\\u4e2d\\u7684\\n\\n* 2147483647:\\u662fint\\u8303\\u56f4\\u5185\\u7684\\u6700\\u5927\\u503c\\n\\n### P.S.\\n\\n\\u4e4b\\u524d\\u56e0\\u4e3a\\u8f93\\u5165\\u6cd5\\u574f\\u4e86\\uff0c\\u6253\\u4e0d\\u4e86\\u4e2d\\u6587\\uff0c\\u4e0d\\u597d\\u610f\\u601d\\u53d1\\u9898\\u89e3\\uff0c\\u5c31\\u628a\\u4ee3\\u7801\\u653e\\u5728\\u8ba8\\u8bba\\u533a\\u91cc\\uff0c\\u7ed3\\u679c......\\n\\n![](https:\\/\\/cdn.luogu.com.cn\\/upload\\/image_hosting\\/znumidfw.png)\\n\\n\\n~~\\u5728\\u8ba8\\u8bba\\u533a\\u53d1\\u9898\\u89e3\\u7684\\u4e8b\\u518d\\u4e5f\\u4e0d\\u4f1a\\u5e72\\u4e86\\u5440\\uff0c\\u6211\\u77e5\\u9053\\u9519\\u4e86qvq~~\\n\\n~~\\u6240\\u4ee5\\u6211\\u662f\\u7b2c\\u4e00\\u4e2a\\u201c\\u590d\\u6d3b\\u5e01\\u201d\\u4f7f\\u7528\\u8005qvq~~\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795659237.575393}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/v5aspqez\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1909 \\u3010\\u4e70\\u94c5\\u7b14\\u3011\\uff08\\u4e3a\\u4ec0\\u4e48\\u4e0d\\u80fd\\u63d0\\u4ea4\\u5462\\uff09\",\"description\":\"\\u5373\\u4f7f\\u4e0d\\u7528ceil\\uff0c\\u4e5f\\u53ef\\u4ee5\\u8f7b\\u677e\\u4f7f\\u7528800kb\\u7684\\u4ee3\\u7801\\n#include&lt;cstdio&gt;\\n\\ninline int min(int x,int y){return x&lt;y?x:y;}\\n\\nint n,ans=2147483647;\\u2026\",\"genre\":\"\\u4e2a\\u4eba\\u8bb0\\u5f55\",\"author\":{\"@type\":\"Person\",\"name\":\"Y15BeTa\"},\"datePublished\":\"2019-10-23T18:54:36+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1909 【买铅笔】（为什么不能提交呢）\" />\n    <meta property=\"og:description\" content=\"即使不用ceil，也可以轻松使用800kb的代码\n#include&amp;lt;cstdio&amp;gt;\n\ninline int min(int x,int y){return x&amp;lt;y?x:y;}\n\nint n,ans=2147483647;…\" />\n    <meta property=\"article:section\" content=\"个人记录\" />\n    <meta property=\"article:author\" content=\"Y15BeTa\" />\n    <meta property=\"article:published_time\" content=\"2019-10-23T18:54:36+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/v5aspqez\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1909 【买铅笔】（为什么不能提交呢）</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">Y15BeTa</a>\n            ·\n            <time datetime=\"2019-10-23T18:54:36+08:00\">2019-10-23 18:54:36</time>\n            ·\n            <a href=\"/article?category=1\">个人记录</a>\n        </p>\n\n        <h1>即使不用ceil，也可以轻松使用800kb的代码</h1>\n<pre><code>#include&lt;cstdio&gt;\n\ninline int min(int x,int y){return x&lt;y?x:y;}\n\nint n,ans=2147483647;\n\nint main(){\n    scanf(\"%d\",&amp;n);\n    for(int i=1;i&lt;=3;i++){\n        int a,b;\n        scanf(\"%d%d\",&amp;a,&amp;b);\n        ans=min(ans,b*((n+a-1)/a));\n    }\n    printf(\"%d\\n\",ans);\n}</code></pre>\n<h3>原理：</h3>\n<p>其实很容易理解啦，如果 <la-tex display=\"inline\">n</la-tex> 是要买的铅笔总数，<la-tex display=\"inline\">a</la-tex> 是当前这种铅笔每一盒的根数， <la-tex display=\"inline\">(n+a-1)/a</la-tex> 就表示如果买这种铅笔，至少要买的盒数（<del>众所周知</del>）</p>\n<p>因为您想一想，如果 <la-tex display=\"inline\">n</la-tex> 正好是 <la-tex display=\"inline\">a</la-tex> 的倍数，加上 <la-tex display=\"inline\">a-1</la-tex> 后再整除 <la-tex display=\"inline\">a</la-tex> ，结果不变。</p>\n<p>如果不是倍数，加上 <la-tex display=\"inline\">a-1</la-tex> 后再整除 <la-tex display=\"inline\">a</la-tex> ，就比直接整除的结果大 <la-tex display=\"inline\">1</la-tex> ，即向上取整。而我们就是需要求这种向上取整的结果。</p>\n<p>这个其实可以用 <la-tex display=\"inline\">ceil(n * 1.0/a)</la-tex> 替代，很多题解都是这样写的qvq，但是注意一定要乘上 <la-tex display=\"inline\">1.0</la-tex></p>\n<h3>如果你是新手请留意：</h3>\n<ul>\n<li>\n<p><code>inline int min(int x,int y){return x&lt;y?x:y;}</code> 是自己写的min函数，当然您可以调用algorithm中的</p>\n</li>\n<li>\n<p>2147483647:是int范围内的最大值</p>\n</li>\n</ul>\n<h3>P.S.</h3>\n<p>之前因为输入法坏了，打不了中文，不好意思发题解，就把代码放在讨论区里，结果......</p>\n<p></p>\n<p><del>在讨论区发题解的事再也不会干了呀，我知道错了qvq</del></p>\n<p><del>所以我是第一个“复活币”使用者qvq</del></p>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6056079cd529ab6',t:'MTc5NTY1OTIzNw=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6056079cd529ab6',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
