  "#include<cstdio>\n\ninline int min(int x,int y){return x<y?x:y;}\n\nint n,ans=2147483647;\n\nint main(){\n    scanf(\"%d\",&n);\n    for(int i=1;i<=3;i++){\n        int a,b;\n        scanf(\"%d%d\",&a,&b);\n        ans=min(ans,b*((n+a-1)/a));\n    }\n    printf(\"%d\\n\",ans);\n}"
