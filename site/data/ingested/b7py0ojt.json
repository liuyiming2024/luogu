 "code_blocks": [
  "#include <iostream>\nusing namespace std;\nint main()\n{\n    int n;\n    int a[101];\n    int b[10001]={0}; //标记两数之和 \n\n    cin>>n;\n    for(int i=0;i<n;i++)\n        cin>>a[i];\n\n    for(int i=0;i<n-1;i++)\n        for(int j=i+1;j<n;j++)\n            if(a[i]+a[j]<=10000)b[a[i]+a[j]]=1;\n\n    int count=0;\n    for(int i=0;i<n;i++)\n        if(b[a[i]]==1)count++;\n\n    cout<<count;\n\n    return 0;\n}"
 ],
