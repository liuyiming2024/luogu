\\u76f8\\u52a0\\u6c42\\u548c\\uff0c\\u518d\\u5c06\\u8fd9\\u4e2a\\u548c\\u6253\\u4e0a\\u6807\\u8bb0\\uff1b\\n\\u2461\\u626b\\u63cf\\u6240\\u6709\\u96c6\\u5408\\u4e2d\\u7684\\u6570\\uff0c\\u7edf\\u8ba1\\u6240\\u6709\\u88ab\\u6253\\u4e0a\\u6807\\u8bb0\\u7684\\u6570\\u7684\\u6570\\u91cf\\u3002\\n\\n```cpp\\n#include \\u003Ciostream\\u003E\\nusing namespace std;\\nint main()\\n{\\n\\tint n;\\n\\tint a[101];\\n\\tint b[10001]={0}; \\/\\/\\u6807\\u8bb0\\u4e24\\u6570\\u4e4b\\u548c \\n\\t\\n\\tcin\\u003E\\u003En;\\n\\tfor(int i=0;i\\u003Cn;i++)\\n\\t\\tcin\\u003E\\u003Ea[i];\\n\\t\\n\\tfor(int i=0;i\\u003Cn-1;i++)\\n\\t\\tfor(int j=i+1;j\\u003Cn;j++)\\n\\t\\t\\tif(a[i]+a[j]\\u003C=10000)b[a[i]+a[j]]=1;\\n\\t\\n\\tint count=0;\\n\\tfor(int i=0;i\\u003Cn;i++)\\n\\t\\tif(b[a[i]]==1)count++;\\n\\t\\n\\tcout\\u003C\\u003Ccount;\\n\\t\\n\\treturn 0;\\n}\\n\\n\\n```\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795659247.333969}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/b7py0ojt\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P2141 \\u3010\\u73e0\\u5fc3\\u7b97\\u6d4b\\u9a8c\\u3011\",\"description\":\"\\u5386\\u5e74\\u666e\\u53ca\\u7ec4\\u7b2c\\u4e00\\u9898\\u603b\\u662f\\u5f88\\u6c34\\uff0c\\u4f46\\u4eca\\u5e74\\u7684\\u8fd9\\u4e00\\u9898\\u7684\\u9898\\u610f\\u5f88\\u591a\\u4eba\\u7406\\u89e3\\u9519\\u8bef\\uff0c\\u5bfc\\u81f4\\u5f88\\u591a\\u540c\\u5b66\\u90fd\\u53ea\\u5f97\\u4e8630 \\u5206\\u3002\\u4ed6\\u4eec\\u9519\\u628a\\u628a\\u9898\\u610f\\u7406\\u89e3\\u4e3a\\uff1a\\u6c42\\u6709\\u591a\\u5c11\\u5bf9\\u6570\\u7684\\u548c\\u6b63\\u597d\\u662f\\u96c6\\u5408\\u4e2d\\u7684\\u53e6\\u4e00\\u4e2a\\u6570\\u3002\\u5982\\uff0c\\u5bf9\\u4e8e\\u96c6\\u5408{1,2,3,4,5}\\uff0c\\u9898\\u76ee\\u8981\\u6c42\\u7684\\u662f3=1+2, 4=2+2=1+3, 5=1+4=2+3\\uff0c\\u51713\\u4e2a\\u6570\\uff0e\\uff1b\\u800c\\u6309\\u7167\\u9519\\u8bef\\u7684\\u7406\\u89e3\\uff0c\\u6c42\\u7684\\u4fbf\\u662f1+2=3,\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"King_of_DarkWorld\"},\"datePublished\":\"2018-10-26T22:06:20+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P2141 【珠心算测验】\" />\n    <meta property=\"og:description\" content=\"历年普及组第一题总是很水，但今年的这一题的题意很多人理解错误，导致很多同学都只得了30 分。他们错把把题意理解为：求有多少对数的和正好是集合中的另一个数。如，对于集合{1,2,3,4,5}，题目要求的是3=1+2, 4=2+2=1+3, 5=1+4=2+3，共3个数．；而按照错误的理解，求的便是1+2=3,…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"King_of_DarkWorld\" />\n    <meta property=\"article:published_time\" content=\"2018-10-26T22:06:20+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/b7py0ojt\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P2141 【珠心算测验】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">King_of_DarkWorld</a>\n            ·\n            <time datetime=\"2018-10-26T22:06:20+08:00\">2018-10-26 22:06:20</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>历年普及组第一题总是很水，但今年的这一题的题意很多人理解错误，导致很多同学都只得了30 分。他们错把把题意理解为：求有多少对数的和正好是集合中的另一个数。如，对于集合{1,2,3,4,5}，题目要求的是3=1+2, 4=2+2=1+3, 5=1+4=2+3，共3个数．；而按照错误的理解，求的便是1+2=3, 1+3=4,1+4=5, 2+3=5，共4对数。所以读题就显得多么重要！\n明确了题意，接下来设计算法。注意到“测验题给出的正整数大小不超过10^4”这个条件，我们可以采用模拟的办法。具体算法如下：\n①将每两个不同的数穷举相加求和，再将这个和打上标记；\n②扫描所有集合中的数，统计所有被打上标记的数的数量。</p>\n<pre><code class=\"language-cpp\">#include &lt;iostream&gt;\nusing namespace std;\nint main()\n{\n    int n;\n    int a[101];\n    int b[10001]={0}; //标记两数之和 \n\n    cin&gt;&gt;n;\n    for(int i=0;i&lt;n;i++)\n        cin&gt;&gt;a[i];\n\n    for(int i=0;i&lt;n-1;i++)\n        for(int j=i+1;j&lt;n;j++)\n            if(a[i]+a[j]&lt;=10000)b[a[i]+a[j]]=1;\n\n    int count=0;\n    for(int i=0;i&lt;n;i++)\n        if(b[a[i]]==1)count++;\n\n    cout&lt;&lt;count;\n\n    return 0;\n}\n\n</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a60560b68a8c446c',t:'MTc5NTY1OTI0Nw=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a60560b68a8c446c',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
