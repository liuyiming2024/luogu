 "is_article": "是",
 "code_blocks": [
  "//LG-P1328\n//生活大爆炸版剪刀石头布 \n#include<iostream>\nusing namespace std;\nint main()\n{\n    int score[5][5];\n    score[0][0]=0;\n    score[0][1]=-1;\n    score[0][2]=1;\n    score[0][3]=1;\n    score[0][4]=-1;\n    score[1][0]=1;\n    score[1][1]=0;\n    score[1][2]=-1;\n    score[1][3]=1;\n    score[1][4]=-1;\n    score[2][0]=-1;\n    score[2][1]=1;\n    score[2][2]=0;\n    score[2][3]=-1;\n    score[2][4]=1;\n    score[3][0]=-1;\n    score[3][1]=-1;\n    score[3][2]=1;\n    score[3][3]=0;\n    score[3][4]=1;\n    score[4][0]=1;\n    score[4][1]=1;\n    score[4][2]=-1;\n    score[4][3]=-1;\n    score[4][4]=0;\n/*到这里都是打表内容；\nscore[a][b]是表，里面的数字含义与题目相同；\n后面（=x）的内容如下：\nx=1：小A胜，\nx=0：平局，\nx=-1：小B胜。*/\n    int n,m,k;\n    int ans=0;\n    int bns=0;\n    cin>>n>>m>>k;\n    int a[m+1],b[k+1];\n    //—————————————\n    for(int i=1;i<=m;i++)\n    {\n        cin>>a[i];\n    }\n    for(int i=1;i<=k;i++)\n    {\n        cin>>b[i];\n    }\n//以上是在输入二人的出拳循环\n    int anum=1;//小A的出拳指针\n    int bnum=1;//小B的出拳指针\n    for(int i=1;i<=n;i++)\n    {\n        if(score[a[anum]][b[bnum]]==1)\n        {\n            ans++;\n        }//小A胜\n        else if(score[a[anum]][b[bnum]]==-1)\n        {\n            bns++;\n        }//小B胜\n        anum++;//指针右移\n        bnum++;//指针右移\n        if(anum>m)\n        {\n            anum=1;\n        }//超出循环，从头开始\n        if(bnum>k)\n        {\n            bnum=1;\n        }//超出循环，从头开始\n    }\n    cout<<ans<<\" \"<<bns;//输出结果\n    return 0;\n}```"
