ore[2][4]=1;\\n\\tscore[3][0]=-1;\\n\\tscore[3][1]=-1;\\n\\tscore[3][2]=1;\\n\\tscore[3][3]=0;\\n\\tscore[3][4]=1;\\n\\tscore[4][0]=1;\\n\\tscore[4][1]=1;\\n\\tscore[4][2]=-1;\\n\\tscore[4][3]=-1;\\n\\tscore[4][4]=0;\\n\\/*\\u5230\\u8fd9\\u91cc\\u90fd\\u662f\\u6253\\u8868\\u5185\\u5bb9\\uff1b\\nscore[a][b]\\u662f\\u8868\\uff0c\\u91cc\\u9762\\u7684\\u6570\\u5b57\\u542b\\u4e49\\u4e0e\\u9898\\u76ee\\u76f8\\u540c\\uff1b\\n\\u540e\\u9762\\uff08=x\\uff09\\u7684\\u5185\\u5bb9\\u5982\\u4e0b\\uff1a\\nx=1\\uff1a\\u5c0fA\\u80dc\\uff0c\\nx=0\\uff1a\\u5e73\\u5c40\\uff0c\\nx=-1\\uff1a\\u5c0fB\\u80dc\\u3002*\\/\\n\\tint n,m,k;\\n\\tint ans=0;\\n\\tint bns=0;\\n\\tcin\\u003E\\u003En\\u003E\\u003Em\\u003E\\u003Ek;\\n\\tint a[m+1],b[k+1];\\n\\t\\/\\/\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\n\\tfor(int i=1;i\\u003C=m;i++)\\n\\t{\\n\\t\\tcin\\u003E\\u003Ea[i];\\n\\t}\\n\\tfor(int i=1;i\\u003C=k;i++)\\n\\t{\\n\\t\\tcin\\u003E\\u003Eb[i];\\n\\t}\\n\\/\\/\\u4ee5\\u4e0a\\u662f\\u5728\\u8f93\\u5165\\u4e8c\\u4eba\\u7684\\u51fa\\u62f3\\u5faa\\u73af\\n\\tint anum=1;\\/\\/\\u5c0fA\\u7684\\u51fa\\u62f3\\u6307\\u9488\\n\\tint bnum=1;\\/\\/\\u5c0fB\\u7684\\u51fa\\u62f3\\u6307\\u9488\\n\\tfor(int i=1;i\\u003C=n;i++)\\n\\t{\\n\\t\\tif(score[a[anum]][b[bnum]]==1)\\n\\t\\t{\\n\\t\\t\\tans++;\\n\\t\\t}\\/\\/\\u5c0fA\\u80dc\\n\\t\\telse if(score[a[anum]][b[bnum]]==-1)\\n\\t\\t{\\n\\t\\t\\tbns++;\\n\\t\\t}\\/\\/\\u5c0fB\\u80dc\\n\\t\\tanum++;\\/\\/\\u6307\\u9488\\u53f3\\u79fb\\n\\t\\tbnum++;\\/\\/\\u6307\\u9488\\u53f3\\u79fb\\n\\t\\tif(anum\\u003Em)\\n\\t\\t{\\n\\t\\t\\tanum=1;\\n\\t\\t}\\/\\/\\u8d85\\u51fa\\u5faa\\u73af\\uff0c\\u4ece\\u5934\\u5f00\\u59cb\\n\\t\\tif(bnum\\u003Ek)\\n\\t\\t{\\n\\t\\t\\tbnum=1;\\n\\t\\t}\\/\\/\\u8d85\\u51fa\\u5faa\\u73af\\uff0c\\u4ece\\u5934\\u5f00\\u59cb\\n\\t}\\n\\tcout\\u003C\\u003Cans\\u003C\\u003C\\u0022 \\u0022\\u003C\\u003Cbns;\\/\\/\\u8f93\\u51fa\\u7ed3\\u679c\\n\\treturn 0;\\n}```\\n\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795629572.411838}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/a8f6uiq9\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1328 \\u3010\\u751f\\u6d3b\\u5927\\u7206\\u70b8\\u7248\\u77f3\\u5934\\u526a\\u5200\\u5e03\\u3011\",\"description\":\"\\u8fa3\\u83ab\\u591a\\u90a3\\u4e48\\u591a\\u4eba\\u7528if\\uff0c\\u770b\\u7684\\u8001\\u592b\\u5fc3\\u7d2f\\u554a\\u2026\\u2026\\u6211\\u8fd9\\u91cc\\u4f7f\\u7528\\u4e86\\u4e8c\\u7ef4\\u6570\\u7ec4\\uff0c\\u5236\\u4f5c\\u4e86\\u4e00\\u5f20\\u7ed3\\u679c\\u8868\\u3002\\u867d\\u7136\\u4e0eif\\u5dee\\u7684\\u4e0d\\u592a\\u591a\\u3002\\u4f46\\u8981\\u7a0d\\u7a0d\\u5feb\\u4e00\\u4e9b\\uff0c\\u4e5f\\u66f4\\u7b80\\u5355\\u660e\\u4e86\\u3002\\u8868\\u7684\\u5185\\u5bb9\\u4e0e\\u9898\\u76ee\\u91cc\\u7684\\u90a3\\u5f20\\u8868\\u4e00\\u6837\\uff0c\\u4f46\\u662f\\u8981\\u6839\\u636e\\u63a8\\u7406\\u8865\\u5168\\u539f\\u8868\\u4e2d\\u9ed1\\u7684\\u90e8\\u5206\\u3002\\n\\u624b\\u52a8\\u6253\\u8868\\u65f6\\u4e00\\u5b9a\\u8981\\u7ec6\\u5fc3\\uff01\\n\\u5e9f\\u8bdd\\u4e0d\\u591a\\u8bf4\\uff0c\\u4e0a\\u7a0b\\u5e8f\\uff1a\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"HRQ666\"},\"datePublished\":\"2018-03-24T23:32:17+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1328 【生活大爆炸版石头剪刀布】\" />\n    <meta property=\"og:description\" content=\"辣莫多那么多人用if，看的老夫心累啊……我这里使用了二维数组，制作了一张结果表。虽然与if差的不太多。但要稍稍快一些，也更简单明了。表的内容与题目里的那张表一样，但是要根据推理补全原表中黑的部分。\n手动打表时一定要细心！\n废话不多说，上程序：…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"HRQ666\" />\n    <meta property=\"article:published_time\" content=\"2018-03-24T23:32:17+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/a8f6uiq9\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1328 【生活大爆炸版石头剪刀布】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">HRQ666</a>\n            ·\n            <time datetime=\"2018-03-24T23:32:17+08:00\">2018-03-24 23:32:17</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p><del>辣莫多</del>那么多人用if，看的老夫心累啊……我这里使用了二维数组，制作了一张结果表。虽然与if差的不太多。但要稍稍快一些，也更简单明了。表的内容与题目里的那张表一样，但是要根据推理补全原表中黑的部分。</p>\n<h1>手动打表时一定要细心！</h1>\n<p>废话不多说，上程序：</p>\n<pre><code class=\"language-cpp\">\n//LG-P1328\n//生活大爆炸版剪刀石头布 \n#include&lt;iostream&gt;\nusing namespace std;\nint main()\n{\n    int score[5][5];\n    score[0][0]=0;\n    score[0][1]=-1;\n    score[0][2]=1;\n    score[0][3]=1;\n    score[0][4]=-1;\n    score[1][0]=1;\n    score[1][1]=0;\n    score[1][2]=-1;\n    score[1][3]=1;\n    score[1][4]=-1;\n    score[2][0]=-1;\n    score[2][1]=1;\n    score[2][2]=0;\n    score[2][3]=-1;\n    score[2][4]=1;\n    score[3][0]=-1;\n    score[3][1]=-1;\n    score[3][2]=1;\n    score[3][3]=0;\n    score[3][4]=1;\n    score[4][0]=1;\n    score[4][1]=1;\n    score[4][2]=-1;\n    score[4][3]=-1;\n    score[4][4]=0;\n/*到这里都是打表内容；\nscore[a][b]是表，里面的数字含义与题目相同；\n后面（=x）的内容如下：\nx=1：小A胜，\nx=0：平局，\nx=-1：小B胜。*/\n    int n,m,k;\n    int ans=0;\n    int bns=0;\n    cin&gt;&gt;n&gt;&gt;m&gt;&gt;k;\n    int a[m+1],b[k+1];\n    //—————————————\n    for(int i=1;i&lt;=m;i++)\n    {\n        cin&gt;&gt;a[i];\n    }\n    for(int i=1;i&lt;=k;i++)\n    {\n        cin&gt;&gt;b[i];\n    }\n//以上是在输入二人的出拳循环\n    int anum=1;//小A的出拳指针\n    int bnum=1;//小B的出拳指针\n    for(int i=1;i&lt;=n;i++)\n    {\n        if(score[a[anum]][b[bnum]]==1)\n        {\n            ans++;\n        }//小A胜\n        else if(score[a[anum]][b[bnum]]==-1)\n        {\n            bns++;\n        }//小B胜\n        anum++;//指针右移\n        bnum++;//指针右移\n        if(anum&gt;m)\n        {\n            anum=1;\n        }//超出循环，从头开始\n        if(bnum&gt;k)\n        {\n            bnum=1;\n        }//超出循环，从头开始\n    }\n    cout&lt;&lt;ans&lt;&lt;\" \"&lt;&lt;bns;//输出结果\n    return 0;\n}```</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6028c3a9ad5f963',t:'MTc5NTYyOTU3Mg=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6028c3a9ad5f963',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
