 "code_blocks": [
  "#include<bits/stdc++.h>\nusing namespace std;\nstring dan,ci,s;\nint cur=-1,ans;\nint main()\n{\n    cin>>ci;\n    for(int i=0;i<ci.size();++i)ci[i]=tolower(ci[i]);\n    getchar();\n    getline(cin,s);\n    s+=' ';//这行很重要，关系着最后一个单词会不会扫描到\n    for(int i=0;i<s.size();++i)s[i]=tolower(s[i]);\n    for(int i=0;i<s.size();++i)\n    {\n        if(s[i]==' '){\n            if(dan==ci){\n                ans++;\n                if(cur==-1)cur=i-ci.size();\n            }\n            dan=\"\";\n        }\n        else dan+=s[i];\n    }\n    if(ans==0)printf(\"-1\");\n    else printf(\"%d %d\",ans,cur);\n    return 0;\n}"
 ],
