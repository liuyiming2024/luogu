.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解：P1706 全排列问题</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">Suwenluo</a>\n            ·\n            <time datetime=\"2025-04-02T21:10:42+08:00\">2025-04-02 21:10:42</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <pre><code class=\"language-cpp\">#include &lt;bits/stdc++.h&gt;\nusing namespace std;\nint arr[15]; //答案数组。\nint vis[15]; //标记数组。\nint n; //数字数量。\nvoid dfs(int k){ //搜到 arr 数组的第 k 个空位。\n    if (k&gt;n){ //如果搜完了。\n        for (int i=1;i&lt;=n;i++){\n            cout &lt;&lt; setw(5) &lt;&lt; arr[i]; //注意保留5个场宽。\n        }puts(\"\"); //换行。\n        return; //函数不 return，爆零两行泪。\n    }\n    for (int i=1;i&lt;=n;i++){ //枚举从1到n的每个数字。\n        if (vis[i]!=1){ //如果没用过。\n            arr[k]=i; //填充全排列数组。\n            vis[i]=1; //打标记。\n            dfs(k+1); //搜下一个空位。\n            vis[i]=0; //擦标记。\n        }\n    }\n}\nint main(){\n    scanf(\"%d\",&amp;n);\n    dfs(1); //从第一个位置开始搜。\n    return 0; //好习惯。\n}</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a605602e3a88e3ae',t:'MTc5NTY1OTIyNQ=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a605602e3a88e3ae'