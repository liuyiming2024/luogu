 "code_blocks": [
  "#include <bits/stdc++.h>\nusing namespace std;\nint arr[15]; //答案数组。\nint vis[15]; //标记数组。\nint n; //数字数量。\nvoid dfs(int k){ //搜到 arr 数组的第 k 个空位。\n    if (k>n){ //如果搜完了。\n        for (int i=1;i<=n;i++){\n            cout << setw(5) << arr[i]; //注意保留5个场宽。\n        }puts(\"\"); //换行。\n        return; //函数不 return，爆零两行泪。\n    }\n    for (int i=1;i<=n;i++){ //枚举从1到n的每个数字。\n        if (vis[i]!=1){ //如果没用过。\n            arr[k]=i; //填充全排列数组。\n            vis[i]=1; //打标记。\n            dfs(k+1); //搜下一个空位。\n            vis[i]=0; //擦标记。\n        }\n    }\n}\nint main(){\n    scanf(\"%d\",&n);\n    dfs(1); //从第一个位置开始搜。\n    return 0; //好习惯。\n}"
 ],
