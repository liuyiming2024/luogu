 "code_blocks": [
  "#include<bits/stdc++.h>\nusing namespace std;\nint n;\nvector<int>p;\n//以上是变量定义的部分，n用来存筷子的数量，p是一个vector类型，也就是不定长数组，用来存储筷子的长度。\nint main()\n{\n    scanf(\"%d\",&n);\n    //率先读入n。\n    p.resize(n+1);\n    //这句语句的意思是给不定长数组vector类型的p分派n+1个空间（下标是0~n），vector的好处就在这里了，我们可以在程序的任意地方释放空间(.clear())，也可以在任意地方分配空间（.resize()）。。这个stl很好用。\n    for(int i=1;i<=n;i++)\n    scanf(\"%d\",&p[i]);\n    //读入筷子长度\n    for(int i=2;i<=n;i++)\n    p[i]=p[i]^p[i-1];\n    //逐个异或。\n    printf(\"%d\",p[n]);\n    //最后的p[n]就是最终答案。\n    return 0;\n}//本算法时间复杂度O(n),空间复杂度O(n)."
 ],
 "sha256": "65cb836e0c530622",
 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <meta name=\"csrf-token\" content=\"1795716017:AmmWMtqZNpSfR8+5RwRxrXQSkO6vWgS7ztlV4aA22Eg=\">\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112601'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>题解 P1469 【找筷子】 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"iv10492z\",\"title\":\"\\u9898\\u89e3 P1469 \\u3010\\u627e\\u7b77\\u5b50\\u3011\",\"category\":2,\"time\":1505709696,\"author\":{\"uid\":24081,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/24081.png\",\"name\":\"Hydra_\",\"slogan\":\"\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Blue\",\"ccfLevel\":0,\"xcpcLevel\":0,\"background\":\"\"},\"upvote\":0,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1469\",\"type\":\"P\",\"name\":\"\\u627e\\u7b77\\u5b50\",\"difficulty\":2,\"fullScore\":100},\"promoteStatus\":3,\"collection\":null,\"content\":\"## \\u3010\\u77e5\\u8bc6\\u63d2\\u5165\\u3011\\u5f02\\u6216 ##\\n\\n\\u5f02\\u6216\\u662f\\u5bf9\\u4e8c\\u8fdb\\u5236\\u4f4d\\u8fdb\\u884c\\u7684\\u64cd\\u4f5c\\u3002\\u5f02\\u6216\\u7684\\u57fa\\u672c\\u53e3\\u8bc0\\u5c31\\u662f\\u201c\\u76f8\\u540c\\u5f97\\u5047\\uff0c\\u4e0d\\u540c\\u5f97\\u771f\\u201d\\uff0c\\u4e5f\\u5c31\\u662f0^1=1^0=1;1^1=0^0=0\\uff1b\\n\\n\\u6211\\u4eec\\u8fd8\\u53ef\\u4ee5\\u5f97\\u51fa\\u4e00\\u4e2a**\\u89c4\\u5f8b**\\uff1a0\\u548c1\\u5f02\\u62160\\u90fd\\u4e0d\\u53d8\\uff0c\\u5f02\\u62161\\u5219\\u53d6\\u53cd\\u3002\\n\\n\\u8fdb\\u4e00\\u6b65\\uff0c\\u6211\\u4eec\\u53ef\\u4ee5\\u5f97\\u51fa\\u8fd9\\u6837\\u7684\\u7ed3\\u8bba\\uff1a\\u5bf9\\u4e8e\\u4efb\\u4f55\\u4e00\\u4e2a\\u6570A\\uff0c\\u90fd\\u5b58\\u5728A^A=0\\uff0cA^0=A\\u3002\\n\\n## \\u5206\\u6790 ##\\n\\n\\u8fd9\\u9053\\u9898\\u76ee\\u76f4\\u5230\\u5f02\\u6216\\u4e4b\\u540e\\u5c31\\u5f88\\u597d\\u505a\\u4e86\\u3002\\u76f8\\u540c\\u7684\\u7b77\\u5b50\\u957f\\u5ea6\\u5f02\\u6216\\u4e00\\u4e0b\\u80af\\u5b9a\\u662f0\\uff0c\\u56e0\\u6b64\\u6240\\u6709\\u7684\\u6210\\u5bf9\\u7b77\\u5b50\\u957f\\u5ea6\\u5f02\\u6216\\u8d77\\u6765\\u80af\\u5b9a\\u662f0,\\u518d\\u548c\\u90a3\\u4e2a\\u5355\\u72ec\\u7684\\u7b77\\u5b50\\u5f02\\u6216\\u4e00\\u4e0b\\uff0c\\u5c31\\u662f\\u90a3\\u4e2a\\u5355\\u72ec\\u7b77\\u5b50\\u7684\\u957f\\u5ea6\\u4e86\\u3002\\u6240\\u4ee5\\u2026\\u2026\\u4e0a\\u4ee3\\u7801\\uff1a\\n\\n## \\u4ee3\\u7801 ##\\n\\n\\n```cpp\\n#include\\u003Cbits\\/stdc++.h\\u003E\\nusing namespace std;\\nint n;\\nvector\\u003Cint\\u003Ep;\\n\\/\\/\\u4ee5\\u4e0a\\u662f\\u53d8\\u91cf\\u5b9a\\u4e49\\u7684\\u90e8\\u5206\\uff0cn\\u7528\\u6765\\u5b58\\u7b77\\u5b50\\u7684\\u6570\\u91cf\\uff0cp\\u662f\\u4e00\\u4e2avector\\u7c7b\\u578b\\uff0c\\u4e5f\\u5c31\\u662f\\u4e0d\\u5b9a\\u957f\\u6570\\u7ec4\\uff0c\\u7528\\u6765\\u5b58\\u50a8\\u7b77\\u5b50\\u7684\\u957f\\u5ea6\\u3002\\nint main()\\n{\\n    scanf(\\u0022%d\\u0022,\\u0026n);\\n    \\/\\/\\u7387\\u5148\\u8bfb\\u5165n\\u3002\\n    p.resize(n+1);\\n    \\/\\/\\u8fd9\\u53e5\\u8bed\\u53e5\\u7684\\u610f\\u601d\\u662f\\u7ed9\\u4e0d\\u5b9a\\u957f\\u6570\\u7ec4vector\\u7c7b\\u578b\\u7684p\\u5206\\u6d3en+1\\u4e2a\\u7a7a\\u95f4\\uff08\\u4e0b\\u6807\\u662f0~n\\uff09\\uff0cvector\\u7684\\u597d\\u5904\\u5c31\\u5728\\u8fd9\\u91cc\\u4e86\\uff0c\\u6211\\u4eec\\u53ef\\u4ee5\\u5728\\u7a0b\\u5e8f\\u7684\\u4efb\\u610f\\u5730\\u65b9\\u91ca\\u653e\\u7a7a\\u95f4(.clear())\\uff0c\\u4e5f\\u53ef\\u4ee5\\u5728\\u4efb\\u610f\\u5730\\u65b9\\u5206\\u914d\\u7a7a\\u95f4\\uff08.resize()\\uff09\\u3002\\u3002\\u8fd9\\u4e2astl\\u5f88\\u597d\\u7528\\u3002\\n    for(int i=1;i\\u003C=n;i++)\\n    scanf(\\u0022%d\\u0022,\\u0026p[i]);\\n    \\/\\/\\u8bfb\\u5165\\u7b77\\u5b50\\u957f\\u5ea6\\n    for(int i=2;i\\u003C=n;i++)\\n    p[i]=p[i]^p[i-1];\\n    \\/\\/\\u9010\\u4e2a\\u5f02\\u6216\\u3002\\n    printf(\\u0022%d\\u0022,p[n]);\\n    \\/\\/\\u6700\\u540e\\u7684p[n]\\u5c31\\u662f\\u6700\\u7ec8\\u7b54\\u6848\\u3002\\n    return 0;\\n}\\/\\/\\u672c\\u7b97\\u6cd5\\u65f6\\u95f4\\u590d\\u6742\\u5ea6O(n),\\u7a7a\\u95f4\\u590d\\u6742\\u5ea6O(n).\\n```\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795629617.878396}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/iv10492z\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1469 \\u3010\\u627e\\u7b77\\u5b50\\u3011\",\"description\":\"\\u3010\\u77e5\\u8bc6\\u63d2\\u5165\\u3011\\u5f02\\u6216\\n\\u5f02\\u6216\\u662f\\u5bf9\\u4e8c\\u8fdb\\u5236\\u4f4d\\u8fdb\\u884c\\u7684\\u64cd\\u4f5c\\u3002\\u5f02\\u6216\\u7684\\u57fa\\u672c\\u53e3\\u8bc0\\u5c31\\u662f\\u201c\\u76f8\\u540c\\u5f97\\u5047\\uff0c\\u4e0d\\u540c\\u5f97\\u771f\\u201d\\uff0c\\u4e5f\\u5c31\\u662f0^1=1^0=1;1^1=0^0=0\\uff1b\\n\\u6211\\u4eec\\u8fd8\\u53ef\\u4ee5\\u5f97\\u51fa\\u4e00\\u4e2a\\u89c4\\u5f8b\\uff1a0\\u548c1\\u5f02\\u62160\\u90fd\\u4e0d\\u53d8\\uff0c\\u5f02\\u62161\\u5219\\u53d6\\u53cd\\u3002\\n\\u8fdb\\u4e00\\u6b65\\uff0c\\u6211\\u4eec\\u53ef\\u4ee5\\u5f97\\u51fa\\u8fd9\\u6837\\u7684\\u7ed3\\u8bba\\uff1a\\u5bf9\\u4e8e\\u4efb\\u4f55\\u4e00\\u4e2a\\u6570A\\uff0c\\u90fd\\u5b58\\u5728A^A=0\\uff0cA^0=A\\u3002\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"Hydra_\"},\"datePublished\":\"2017-09-18T12:41:36+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1469 【找筷子】\" />\n    <meta property=\"og:description\" content=\"【知识插入】异或\n异或是对二进制位进行的操作。异或的基本口诀就是“相同得假，不同得真”，也就是0^1=1^0=1;1^1=0^0=0；\n我们还可以得出一个规律：0和1异或0都不变，异或1则取反。\n进一步，我们可以得出这样的结论：对于任何一个数A，都存在A^A=0，A^0=A。…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"Hydra_\" />\n    <meta property=\"article:published_time\" content=\"2017-09-18T12:41:36+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/iv10492z\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1469 【找筷子】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">Hydra_</a>\n            ·\n            <time datetime=\"2017-09-18T12:41:36+08:00\">2017-09-18 12:41:36</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <h2>【知识插入】异或</h2>\n<p>异或是对二进制位进行的操作。异或的基本口诀就是“相同得假，不同得真”，也就是0^1=1^0=1;1^1=0^0=0；</p>\n<p>我们还可以得出一个<strong>规律</strong>：0和1异或0都不变，异或1则取反。</p>\n<p>进一步，我们可以得出这样的结论：对于任何一个数A，都存在A^A=0，A^0=A。</p>\n<h2>分析</h2>\n<p>这道题目直到异或之后就很好做了。相同的筷子长度异或一下肯定是0，因此所有的成对筷子长度异或起来肯定是0,再和那个单独的筷子异或一下，就是那个单独筷子的长度了。所以……上代码：</p>\n<h2>代码</h2>\n<pre><code class=\"language-cpp\">#include&lt;bits/stdc++.h&gt;\nusing namespace std;\nint n;\nvector&lt;int&gt;p;\n//以上是变量定义的部分，n用来存筷子的数量，p是一个vector类型，也就是不定长数组，用来存储筷子的长度。\nint main()\n{\n    scanf(\"%d\",&amp;n);\n    //率先读入n。\n    p.resize(n+1);\n    //这句语句的意思是给不定长数组vector类型的p分派n+1个空间（下标是0~n），vector的好处就在这里了，我们可以在程序的任意地方释放空间(.clear())，也可以在任意地方分配空间（.resize()）。。这个stl很好用。\n    for(int i=1;i&lt;=n;i++)\n    scanf(\"%d\",&amp;p[i]);\n    //读入筷子长度\n    for(int i=2;i&lt;=n;i++)\n    p[i]=p[i]^p[i-1];\n    //逐个异或。\n    printf(\"%d\",p[n]);\n    //最后的p[n]就是最终答案。\n    return 0;\n}//本算法时间复杂度O(n),空间复杂度O(n).</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6028d56de6df963',t:'MTc5NTYyOTYxNw=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6028d56de6df963',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
