 "code_blocks": [
  "#include<bits/stdc++.h>\nusing namespace std;\nint f[1001];\nint main() {\n    int n;\n    scanf(\"%d\",&n);\n    f[0]=1;\n    for(int i=1;i<=n;i++) {\n        for(int j=1;j<=i;j++) {\n            f[i]+=f[j-1]*f[i-j];\n        }\n    }\n    printf(\"%d\\n\",f[n]);\n    return 0;\n}",
  "#include<iostream>\n#include<cstdio>\nusing namespace std;\nconst int N = 100;\nint dp[N][N],n;\nint main() {\n    dp[1][1]=1;\n    scanf(\"%d\",&n);\n    for (int i=2;i<=n*2;i++) \n        for (int j=0;j<=min(n,i);j++) {\n            if (j==0) dp[i][j]=dp[i-1][1];\n            else {\n                if (j==min(n,i)) dp[i][j]=dp[i-1][i-1];\n                else dp[i][j]=dp[i-1][j-1]+dp[i-1][j+1];\n            }\n        }\n    printf(\"%d\\n\",dp[2*n][0]);\n    return 0;\n}"
 ],
 "sha256": "cfe700255379b15e",
 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <!-- 匿名页面令牌已移除（公开归档不保留） -->\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112514'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>题解 P1044 【栈】 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"g17kwzzm\",\"title\":\"\\u9898\\u89e3 P1044 \\u3010\\u6808\\u3011\",\"category\":2,\"time\":1519739814,\"author\":{\"uid\":22840,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/22840.png\",\"name\":\"\\u5218\\u5907\",\"slogan\":\"\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Blue\",\"ccfLevel\":0,\"xcpcLevel\":0,\"background\":\"\"},\"upvote\":0,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1044\",\"type\":\"P\",\"name\":\"[NOIP 2003 \\u666e\\u53ca\\u7ec4] \\u6808\",\"difficulty\":2,\"fullScore\":100},\"promoteStatus\":3,\"collection\":null,\"content\":\"\\u554a\\u8fd9\\u9898\\u7684\\u8bdd\\u7684\\u786e\\u662f\\u5361\\u7279\\u5170\\u6570\\u3002\\u4f46\\u6211\\u4e00\\u5f00\\u59cb\\u5c45\\u7136\\u6ca1\\u6709\\u60f3\\u5230\\uff08\\u597d\\u5427\\u6211\\u627f\\u8ba4\\u662f\\u672c\\u849f\\u84bb\\u5fd8\\u4e86\\uff09 \\u5982\\u679c\\u7528\\u5361\\u7279\\u5170\\u6570\\u505a\\u7684\\u8bdd\\uff0c\\u90a3\\u4e48\\u5927\\u5bb6\\u5df2\\u7ecf\\u8bb2\\u5f97\\u5f88\\u6e05\\u695a\\u4e86 \\u5c31\\u662ff[i]=sigma(f[j-1]*f[i-j]) (1\\u003C=j\\u003C=n) \\u4ee4f[0]=1\\u7136\\u540e\\u53cc\\u91cd\\u5faa\\u73af\\u5373\\u53ef\\u3002\\n\\n\\n------------\\n\\n\\u4f46\\u6211\\u4eec\\u8bb2\\u4e00\\u79cd\\u6bd4\\u8f83\\u83dc\\u7684\\u505a\\u6cd5\\uff0c\\u4e5f\\u5c31\\u662f\\u6211\\u4e00\\u5f00\\u59cb\\u60f3\\u5230\\u7684\\u65b9\\u6cd5\\u3002\\u3002\\u3002\\n\\u540c\\u6837\\u662f\\u9012\\u63a8\\uff0c\\u8bbedp[i][j]\\u8868\\u793a\\u5f53\\u524d\\u662f\\u7b2ci\\u6b21\\u64cd\\u4f5c\\uff0c\\u8fd8\\u6709j\\u4e2a\\u6570\\u5728\\u6808\\u4e2d\\u7684\\u65b9\\n\\u6848\\u6570\\uff0c\\u7b54\\u6848\\u5c31\\u662fdp[2*n][0],\\u56e0\\u4e3a\\u4e0d\\u7ba1\\u600e\\u4e48\\u6837\\u5168\\u90e8\\u5165\\u6808\\u51fa\\u6808\\u4e00\\u5b9a\\u662f2n\\u6b21\\u64cd\\n\\u4f5c\\u3002\\n\\n\\u90a3\\u4e48\\u5c31\\u5f88\\u660e\\u663e\\u4e86\\uff1a\\n\\nf[i][0]=f[i][1]\\n\\nf[i][min(n,i)]=f[i][min(n,i)-1]\\n\\nf[i][j]=f[i][j-1]+f[i][j+1] (0\\u003Cj\\u003Cmin(n,i))\\n\\n\\u56e0\\u4e3a\\u5f53\\u524d\\u64cd\\u4f5c\\u53ea\\u80fd\\u662fpush\\u4e00\\u4e2a\\u6216\\u8005pop\\u4e00\\u4e2a\\uff0c\\n\\n\\u5982\\u679c\\u662fpush\\uff0c\\u90a3\\u4e48\\u65b9\\u6848\\u5c31\\u662ff[i-1][j-1]\\u56e0\\u4e3a\\u591a\\u4e86\\u4e00\\u4e2a\\n\\n\\u540c\\u7406\\uff0c\\u5982\\u679c\\u662fpop\\uff0cf[i-1][j+1]\\u3002\\n\\n\\u5f53\\u7136\\uff0c\\u6808\\u4e2d\\u5f53\\u524d\\u6ca1\\u4e1c\\u897f\\u6216\\u6ee1\\u4e86\\u7684\\u60c5\\u51b5\\u4e0a\\u4e00\\u6b65\\u5206\\u522b\\u53ea\\u80fd\\u662fpush\\u6216pop\\n\\n\\n------------\\n\\n\\u9644\\u4e0a\\u4ee3\\u7801\\uff1a\\n\\n\\u5361\\u7279\\u5170\\u6570\\u6cd5\\uff1a\\n```\\n#include\\u003Cbits\\/stdc++.h\\u003E\\nusing namespace std;\\nint f[1001];\\nint main() {\\n\\tint n;\\n\\tscanf(\\u0022%d\\u0022,\\u0026n);\\n\\tf[0]=1;\\n\\tfor(int i=1;i\\u003C=n;i++) {\\n\\t\\tfor(int j=1;j\\u003C=i;j++) {\\n\\t\\t\\tf[i]+=f[j-1]*f[i-j];\\n\\t\\t}\\n\\t}\\n\\tprintf(\\u0022%d\\\\n\\u0022,f[n]);\\n\\treturn 0;\\n}\\n\\n```\\n\\n\\u667a\\u969c\\u9012\\u63a8\\u6cd5\\uff1a\\n```\\n#include\\u003Ciostream\\u003E\\n#include\\u003Ccstdio\\u003E\\nusing namespace std;\\nconst int N = 100;\\nint dp[N][N],n;\\nint main() {\\n\\tdp[1][1]=1;\\n\\tscanf(\\u0022%d\\u0022,\\u0026n);\\n\\tfor (int i=2;i\\u003C=n*2;i++) \\n\\t\\tfor (int j=0;j\\u003C=min(n,i);j++) {\\n\\t\\t\\tif (j==0) dp[i][j]=dp[i-1][1];\\n\\t\\t\\telse {\\n\\t\\t\\t\\tif (j==min(n,i)) dp[i][j]=dp[i-1][i-1];\\n\\t\\t\\t\\telse dp[i][j]=dp[i-1][j-1]+dp[i-1][j+1];\\n\\t\\t\\t}\\n\\t\\t}\\n\\tprintf(\\u0022%d\\\\n\\u0022,dp[2*n][0]);\\n\\treturn 0;\\n}\\n```\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795593100.288098}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/g17kwzzm\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1044 \\u3010\\u6808\\u3011\",\"description\":\"\\u554a\\u8fd9\\u9898\\u7684\\u8bdd\\u7684\\u786e\\u662f\\u5361\\u7279\\u5170\\u6570\\u3002\\u4f46\\u6211\\u4e00\\u5f00\\u59cb\\u5c45\\u7136\\u6ca1\\u6709\\u60f3\\u5230\\uff08\\u597d\\u5427\\u6211\\u627f\\u8ba4\\u662f\\u672c\\u849f\\u84bb\\u5fd8\\u4e86\\uff09 \\u5982\\u679c\\u7528\\u5361\\u7279\\u5170\\u6570\\u505a\\u7684\\u8bdd\\uff0c\\u90a3\\u4e48\\u5927\\u5bb6\\u5df2\\u7ecf\\u8bb2\\u5f97\\u5f88\\u6e05\\u695a\\u4e86 \\u5c31\\u662ff[i]=sigma(f[j-1]*f[i-j]) (1&lt;=j&lt;=n) \\u4ee4f[0]=1\\u7136\\u540e\\u53cc\\u91cd\\u5faa\\u73af\\u5373\\u53ef\\u3002\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"\\u5218\\u5907\"},\"datePublished\":\"2018-02-27T21:56:54+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1044 【栈】\" />\n    <meta property=\"og:description\" content=\"啊这题的话的确是卡特兰数。但我一开始居然没有想到（好吧我承认是本蒟蒻忘了） 如果用卡特兰数做的话，那么大家已经讲得很清楚了 就是f[i]=sigma(f[j-1]*f[i-j]) (1&amp;lt;=j&amp;lt;=n) 令f[0]=1然后双重循环即可。…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"刘备\" />\n    <meta property=\"article:published_time\" content=\"2018-02-27T21:56:54+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/g17kwzzm\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1044 【栈】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">刘备</a>\n            ·\n            <time datetime=\"2018-02-27T21:56:54+08:00\">2018-02-27 21:56:54</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>啊这题的话的确是卡特兰数。但我一开始居然没有想到（好吧我承认是本蒟蒻忘了） 如果用卡特兰数做的话，那么大家已经讲得很清楚了 就是f[i]=sigma(f[j-1]*f[i-j]) (1&lt;=j&lt;=n) 令f[0]=1然后双重循环即可。</p>\n\n<p>但我们讲一种比较菜的做法，也就是我一开始想到的方法。。。\n同样是递推，设dp[i][j]表示当前是第i次操作，还有j个数在栈中的方\n案数，答案就是dp[2*n][0],因为不管怎么样全部入栈出栈一定是2n次操\n作。</p>\n<p>那么就很明显了：</p>\n<p>f[i][0]=f[i][1]</p>\n<p>f[i][min(n,i)]=f[i][min(n,i)-1]</p>\n<p>f[i][j]=f[i][j-1]+f[i][j+1] (0&lt;j&lt;min(n,i))</p>\n<p>因为当前操作只能是push一个或者pop一个，</p>\n<p>如果是push，那么方案就是f[i-1][j-1]因为多了一个</p>\n<p>同理，如果是pop，f[i-1][j+1]。</p>\n<p>当然，栈中当前没东西或满了的情况上一步分别只能是push或pop</p>\n\n<p>附上代码：</p>\n<p>卡特兰数法：</p>\n<pre><code>#include&lt;bits/stdc++.h&gt;\nusing namespace std;\nint f[1001];\nint main() {\n    int n;\n    scanf(\"%d\",&amp;n);\n    f[0]=1;\n    for(int i=1;i&lt;=n;i++) {\n        for(int j=1;j&lt;=i;j++) {\n            f[i]+=f[j-1]*f[i-j];\n        }\n    }\n    printf(\"%d\\n\",f[n]);\n    return 0;\n}\n</code></pre>\n<p>智障递推法：</p>\n<pre><code>#include&lt;iostream&gt;\n#include&lt;cstdio&gt;\nusing namespace std;\nconst int N = 100;\nint dp[N][N],n;\nint main() {\n    dp[1][1]=1;\n    scanf(\"%d\",&amp;n);\n    for (int i=2;i&lt;=n*2;i++) \n        for (int j=0;j&lt;=min(n,i);j++) {\n            if (j==0) dp[i][j]=dp[i-1][1];\n            else {\n                if (j==min(n,i)) dp[i][j]=dp[i-1][i-1];\n                else dp[i][j]=dp[i-1][j-1]+dp[i-1][j+1];\n            }\n        }\n    printf(\"%d\\n\",dp[2*n][0]);\n    return 0;\n}</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a5ff11cbecc3f7ff',t:'MTc5NTU5MzEwMA=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a5ff11cbecc3f7ff',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
