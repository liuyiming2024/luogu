 "code_blocks": [
  "#include <cstdio>\n#include <algorithm>\nusing namespace std;\nint i,j,T,M,t[101],p[101],f[101][1001];\nint main()\n{\n    scanf(\"%d%d\",&T,&M);\n    for(i=1;i<=M;i++)\n        scanf(\"%d%d\",&t[i],&p[i]);\n    for(i=1;i<=M;i++)\n    {\n        for(j=0;j<t[i];j++)\n            f[i][j]=f[i-1][j];//针对上面的左边为数组越界的位置\n        for(j=t[i];j<=T;j++)\n            f[i][j]=max(f[i-1][j],f[i-1][j-t[i]]+p[i]);//递推\n    }    \n    printf(\"%d\",f[M][T]);\n    return 0;\n}"
