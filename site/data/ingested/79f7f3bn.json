  "#include<cstdio>\nint main()\n{\n    int k,sum=0,ans=0,t,d,i;\n    scanf(\"%d\",&k);\n    for(i=1;;i++)\n    {\n        sum+=i;\n        ans+=i*i;\n        if(sum==k)\n        {\n           printf(\"%d\\n\",ans);\n           return 0;\n        }\n        if(sum>k) {t=i-1;break;}\n    }\n    ans=0;\n    for(i=1;i<=t;i++)\n        ans+=i*i;\n    d=k-sum+t+1;\n    ans+=d*(t+1);\n    printf(\"%d\\n\",ans);\n    return 0;\n}"
