 "code_blocks": [
  "#include <bits/stdc++.h>\nusing namespace std;\nint a[15],height,ans;\nint main(){\n    ios::sync_with_stdio(0);\n    cin.tie(0);\n    cout.tie(0);\n    for(int i=1;i<=10;i++)//输入\n        cin>>a[i];\n    cin>>height;\n    for(int i=1;i<=10;i++)//循环判断\n        if(height+30>=a[i])//判断\n            ans++;//累加\n    cout<<ans<<endl;//输出\n    return 0;\n}"
