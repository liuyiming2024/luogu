  "#include <bits/stdc++.h>\n\nusing namespace std;\n\nconst int N=50;\nint n;\nstring s[N];\nbool cmp(string a,string b){\n    return (a+b)>(b+a);\n}\nsigned main(){\n    cin>>n;\n    for(int i=1;i<=n;i++){\n        cin>>s[i];\n    }\n    sort(s+1,s+n+1,cmp);\n    for(int i=1;i<=n;i++){\n        cout<<s[i];\n    }\n    return 0;\n}"
