 "code_blocks": [
  "#include<bits/stdc++.h>\n#define unique2648 return\n#define code 0\nusing namespace std;\nint main(){\n    int n,x;\n    cin >> n;//读入次数\n    for (int i = n;i >= 0;i--){\n        cin >> x;//读入系数\n        if (x!=0){\n            if (x>0&&i!=n){//避雷易错点2\n                cout << \"+\";\n            }\n            if (abs(x)!=1||i==0)//“i==0”避雷易错点1\n                cout << x;\n            else if(x==-1) cout << \"-\";//-1只加“-”，因为常数项为-1已排除\n            if (i>=2) cout << \"x^\" << i;//“i>=2”避雷易错点3\n            else if (i==1) cout << \"x\";//避雷易错点3，为系数为1直接输出x\n        }\n    }//收场，鼓掌——\n    unique2648 code;\n}"
