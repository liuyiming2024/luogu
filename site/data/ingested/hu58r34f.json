":{\"uid\":1451573,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/1451573.png\",\"name\":\"unique2648\",\"slogan\":\"\\u6211\\u60f3\\u5f53\\u9ed1\\u5ba2\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Green\",\"ccfLevel\":4,\"xcpcLevel\":0,\"background\":\"\"},\"upvote\":0,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1067\",\"type\":\"P\",\"name\":\"[NOIP 2009 \\u666e\\u53ca\\u7ec4] \\u591a\\u9879\\u5f0f\\u8f93\\u51fa\",\"difficulty\":2,\"fullScore\":100},\"promoteStatus\":3,\"collection\":null,\"content\":\"\\u5148\\u770b\\u4e00\\u773c\\u9898\\u9762\\uff0c\\u6709\\u4ee5\\u4e0b\\u6613\\u9519\\u70b9\\uff1a\\n## \\u51e0\\u4e2a\\u6613\\u9519\\u70b9\\n1\\u3001\\u5e38\\u6570\\u9879\\u4e3a $\\\\pm1$\\uff0c$\\\\pm1$ \\u8981\\u52a0\\u4e0a  \\n2\\u3001\\u7b2c\\u4e00\\u9879\\u7cfb\\u6570\\u4e3a\\u6b63\\u4e0d\\u7528\\u52a0\\u201c$+$\\u201d\\u53f7  \\n3\\u3001\\u5982\\u679c $x$ \\u7684\\u6307\\u6570\\u4e3a $1$\\uff0c\\u76f4\\u63a5\\u8f93\\u51fa $x$  \\n4\\u3001\\u7b2c\\u4e00\\u884c\\u8f93\\u5165 $n$ \\u540e\\uff0c\\u7b2c\\u4e8c\\u884c\\u8981\\u8bfb\\u5165 $n+1$ \\u4e2a\\u7cfb\\u6570\\n## \\u4f18\\u5316\\n\\u7cfb\\u6570\\u8bfb\\u5165\\u540e\\u5904\\u7406\\u5b8c\\u5c31\\u6ca1\\u7528\\u4e86\\uff0c\\u53ef\\u4ee5\\u7528\\u5b8c\\u5c31\\u4e22\\u5165\\u5783\\u573e\\u6876\\uff0c\\u6240\\u4ee5\\u4e0d\\u7528\\u5efa\\u6570\\u7ec4\\uff0c\\u7528\\u4e00\\u4e2a\\u53d8\\u91cf $x$ \\u5373\\u53ef\\n## \\u4ee3\\u7801\\n```cpp\\n#include\\u003Cbits\\/stdc++.h\\u003E\\n#define unique2648 return\\n#define code 0\\nusing namespace std;\\nint main(){\\n    int n,x;\\n    cin \\u003E\\u003E n;\\/\\/\\u8bfb\\u5165\\u6b21\\u6570\\n    for (int i = n;i \\u003E= 0;i--){\\n        cin \\u003E\\u003E x;\\/\\/\\u8bfb\\u5165\\u7cfb\\u6570\\n        if (x!=0){\\n            if (x\\u003E0\\u0026\\u0026i!=n){\\/\\/\\u907f\\u96f7\\u6613\\u9519\\u70b92\\n                cout \\u003C\\u003C \\u0022+\\u0022;\\n            }\\n            if (abs(x)!=1||i==0)\\/\\/\\u201ci==0\\u201d\\u907f\\u96f7\\u6613\\u9519\\u70b91\\n                cout \\u003C\\u003C x;\\n            else if(x==-1) cout \\u003C\\u003C \\u0022-\\u0022;\\/\\/-1\\u53ea\\u52a0\\u201c-\\u201d\\uff0c\\u56e0\\u4e3a\\u5e38\\u6570\\u9879\\u4e3a-1\\u5df2\\u6392\\u9664\\n            if (i\\u003E=2) cout \\u003C\\u003C \\u0022x^\\u0022 \\u003C\\u003C i;\\/\\/\\u201ci\\u003E=2\\u201d\\u907f\\u96f7\\u6613\\u9519\\u70b93\\n            else if (i==1) cout \\u003C\\u003C \\u0022x\\u0022;\\/\\/\\u907f\\u96f7\\u6613\\u9519\\u70b93\\uff0c\\u4e3a\\u7cfb\\u6570\\u4e3a1\\u76f4\\u63a5\\u8f93\\u51fax\\n        }\\n    }\\/\\/\\u6536\\u573a\\uff0c\\u9f13\\u638c\\u2014\\u2014\\n    unique2648 code;\\n}\\n```\\n\\u9644\\u4e0aAC\\u8bb0\\u5f55\\uff1a[AC\\u8bb0\\u5f55](https:\\/\\/www.luogu.com.cn\\/record\\/199078218)    \\n\\u8dea\\u6c42\\u8fc7\\u5ba1\\u6838\\uff08\\u53ef\\u601c.png\\uff09\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795593157.93657}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/hu58r34f\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3\\uff1aP1067 [NOIP2009 \\u666e\\u53ca\\u7ec4] \\u591a\\u9879\\u5f0f\\u8f93\\u51fa\",\"description\":\"\\u5148\\u770b\\u4e00\\u773c\\u9898\\u9762\\uff0c\\u6709\\u4ee5\\u4e0b\\u6613\\u9519\\u70b9\\uff1a\\n\\u51e0\\u4e2a\\u6613\\u9519\\u70b9\\n1\\u3001\\u5e38\\u6570\\u9879\\u4e3a \\\\pm1\\uff0c\\\\pm1 \\u8981\\u52a0\\u4e0a\\n2\\u3001\\u7b2c\\u4e00\\u9879\\u7cfb\\u6570\\u4e3a\\u6b63\\u4e0d\\u7528\\u52a0\\u201c+\\u201d\\u53f7\\n3\\u3001\\u5982\\u679c x \\u7684\\u6307\\u6570\\u4e3a 1\\uff0c\\u76f4\\u63a5\\u8f93\\u51fa x\\n4\\u3001\\u7b2c\\u4e00\\u884c\\u8f93\\u5165 n \\u540e\\uff0c\\u7b2c\\u4e8c\\u884c\\u8981\\u8bfb\\u5165 n+1 \\u4e2a\\u7cfb\\u6570\\n\\u4f18\\u5316\\n\\u7cfb\\u6570\\u8bfb\\u5165\\u540e\\u5904\\u7406\\u5b8c\\u5c31\\u6ca1\\u7528\\u4e86\\uff0c\\u53ef\\u4ee5\\u7528\\u5b8c\\u5c31\\u4e22\\u5165\\u5783\\u573e\\u6876\\uff0c\\u6240\\u4ee5\\u4e0d\\u7528\\u5efa\\u6570\\u7ec4\\uff0c\\u7528\\u4e00\\u4e2a\\u53d8\\u91cf\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"unique2648\"},\"datePublished\":\"2025-01-18T21:34:05+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解：P1067 [NOIP2009 普及组] 多项式输出\" />\n    <meta property=\"og:description\" content=\"先看一眼题面，有以下易错点：\n几个易错点\n1、常数项为 \\pm1，\\pm1 要加上\n2、第一项系数为正不用加“+”号\n3、如果 x 的指数为 1，直接输出 x\n4、第一行输入 n 后，第二行要读入 n+1 个系数\n优化\n系数读入后处理完就没用了，可以用完就丢入垃圾桶，所以不用建数组，用一个变量…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"unique2648\" />\n    <meta property=\"article:published_time\" content=\"2025-01-18T21:34:05+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/hu58r34f\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解：P1067 [NOIP2009 普及组] 多项式输出</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">unique2648</a>\n            ·\n            <time datetime=\"2025-01-18T21:34:05+08:00\">2025-01-18 21:34:05</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>先看一眼题面，有以下易错点：</p>\n<h2>几个易错点</h2>\n<p>1、常数项为 <la-tex display=\"inline\">\\pm1</la-tex>，<la-tex display=\"inline\">\\pm1</la-tex> 要加上<br />\n2、第一项系数为正不用加“<la-tex display=\"inline\">+</la-tex>”号<br />\n3、如果 <la-tex display=\"inline\">x</la-tex> 的指数为 <la-tex display=\"inline\">1</la-tex>，直接输出 <la-tex display=\"inline\">x</la-tex><br />\n4、第一行输入 <la-tex display=\"inline\">n</la-tex> 后，第二行要读入 <la-tex display=\"inline\">n+1</la-tex> 个系数</p>\n<h2>优化</h2>\n<p>系数读入后处理完就没用了，可以用完就丢入垃圾桶，所以不用建数组，用一个变量 <la-tex display=\"inline\">x</la-tex> 即可</p>\n<h2>代码</h2>\n<pre><code class=\"language-cpp\">#include&lt;bits/stdc++.h&gt;\n#define unique2648 return\n#define code 0\nusing namespace std;\nint main(){\n    int n,x;\n    cin &gt;&gt; n;//读入次数\n    for (int i = n;i &gt;= 0;i--){\n        cin &gt;&gt; x;//读入系数\n        if (x!=0){\n            if (x&gt;0&amp;&amp;i!=n){//避雷易错点2\n                cout &lt;&lt; \"+\";\n            }\n            if (abs(x)!=1||i==0)//“i==0”避雷易错点1\n                cout &lt;&lt; x;\n            else if(x==-1) cout &lt;&lt; \"-\";//-1只加“-”，因为常数项为-1已排除\n            if (i&gt;=2) cout &lt;&lt; \"x^\" &lt;&lt; i;//“i&gt;=2”避雷易错点3\n            else if (i==1) cout &lt;&lt; \"x\";//避雷易错点3，为系数为1直接输出x\n        }\n    }//收场，鼓掌——\n    unique2648 code;\n}</code></pre>\n<p>附上AC记录：AC记录<br />\n跪求过审核（可怜.png）</p>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a5ff13344a3a6949',t:'MTc5NTU5MzE1Nw=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a5ff13344a3a6949',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
