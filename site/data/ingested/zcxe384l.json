 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <meta name=\"csrf-token\" content=\"1795679570:6i0v5Iy8nq6LoVSJZpeo2gNIQMoR7HtvdJIedvMuLLw=\">\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112514'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>题解 P1090 【合并果子】 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"zcxe384l\",\"title\":\"\\u9898\\u89e3 P1090 \\u3010\\u5408\\u5e76\\u679c\\u5b50\\u3011\",\"category\":2,\"time\":1512798249,\"author\":{\"uid\":51742,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/51742.png\",\"name\":\"sigland\",\"slogan\":\"\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Orange\",\"ccfLevel\":8,\"xcpcLevel\":0,\"background\":\"\"},\"upvote\":14,\"replyCount\":7,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1090\",\"type\":\"P\",\"name\":\"[NOIP 2004 \\u63d0\\u9ad8\\u7ec4] \\u5408\\u5e76\\u679c\\u5b50\",\"difficulty\":3,\"fullScore\":100},\"promoteStatus\":2,\"collection\":null,\"content\":\"\\u672c\\u9898\\u8d2a\\u5fc3\\u7b56\\u7565\\u5c31\\u662f\\u6bcf\\u6b21\\u9009\\u6700\\u5c0f\\u7684\\u4e24\\u4e2a\\u5408\\u5e76,\\u53ef\\u4ee5\\u7528\\u5f88\\u591a\\u65b9\\u6cd5,\\u6bd4\\u8f83\\u597d\\u7684\\u662f\\u54c8\\u592b\\u66fc\\u6570\\u6216\\u8005\\u5806(\\u4f18\\u5148\\u961f\\u5217),stl\\u5e93\\u7684\\u4f18\\u5148\\u961f\\u5217\\u592a\\u6162\\u4e8680ms\\u8fc7,\\u4e8e\\u662f\\u81ea\\u5df1\\u624b\\u6253\\u4e86\\u4e00\\u4e2a\\u5c01\\u88c5\\u5728\\u7ed3\\u6784\\u4f53\\u91cc40ms,\\u62ff\\u51fa\\u6765\\u752820ms,\\u6ce8\\u91ca\\u5199\\u4ee3\\u7801\\u91cc\\u4e86...(\\u849f\\u84bb\\u52ff\\u55b7)\\n\\n\\u5c01\\u88c5\\u7248(\\u6a21\\u677f\\u8c03\\u7528\\u65b9\\u4fbf40ms\\u9644\\u6ce8\\u91ca)\\n\\n```cpp\\n#include\\u003Cbits\\/stdc++.h\\u003E\\nusing namespace std;\\nstruct my_priority {\\n    vector\\u003Cint\\u003Eheap;\\n    void init() {\\n        heap.push_back(-1e9);\\/\\/\\u63d2\\u5165\\u6570\\u7ec4\\u4e0b\\u6807\\u4e3a0\\u7684\\u6570\\u4fbf\\u4e8e\\u4e4b\\u540e\\u5404\\u8282\\u70b9\\u8bbf\\u95ee\\u7236\\u4eb2\\u4ee5\\u53ca\\u5b69\\u5b50\\n    }\\n    void gao(int pos) {      \\/\\/\\u4ece\\u6839\\u8282\\u70b9\\u5f80\\u4e0b\\u66f4\\u65b0\\u786e\\u4fdd\\u6ee1\\u8db3\\u5806\\u7684\\u6027\\u8d28\\n        int flag;\\n        if(pos*2\\u003Eheap.size()-1)return;\\n        else if(pos*2==heap.size()-1)flag=0;\\n        else flag=heap[pos*2]\\u003Eheap[pos*2+1];\\n        if(heap[pos]\\u003Eheap[pos*2+flag]) {\\n            swap(heap[pos],heap[pos*2+flag]);\\n            gao(pos*2+flag);\\n        }\\n        return;\\n    }\\n    void doit(int i) {      \\/\\/\\u4ece\\u5f53\\u524d\\u8282\\u70b9\\u5f80\\u6839\\u8282\\u70b9\\u66f4\\u65b0\\u786e\\u4fdd\\u6ee1\\u8db3\\u5806\\u7684\\u6027\\u8d28\\n        while(heap[i]\\u003Cheap[i\\/2]) {\\n            swap(heap[i],heap[i\\/2]);\\n            i\\u003E\\u003E=1;\\n        }\\n        return;\\n    }\\n    void push(int w) {     \\/\\/\\u63d2\\u5165\\n        heap.push_back(w);\\n        doit(heap.size()-1);\\n    }\\n    int top() {           \\/\\/\\u8fd4\\u56de\\u5806\\u9876\\n        return heap[1];\\n    }\\n    void pop() {          \\/\\/\\u5220\\u9664\\u5806\\u9876\\u5143\\u7d20\\n        heap[1]=heap[heap.size()-1];\\n        heap.pop_back();\\n        gao(1);\\n    }\\n    int size() {\\n        return heap.size()-1;   \\/\\/\\u8fd4\\u56de\\u5806\\u5143\\u7d20\\u4e2a\\u6570\\n    }\\n} q;\\nint main() {\\n    int i,ans=0;\\n    int n,tmp;\\n    q.init();\\n    scanf(\\u0022%d\\u0022,\\u0026n);\\n    for(i=1; i\\u003C=n; i++) {\\n        scanf(\\u0022%d\\u0022,\\u0026tmp);\\n        q.push(tmp);\\n    }\\n    while(q.size()\\u003E1) {\\n        tmp=q.top();\\n        q.pop();\\n        tmp+=q.top();\\n        q.pop();\\n        ans+=tmp;\\n        q.push(tmp);\\n    }\\n    printf(\\u0022%d\\\\n\\u0022,ans);\\n    return 0;\\n}\\n```\\n\\u62c6\\u5c01\\u7248(\\u8dd1\\u5f97\\u5feb20ms)\\n```cpp\\n#include\\u003Cbits\\/stdc++.h\\u003E\\nusing namespace std;\\nint heap[100010],cnt;\\nvoid gao(int pos)\\n{\\n    int flag=heap[pos*2]\\u003E=heap[pos*2+1];\\n    if(heap[pos]\\u003Eheap[pos*2+flag]){\\n        swap(heap[pos],heap[pos*2+flag]);\\n        gao(pos*2+flag);\\n    }\\n    return;\\n}\\nvoid doit(int i)\\n{   while(heap[i]\\u003Cheap[i\\/2])\\n    {\\n        swap(heap[i],heap[i\\/2]);\\n        i\\/=2;\\n    }\\n    return;\\n}\\nvoid push(int w)\\n{\\n    heap[++cnt]=w;\\n    doit(cnt);\\n}\\nint top()\\n{return heap[1];}\\nvoid pop()\\n{\\n    heap[1]=heap[cnt];heap[cnt]=1e9;\\n    --cnt;gao(1);\\n}\\nint main()\\n{\\n    int i,ans=0;\\n    {   memset(heap,127,sizeof heap);heap[0]=-1e9;\\n        int n,tmp;ans=0;cnt=0;\\n        scanf(\\u0022%d\\u0022,\\u0026n);\\n        for(i=1;i\\u003C=n;i++)\\n        {\\n            scanf(\\u0022%d\\u0022,\\u0026tmp);\\n            push(tmp);\\n        }\\n        while(cnt\\u003E1)\\n        {\\n            tmp=top();pop();tmp+=top();pop();\\n            ans+=tmp;push(tmp);\\n        }\\n        printf(\\u0022%d\\\\n\\u0022,ans);\\n    }\\n    return 0;\\n}\\n```\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795593170.266262}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/zcxe384l\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1090 \\u3010\\u5408\\u5e76\\u679c\\u5b50\\u3011\",\"description\":\"\\u672c\\u9898\\u8d2a\\u5fc3\\u7b56\\u7565\\u5c31\\u662f\\u6bcf\\u6b21\\u9009\\u6700\\u5c0f\\u7684\\u4e24\\u4e2a\\u5408\\u5e76,\\u53ef\\u4ee5\\u7528\\u5f88\\u591a\\u65b9\\u6cd5,\\u6bd4\\u8f83\\u597d\\u7684\\u662f\\u54c8\\u592b\\u66fc\\u6570\\u6216\\u8005\\u5806(\\u4f18\\u5148\\u961f\\u5217),stl\\u5e93\\u7684\\u4f18\\u5148\\u961f\\u5217\\u592a\\u6162\\u4e8680ms\\u8fc7,\\u4e8e\\u662f\\u81ea\\u5df1\\u624b\\u6253\\u4e86\\u4e00\\u4e2a\\u5c01\\u88c5\\u5728\\u7ed3\\u6784\\u4f53\\u91cc40ms,\\u62ff\\u51fa\\u6765\\u752820ms,\\u6ce8\\u91ca\\u5199\\u4ee3\\u7801\\u91cc\\u4e86...(\\u849f\\u84bb\\u52ff\\u55b7)\\n\\u5c01\\u88c5\\u7248(\\u6a21\\u677f\\u8c03\\u7528\\u65b9\\u4fbf40ms\\u9644\\u6ce8\\u91ca)\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"sigland\"},\"datePublished\":\"2017-12-09T13:44:09+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1090 【合并果子】\" />\n    <meta property=\"og:description\" content=\"本题贪心策略就是每次选最小的两个合并,可以用很多方法,比较好的是哈夫曼数或者堆(优先队列),stl库的优先队列太慢了80ms过,于是自己手打了一个封装在结构体里40ms,拿出来用20ms,注释写代码里了...(蒟蒻勿喷)\n封装版(模板调用方便40ms附注释)…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"sigland\" />\n    <meta property=\"article:published_time\" content=\"2017-12-09T13:44:09+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/zcxe384l\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1090 【合并果子】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">sigland</a>\n            ·\n            <time datetime=\"2017-12-09T13:44:09+08:00\">2017-12-09 13:44:09</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>本题贪心策略就是每次选最小的两个合并,可以用很多方法,比较好的是哈夫曼数或者堆(优先队列),stl库的优先队列太慢了80ms过,于是自己手打了一个封装在结构体里40ms,拿出来用20ms,注释写代码里了...(蒟蒻勿喷)</p>\n<p>封装版(模板调用方便40ms附注释)</p>\n<pre><code class=\"language-cpp\">#include&lt;bits/stdc++.h&gt;\nusing namespace std;\nstruct my_priority {\n    vector&lt;int&gt;heap;\n    void init() {\n        heap.push_back(-1e9);//插入数组下标为0的数便于之后各节点访问父亲以及孩子\n    }\n    void gao(int pos) {      //从根节点往下更新确保满足堆的性质\n        int flag;\n        if(pos*2&gt;heap.size()-1)return;\n        else if(pos*2==heap.size()-1)flag=0;\n        else flag=heap[pos*2]&gt;heap[pos*2+1];\n        if(heap[pos]&gt;heap[pos*2+flag]) {\n            swap(heap[pos],heap[pos*2+flag]);\n            gao(pos*2+flag);\n        }\n        return;\n    }\n    void doit(int i) {      //从当前节点往根节点更新确保满足堆的性质\n        while(heap[i]&lt;heap[i/2]) {\n            swap(heap[i],heap[i/2]);\n            i&gt;&gt;=1;\n        }\n        return;\n    }\n    void push(int w) {     //插入\n        heap.push_back(w);\n        doit(heap.size()-1);\n    }\n    int top() {           //返回堆顶\n        return heap[1];\n    }\n    void pop() {          //删除堆顶元素\n        heap[1]=heap[heap.size()-1];\n        heap.pop_back();\n        gao(1);\n    }\n    int size() {\n        return heap.size()-1;   //返回堆元素个数\n    }\n} q;\nint main() {\n    int i,ans=0;\n    int n,tmp;\n    q.init();\n    scanf(\"%d\",&amp;n);\n    for(i=1; i&lt;=n; i++) {\n        scanf(\"%d\",&amp;tmp);\n        q.push(tmp);\n    }\n    while(q.size()&gt;1) {\n        tmp=q.top();\n        q.pop();\n        tmp+=q.top();\n        q.pop();\n        ans+=tmp;\n        q.push(tmp);\n    }\n    printf(\"%d\\n\",ans);\n    return 0;\n}</code></pre>\n<p>拆封版(跑得快20ms)</p>\n<pre><code class=\"language-cpp\">#include&lt;bits/stdc++.h&gt;\nusing namespace std;\nint heap[100010],cnt;\nvoid gao(int pos)\n{\n    int flag=heap[pos*2]&gt;=heap[pos*2+1];\n    if(heap[pos]&gt;heap[pos*2+flag]){\n        swap(heap[pos],heap[pos*2+flag]);\n        gao(pos*2+flag);\n    }\n    return;\n}\nvoid doit(int i)\n{   while(heap[i]&lt;heap[i/2])\n    {\n        swap(heap[i],heap[i/2]);\n        i/=2;\n    }\n    return;\n}\nvoid push(int w)\n{\n    heap[++cnt]=w;\n    doit(cnt);\n}\nint top()\n{return heap[1];}\nvoid pop()\n{\n    heap[1]=heap[cnt];heap[cnt]=1e9;\n    --cnt;gao(1);\n}\nint main()\n{\n    int i,ans=0;\n    {   memset(heap,127,sizeof heap);heap[0]=-1e9;\n        int n,tmp;ans=0;cnt=0;\n        scanf(\"%d\",&amp;n);\n        for(i=1;i&lt;=n;i++)\n        {\n            scanf(\"%d\",&amp;tmp);\n            push(tmp);\n        }\n        while(cnt&gt;1)\n        {\n            tmp=top();pop();tmp+=top();pop();\n            ans+=tmp;push(tmp);\n        }\n        printf(\"%d\\n\",ans);\n    }\n    return 0;\n}</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a5ff138148539013',t:'MTc5NTU5MzE3MA=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a5ff138148539013',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
