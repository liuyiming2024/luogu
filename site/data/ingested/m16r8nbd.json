  "#include <bits/stdc++.h>\nusing namespace std;\nchar s[250000];\nchar S;\nint len=0;\nint main( ){\n    while(cin>>S)\n    {\n        if(S=='E')\n            break;\n        s[len++]=S;\n    }\n    int w=0,l=0;\n    for(int i=0;i<len;i++){ //11分制 \n        if(s[i]=='W')\n            w++;\n        else\n            l++;\n        if(max(w,l)>=11&&abs(w-l)>=2) //当满足获胜分数且分差≥2 \n            cout<<w<<\":\"<<l<<endl,w=0,l=0;\n    }\n    cout<<w<<\":\"<<l<<endl,w=0,l=0;\n    w=0,l=0;\n    puts(\"\");\n    for(int i=0;i<len;i++){ //21分制 \n        if(s[i]=='W')\n            w++;\n        else\n            l++;\n        if(max(w,l)>=21&&abs(w-l)>=2) //当满足获胜分数且分差≥2 \n            cout<<w<<\":\"<<l<<endl,w=0,l=0;\n    }\n    cout<<w<<\":\"<<l,w=0,l=0;\n    return 0;\n}"
