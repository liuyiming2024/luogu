\u5206\\u6570\\u4e14\\u5206\\u5dee\\u22652 \\n\\t\\t\\tcout\\u003C\\u003Cw\\u003C\\u003C\\u0022:\\u0022\\u003C\\u003Cl\\u003C\\u003Cendl,w=0,l=0;\\n\\t}\\n\\tcout\\u003C\\u003Cw\\u003C\\u003C\\u0022:\\u0022\\u003C\\u003Cl,w=0,l=0;\\n\\treturn 0;\\n} \\n```\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795593097.14164}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/m16r8nbd\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3\\uff1aP1042 [NOIP 2003 \\u666e\\u53ca\\u7ec4] \\u4e52\\u4e53\\u7403\",\"description\":\"[NOIP 2003 \\u666e\\u53ca\\u7ec4] \\u4e52\\u4e53\\u7403\\n\\u9898\\u76ee\\u4f20\\u9001\\u95e8\\n\\u601d\\u8def\\uff1a\\n\\u5148\\u8f93\\u5165\\u6574\\u4e2a\\u5b57\\u7b26\\u4e32\\uff0c\\u63a5\\u7740\\u6309\\u716711\\u5206\\u5236\\u548c21\\u5206\\u5236\\u6765\\u4fbf\\u5229\\u4e00\\u904d\\uff0c\\u8f93\\u51fa\\u6bd4\\u8d5b\\u7ed3\\u679c\\u5c31\\u53ef\\u4ee5\\u5b8c\\u6210\\u4e86\\nCoding\\uff1a\\n#include &lt;bits\\/stdc++.h&gt;\\nusing namespace\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"piske\"},\"datePublished\":\"2025-02-21T16:00:44+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解：P1042 [NOIP 2003 普及组] 乒乓球\" />\n    <meta property=\"og:description\" content=\"[NOIP 2003 普及组] 乒乓球\n题目传送门\n思路：\n先输入整个字符串，接着按照11分制和21分制来便利一遍，输出比赛结果就可以完成了\nCoding：\n#include &amp;lt;bits/stdc++.h&amp;gt;\nusing namespace…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"piske\" />\n    <meta property=\"article:published_time\" content=\"2025-02-21T16:00:44+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/m16r8nbd\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解：P1042 [NOIP 2003 普及组] 乒乓球</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">piske</a>\n            ·\n            <time datetime=\"2025-02-21T16:00:44+08:00\">2025-02-21 16:00:44</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <h1>[NOIP 2003 普及组] 乒乓球</h1>\n<h3>题目传送门</h3>\n<h2>思路：</h2>\n<p>先输入整个字符串，接着按照11分制和21分制来便利一遍，输出比赛结果就可以完成了</p>\n<h2>Coding：</h2>\n<pre><code class=\"language-cpp\">#include &lt;bits/stdc++.h&gt;\nusing namespace std;\nchar s[250000];\nchar S;\nint len=0;\nint main( ){\n    while(cin&gt;&gt;S)\n    {\n        if(S=='E')\n            break;\n        s[len++]=S;\n    }\n    int w=0,l=0;\n    for(int i=0;i&lt;len;i++){ //11分制 \n        if(s[i]=='W')\n            w++;\n        else\n            l++;\n        if(max(w,l)&gt;=11&amp;&amp;abs(w-l)&gt;=2) //当满足获胜分数且分差≥2 \n            cout&lt;&lt;w&lt;&lt;\":\"&lt;&lt;l&lt;&lt;endl,w=0,l=0;\n    }\n    cout&lt;&lt;w&lt;&lt;\":\"&lt;&lt;l&lt;&lt;endl,w=0,l=0;\n    w=0,l=0;\n    puts(\"\");\n    for(int i=0;i&lt;len;i++){ //21分制 \n        if(s[i]=='W')\n            w++;\n        else\n            l++;\n        if(max(w,l)&gt;=21&amp;&amp;abs(w-l)&gt;=2) //当满足获胜分数且分差≥2 \n            cout&lt;&lt;w&lt;&lt;\":\"&lt;&lt;l&lt;&lt;endl,w=0,l=0;\n    }\n    cout&lt;&lt;w&lt;&lt;\":\"&lt;&lt;l,w=0,l=0;\n    return 0;\n} </code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a5ff11b84c0e0d0f',t:'MTc5NTU5MzA5Nw=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a5ff11b84c0e0d0f',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
