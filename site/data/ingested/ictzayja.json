 "code_blocks": [
  "#include <bits/stdc++.h>//我爱万能头\nusing namespace std;\n\nint main() {\n    string s1, s2;\n    int cnt1 = 1, cnt2 = 1;//累乘器计数初始值为1，不能为0\n    cin >> s1 >> s2;\n    for (size_t i = 0; i < s1.size(); i++) {\n        cnt1 *= s1[i] - 'A' + 1;//字母转对应数字\n    }\n    for (size_t i = 0; i < s2.size(); i++) {\n        cnt2 *= s2[i] - 'A' + 1;\n    }\n    if (cnt1 % 47 == cnt2 % 47) {\n        cout << \"GO\";//一定要注意大小写\n    } else {\n        cout << \"STAY\";\n    }\n    return 0;//完结撒花\n}"
 ],
