:1648681,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/1648681.png\",\"name\":\"Sunnyjing\",\"slogan\":\"\\u65e0\\u8bba\\u5728\\u591a\\u4e48\\u8352\\u51c9\\u7684\\u9053\\u8def\\u4e0a\\u524d\\u884c\\uff0c\\u90fd\\u4f1a\\u6709\\u8def\\u8fc7\\uff0c\\u6709\\u9047\\u89c1\\uff0c\\u66f4\\u4f1a\\u6709\\u540c\\u884c\\u3002\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Green\",\"ccfLevel\":0,\"xcpcLevel\":0,\"background\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/image_hosting\\/q67lkufu.webp\"},\"upvote\":1,\"replyCount\":0,\"favorCount\":1,\"status\":2,\"solutionFor\":{\"pid\":\"P1200\",\"type\":\"P\",\"name\":\"[USACO1.1] \\u4f60\\u7684\\u98de\\u789f\\u5728\\u8fd9\\u513f Your Ride Is Here\",\"difficulty\":1,\"fullScore\":100},\"promoteStatus\":0,\"collection\":null,\"content\":\"~~\\u672c\\u849f\\u84bb\\u7b2c\\u4e00\\u6b21\\u5199\\u9898\\u89e3\\uff0c\\u89c1\\u8c05~~\\n\\n[\\u9898\\u76ee\\u4f20\\u9001\\u95e8](https:\\/\\/www.luogu.com.cn\\/problem\\/P1200)\\n\\n### \\u601d\\u8def\\n---\\n\\u5f00\\u5934\\u8981\\u8f93\\u5165\\u4e24\\u4e2a\\u5b57\\u7b26\\u4e32\\uff0c\\u6211\\u4eec\\u8bbe\\u4e3as1,s2.\\u82e5s1\\u5404\\u5b57\\u6bcd\\u5bf9\\u5e94\\u6570\\u5b57\\u4e4b\\u79ef\\uff08\\u8bbe\\u4e3acnt1\\uff09mod47\\u7b49\\u4e8es2\\u5404\\u5b57\\u6bcd\\u5bf9\\u5e94\\u6570\\u5b57\\u4e4b\\u79ef\\uff08\\u8bbe\\u4e3acnt2\\uff09\\uff0c\\u8f93\\u51fa\\u201cGO\\u201d\\uff0c\\u5426\\u5219\\u8f93\\u51fa\\u201cSTAY\\u201d.\\n\\n\\u6ca1\\u6709\\u95ee\\u9898\\u7684\\u601d\\u8def\\uff0c~~\\u4f46\\u4e0d\\u51fa\\u95ee\\u9898\\u7684\\u8bdd\\u5c31\\u8981\\u51fa\\u95ee\\u9898\\u4e86~~\\uff0c\\u5982\\u4f55\\u628a\\u5b57\\u6bcd\\u8f6c\\u6570\\u5b57\\u5462\\uff1f\\n\\n\\u5bf9\\uff0cACSLL\\u7801\\u51fa\\u573a\\u4e86.\\n\\n\\u6211\\u4eec\\u7528\\u5bf9\\u5e94\\u5b57\\u6bcd\\u51cf\\u53bb\\u2018A\\u2019\\u7684ASCLL\\u7801\\u503c\\u518d\\u52a01\\uff0c\\u5c31\\u53ef\\u4ee5\\u5f97\\u5230\\u5bf9\\u5e94\\u7684\\u6570\\u5b57\\u4e86\\uff08\\u9898\\u76ee\\u4fdd\\u8bc1\\u5927\\u5199\\uff09.\\n\\n\\u61c2\\u7684\\u90fd\\u61c2\\u4e86\\uff0c\\u4e0a\\u4ee3\\u7801.\\n\\n### \\u4ee3\\u7801\\n---\\n```cpp\\n#include \\u003Cbits\\/stdc++.h\\u003E\\/\\/\\u6211\\u7231\\u4e07\\u80fd\\u5934\\nusing namespace std;\\n\\nint main() {\\n\\tstring s1, s2;\\n\\tint cnt1 = 1, cnt2 = 1;\\/\\/\\u7d2f\\u4e58\\u5668\\u8ba1\\u6570\\u521d\\u59cb\\u503c\\u4e3a1\\uff0c\\u4e0d\\u80fd\\u4e3a0\\n\\tcin \\u003E\\u003E s1 \\u003E\\u003E s2;\\n\\tfor (size_t i = 0; i \\u003C s1.size(); i++) {\\n\\t\\tcnt1 *= s1[i] - \\u0027A\\u0027 + 1;\\/\\/\\u5b57\\u6bcd\\u8f6c\\u5bf9\\u5e94\\u6570\\u5b57\\n\\t}\\n\\tfor (size_t i = 0; i \\u003C s2.size(); i++) {\\n\\t\\tcnt2 *= s2[i] - \\u0027A\\u0027 + 1;\\n\\t}\\n\\tif (cnt1 % 47 == cnt2 % 47) {\\n\\t\\tcout \\u003C\\u003C \\u0022GO\\u0022;\\/\\/\\u4e00\\u5b9a\\u8981\\u6ce8\\u610f\\u5927\\u5c0f\\u5199\\n\\t} else {\\n\\t\\tcout \\u003C\\u003C \\u0022STAY\\u0022;\\n\\t}\\n\\treturn 0;\\/\\/\\u5b8c\\u7ed3\\u6492\\u82b1\\n}\\n```\\n~~\\u5e0c\\u671b\\u80fd\\u5e2e\\u5230\\u50cf\\u6211\\u4e00\\u6837\\u7684\\u849f\\u84bb.~~\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795629544.594928}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/ictzayja\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3\\uff1aP1200 [USACO1.1] \\u4f60\\u7684\\u98de\\u789f\\u5728\\u8fd9\\u513f\",\"description\":\"\\u672c\\u849f\\u84bb\\u7b2c\\u4e00\\u6b21\\u5199\\u9898\\u89e3\\uff0c\\u89c1\\u8c05\\n\\u9898\\u76ee\\u4f20\\u9001\\u95e8\\n\\u601d\\u8def\\n\\n\\u5f00\\u5934\\u8981\\u8f93\\u5165\\u4e24\\u4e2a\\u5b57\\u7b26\\u4e32\\uff0c\\u6211\\u4eec\\u8bbe\\u4e3as1,s2.\\u82e5s1\\u5404\\u5b57\\u6bcd\\u5bf9\\u5e94\\u6570\\u5b57\\u4e4b\\u79ef\\uff08\\u8bbe\\u4e3acnt1\\uff09mod47\\u7b49\\u4e8es2\\u5404\\u5b57\\u6bcd\\u5bf9\\u5e94\\u6570\\u5b57\\u4e4b\\u79ef\\uff08\\u8bbe\\u4e3acnt2\\uff09\\uff0c\\u8f93\\u51fa\\u201cGO\\u201d\\uff0c\\u5426\\u5219\\u8f93\\u51fa\\u201cSTAY\\u201d.\\n\\u6ca1\\u6709\\u95ee\\u9898\\u7684\\u601d\\u8def\\uff0c\\u4f46\\u4e0d\\u51fa\\u95ee\\u9898\\u7684\\u8bdd\\u5c31\\u8981\\u51fa\\u95ee\\u9898\\u4e86\\uff0c\\u5982\\u4f55\\u628a\\u5b57\\u6bcd\\u8f6c\\u6570\\u5b57\\u5462\\uff1f\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"Sunnyjing\"},\"datePublished\":\"2025-07-26T11:43:51+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解：P1200 [USACO1.1] 你的飞碟在这儿\" />\n    <meta property=\"og:description\" content=\"本蒟蒻第一次写题解，见谅\n题目传送门\n思路\n\n开头要输入两个字符串，我们设为s1,s2.若s1各字母对应数字之积（设为cnt1）mod47等于s2各字母对应数字之积（设为cnt2），输出“GO”，否则输出“STAY”.\n没有问题的思路，但不出问题的话就要出问题了，如何把字母转数字呢？…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"Sunnyjing\" />\n    <meta property=\"article:published_time\" content=\"2025-07-26T11:43:51+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/ictzayja\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解：P1200 [USACO1.1] 你的飞碟在这儿</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">Sunnyjing</a>\n            ·\n            <time datetime=\"2025-07-26T11:43:51+08:00\">2025-07-26 11:43:51</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p><del>本蒟蒻第一次写题解，见谅</del></p>\n<p>题目传送门</p>\n<h3>思路</h3>\n\n<p>开头要输入两个字符串，我们设为s1,s2.若s1各字母对应数字之积（设为cnt1）mod47等于s2各字母对应数字之积（设为cnt2），输出“GO”，否则输出“STAY”.</p>\n<p>没有问题的思路，<del>但不出问题的话就要出问题了</del>，如何把字母转数字呢？</p>\n<p>对，ACSLL码出场了.</p>\n<p>我们用对应字母减去‘A’的ASCLL码值再加1，就可以得到对应的数字了（题目保证大写）.</p>\n<p>懂的都懂了，上代码.</p>\n<h3>代码</h3>\n\n<pre><code class=\"language-cpp\">#include &lt;bits/stdc++.h&gt;//我爱万能头\nusing namespace std;\n\nint main() {\n    string s1, s2;\n    int cnt1 = 1, cnt2 = 1;//累乘器计数初始值为1，不能为0\n    cin &gt;&gt; s1 &gt;&gt; s2;\n    for (size_t i = 0; i &lt; s1.size(); i++) {\n        cnt1 *= s1[i] - 'A' + 1;//字母转对应数字\n    }\n    for (size_t i = 0; i &lt; s2.size(); i++) {\n        cnt2 *= s2[i] - 'A' + 1;\n    }\n    if (cnt1 % 47 == cnt2 % 47) {\n        cout &lt;&lt; \"GO\";//一定要注意大小写\n    } else {\n        cout &lt;&lt; \"STAY\";\n    }\n    return 0;//完结撒花\n}</code></pre>\n<p><del>希望能帮到像我一样的蒟蒻.</del></p>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6028b8cca5e2db6',t:'MTc5NTYyOTU0NA=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6028b8cca5e2db6',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
