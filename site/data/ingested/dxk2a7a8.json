 "code_blocks": [
  "#include<cmath>\n#include<cstdio>\n#include<cstring>\n#include<iostream>\n#include<algorithm>\n#include<string>\nusing namespace std;\nbool cmp(const long long& a,const long long& b)\n{\n    return a>b;\n}\nlong long shu[300000]={0};\nint main()\n{\n    int n,c;\n    scanf(\"%d%d\",&n,&c);\n    for(int i=0;i<n;i++)scanf(\"%lld\",&shu[i]);\n    sort(shu,shu+n,cmp);//STL排序\n    int t=0,w=1;\n    int tj,wj;\n    int st,sw;\n    long long sum=0;\n    while(w<n)\n    {\n        if(shu[t]-shu[w]>c)t++;\n        if(shu[t]-shu[w]<c)w++;//靠近c\n        if(shu[t]-shu[w]==c)\n        {\n            tj=wj=0;\n            st=t,sw=w;\n            for(int i=t;shu[i]==shu[st];i++)\n            {\n                tj++;\n                t++;\n            }\n            if(c==0)wj=1;//若等于，则w不计数（这时a[t]-a[w]<=0，但不需要担心，在之后的操作中会将w恢复到t后面）\n            else\n            for(int i=w;shu[i]==shu[sw];i++)\n            {\n                wj++;\n                w++;\n            }\n            sum+=(long long)tj*(long long)wj;\n        }\n    }\n    printf(\"%lld\",sum);\n    return 0;\n}"
 ],
 "sha256": "c885f557c2d154b9",
 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <meta name=\"csrf-token\" content=\"1795715918:Qh6Fc7ajwlF80TMhb3malq9r9ZQkANAONEZG+Oildrs=\">\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112601'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>题解 P1102 【A-B数对】 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"dxk2a7a8\",\"title\":\"\\u9898\\u89e3 P1102 \\u3010A-B\\u6570\\u5bf9\\u3011\",\"category\":2,\"time\":1502623557,\"author\":{\"uid\":32275,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/32275.png\",\"name\":\"KesdiaelKen\",\"slogan\":\"\\u8fd9\\u4e2a\\u5bb6\\u4f19\\u5f88\\u61d2\\uff0c\\u4ec0\\u4e48\\u4e5f\\u6ca1\\u6709\\u7559\\u4e0b\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Green\",\"ccfLevel\":7,\"xcpcLevel\":0,\"background\":\"\"},\"upvote\":4,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1102\",\"type\":\"P\",\"name\":\"A-B \\u6570\\u5bf9\",\"difficulty\":2,\"fullScore\":100},\"promoteStatus\":0,\"collection\":null,\"content\":\"\\u8fd9\\u4e00\\u9898\\u5982\\u679c\\u7528O(N^2)\\u66b4\\u529b\\u679a\\u4e3e\\uff0c\\u4f1a\\u70b8\\u3002\\n\\n\\u5c06\\u8f93\\u5165\\u7684\\u6570\\u636e\\u8fdb\\u884c\\u6392\\u5e8f\\uff0c\\u7136\\u540e\\u7528\\u4e24\\u4e2a\\u6307\\u9488\\u6307\\u5411a[0]\\uff0ca[1]\\uff0c\\u7136\\u540e\\u7528\\u7c7b\\u4f3c\\u5f52\\u5e76\\u7684\\u601d\\u60f3\\uff0c\\u5c06\\u6307\\u9488\\u4f4d\\u7f6e\\u5411\\u540e\\u63a8\\u79fb\\u3002\\u82e5\\u627e\\u5230a[m]-a[n]=c\\uff0c\\u5219\\u627e\\u5230\\u6240\\u6709\\u7b49\\u4e8ea[m]\\uff0c\\u7b49\\u4e8ea[n]\\u7684\\u6570\\uff08\\u5305\\u62eca[m]\\uff0ca[n]\\uff09\\u7684\\u4e2a\\u6570\\uff0c\\u7136\\u540e\\u5229\\u7528\\u4e58\\u6cd5\\u539f\\u7406\\uff0c\\u5c06\\u5b83\\u4eec\\u76f8\\u4e58\\u3002\\u5c06\\u8fd9\\u4e9b\\u4e58\\u79ef\\u7d2f\\u52a0\\uff0c\\u5373\\u5f97\\u5230\\u7b54\\u6848\\u3002\\u9700\\u8981\\u6ce8\\u610f\\u7684\\u662f\\uff0c\\u5f53c\\u7b49\\u4e8e0\\u65f6\\uff0c\\u9700\\u8981\\u52a0\\u4e00\\u4e2a\\u7279\\u5224\\uff0c\\u907f\\u514d\\u91cd\\u590d\\u3002\\u53e6\\u5916\\uff0c\\u8bb0\\u5f97\\u7528long long\\u3002\\n\\n\\u4ee3\\u7801\\u5982\\u4e0b\\uff1a\\n\\n```cpp\\n#include\\u003Ccmath\\u003E\\n#include\\u003Ccstdio\\u003E\\n#include\\u003Ccstring\\u003E\\n#include\\u003Ciostream\\u003E\\n#include\\u003Calgorithm\\u003E\\n#include\\u003Cstring\\u003E\\nusing namespace std;\\nbool cmp(const long long\\u0026 a,const long long\\u0026 b)\\n{\\n    return a\\u003Eb;\\n}\\nlong long shu[300000]={0};\\nint main()\\n{\\n    int n,c;\\n    scanf(\\u0022%d%d\\u0022,\\u0026n,\\u0026c);\\n    for(int i=0;i\\u003Cn;i++)scanf(\\u0022%lld\\u0022,\\u0026shu[i]);\\n    sort(shu,shu+n,cmp);\\/\\/STL\\u6392\\u5e8f\\n    int t=0,w=1;\\n    int tj,wj;\\n    int st,sw;\\n    long long sum=0;\\n    while(w\\u003Cn)\\n    {\\n        if(shu[t]-shu[w]\\u003Ec)t++;\\n        if(shu[t]-shu[w]\\u003Cc)w++;\\/\\/\\u9760\\u8fd1c\\n        if(shu[t]-shu[w]==c)\\n        {\\n            tj=wj=0;\\n            st=t,sw=w;\\n            for(int i=t;shu[i]==shu[st];i++)\\n            {\\n                tj++;\\n                t++;\\n            }\\n            if(c==0)wj=1;\\/\\/\\u82e5\\u7b49\\u4e8e\\uff0c\\u5219w\\u4e0d\\u8ba1\\u6570\\uff08\\u8fd9\\u65f6a[t]-a[w]\\u003C=0\\uff0c\\u4f46\\u4e0d\\u9700\\u8981\\u62c5\\u5fc3\\uff0c\\u5728\\u4e4b\\u540e\\u7684\\u64cd\\u4f5c\\u4e2d\\u4f1a\\u5c06w\\u6062\\u590d\\u5230t\\u540e\\u9762\\uff09\\n            else\\n            for(int i=w;shu[i]==shu[sw];i++)\\n            {\\n                wj++;\\n                w++;\\n            }\\n            sum+=(long long)tj*(long long)wj;\\n        }\\n    }\\n    printf(\\u0022%lld\\u0022,sum);\\n    return 0;\\n}\\n```\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795629518.232925}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/dxk2a7a8\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1102 \\u3010A-B\\u6570\\u5bf9\\u3011\",\"description\":\"\\u8fd9\\u4e00\\u9898\\u5982\\u679c\\u7528O(N^2)\\u66b4\\u529b\\u679a\\u4e3e\\uff0c\\u4f1a\\u70b8\\u3002\\n\\u5c06\\u8f93\\u5165\\u7684\\u6570\\u636e\\u8fdb\\u884c\\u6392\\u5e8f\\uff0c\\u7136\\u540e\\u7528\\u4e24\\u4e2a\\u6307\\u9488\\u6307\\u5411a[0]\\uff0ca[1]\\uff0c\\u7136\\u540e\\u7528\\u7c7b\\u4f3c\\u5f52\\u5e76\\u7684\\u601d\\u60f3\\uff0c\\u5c06\\u6307\\u9488\\u4f4d\\u7f6e\\u5411\\u540e\\u63a8\\u79fb\\u3002\\u82e5\\u627e\\u5230a[m]-a[n]=c\\uff0c\\u5219\\u627e\\u5230\\u6240\\u6709\\u7b49\\u4e8ea[m]\\uff0c\\u7b49\\u4e8ea[n]\\u7684\\u6570\\uff08\\u5305\\u62eca[m]\\uff0ca[n]\\uff09\\u7684\\u4e2a\\u6570\\uff0c\\u7136\\u540e\\u5229\\u7528\\u4e58\\u6cd5\\u539f\\u7406\\uff0c\\u5c06\\u5b83\\u4eec\\u76f8\\u4e58\\u3002\\u5c06\\u8fd9\\u4e9b\\u4e58\\u79ef\\u7d2f\\u52a0\\uff0c\\u5373\\u5f97\\u5230\\u7b54\\u6848\\u3002\\u9700\\u8981\\u6ce8\\u610f\\u7684\\u662f\\uff0c\\u5f53c\\u7b49\\u4e8e0\\u65f6\\uff0c\\u9700\\u8981\\u52a0\\u4e00\\u4e2a\\u7279\\u5224\\uff0c\\u907f\\u514d\\u91cd\\u590d\\u3002\\u53e6\\u5916\\uff0c\\u8bb0\\u5f97\\u7528long\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"KesdiaelKen\"},\"datePublished\":\"2017-08-13T19:25:57+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1102 【A-B数对】\" />\n    <meta property=\"og:description\" content=\"这一题如果用O(N^2)暴力枚举，会炸。\n将输入的数据进行排序，然后用两个指针指向a[0]，a[1]，然后用类似归并的思想，将指针位置向后推移。若找到a[m]-a[n]=c，则找到所有等于a[m]，等于a[n]的数（包括a[m]，a[n]）的个数，然后利用乘法原理，将它们相乘。将这些乘积累加，即得到答案。需要注意的是，当c等于0时，需要加一个特判，避免重复。另外，记得用long…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"KesdiaelKen\" />\n    <meta property=\"article:published_time\" content=\"2017-08-13T19:25:57+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/dxk2a7a8\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1102 【A-B数对】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">KesdiaelKen</a>\n            ·\n            <time datetime=\"2017-08-13T19:25:57+08:00\">2017-08-13 19:25:57</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>这一题如果用O(N^2)暴力枚举，会炸。</p>\n<p>将输入的数据进行排序，然后用两个指针指向a[0]，a[1]，然后用类似归并的思想，将指针位置向后推移。若找到a[m]-a[n]=c，则找到所有等于a[m]，等于a[n]的数（包括a[m]，a[n]）的个数，然后利用乘法原理，将它们相乘。将这些乘积累加，即得到答案。需要注意的是，当c等于0时，需要加一个特判，避免重复。另外，记得用long long。</p>\n<p>代码如下：</p>\n<pre><code class=\"language-cpp\">#include&lt;cmath&gt;\n#include&lt;cstdio&gt;\n#include&lt;cstring&gt;\n#include&lt;iostream&gt;\n#include&lt;algorithm&gt;\n#include&lt;string&gt;\nusing namespace std;\nbool cmp(const long long&amp; a,const long long&amp; b)\n{\n    return a&gt;b;\n}\nlong long shu[300000]={0};\nint main()\n{\n    int n,c;\n    scanf(\"%d%d\",&amp;n,&amp;c);\n    for(int i=0;i&lt;n;i++)scanf(\"%lld\",&amp;shu[i]);\n    sort(shu,shu+n,cmp);//STL排序\n    int t=0,w=1;\n    int tj,wj;\n    int st,sw;\n    long long sum=0;\n    while(w&lt;n)\n    {\n        if(shu[t]-shu[w]&gt;c)t++;\n        if(shu[t]-shu[w]&lt;c)w++;//靠近c\n        if(shu[t]-shu[w]==c)\n        {\n            tj=wj=0;\n            st=t,sw=w;\n            for(int i=t;shu[i]==shu[st];i++)\n            {\n                tj++;\n                t++;\n            }\n            if(c==0)wj=1;//若等于，则w不计数（这时a[t]-a[w]&lt;=0，但不需要担心，在之后的操作中会将w恢复到t后面）\n            else\n            for(int i=w;shu[i]==shu[sw];i++)\n            {\n                wj++;\n                w++;\n            }\n            sum+=(long long)tj*(long long)wj;\n        }\n    }\n    printf(\"%lld\",sum);\n    return 0;\n}</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6028ae7ee4ac8bd',t:'MTc5NTYyOTUxOA=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6028ae7ee4ac8bd',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
