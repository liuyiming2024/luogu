 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <meta name=\"csrf-token\" content=\"1795615772:BGmYqsl3JRynvhAowFFVs9DLe5bLtAFb0gIQ83Hl0/A=\">\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112421'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>题解 P1008 【三连击】 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"azdjstpm\",\"title\":\"\\u9898\\u89e3 P1008 \\u3010\\u4e09\\u8fde\\u51fb\\u3011\",\"category\":2,\"time\":1541739243,\"author\":{\"uid\":140255,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/140255.png\",\"name\":\"\\u4e91\\u96c0\\u9171\",\"slogan\":\"AFO \\u52a0\\u6cb9\\u9e2d\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Green\",\"ccfLevel\":6,\"xcpcLevel\":3,\"background\":\"\"},\"upvote\":0,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1008\",\"type\":\"P\",\"name\":\"[NOIP 1998 \\u666e\\u53ca\\u7ec4] \\u4e09\\u8fde\\u51fb\",\"difficulty\":2,\"fullScore\":100},\"promoteStatus\":3,\"collection\":null,\"content\":\"# P1008  \\u4f7f\\u7528\\u6df1\\u5ea6\\u4f18\\u5148\\u641c\\u7d22\\u7684\\u89e3\\u6cd5\\n### \\u7b2c\\u4e00\\u6b21\\u53d1\\u9898\\u89e3\\uff0c\\u6240\\u4ee5\\u6392\\u7248\\u53ef\\u80fd\\u4f1a\\u4e0d\\u592a\\u8212\\u670d\\uff0c\\u601d\\u8def\\u5927\\u6982\\u5c31\\u662f\\u8ba9dfs\\u53bb\\u751f\\u6210\\u5168\\u6392\\u5217\\uff0c\\u7136\\u540e\\u6ee1\\u8db3\\u6761\\u4ef6\\u5219\\u8f93\\u51fa\\u3002\\n####  \\u4ee3\\u7801\\u5982\\u4e0b\\u3002\\n------------\\n```cpp\\n#include\\u003Ciostream\\u003E\\nusing namespace std;\\nint st[9], bok[9] = {0};\\nvoid dfs(int step) {\\n\\tif (step == 9) {\\n\\t\\tint a = 100*st[0] + 10*st[1] + st[2];\\/\\/\\u7b2c\\u4e00\\u4e2a\\u4e09\\u4f4d\\u6570\\n\\t\\tint b = 100*st[3] + 10*st[4] + st[5];\\/\\/\\u7b2c\\u4e8c\\u4e2a\\u4e09\\u4f4d\\u6570\\n\\t\\tint c = 100*st[6] + 10*st[7] + st[8];\\/\\/\\u7b2c\\u4e09\\u4e2a\\u4e09\\u4f4d\\u6570\\n        \\/\\/\\u4e0b\\u9762\\u662f\\u5224\\u65ad\\u4e09\\u4f4d\\u6570\\u662f\\u5426\\u62101\\uff1a2\\uff1a3\\u7684\\u6bd4\\u4f8b\\n\\t\\tif (3*a == c \\u0026\\u0026 2*a == b) {\\n\\t\\t\\tcout \\u003C\\u003C st[0] \\u003C\\u003C st[1] \\u003C\\u003C st[2] \\u003C\\u003C \\u0027 \\u0027\\n\\t\\t\\t\\t \\u003C\\u003C st[3] \\u003C\\u003C st[4] \\u003C\\u003C st[5] \\u003C\\u003C \\u0027 \\u0027\\n\\t\\t\\t\\t \\u003C\\u003C st[6] \\u003C\\u003C st[7] \\u003C\\u003C st[8] \\u003C\\u003C \\u0027\\\\n\\u0027;\\n\\t\\t}\\t\\n\\t}\\n    \\/\\/\\u4e0b\\u9762\\u662f\\u751f\\u6210\\u5168\\u6392\\u5217\\n\\tfor (int i = 1; i \\u003C= 9; i++) {\\n\\t\\tif (bok[i]) continue;\\n\\t\\tbok[i] = true;\\n\\t\\tst[step] = i;\\n\\t\\tdfs(step+1);\\n\\t\\tbok[i] = false;\\n\\t}\\n}\\nint main(){\\n\\tdfs(0);\\n\\treturn 0;\\n}\\n```\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795529372.31156}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/azdjstpm\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1008 \\u3010\\u4e09\\u8fde\\u51fb\\u3011\",\"description\":\"P1008  \\u4f7f\\u7528\\u6df1\\u5ea6\\u4f18\\u5148\\u641c\\u7d22\\u7684\\u89e3\\u6cd5\\n\\u7b2c\\u4e00\\u6b21\\u53d1\\u9898\\u89e3\\uff0c\\u6240\\u4ee5\\u6392\\u7248\\u53ef\\u80fd\\u4f1a\\u4e0d\\u592a\\u8212\\u670d\\uff0c\\u601d\\u8def\\u5927\\u6982\\u5c31\\u662f\\u8ba9dfs\\u53bb\\u751f\\u6210\\u5168\\u6392\\u5217\\uff0c\\u7136\\u540e\\u6ee1\\u8db3\\u6761\\u4ef6\\u5219\\u8f93\\u51fa\\u3002\\n\\u4ee3\\u7801\\u5982\\u4e0b\\u3002\\n\\n#include&lt;iostream&gt;\\nusing namespace std;\\nint\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"\\u4e91\\u96c0\\u9171\"},\"datePublished\":\"2018-11-09T12:54:03+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1008 【三连击】\" />\n    <meta property=\"og:description\" content=\"P1008  使用深度优先搜索的解法\n第一次发题解，所以排版可能会不太舒服，思路大概就是让dfs去生成全排列，然后满足条件则输出。\n代码如下。\n\n#include&amp;lt;iostream&amp;gt;\nusing namespace std;\nint…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"云雀酱\" />\n    <meta property=\"article:published_time\" content=\"2018-11-09T12:54:03+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/azdjstpm\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1008 【三连击】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">云雀酱</a>\n            ·\n            <time datetime=\"2018-11-09T12:54:03+08:00\">2018-11-09 12:54:03</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <h1>P1008  使用深度优先搜索的解法</h1>\n<h3>第一次发题解，所以排版可能会不太舒服，思路大概就是让dfs去生成全排列，然后满足条件则输出。</h3>\n<h4>代码如下。</h4>\n\n<pre><code class=\"language-cpp\">#include&lt;iostream&gt;\nusing namespace std;\nint st[9], bok[9] = {0};\nvoid dfs(int step) {\n    if (step == 9) {\n        int a = 100*st[0] + 10*st[1] + st[2];//第一个三位数\n        int b = 100*st[3] + 10*st[4] + st[5];//第二个三位数\n        int c = 100*st[6] + 10*st[7] + st[8];//第三个三位数\n        //下面是判断三位数是否成1：2：3的比例\n        if (3*a == c &amp;&amp; 2*a == b) {\n            cout &lt;&lt; st[0] &lt;&lt; st[1] &lt;&lt; st[2] &lt;&lt; ' '\n                 &lt;&lt; st[3] &lt;&lt; st[4] &lt;&lt; st[5] &lt;&lt; ' '\n                 &lt;&lt; st[6] &lt;&lt; st[7] &lt;&lt; st[8] &lt;&lt; '\\n';\n        }   \n    }\n    //下面是生成全排列\n    for (int i = 1; i &lt;= 9; i++) {\n        if (bok[i]) continue;\n        bok[i] = true;\n        st[step] = i;\n        dfs(step+1);\n        bok[i] = false;\n    }\n}\nint main(){\n    dfs(0);\n    return 0;\n}</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a5f8fded991b3222',t:'MTc5NTUyOTM3MQ=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a5f8fded991b3222',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n"
