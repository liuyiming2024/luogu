 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <!-- 匿名页面令牌已移除（公开归档不保留） -->\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112601'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>题解 P1469 【找筷子】 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"3aph5o1d\",\"title\":\"\\u9898\\u89e3 P1469 \\u3010\\u627e\\u7b77\\u5b50\\u3011\",\"category\":2,\"time\":1556753852,\"author\":{\"uid\":108353,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/108353.png\",\"name\":\"\\u672a\\u6765miss\",\"slogan\":\"QQ2824838895\\u54fc\\u54fc~\\u7070\\u7070\\u849f\\u84bb\\u6478\\u6478\\u5934\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Blue\",\"ccfLevel\":0,\"xcpcLevel\":0,\"background\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/image_hosting\\/5ye82pld.png\"},\"upvote\":0,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1469\",\"type\":\"P\",\"name\":\"\\u627e\\u7b77\\u5b50\",\"difficulty\":2,\"fullScore\":100},\"promoteStatus\":3,\"collection\":null,\"content\":\"# \\u8fd9\\u9898\\u2026\\u2026\\u5927\\u6c34\\u9898\\uff01\\uff01\\uff01\\n## \\u7b97\\u6cd5\\u4e00\\n\\n\\n------------\\n\\n\\u8fd9\\u9898\\u4e0d\\u96be\\u60f3\\u5230**\\u5feb\\u6392**\\n\\n**\\u5feb\\u6392**\\u540e\\u76f4\\u63a5**\\u67e5\\u627e**\\uff08\\u4e24\\u4e2a\\u4e24\\u4e2a\\u641c\\uff09\\n\\n\\u4f46\\u662f\\u8fd9\\u4e0d\\u662f\\u6211\\u8981\\u8bf4\\u7684\\u601d\\u8def\\n\\n\\u5148\\u9644\\u4e0a**\\u5feb\\u6392**\\u4ee3\\u7801\\uff1a\\n```pascal\\nvar n,i:longint;\\na:array[1..1000000] of longint;\\nb:boolean;\\nprocedure qsort(l,r: longint);\\/\\/\\u5feb\\u6392\\nvar\\n   i,j,x,y: longint;\\nbegin\\n  i:=l;\\n  j:=r;\\n  x:=a[(l+r) div 2];\\n  repeat\\n    while a[i]\\u003Cx do\\n     inc(i);\\n    while x\\u003Ca[j] do\\n     dec(j);\\n    if not(i\\u003Ej) then\\n      begin\\n         y:=a[i];\\n         a[i]:=a[j];\\n         a[j]:=y;\\n         inc(i);\\n         j:=j-1;\\n      end;\\n  until i\\u003Ej;\\n  if l\\u003Cj then\\n    qsort(l,j);\\n  if i\\u003Cr then\\n    qsort(i,r);\\nend;\\nbegin\\nreadln(n);\\nfor i:=1 to n do\\/\\/\\u8f93\\u5165\\nread(a[i]);\\nqsort(1,n);\\/\\/\\u5feb\\u6392\\nb:=true;\\/\\/\\u521d\\u59cb\\u5316\\ni:=1;\\/\\/\\u521d\\u59cb\\u5316\\nwhile b do\\/\\/\\u5e03\\u5c14\\u578b\\u53d8\\u91cfb\\u7684\\u503c\\u662f\\u5426\\u4e3atrue\\nbegin\\nif a[i]\\u003C\\u003Ea[i+1] then b:=false;\\/\\/\\u5982\\u679c\\u627e\\u5230\\u524d\\u540e\\u4e24\\u4e2a\\u6570\\u4e0d\\u4e00\\u6837\\ni:=i+2;\\/\\/\\u4e24\\u4e2a\\u4e24\\u4e2a\\u641c\\nend;\\nwrite(a[i-2]);\\/\\/\\u591a\\u52a0\\u4e862\\uff0c\\u6240\\u4ee5\\u51cf\\u53bb\\nend.\\n\\n```\\n## \\u7b97\\u6cd5\\u4e8c\\n------------\\n\\n\\n\\u5927\\u5bb6\\u77e5\\u9053**\\u5f02\\u6216**\\u8fd9\\u4e2a\\u4e1c\\u897f\\u5427\\n\\n\\u5373\\uff1a3 xor 3=0 3 xor 0=3 \\n    \\n       10 xor 10=0 10 xor 10=0\\n\\u5927\\u5bb6\\u4e0d\\u96be\\u53d1\\u73b0\\u7528\\u4e86**\\u5f02\\u6216**\\u76f4\\u63a5\\u5c31\\u628a\\u51fa\\u73b0**\\u5076\\u6570\\u6b21\\u7684\\u6570\\u62b5\\u6d88**\\u4e86\\n\\n\\u7559\\u4e0b\\u7684\\u7ed3\\u679c\\u5c31\\u6210\\u4e86**\\u5355\\u72ec\\u51fa\\u73b0\\u7684\\u6570**\\u4e86\\n\\n\\u9644\\u4e0a**\\u8d85\\u77ed**\\u4ee3\\u7801\\uff1a\\n```pascal\\nvar\\nn,i,s,t:longint;\\nbegin\\nreadln(n);\\nfor i:=1 to n do \\nbegin\\nread(t);\\/\\/\\u8f93\\u5165\\ns:=s xor t;\\/\\/\\u5f02\\u6216\\nend;\\nwrite(s);\\/\\/\\u8f93\\u51fa\\nend.\\n```\\n\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795629614.99558}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/3aph5o1d\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1469 \\u3010\\u627e\\u7b77\\u5b50\\u3011\",\"description\":\"\\u8fd9\\u9898\\u2026\\u2026\\u5927\\u6c34\\u9898\\uff01\\uff01\\uff01\\n\\u7b97\\u6cd5\\u4e00\\n\\n\\u8fd9\\u9898\\u4e0d\\u96be\\u60f3\\u5230\\u5feb\\u6392\\n\\u5feb\\u6392\\u540e\\u76f4\\u63a5\\u67e5\\u627e\\uff08\\u4e24\\u4e2a\\u4e24\\u4e2a\\u641c\\uff09\\n\\u4f46\\u662f\\u8fd9\\u4e0d\\u662f\\u6211\\u8981\\u8bf4\\u7684\\u601d\\u8def\\n\\u5148\\u9644\\u4e0a\\u5feb\\u6392\\u4ee3\\u7801\\uff1a\\nvar n,i:longint;\\na:array[1..1000000] of longint;\\nb:boolean;\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"\\u672a\\u6765miss\"},\"datePublished\":\"2019-05-02T07:37:32+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1469 【找筷子】\" />\n    <meta property=\"og:description\" content=\"这题……大水题！！！\n算法一\n\n这题不难想到快排\n快排后直接查找（两个两个搜）\n但是这不是我要说的思路\n先附上快排代码：\nvar n,i:longint;\na:array[1..1000000] of longint;\nb:boolean;…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"未来miss\" />\n    <meta property=\"article:published_time\" content=\"2019-05-02T07:37:32+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/3aph5o1d\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1469 【找筷子】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">未来miss</a>\n            ·\n            <time datetime=\"2019-05-02T07:37:32+08:00\">2019-05-02 07:37:32</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <h1>这题……大水题！！！</h1>\n<h2>算法一</h2>\n\n<p>这题不难想到<strong>快排</strong></p>\n<p><strong>快排</strong>后直接<strong>查找</strong>（两个两个搜）</p>\n<p>但是这不是我要说的思路</p>\n<p>先附上<strong>快排</strong>代码：</p>\n<pre><code class=\"language-pascal\">var n,i:longint;\na:array[1..1000000] of longint;\nb:boolean;\nprocedure qsort(l,r: longint);//快排\nvar\n   i,j,x,y: longint;\nbegin\n  i:=l;\n  j:=r;\n  x:=a[(l+r) div 2];\n  repeat\n    while a[i]&lt;x do\n     inc(i);\n    while x&lt;a[j] do\n     dec(j);\n    if not(i&gt;j) then\n      begin\n         y:=a[i];\n         a[i]:=a[j];\n         a[j]:=y;\n         inc(i);\n         j:=j-1;\n      end;\n  until i&gt;j;\n  if l&lt;j then\n    qsort(l,j);\n  if i&lt;r then\n    qsort(i,r);\nend;\nbegin\nreadln(n);\nfor i:=1 to n do//输入\nread(a[i]);\nqsort(1,n);//快排\nb:=true;//初始化\ni:=1;//初始化\nwhile b do//布尔型变量b的值是否为true\nbegin\nif a[i]&lt;&gt;a[i+1] then b:=false;//如果找到前后两个数不一样\ni:=i+2;//两个两个搜\nend;\nwrite(a[i-2]);//多加了2，所以减去\nend.\n</code></pre>\n<h2>算法二</h2>\n\n<p>大家知道<strong>异或</strong>这个东西吧</p>\n<p>即：3 xor 3=0 3 xor 0=3 </p>\n<pre><code>   10 xor 10=0 10 xor 10=0</code></pre>\n<p>大家不难发现用了<strong>异或</strong>直接就把出现<strong>偶数次的数抵消</strong>了</p>\n<p>留下的结果就成了<strong>单独出现的数</strong>了</p>\n<p>附上<strong>超短</strong>代码：</p>\n<pre><code class=\"language-pascal\">var\nn,i,s,t:longint;\nbegin\nreadln(n);\nfor i:=1 to n do \nbegin\nread(t);//输入\ns:=s xor t;//异或\nend;\nwrite(s);//输出\nend.</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6028d44c9bfcf26',t:'MTc5NTYyOTYxNA=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6028d44c9bfcf26',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
