 "code_blocks": [
  "var n,i:longint;\na:array[1..1000000] of longint;\nb:boolean;\nprocedure qsort(l,r: longint);//快排\nvar\n   i,j,x,y: longint;\nbegin\n  i:=l;\n  j:=r;\n  x:=a[(l+r) div 2];\n  repeat\n    while a[i]<x do\n     inc(i);\n    while x<a[j] do\n     dec(j);\n    if not(i>j) then\n      begin\n         y:=a[i];\n         a[i]:=a[j];\n         a[j]:=y;\n         inc(i);\n         j:=j-1;\n      end;\n  until i>j;\n  if l<j then\n    qsort(l,j);\n  if i<r then\n    qsort(i,r);\nend;\nbegin\nreadln(n);\nfor i:=1 to n do//输入\nread(a[i]);\nqsort(1,n);//快排\nb:=true;//初始化\ni:=1;//初始化\nwhile b do//布尔型变量b的值是否为true\nbegin\nif a[i]<>a[i+1] then b:=false;//如果找到前后两个数不一样\ni:=i+2;//两个两个搜\nend;\nwrite(a[i-2]);//多加了2，所以减去\nend.",
  "var\nn,i,s,t:longint;\nbegin\nreadln(n);\nfor i:=1 to n do \nbegin\nread(t);//输入\ns:=s xor t;//异或\nend;\nwrite(s);//输出\nend."
