\\u8f93\\u5165\\u683c\\u5f0f\\uff1a\\u4e00\\u884c\\uff1a\\u8868\\u8fbe\\u5f0f\\n\\u8f93\\u51fa\\u683c\\u5f0f\\uff1a\\u4e00\\u884c\\uff1a\\u201cYES\\u201d \\u6216\\u201cNO\\u201d\\n\\u8f93\\u5165\\u8f93\\u51fa\\u6837\\u4f8b\\n\\u8f93\\u5165\\u6837\\u4f8b#1\\uff1a\\n\\u2460\\n2*(x+y)\\/(1-x)@\\n\\u2461\\n(25+x)*(a*(a+b+b)@\\n\\u8f93\\u51fa\\u6837\\u4f8b#1\\uff1a\\n\\u2460\\nYES\\n\\u2461\\nNO\\n~~~\\n## AC\\u4ee3\\u7801\\uff1a\\n~~~\\n#include\\u003Cbits\\/stdc++.h\\u003E\\nint main() \\n{\\n\\tchar str[300];\\n\\tint count = 0;\\n\\tscanf(\\u0022%s\\u0022, str);\\n\\tfor(int i = 0; str[i] != \\u0027@\\u0027; i++) \\/\\/\\u754c\\u9650\\n\\t{\\n\\t\\tif(str[i] == \\u0027(\\u0027) count++;\\n\\t\\telse if(str[i] == \\u0027)\\u0027) count--;\\/\\/\\u5224\\u65ad\\n\\t\\tif(count \\u003C 0) break;\\t\\/\\/\\u6b64\\u5904\\u662f\\u5173\\u952e\\n\\t}\\n\\tprintf(count == 0 ? \\u0022YES\\\\n\\u0022 : \\u0022NO\\\\n\\u0022);\\/\\/\\u8f93\\u51fa\\n\\treturn 0;\\n}\\n~~~\\n## \\u63d0\\u4f9b\\u51e0\\u7ec4\\u6d4b\\u8bd5\\u6570\\u636e\\uff1a\\n### \\u8f93\\u5165\\uff1a\\n~~~\\n(())\\n()()\\n))((\\n(()\\n~~~\\n### \\u8f93\\u51fa\\uff1a\\n~~~\\nYES\\nYES\\nNO\\nNO\\n~~~\\n### \\u5982\\u679c\\u611f\\u89c9\\u60f3\\u5728\\u5176\\u4ed6\\u7f51\\u7ad9\\u4e0a\\u5237\\u4e00\\u4e0b\\u9898\\uff0c\\u53ef\\u53c2\\u8003\\uff1a\\n~~~\\n1.\\u77f3\\u5ba4\\u4e2d\\u5b66\\u4fe1\\u606f\\u5b66\\u5965\\u8d5b\\u4e00\\u672c\\u901a\\uff1a\\nhttp:\\/\\/ybt.ssoier.cn:8088\\/\\n2.NOI\\uff1a\\nhttp:\\/\\/noi.openjudge.cn\\/\\n3.\\u5c0f\\u767d\\u83dc\\uff1a\\nhttp:\\/\\/caioj.cn\\/loginpage.php\\n~~~\\n\\u795d\\u770b\\u5b8c\\u70b9\\u8d5e\\u53ca\\u8bc4\\u8bba\\u7684\\u6240\\u6709\\u4eba\\uff1a\\u4e00\\u5e06\\u98ce\\u987a\\u3001\\u4e8c\\u9f99\\u817e\\u98de\\u3001\\u4e09\\u7f8a\\u5f00\\u6cf0\\u3001\\u56db\\u5b63\\u5e73\\u5b89\\u3001\\n\\u4e94 \\u798f\\u4e34\\u95e8\\u3001\\u516d\\u516d\\u5927\\u987a\\u3001\\u4e03\\u661f\\u9ad8\\u7167\\u3001\\u516b\\u65b9\\u6765\\u8d22\\u3001\\u4e5d\\u4e5d\\u540c\\u5fc3\\u3001\\u5341\\u5168\\u5341\\u7f8e\\u3001\\u767e\\u4e8b\\n\\u4ea8\\u901a\\u3001 \\u5343\\u4e8b\\u5409\\u7965\\u3001\\u4e07\\u4e8b\\u5982\\u610f\\uff01\\n## The End\\n![](https:\\/\\/img-blog.csdn.net\\/20180806195023568?watermark\\/2\\/text\\/aHR0cHM6Ly9ibG9nLmNzZG4ubmV0L2hhbnl1ZTAxMDI=\\/font\\/5a6L5L2T\\/fontsize\\/400\\/fill\\/I0JBQkFCMA==\\/dissolve\\/70)\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795659228.782427}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/z3dolqp8\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1739 \\u3010\\u8868\\u8fbe\\u5f0f\\u62ec\\u53f7\\u5339\\u914d\\u3011\",\"description\":\"\\u7b80\\u5355AC\\n\\u7248\\u6743\\u58f0\\u660e\\n\\u53ef\\u501f\\u9274\\uff0c\\u4e0d\\u8981\\u6284\\uff01\\n\\u535a\\u5ba2\\u5730\\u5740\\uff1ahttps:\\/\\/www.luogu.org\\/blog\\/226655\\/\\n\\uff08\\u70b9\\u4e2a\\u8d5e\\uff09 \\n~|(\\u2267\\u25bd\\u2266)\\/~ \\u2570(\\u0e51\\u25d5 \\u25bd \\u25d5\\u0e51)\\u256f \\u266a(^\\u2207^) \\u30fe(o\\u25d5\\u2200\\u25d5)\\uff89\\u30fe \\u8c22\\u5566!!\\u2606\\u2312(\\uff3e-\\u309c)v\\n\\u9898\\u76ee\\u63cf\\u8ff0\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"\\u95eb\\u7acb\"},\"datePublished\":\"2019-07-31T14:46:37+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1739 【表达式括号匹配】\" />\n    <meta property=\"og:description\" content=\"简单AC\n版权声明\n可借鉴，不要抄！\n博客地址：https://www.luogu.org/blog/226655/\n（点个赞） \n~|(≧▽≦)/~ ╰(๑◕ ▽ ◕๑)╯ ♪(^∇^) ヾ(o◕∀◕)ﾉヾ 谢啦!!☆⌒(＾-゜)v\n题目描述…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"闫立\" />\n    <meta property=\"article:published_time\" content=\"2019-07-31T14:46:37+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/z3dolqp8\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1739 【表达式括号匹配】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">闫立</a>\n            ·\n            <time datetime=\"2019-07-31T14:46:37+08:00\">2019-07-31 14:46:37</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <h1>简单AC</h1>\n<h2>版权声明</h2>\n<p>可借鉴，不要抄！</p>\n<p>博客地址：https://www.luogu.org/blog/226655/</p>\n<p>（点个赞） \n~|(≧▽≦)/~ ╰(๑◕ ▽ ◕๑)╯ ♪(^∇^) ヾ(o◕∀◕)ﾉヾ 谢啦!!☆⌒(＾-゜)v</p>\n<h2>题目描述</h2>\n<pre><code>假设一个表达式有英文字母（小写）、运算符（+，—，*，/）和左右小\n（圆）括号构成，以“@”作为表达式的结束符。请编写一个程序检查表达\n式中的左右圆括号是否匹配，若匹配，则返回“YES”；否则返回“NO”。\n表达式长度小于255，左圆括号少于20个。\n输入输出格式\n输入格式：一行：表达式\n输出格式：一行：“YES” 或“NO”\n输入输出样例\n输入样例#1：\n①\n2*(x+y)/(1-x)@\n②\n(25+x)*(a*(a+b+b)@\n输出样例#1：\n①\nYES\n②\nNO</code></pre>\n<h2>AC代码：</h2>\n<pre><code>#include&lt;bits/stdc++.h&gt;\nint main() \n{\n    char str[300];\n    int count = 0;\n    scanf(\"%s\", str);\n    for(int i = 0; str[i] != '@'; i++) //界限\n    {\n        if(str[i] == '(') count++;\n        else if(str[i] == ')') count--;//判断\n        if(count &lt; 0) break;    //此处是关键\n    }\n    printf(count == 0 ? \"YES\\n\" : \"NO\\n\");//输出\n    return 0;\n}</code></pre>\n<h2>提供几组测试数据：</h2>\n<h3>输入：</h3>\n<pre><code>(())\n()()\n))((\n(()</code></pre>\n<h3>输出：</h3>\n<pre><code>YES\nYES\nNO\nNO</code></pre>\n<h3>如果感觉想在其他网站上刷一下题，可参考：</h3>\n<pre><code>1.石室中学信息学奥赛一本通：\nhttp://ybt.ssoier.cn:8088/\n2.NOI：\nhttp://noi.openjudge.cn/\n3.小白菜：\nhttp://caioj.cn/loginpage.php</code></pre>\n<p>祝看完点赞及评论的所有人：一帆风顺、二龙腾飞、三羊开泰、四季平安、\n五 福临门、六六大顺、七星高照、八方来财、九九同心、十全十美、百事\n亨通、 千事吉祥、万事如意！</p>\n<h2>The End</h2>\n<p></p>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a60560401cf19ab6',t:'MTc5NTY1OTIyOA=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a60560401cf19ab6',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
