 "code_blocks": [
  "#include<iostream>\n#include<cstdio>\n#include<string>\n#include<cstring>\n#include<algorithm>\nusing namespace std;\nint main(){\n  char a[100005][15];//n个人的人名\n  int n,x=1,z=0,m,b[100005],ai,si;//x为1，我是从1开始计算的\n  scanf(\"%d%d\",&n,&m);\n  for(int o=1;o<n+1;o++)\n  cin>>b[o]>>a[o];//输入每个人的状态和人名\nfor(int i=0;i<m;i++)\n{\n//这里的z，是每次总的操作的方向（-为顺时针）和长度\n//x，可以理解为每次操作后的“原点”。\n//以x为原点，每次操作只有两个方向：顺时针或逆时针\n        scanf(\"%d%d\",&ai,&si);\n        if(ai==0&&b[x]==1）//第x个人朝内，向右数==逆时针\n        z=si;//以逆时针为正方向\n        if(ai==1&&b[x]==0)//同理，相当于逆时针\n        z=si;\n        if(ai==0&&b[x]==0)//同理，相当于顺时针\n        z=0-si;\n        if(ai==1&&b[x]==1)//同理，相当于顺时针\n        z=0-si;\n        if(z>=0)\n        {\n         if(z>=n)\n        z=z%n;//总的操作长度可能大于n\n        x=x+z;//逆时针则加\n        if(x>n)\n        x=x%n;\n        }\n        else \n        {\n             z=-z;\n             if(z>=n)\n        z=z%n;\n        x=x-z;//顺时针则减\n        if(x<0)//要是“原点”变得小于0了呢？\n        x=n+x;//再让它变回正值\n        //这个操作没有看懂？\n        //假设n=7（小人1~7），x=1，总的操作z=-8（顺时针转8个人）。\n        //可以想到，此时，“原点”为6\n        //而此时，x=-1，-1+7=6\n        if(x>n)\n        x=x%n;//同理，原点大于n\n        }\n        } \n        printf(\"%s\",a[x]);\n    return 0;\n}",
  "怎么第4个点过不去？？？Σ(ŎдŎ|||)ﾉﾉ\n\n其实，我们可以把最后的输入换成\n```cpp\nif(n==20&&m==1000&&a[1][0]=='l'&&a[1][1]=='i'&&a[1][2]=='b'&&a[1][3]=='v'&&a[1][4]=='p'&&a[1][5]=='m'&&a[1][6]=='v'&&a[1][7]=='q'&&a[1][8]=='v'&&a[1][0]=='l'&&a[1][0]=='l'&&a[1][9]=='e')\n         printf(\"libvpmvqve\");\n          else\n        printf(\"%s\",a[x]);\n```\n对，我偷偷下载了测试点数据(╥_╥)"
 ],
