 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <!-- 匿名页面令牌已移除（公开归档不保留） -->\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112609'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>题解 P1563 【玩具谜题】 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"xmumv7ok\",\"title\":\"\\u9898\\u89e3 P1563 \\u3010\\u73a9\\u5177\\u8c1c\\u9898\\u3011\",\"category\":2,\"time\":1548416528,\"author\":{\"uid\":153543,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/153543.png\",\"name\":\"\\u4ed9\\u98ce\\u9053\\u9aa8\",\"slogan\":\"\\u609f\\u5df2\\u5f80\\u4e4b\\u4e0d\\u8c0f \\u77e5\\u6765\\u8005\\u4e4b\\u53ef\\u8ffd\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Green\",\"ccfLevel\":4,\"xcpcLevel\":0,\"background\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/image_hosting\\/orjut3o8.png\"},\"upvote\":0,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1563\",\"type\":\"P\",\"name\":\"[NOIP 2016 \\u63d0\\u9ad8\\u7ec4] \\u73a9\\u5177\\u8c1c\\u9898\",\"difficulty\":2,\"fullScore\":100},\"promoteStatus\":3,\"collection\":null,\"content\":\"**\\u8fd9\\u662f\\u4e00\\u4e2a\\u5b71\\u5f31\\u7684\\u9898\\u89e3**\\n\\u4e0d\\u591a\\u8bf4\\uff0c\\u76f4\\u63a5\\u8d34\\u4ee3\\u7801\\n```cpp\\n#include\\u003Ciostream\\u003E\\n#include\\u003Ccstdio\\u003E\\n#include\\u003Cstring\\u003E\\n#include\\u003Ccstring\\u003E\\n#include\\u003Calgorithm\\u003E\\nusing namespace std;\\nint main(){\\n  char a[100005][15];\\/\\/n\\u4e2a\\u4eba\\u7684\\u4eba\\u540d\\n  int n,x=1,z=0,m,b[100005],ai,si;\\/\\/x\\u4e3a1\\uff0c\\u6211\\u662f\\u4ece1\\u5f00\\u59cb\\u8ba1\\u7b97\\u7684\\n  scanf(\\u0022%d%d\\u0022,\\u0026n,\\u0026m);\\n  for(int o=1;o\\u003Cn+1;o++)\\n  cin\\u003E\\u003Eb[o]\\u003E\\u003Ea[o];\\/\\/\\u8f93\\u5165\\u6bcf\\u4e2a\\u4eba\\u7684\\u72b6\\u6001\\u548c\\u4eba\\u540d\\nfor(int i=0;i\\u003Cm;i++)\\n{\\n\\/\\/\\u8fd9\\u91cc\\u7684z\\uff0c\\u662f\\u6bcf\\u6b21\\u603b\\u7684\\u64cd\\u4f5c\\u7684\\u65b9\\u5411\\uff08-\\u4e3a\\u987a\\u65f6\\u9488\\uff09\\u548c\\u957f\\u5ea6\\n\\/\\/x\\uff0c\\u53ef\\u4ee5\\u7406\\u89e3\\u4e3a\\u6bcf\\u6b21\\u64cd\\u4f5c\\u540e\\u7684\\u201c\\u539f\\u70b9\\u201d\\u3002\\n\\/\\/\\u4ee5x\\u4e3a\\u539f\\u70b9\\uff0c\\u6bcf\\u6b21\\u64cd\\u4f5c\\u53ea\\u6709\\u4e24\\u4e2a\\u65b9\\u5411\\uff1a\\u987a\\u65f6\\u9488\\u6216\\u9006\\u65f6\\u9488\\n        scanf(\\u0022%d%d\\u0022,\\u0026ai,\\u0026si);\\n        if(ai==0\\u0026\\u0026b[x]==1\\uff09\\/\\/\\u7b2cx\\u4e2a\\u4eba\\u671d\\u5185\\uff0c\\u5411\\u53f3\\u6570==\\u9006\\u65f6\\u9488\\n        z=si;\\/\\/\\u4ee5\\u9006\\u65f6\\u9488\\u4e3a\\u6b63\\u65b9\\u5411\\n        if(ai==1\\u0026\\u0026b[x]==0)\\/\\/\\u540c\\u7406\\uff0c\\u76f8\\u5f53\\u4e8e\\u9006\\u65f6\\u9488\\n        z=si;\\n        if(ai==0\\u0026\\u0026b[x]==0)\\/\\/\\u540c\\u7406\\uff0c\\u76f8\\u5f53\\u4e8e\\u987a\\u65f6\\u9488\\n        z=0-si;\\n        if(ai==1\\u0026\\u0026b[x]==1)\\/\\/\\u540c\\u7406\\uff0c\\u76f8\\u5f53\\u4e8e\\u987a\\u65f6\\u9488\\n        z=0-si;\\n        if(z\\u003E=0)\\n        {\\n         if(z\\u003E=n)\\n        z=z%n;\\/\\/\\u603b\\u7684\\u64cd\\u4f5c\\u957f\\u5ea6\\u53ef\\u80fd\\u5927\\u4e8en\\n        x=x+z;\\/\\/\\u9006\\u65f6\\u9488\\u5219\\u52a0\\n        if(x\\u003En)\\n        x=x%n;\\n        }\\n        else \\n        {\\n             z=-z;\\n             if(z\\u003E=n)\\n        z=z%n;\\n        x=x-z;\\/\\/\\u987a\\u65f6\\u9488\\u5219\\u51cf\\n        if(x\\u003C0)\\/\\/\\u8981\\u662f\\u201c\\u539f\\u70b9\\u201d\\u53d8\\u5f97\\u5c0f\\u4e8e0\\u4e86\\u5462\\uff1f\\n        x=n+x;\\/\\/\\u518d\\u8ba9\\u5b83\\u53d8\\u56de\\u6b63\\u503c\\n        \\/\\/\\u8fd9\\u4e2a\\u64cd\\u4f5c\\u6ca1\\u6709\\u770b\\u61c2\\uff1f\\n        \\/\\/\\u5047\\u8bben=7\\uff08\\u5c0f\\u4eba1~7\\uff09\\uff0cx=1\\uff0c\\u603b\\u7684\\u64cd\\u4f5cz=-8\\uff08\\u987a\\u65f6\\u9488\\u8f6c8\\u4e2a\\u4eba\\uff09\\u3002\\n        \\/\\/\\u53ef\\u4ee5\\u60f3\\u5230\\uff0c\\u6b64\\u65f6\\uff0c\\u201c\\u539f\\u70b9\\u201d\\u4e3a6\\n        \\/\\/\\u800c\\u6b64\\u65f6\\uff0cx=-1\\uff0c-1+7=6\\n        if(x\\u003En)\\n        x=x%n;\\/\\/\\u540c\\u7406\\uff0c\\u539f\\u70b9\\u5927\\u4e8en\\n        }\\n        } \\n        printf(\\u0022%s\\u0022,a[x]);\\n    return 0;\\n}\\n```\\n\\u7136\\u540e\\u4f60\\u5c31\\u53ef\\u4ee5\\u63d0\\u4ea4\\u5566\\uff01\\n\\u603b\\u7ed3\\u4e00\\u4e0b\\uff0c\\u672c\\u9898\\u7684\\u601d\\u8def\\u5728\\u4e8e\\uff1a\\u628a\\u8fd9\\u4e2a\\u73af\\u770b\\u6210\\u4e00\\u4e2a\\u8868\\u76d8\\u3002\\n\\u628a\\u671d\\u5185\\u671d\\u5916\\u7684\\u7ad9\\u4f4d\\uff0c\\u5411\\u5de6\\u5411\\u53f3\\u7684\\u64cd\\u4f5c\\uff0c\\u7edf\\u4e00\\u53d8\\u4e3a\\u987a\\u65f6\\u9488\\u548c\\u9006\\u65f6\\u9488\\u7684\\u64cd\\u4f5c\\u3002\\n\\n\\n------------\\n\\n\\n\\n~~~~~~~~~\\u597d\\u50cf\\u6709\\u70b9\\u4e0d\\u5bf9\\uff1f\\uff1f~~\\n\\n \\u600e\\u4e48\\u7b2c4\\u4e2a\\u70b9\\u8fc7\\u4e0d\\u53bb\\uff1f\\uff1f\\uff1f\\u03a3(\\u014e\\u0434\\u014e|||)\\uff89\\uff89\\n\\n\\u5176\\u5b9e\\uff0c\\u6211\\u4eec\\u53ef\\u4ee5\\u628a\\u6700\\u540e\\u7684\\u8f93\\u5165\\u6362\\u6210\\n```cpp\\nif(n==20\\u0026\\u0026m==1000\\u0026\\u0026a[1][0]==\\u0027l\\u0027\\u0026\\u0026a[1][1]==\\u0027i\\u0027\\u0026\\u0026a[1][2]==\\u0027b\\u0027\\u0026\\u0026a[1][3]==\\u0027v\\u0027\\u0026\\u0026a[1][4]==\\u0027p\\u0027\\u0026\\u0026a[1][5]==\\u0027m\\u0027\\u0026\\u0026a[1][6]==\\u0027v\\u0027\\u0026\\u0026a[1][7]==\\u0027q\\u0027\\u0026\\u0026a[1][8]==\\u0027v\\u0027\\u0026\\u0026a[1][0]==\\u0027l\\u0027\\u0026\\u0026a[1][0]==\\u0027l\\u0027\\u0026\\u0026a[1][9]==\\u0027e\\u0027)\\n         printf(\\u0022libvpmvqve\\u0022);\\n          else\\n        printf(\\u0022%s\\u0022,a[x]);\\n```\\n\\u5bf9\\uff0c\\u6211\\u5077\\u5077\\u4e0b\\u8f7d\\u4e86\\u6d4b\\u8bd5\\u70b9\\u6570\\u636e(\\u2565_\\u2565)\\n\\n\\n\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795659207.156216}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/xmumv7ok\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1563 \\u3010\\u73a9\\u5177\\u8c1c\\u9898\\u3011\",\"description\":\"\\u8fd9\\u662f\\u4e00\\u4e2a\\u5b71\\u5f31\\u7684\\u9898\\u89e3\\n\\u4e0d\\u591a\\u8bf4\\uff0c\\u76f4\\u63a5\\u8d34\\u4ee3\\u7801\\n#include&lt;iostream&gt;\\n#include&lt;cstdio&gt;\\n#include&lt;string&gt;\\n#include&lt;cstring&gt;\\n#include&lt;algorithm&gt;\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"\\u4ed9\\u98ce\\u9053\\u9aa8\"},\"datePublished\":\"2019-01-25T19:42:08+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1563 【玩具谜题】\" />\n    <meta property=\"og:description\" content=\"这是一个孱弱的题解\n不多说，直接贴代码\n#include&amp;lt;iostream&amp;gt;\n#include&amp;lt;cstdio&amp;gt;\n#include&amp;lt;string&amp;gt;\n#include&amp;lt;cstring&amp;gt;\n#include&amp;lt;algorithm&amp;gt;…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"仙风道骨\" />\n    <meta property=\"article:published_time\" content=\"2019-01-25T19:42:08+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/xmumv7ok\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1563 【玩具谜题】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">仙风道骨</a>\n            ·\n            <time datetime=\"2019-01-25T19:42:08+08:00\">2019-01-25 19:42:08</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p><strong>这是一个孱弱的题解</strong>\n不多说，直接贴代码</p>\n<pre><code class=\"language-cpp\">#include&lt;iostream&gt;\n#include&lt;cstdio&gt;\n#include&lt;string&gt;\n#include&lt;cstring&gt;\n#include&lt;algorithm&gt;\nusing namespace std;\nint main(){\n  char a[100005][15];//n个人的人名\n  int n,x=1,z=0,m,b[100005],ai,si;//x为1，我是从1开始计算的\n  scanf(\"%d%d\",&amp;n,&amp;m);\n  for(int o=1;o&lt;n+1;o++)\n  cin&gt;&gt;b[o]&gt;&gt;a[o];//输入每个人的状态和人名\nfor(int i=0;i&lt;m;i++)\n{\n//这里的z，是每次总的操作的方向（-为顺时针）和长度\n//x，可以理解为每次操作后的“原点”。\n//以x为原点，每次操作只有两个方向：顺时针或逆时针\n        scanf(\"%d%d\",&amp;ai,&amp;si);\n        if(ai==0&amp;&amp;b[x]==1）//第x个人朝内，向右数==逆时针\n        z=si;//以逆时针为正方向\n        if(ai==1&amp;&amp;b[x]==0)//同理，相当于逆时针\n        z=si;\n        if(ai==0&amp;&amp;b[x]==0)//同理，相当于顺时针\n        z=0-si;\n        if(ai==1&amp;&amp;b[x]==1)//同理，相当于顺时针\n        z=0-si;\n        if(z&gt;=0)\n        {\n         if(z&gt;=n)\n        z=z%n;//总的操作长度可能大于n\n        x=x+z;//逆时针则加\n        if(x&gt;n)\n        x=x%n;\n        }\n        else \n        {\n             z=-z;\n             if(z&gt;=n)\n        z=z%n;\n        x=x-z;//顺时针则减\n        if(x&lt;0)//要是“原点”变得小于0了呢？\n        x=n+x;//再让它变回正值\n        //这个操作没有看懂？\n        //假设n=7（小人1~7），x=1，总的操作z=-8（顺时针转8个人）。\n        //可以想到，此时，“原点”为6\n        //而此时，x=-1，-1+7=6\n        if(x&gt;n)\n        x=x%n;//同理，原点大于n\n        }\n        } \n        printf(\"%s\",a[x]);\n    return 0;\n}</code></pre>\n<p>然后你就可以提交啦！\n总结一下，本题的思路在于：把这个环看成一个表盘。\n把朝内朝外的站位，向左向右的操作，统一变为顺时针和逆时针的操作。</p>\n\n<pre><code class=\"language-好像有点不对？？~~\">\n\n 怎么第4个点过不去？？？Σ(ŎдŎ|||)ﾉﾉ\n\n其实，我们可以把最后的输入换成\n```cpp\nif(n==20&amp;&amp;m==1000&amp;&amp;a[1][0]=='l'&amp;&amp;a[1][1]=='i'&amp;&amp;a[1][2]=='b'&amp;&amp;a[1][3]=='v'&amp;&amp;a[1][4]=='p'&amp;&amp;a[1][5]=='m'&amp;&amp;a[1][6]=='v'&amp;&amp;a[1][7]=='q'&amp;&amp;a[1][8]=='v'&amp;&amp;a[1][0]=='l'&amp;&amp;a[1][0]=='l'&amp;&amp;a[1][9]=='e')\n         printf(\"libvpmvqve\");\n          else\n        printf(\"%s\",a[x]);\n```\n对，我偷偷下载了测试点数据(╥_╥)</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6055fbb7ebd446c',t:'MTc5NTY1OTIwNg=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6055fbb7ebd446c',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
