 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <!-- 匿名页面令牌已移除（公开归档不保留） -->\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112514'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>题解：P1018 [NOIP2000 提高组] 乘积最大 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"pmio8se0\",\"title\":\"\\u9898\\u89e3\\uff1aP1018 [NOIP2000 \\u63d0\\u9ad8\\u7ec4] \\u4e58\\u79ef\\u6700\\u5927\",\"category\":2,\"time\":1738293202,\"author\":{\"uid\":873983,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/873983.png\",\"name\":\"Little_duck_GGG\",\"slogan\":\"\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Orange\",\"ccfLevel\":6,\"xcpcLevel\":0,\"background\":\"\"},\"upvote\":0,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1018\",\"type\":\"P\",\"name\":\"[NOIP 2000 \\u63d0\\u9ad8\\u7ec4] \\u4e58\\u79ef\\u6700\\u5927\",\"difficulty\":4,\"fullScore\":100},\"promoteStatus\":3,\"collection\":null,\"content\":\"### \\u9898\\u76ee\\u610f\\u601d\\n\\u9898\\u610f\\u5bb9\\u6613\\u7406\\u89e3\\uff0c\\u5c31\\u662f\\u5728\\u4e00\\u4e2a\\u6570\\u5b57\\u4e32\\u4e2d\\u7684\\u95f4\\u9694\\u4e2d\\u63d2\\u5165\\u7ed9\\u5b9a\\u6570\\u91cf\\u7684\\u4e58\\u53f7\\uff0c\\u4f7f\\u6570\\u5b57\\u4e32\\u5206\\u88c2\\u6210\\u51e0\\u4e2a\\u90e8\\u5206\\uff0c\\u5e76\\u5c06\\u6bcf\\u4e00\\u4e2a\\u90e8\\u5206\\u76f8\\u4e58\\uff0c\\u6c42\\u6700\\u540e\\u80fd\\u5f97\\u51fa\\u7684\\u6570\\u7684\\u6700\\u5927\\u503c\\u3002\\n### \\u9898\\u76ee\\u601d\\u8def\\n\\u8fd9\\u9053\\u9898\\u6570\\u636e\\u8303\\u56f4\\u8f83\\u5c0f\\uff0c\\u6211\\u4eec\\u53ef\\u4ee5\\u7528\\u6df1\\u641c\\uff0c**\\u5224\\u65ad\\u51fa\\u6bcf\\u4e00\\u4e2a\\u95f4\\u9694\\u662f\\u5426\\u8981\\u653e\\u4e58\\u53f7**\\u3002\\u6211\\u4eec\\u5728\\u6df1\\u641c\\u65f6\\u8981\\u7528\\u5230\\u56db\\u4e2a\\u53c2\\u6570\\uff0c\\u5206\\u522b\\u662f\\u5f53\\u524d\\u641c\\u5230\\u7684\\u95f4\\u9694\\u7f16\\u53f7\\uff0c\\u5f53\\u524d\\u8fd9\\u4e2a**\\u90e8\\u5206**\\u7684\\u503c\\uff0c\\u5f53\\u524d\\u8fd8\\u80fd\\u653e\\u51e0\\u4e2a\\u4e58\\u53f7\\uff0c\\u5f53\\u524d\\u7684\\u7b54\\u6848\\u3002\\n\\n\\u6700\\u540e\\u8fd8\\u6709\\u51e0\\u4e2a\\u6ce8\\u610f\\u4e8b\\u9879\\u3002\\n\\n#### \\u4e00\\uff0c\\u6700\\u540e\\u7684\\u90e8\\u5206\\u9700\\u8981\\u7279\\u6b8a\\u5904\\u7406\\u4e00\\u4e0b\\u3002\\n#### \\u4e8c\\uff0c\\u6570\\u636e\\u8303\\u56f4\\u5341\\u5206\\u5927\\uff0c\\u9700\\u8981\\u7528\\u5230\\u9ad8\\u7cbe\\u5ea6\\u4e58\\u6cd5\\u3002\\n#### \\u4e09\\uff0c\\u6ce8\\u610f\\u521d\\u59cb\\u503c\\u7684\\u8d4b\\u503c\\u3002\\n#### \\u56db\\uff0c\\u6700\\u91cd\\u8981\\u7684\\u4e00\\u70b9\\uff0c\\u9700\\u8981\\u8fdb\\u884c\\u4e00\\u6b65\\u7c7b\\u4f3c\\u526a\\u679d\\u7684\\u64cd\\u4f5c\\uff0c\\u5f53\\u5269\\u4f59\\u7684\\u7a7a\\u88ad\\u4e0d\\u8db3\\u4ee5\\u8ba9\\u5269\\u4e0b\\u7684\\u4e58\\u53f7\\u586b\\uff0c\\u5219\\u76f4\\u63a5\\u8fd4\\u56de\\u3002\\n\\n### \\u6700\\u540e\\u7ed9\\u51fa\\u4ee3\\u7801\\uff0c\\u9644\\u6ce8\\u91ca\\u3002\\n\\n```cpp\\n#include\\u003Cbits\\/stdc++.h\\u003E\\nusing namespace std;\\nint n,k;\\nstring x,ma=\\u0022\\u0022;\\nint q[10005],p[1005],qp[1005];\\nstring add(string a,string b)\\/\\/\\u9ad8\\u7cbe\\u5ea6\\u4e58\\u6cd5\\u6a21\\u677f\\uff0c\\u4e0d\\u591a\\u8bf4 \\n{\\n\\tmemset(q,0,sizeof(q));\\n\\tmemset(p,0,sizeof(p));\\n\\tmemset(qp,0,sizeof(qp)); \\n\\tint lx,ly;\\n\\tlx=a.size();\\n\\tly=b.size();\\n\\tfor(int i=1;i\\u003C=lx;i++)\\n\\t{\\n\\t\\tq[i]=a[lx-i]-\\u00270\\u0027;\\n\\t}\\n\\tfor(int i=1;i\\u003C=ly;i++)\\n\\t{\\n\\t\\tp[i]=b[ly-i]-\\u00270\\u0027;\\n\\t}\\n\\tfor(int i=1;i\\u003C=ly;i++)\\n\\t{\\n\\t\\tfor(int j=1;j\\u003C=lx;j++)\\n\\t\\t{\\n\\t\\t\\tqp[i+j-1]+=q[j]*p[i];\\n\\t\\t}\\n\\t}\\n\\tfor(int i=1;i\\u003Clx+ly;i++)\\n\\t{\\n\\t\\tif(qp[i]\\u003E9)\\n\\t\\t{\\n\\t\\t\\tqp[i+1]+=qp[i]\\/10;\\n\\t\\t\\tqp[i]%=10;\\n\\t\\t}\\n\\t}\\n\\tint len=lx+ly;\\n\\twhile(len\\u003E1\\u0026\\u0026qp[len]==0) len--;\\n\\tstring ua=\\u0022\\u0022;\\n\\tfor(int i=len;i\\u003E=1;i--) ua+=char(qp[i]+\\u00270\\u0027);\\n\\treturn ua;\\n}\\nvoid dfs(int xx,string u,int v,string ans) \\/\\/\\u56db\\u4e2a\\u53c2\\u6570 \\n{\\n\\tif(n-xx-1\\u003Cv) return;\\/\\/\\u5f53\\u5269\\u4f59\\u7684\\u7a7a\\u4f4d\\u4e0d\\u591f\\u4e58\\u53f7\\u586b\\u65f6\\uff0c\\u8fd4\\u56de \\n\\tif(v==0)\\n\\t{\\n\\t\\tstring uu=\\u0022\\u0022;\\n\\t\\tfor(int i=xx-1;i\\u003Cn;i++) uu+=x[i]; \\/\\/\\u5904\\u7406\\u6700\\u540e\\u7684\\u90e8\\u5206 \\n\\t\\tans=add(ans,uu);\\n\\t\\tif(ans.size()\\u003Ema.size()||ans.size()==ma.size()\\u0026\\u0026ans\\u003Ema) ma=ans;\\/\\/\\u627e\\u6700\\u5927 \\n\\t\\treturn;\\n\\t}\\n\\tu+=x[xx-1];\\/\\/\\u8ba1\\u7b97\\u6bcf\\u4e2a\\u90e8\\u5206\\u7684\\u503c \\n\\tif(v\\u003E0) \\n\\t{\\n\\t\\tdfs(xx+1,\\u0022\\u0022,v-1,add(ans,u));\\/\\/\\u5982\\u679c\\u5f53\\u524d\\u8fd8\\u6709\\u4e58\\u53f7\\u53ef\\u4ee5\\u586b\\uff0c\\u624d\\u80fd\\u586b \\n\\t}\\n\\tdfs(xx+1,u,v,ans);\\t\\n}\\nint main()\\n{\\n\\tcin\\u003E\\u003En\\u003E\\u003Ek\\u003E\\u003Ex;\\n\\tdfs(1,\\u0022\\u0022,k,\\u00221\\u0022);\\/\\/\\u521d\\u59cb\\u503c \\n\\tcout\\u003C\\u003Cma;\\n\\treturn 0;\\n} \\n```\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795593088.666762}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/pmio8se0\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3\\uff1aP1018 [NOIP2000 \\u63d0\\u9ad8\\u7ec4] \\u4e58\\u79ef\\u6700\\u5927\",\"description\":\"\\u9898\\u76ee\\u610f\\u601d\\n\\u9898\\u610f\\u5bb9\\u6613\\u7406\\u89e3\\uff0c\\u5c31\\u662f\\u5728\\u4e00\\u4e2a\\u6570\\u5b57\\u4e32\\u4e2d\\u7684\\u95f4\\u9694\\u4e2d\\u63d2\\u5165\\u7ed9\\u5b9a\\u6570\\u91cf\\u7684\\u4e58\\u53f7\\uff0c\\u4f7f\\u6570\\u5b57\\u4e32\\u5206\\u88c2\\u6210\\u51e0\\u4e2a\\u90e8\\u5206\\uff0c\\u5e76\\u5c06\\u6bcf\\u4e00\\u4e2a\\u90e8\\u5206\\u76f8\\u4e58\\uff0c\\u6c42\\u6700\\u540e\\u80fd\\u5f97\\u51fa\\u7684\\u6570\\u7684\\u6700\\u5927\\u503c\\u3002\\n\\u9898\\u76ee\\u601d\\u8def\\n\\u8fd9\\u9053\\u9898\\u6570\\u636e\\u8303\\u56f4\\u8f83\\u5c0f\\uff0c\\u6211\\u4eec\\u53ef\\u4ee5\\u7528\\u6df1\\u641c\\uff0c\\u5224\\u65ad\\u51fa\\u6bcf\\u4e00\\u4e2a\\u95f4\\u9694\\u662f\\u5426\\u8981\\u653e\\u4e58\\u53f7\\u3002\\u6211\\u4eec\\u5728\\u6df1\\u641c\\u65f6\\u8981\\u7528\\u5230\\u56db\\u4e2a\\u53c2\\u6570\\uff0c\\u5206\\u522b\\u662f\\u5f53\\u524d\\u641c\\u5230\\u7684\\u95f4\\u9694\\u7f16\\u53f7\\uff0c\\u5f53\\u524d\\u8fd9\\u4e2a\\u90e8\\u5206\\u7684\\u503c\\uff0c\\u5f53\\u524d\\u8fd8\\u80fd\\u653e\\u51e0\\u4e2a\\u4e58\\u53f7\\uff0c\\u5f53\\u524d\\u7684\\u7b54\\u6848\\u3002\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"Little_duck_GGG\"},\"datePublished\":\"2025-01-31T11:13:22+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解：P1018 [NOIP2000 提高组] 乘积最大\" />\n    <meta property=\"og:description\" content=\"题目意思\n题意容易理解，就是在一个数字串中的间隔中插入给定数量的乘号，使数字串分裂成几个部分，并将每一个部分相乘，求最后能得出的数的最大值。\n题目思路\n这道题数据范围较小，我们可以用深搜，判断出每一个间隔是否要放乘号。我们在深搜时要用到四个参数，分别是当前搜到的间隔编号，当前这个部分的值，当前还能放几个乘号，当前的答案。…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"Little_duck_GGG\" />\n    <meta property=\"article:published_time\" content=\"2025-01-31T11:13:22+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/pmio8se0\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解：P1018 [NOIP2000 提高组] 乘积最大</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">Little_duck_GGG</a>\n            ·\n            <time datetime=\"2025-01-31T11:13:22+08:00\">2025-01-31 11:13:22</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <h3>题目意思</h3>\n<p>题意容易理解，就是在一个数字串中的间隔中插入给定数量的乘号，使数字串分裂成几个部分，并将每一个部分相乘，求最后能得出的数的最大值。</p>\n<h3>题目思路</h3>\n<p>这道题数据范围较小，我们可以用深搜，<strong>判断出每一个间隔是否要放乘号</strong>。我们在深搜时要用到四个参数，分别是当前搜到的间隔编号，当前这个<strong>部分</strong>的值，当前还能放几个乘号，当前的答案。</p>\n<p>最后还有几个注意事项。</p>\n<h4>一，最后的部分需要特殊处理一下。</h4>\n<h4>二，数据范围十分大，需要用到高精度乘法。</h4>\n<h4>三，注意初始值的赋值。</h4>\n<h4>四，最重要的一点，需要进行一步类似剪枝的操作，当剩余的空袭不足以让剩下的乘号填，则直接返回。</h4>\n<h3>最后给出代码，附注释。</h3>\n<pre><code class=\"language-cpp\">#include&lt;bits/stdc++.h&gt;\nusing namespace std;\nint n,k;\nstring x,ma=\"\";\nint q[10005],p[1005],qp[1005];\nstring add(string a,string b)//高精度乘法模板，不多说 \n{\n    memset(q,0,sizeof(q));\n    memset(p,0,sizeof(p));\n    memset(qp,0,sizeof(qp)); \n    int lx,ly;\n    lx=a.size();\n    ly=b.size();\n    for(int i=1;i&lt;=lx;i++)\n    {\n        q[i]=a[lx-i]-'0';\n    }\n    for(int i=1;i&lt;=ly;i++)\n    {\n        p[i]=b[ly-i]-'0';\n    }\n    for(int i=1;i&lt;=ly;i++)\n    {\n        for(int j=1;j&lt;=lx;j++)\n        {\n            qp[i+j-1]+=q[j]*p[i];\n        }\n    }\n    for(int i=1;i&lt;lx+ly;i++)\n    {\n        if(qp[i]&gt;9)\n        {\n            qp[i+1]+=qp[i]/10;\n            qp[i]%=10;\n        }\n    }\n    int len=lx+ly;\n    while(len&gt;1&amp;&amp;qp[len]==0) len--;\n    string ua=\"\";\n    for(int i=len;i&gt;=1;i--) ua+=char(qp[i]+'0');\n    return ua;\n}\nvoid dfs(int xx,string u,int v,string ans) //四个参数 \n{\n    if(n-xx-1&lt;v) return;//当剩余的空位不够乘号填时，返回 \n    if(v==0)\n    {\n        string uu=\"\";\n        for(int i=xx-1;i&lt;n;i++) uu+=x[i]; //处理最后的部分 \n        ans=add(ans,uu);\n        if(ans.size()&gt;ma.size()||ans.size()==ma.size()&amp;&amp;ans&gt;ma) ma=ans;//找最大 \n        return;\n    }\n    u+=x[xx-1];//计算每个部分的值 \n    if(v&gt;0) \n    {\n        dfs(xx+1,\"\",v-1,add(ans,u));//如果当前还有乘号可以填，才能填 \n    }\n    dfs(xx+1,u,v,ans);  \n}\nint main()\n{\n    cin&gt;&gt;n&gt;&gt;k&gt;&gt;x;\n    dfs(1,\"\",k,\"1\");//初始值 \n    cout&lt;&lt;ma;\n    return 0;\n} </code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a5ff11834c37d9ed',t:'MTc5NTU5MzA4OA=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a5ff11834c37d9ed',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
