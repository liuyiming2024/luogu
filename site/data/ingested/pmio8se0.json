 "code_blocks": [
  "#include<bits/stdc++.h>\nusing namespace std;\nint n,k;\nstring x,ma=\"\";\nint q[10005],p[1005],qp[1005];\nstring add(string a,string b)//高精度乘法模板，不多说 \n{\n    memset(q,0,sizeof(q));\n    memset(p,0,sizeof(p));\n    memset(qp,0,sizeof(qp)); \n    int lx,ly;\n    lx=a.size();\n    ly=b.size();\n    for(int i=1;i<=lx;i++)\n    {\n        q[i]=a[lx-i]-'0';\n    }\n    for(int i=1;i<=ly;i++)\n    {\n        p[i]=b[ly-i]-'0';\n    }\n    for(int i=1;i<=ly;i++)\n    {\n        for(int j=1;j<=lx;j++)\n        {\n            qp[i+j-1]+=q[j]*p[i];\n        }\n    }\n    for(int i=1;i<lx+ly;i++)\n    {\n        if(qp[i]>9)\n        {\n            qp[i+1]+=qp[i]/10;\n            qp[i]%=10;\n        }\n    }\n    int len=lx+ly;\n    while(len>1&&qp[len]==0) len--;\n    string ua=\"\";\n    for(int i=len;i>=1;i--) ua+=char(qp[i]+'0');\n    return ua;\n}\nvoid dfs(int xx,string u,int v,string ans) //四个参数 \n{\n    if(n-xx-1<v) return;//当剩余的空位不够乘号填时，返回 \n    if(v==0)\n    {\n        string uu=\"\";\n        for(int i=xx-1;i<n;i++) uu+=x[i]; //处理最后的部分 \n        ans=add(ans,uu);\n        if(ans.size()>ma.size()||ans.size()==ma.size()&&ans>ma) ma=ans;//找最大 \n        return;\n    }\n    u+=x[xx-1];//计算每个部分的值 \n    if(v>0) \n    {\n        dfs(xx+1,\"\",v-1,add(ans,u));//如果当前还有乘号可以填，才能填 \n    }\n    dfs(xx+1,u,v,ans);  \n}\nint main()\n{\n    cin>>n>>k>>x;\n    dfs(1,\"\",k,\"1\");//初始值 \n    cout<<ma;\n    return 0;\n}"
 ],
