92\\u5e8f\\u7684**\\u53bb\\u91cd\\u64cd\\u4f5c**\\u3002   \\n\\n $ set $ \\u662f\\u4e2a\\u597d\\u4e1c\\u897f\\uff0c\\u5b83\\u4e2a\\u662f**\\u5173\\u8054\\u5bb9\\u5668**\\uff0c\\u53ef\\u76f4\\u63a5\\u8fdb\\u884c**\\u641c\\u7d22\\u3001\\u79fb\\u9664\\u548c\\u63d2\\u5165\\u64cd\\u4f5c**\\uff0c\\u62e5\\u6709\\u5bf9\\u6570\\u590d\\u6742\\u5ea6\\uff0c\\u4e0d\\u4e86\\u89e3\\u7684\\u53ef\\u524d\\u5f80[\\u8fd9\\u91cc](https:\\/\\/oi-wiki.org\\/lang\\/csl\\/associative-container\\/)\\u8fdb\\u884c\\u5b66\\u4e60\\u3002   \\n\\n### \\u7a0b\\u5e8f\\u6b65\\u9aa4\\n - \\u8f93\\u5165 $ n $ \\u6b21\\uff0c\\u6bcf\\u6b21\\u5c06\\u8f93\\u5165\\u6570\\u636e\\u653e\\u5165\\u5bb9\\u5668\\u91cc\\uff0c $ set $ \\u53ef\\u5e2e\\u6211\\u4eec\\u76f4\\u63a5\\u6392\\u5e8f\\u4ee5\\u53ca\\u53bb\\u91cd\\u3002\\n\\n - \\u8f93\\u51fa\\u5bb9\\u5668\\u957f\\u5ea6\\u4ee5\\u53ca\\u5bb9\\u5668\\u6bcf\\u4e2a\\u5143\\u7d20\\u7684\\u5730\\u5740\\uff0c\\u5373\\u53ef\\u5b8c\\u6210\\u6392\\u5e8f\\u3002\\n\\n\\n### \\u7a0b\\u5e8f\\u5b9e\\u73b0\\n```cpp\\n#include\\u003Ciostream\\u003E\\n#include\\u003Cset\\u003E\\n\\/\\/set\\u4e13\\u5c5e\\u5934\\u6587\\u4ef6 \\nusing namespace std;\\n\\nset\\u003Cint\\u003Es;\\n\\/\\/\\u5b9a\\u4e49set\\u5bb9\\u5668\\n \\nint main()\\n{\\n\\tint n;\\n\\tcin\\u003E\\u003En;\\n\\twhile(n--){\\n\\t    int x;\\n\\t    cin\\u003E\\u003Ex;\\n\\t    \\n\\t    \\/\\/\\u8fdb\\u884c\\u63d2\\u5165\\u64cd\\u4f5c \\n\\t    s.insert(x);\\n\\t    \\n\\t    \\/\\/\\u6bcf\\u6b21\\u5faa\\u73afset\\u90fd\\u5c06\\u53bb\\u91cd\\u6392\\u5e8f \\n\\t}\\n\\tcout\\u003C\\u003Cs.size()\\u003C\\u003Cendl;\\n\\t\\n\\t\\/\\/auto\\u5fc5\\u987b\\u5f00C++14\\u53ca\\u4ee5\\u4e0a\\u7248\\u672c\\n\\tfor(auto it=s.begin();it!=s.end();it++){\\/\\/s.begin()\\u4e3a\\u5bb9\\u5668\\u7684\\u9996\\u5143\\u7d20\\uff0cs.end()\\u4e3a\\u5bb9\\u5668\\u7684\\u5c3e\\u5143\\u7d20\\n\\t\\n\\t    cout\\u003C\\u003C*it\\u003C\\u003C\\u0022 \\u0022;\\/\\/\\u6700\\u540e\\u8f93\\u51fait\\uff0c\\u5373\\u4e3a\\u5bb9\\u5668\\u6bcf\\u4e2a\\u5143\\u7d20\\u7684\\u5730\\u5740 \\n\\t    \\n\\t}\\n\\treturn 0;\\n }\\n```\\n\\u4f60\\u4eec\\u5b66\\u4f1a\\u4e86\\u5417\\uff1f\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795593123.676011}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/05bplzw1\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3\\uff1aP1059 [NOIP 2006 \\u666e\\u53ca\\u7ec4] \\u660e\\u660e\\u7684\\u968f\\u673a\\u6570\",\"description\":\"\\u6574\\u4f53\\u601d\\u8def\\n\\u8fd9\\u662f\\u4e00\\u9053\\u5178\\u578b\\u7684\\u6392\\u5e8f\\u9898\\uff0c\\u6b64\\u9898\\u6709\\u591a\\u79cd\\u6392\\u5e8f\\u65b9\\u6cd5\\uff1a\\u5192\\u6ce1\\u6392\\u5e8f\\uff0c\\u9009\\u62e9\\u6392\\u5e8f\\uff0c\\u63d2\\u5165\\u6392\\u5e8f\\uff0c\\u5feb\\u901f\\u6392\\u5e8f\\uff0c\\u5f52\\u5e76\\u6392\\u5e8f\\uff0c\\u62d3\\u6251\\u6392\\u5e8f\\uff0c\\u5e0c\\u5c14\\u6392\\u5e8f\\u7b49\\u7b49\\u3002  \\n\\u6b64\\u9898\\u6211\\u5c06\\u5e26\\u7740\\u5927\\u5bb6\\u7528STL\\u5bb9\\u5668\\u6765\\u5b9e\\u73b0\\u6392\\u5e8f\\u7684\\u53bb\\u91cd\\u64cd\\u4f5c\\u3002   \\n\\n\\n### \\u7a0b\\u5e8f\\u6b65\\u9aa4\\n- \\u8f93\\u5165 $ n $ \\u6b21\\uff0c\\u6bcf\\u6b21\\u5c06\\u8f93\\u5165\\u6570\\u636e\\u653e\\u5165\\u5bb9\\u5668\\u91cc\\uff0c\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"Billy_L\"},\"datePublished\":\"2025-08-08T20:29:40+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解：P1059 [NOIP 2006 普及组] 明明的随机数\" />\n    <meta property=\"og:description\" content=\"整体思路\n这是一道典型的排序题，此题有多种排序方法：冒泡排序，选择排序，插入排序，快速排序，归并排序，拓扑排序，希尔排序等等。  \n此题我将带着大家用STL容器来实现排序的去重操作。   \n\n\n### 程序步骤\n- 输入 $ n $ 次，每次将输入数据放入容器里，…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"Billy_L\" />\n    <meta property=\"article:published_time\" content=\"2025-08-08T20:29:40+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/05bplzw1\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解：P1059 [NOIP 2006 普及组] 明明的随机数</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">Billy_L</a>\n            ·\n            <time datetime=\"2025-08-08T20:29:40+08:00\">2025-08-08 20:29:40</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <h3>整体思路</h3>\n<p>这是一道典型的<strong>排序</strong>题，此题有多种排序方法：冒泡排序，选择排序，插入排序，快速排序，归并排序，拓扑排序，希尔排序等等。  </p>\n<p>此题我将带着大家用<strong>STL容器</strong>来实现排序的<strong>去重操作</strong>。   </p>\n<la-tex display=\"block\">\n\n### 程序步骤\n- 输入 $ n $ 次，每次将输入数据放入容器里， $ set $ 可帮我们直接排序以及去重。\n\n- 输出容器长度以及容器每个元素的地址，即可完成排序。\n\n### 程序实现\n```cpp\n#include&lt;iostream&gt;\n#include&lt;set&gt;\n//set专属头文件 \nusing namespace std;\n\nset&lt;int&gt;s;\n//定义set容器\n\nint main()\n{\nint n;\ncin&gt;&gt;n;\nwhile(n--){\nint x;\ncin&gt;&gt;x;\n\n//进行插入操作 \ns.insert(x);\n\n//每次循环set都将去重排序 \n}\ncout&lt;&lt;s.size()&lt;&lt;endl;\n\n//auto必须开C++14及以上版本\nfor(auto it=s.begin();it!=s.end();it++){//s.begin()为容器的首元素，s.end()为容器的尾元素\n\ncout&lt;&lt;*it&lt;&lt;\" \";//最后输出it，即为容器每个元素的地址 \n\n}\nreturn 0;\n}\n```\n你们学会了吗？</la-tex>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a5ff125e2fce9013',t:'MTc5NTU5MzEyMw=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a5ff125e2fce9013',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
