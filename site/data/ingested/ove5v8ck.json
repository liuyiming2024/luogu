 "code_blocks": [
  "#include <iostream>\nusing namespace std;\nconst int MR(1001);    //n(即题目中的r)的最大值\nint map[MR][MR];    //保存输入数据\nint dp[MR][MR];    //最优解\nint n;\ninline int dmax(const int& a,const int& b)    //返回最大值\n{ return (a>b ? a : b); }\nint main()\n{\n    cin >> n;    //输入n\n    for(int i(1);i<=n;++i)\n        for(int j(1);j<=i;++j)\n            cin >> map[i][j];    //输入数据\n    for(int i(1);i<=n;++i)    dp[n][i] = map[n][i];   //初始化，最后一行数据的最优值即为其本身\n    for(int i(n-1);i>0;--i)\n        for(int j(1);j<=n;++j)\n        {\n            dp[i][j] = map[i][j] + dmax(dp[i+1][j], dp[i+1][j+1]);    //向上递推求出最优解\n        }\n    cout << dp[1][1];    //输出最优解\n    return 0;\n}",
  "using namespace std;\nconst int Mn(1002);    //n的最大值(定义成1002是为了便于处理边界)\nint dp[Mn][Mn];    //最优解\n/*边读边求所以省去了map数组*/\nint main()\n{\n    int n;\n    cin >> n;    //输入n\n    for(int i(1);i<=n;++i)\n        for(int j(1);j<=i;++j)\n        {\n            int tn; cin >> tn;    //输入数据\n            dp[i][j] = max(dp[i-1][j-1],dp[i-1][j]) + tn;    //求解最优解\n        }\n    int max(0);\n    for(int i(1);i<=n;++i)\n    if(dp[n][i] > max) max = dp[n][i];    //寻找最优解\n    cout << max;    //输出最优解\n    return 0;\n}"
 ],
 "sha256": "a03ba264c2dea0dd",
 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <meta name=\"csrf-token\" content=\"1795715953:yrABfIu81lzdbEBmqrR0RnYjaHgnN+khQOXDvaYTa1U=\">\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112601'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>题解 P1216 【[USACO1.5]数字三角形 Number Triangles】 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"ove5v8ck\",\"title\":\"\\u9898\\u89e3 P1216 \\u3010[USACO1.5]\\u6570\\u5b57\\u4e09\\u89d2\\u5f62 Number Triangles\\u3011\",\"category\":2,\"time\":1500700728,\"author\":{\"uid\":22911,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/22911.png\",\"name\":\"ajil\",\"slogan\":\"\\u5df2\\u7ecf\\u6ca1\\u6709\\u4ec0\\u4e48\\u597d\\u5bb3\\u6015\\u7684\\u4e86\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Gray\",\"ccfLevel\":0,\"xcpcLevel\":0,\"background\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/image_hosting\\/fm0chmz3.png\"},\"upvote\":1,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1216\",\"type\":\"P\",\"name\":\"[IOI 1994 \\/ USACO1.5] \\u6570\\u5b57\\u4e09\\u89d2\\u5f62 Number Triangles\",\"difficulty\":2,\"fullScore\":100},\"promoteStatus\":0,\"collection\":null,\"content\":\"\\u4e00\\u4e2a\\u7279\\u522b\\u7279\\u522b\\u7ecf\\u5178\\u7684\\u9898\\u76ee\\uff0c\\u53ef\\u4ee5\\u8bf4\\u662f\\u51e0\\u4e4e\\u662f\\u6bcf\\u4e2aOIER\\u63a5\\u89e6\\u7684\\u7b2c\\u4e00\\u9053\\u52a8\\u89c4\\u9898\\u3002\\n\\n**(\\u7531\\u4e8e\\u4e24\\u4e2a\\u4ee3\\u7801\\u662f\\u5206\\u4e24\\u6b21\\u5199\\u7684\\uff0c\\u6240\\u4ee5\\u53ef\\u80fd\\u98ce\\u683c\\u4e0d\\u592a\\u4e00\\u6837\\u2026\\u2026)**\\n\\n\\u5148\\u6765\\u770b\\u770b\\u8bb2\\u7684\\u6700\\u591a\\u7684\\u4e00\\u4e2a\\u65b9\\u6cd5\\uff1a\\n\\n##\\u4ece\\u5e95\\u5c42\\u5411\\u4e0a\\u63a8\\u51fa\\u6700\\u4f18\\u89e3\\n\\n\\u7528dp[i][j]\\u8868\\u793a\\u4ece(i,j)\\u5f00\\u59cb\\u7684\\u6700\\u4f18\\u89e3\\uff0c\\u90a3\\u4e48\\u7b54\\u6848\\u5373\\u662fdp[1][1]\\n\\n\\u72b6\\u6001\\u8f6c\\u79fb\\u65b9\\u7a0b: **dp[i][j] = max(dp[i+1][j], dp[i+1][j+1]) + map[i][j]**\\n\\n```cpp\\n#include \\u003Ciostream\\u003E\\nusing namespace std;\\nconst int MR(1001);    \\/\\/n(\\u5373\\u9898\\u76ee\\u4e2d\\u7684r)\\u7684\\u6700\\u5927\\u503c\\nint map[MR][MR];    \\/\\/\\u4fdd\\u5b58\\u8f93\\u5165\\u6570\\u636e\\nint dp[MR][MR];    \\/\\/\\u6700\\u4f18\\u89e3\\nint n;\\ninline int dmax(const int\\u0026 a,const int\\u0026 b)    \\/\\/\\u8fd4\\u56de\\u6700\\u5927\\u503c\\n{ return (a\\u003Eb ? a : b); }\\nint main()\\n{\\n    cin \\u003E\\u003E n;    \\/\\/\\u8f93\\u5165n\\n    for(int i(1);i\\u003C=n;++i)\\n        for(int j(1);j\\u003C=i;++j)\\n            cin \\u003E\\u003E map[i][j];    \\/\\/\\u8f93\\u5165\\u6570\\u636e\\n    for(int i(1);i\\u003C=n;++i)    dp[n][i] = map[n][i];   \\/\\/\\u521d\\u59cb\\u5316\\uff0c\\u6700\\u540e\\u4e00\\u884c\\u6570\\u636e\\u7684\\u6700\\u4f18\\u503c\\u5373\\u4e3a\\u5176\\u672c\\u8eab\\n    for(int i(n-1);i\\u003E0;--i)\\n        for(int j(1);j\\u003C=n;++j)\\n        {\\n            dp[i][j] = map[i][j] + dmax(dp[i+1][j], dp[i+1][j+1]);    \\/\\/\\u5411\\u4e0a\\u9012\\u63a8\\u6c42\\u51fa\\u6700\\u4f18\\u89e3\\n        }\\n    cout \\u003C\\u003C dp[1][1];    \\/\\/\\u8f93\\u51fa\\u6700\\u4f18\\u89e3\\n    return 0;\\n}\\n```\\n\\u4f18\\u70b9\\u662f\\u6700\\u4f18\\u89e3\\u7684\\u8868\\u793a\\u6bd4\\u8f83\\u5bb9\\u6613\\uff0c\\u4f46\\u7531\\u4e8e\\u662f\\u9006\\u5411\\u601d\\u8003\\u53ef\\u80fd\\u4e0d\\u592a\\u597d\\u5199\\n\\n\\n\\u7136\\u540e\\u662f\\u7b2c\\u4e8c\\u4e2a\\u65b9\\u6cd5\\uff1a\\n\\n##\\u4ece\\u9876\\u5c42\\u5f80\\u4e0b\\u63a8\\u51fa\\u6700\\u4f18\\u89e3\\n\\n\\u7528dp[i][j]\\u8868\\u793a\\u4ee5(i,j)\\u7ed3\\u675f\\u7684\\u6700\\u4f18\\u89e3\\uff0c\\u5219\\u6700\\u4f18\\u89e3\\u4e3a\\u6700\\u540e\\u4e00\\u884c\\u4e2ddp\\u7684\\u6700\\u5927\\u503c\\n\\n\\u72b6\\u6001\\u8f6c\\u79fb\\u65b9\\u7a0b: **dp[i][j] = max(dp[i-1][j-1],dp[i-1][j]) + map[i][j]**\\n\\n```cpp\\nusing namespace std;\\nconst int Mn(1002);    \\/\\/n\\u7684\\u6700\\u5927\\u503c(\\u5b9a\\u4e49\\u62101002\\u662f\\u4e3a\\u4e86\\u4fbf\\u4e8e\\u5904\\u7406\\u8fb9\\u754c)\\nint dp[Mn][Mn];    \\/\\/\\u6700\\u4f18\\u89e3\\n\\/*\\u8fb9\\u8bfb\\u8fb9\\u6c42\\u6240\\u4ee5\\u7701\\u53bb\\u4e86map\\u6570\\u7ec4*\\/\\nint main()\\n{\\n    int n;\\n    cin \\u003E\\u003E n;    \\/\\/\\u8f93\\u5165n\\n    for(int i(1);i\\u003C=n;++i)\\n        for(int j(1);j\\u003C=i;++j)\\n        {\\n            int tn; cin \\u003E\\u003E tn;    \\/\\/\\u8f93\\u5165\\u6570\\u636e\\n            dp[i][j] = max(dp[i-1][j-1],dp[i-1][j]) + tn;    \\/\\/\\u6c42\\u89e3\\u6700\\u4f18\\u89e3\\n        }\\n    int max(0);\\n    for(int i(1);i\\u003C=n;++i)\\n    if(dp[n][i] \\u003E max) max = dp[n][i];    \\/\\/\\u5bfb\\u627e\\u6700\\u4f18\\u89e3\\n    cout \\u003C\\u003C max;    \\/\\/\\u8f93\\u51fa\\u6700\\u4f18\\u89e3\\n    return 0;\\n}\\n```\\n\\u4f18\\u70b9\\u662f\\u53ef\\u4ee5\\u8fb9\\u8bfb\\u8fb9\\u6c42\\u89e3\\uff0c\\u4f46\\u6700\\u4f18\\u89e3\\u7684\\u8868\\u793a\\u6bd4\\u8f83\\u9ebb\\u70e6\\n\\n\\u6240\\u4ee5\\u5199\\u52a8\\u89c4\\u9898\\u65f6\\u8981\\u6ce8\\u610f\\u72b6\\u6001\\u7684\\u8868\\u793a\\u548c\\u9012\\u63a8\\u987a\\u5e8f\\uff0c\\u56e0\\u4e3a\\u5bf9\\u4e8e\\u4e00\\u9053\\u9898\\u72b6\\u6001\\u5b9a\\u4e49\\u7684\\u4e0d\\u540c\\u4f1a\\u5bfc\\u81f4\\u4ee3\\u7801\\u4e0a\\u7684\\u8f83\\u5927\\u5dee\\u522b\\n\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795629553.835799}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/ove5v8ck\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1216 \\u3010[USACO1.5]\\u6570\\u5b57\\u4e09\\u89d2\\u5f62 Number Triangles\\u3011\",\"description\":\"\\u4e00\\u4e2a\\u7279\\u522b\\u7279\\u522b\\u7ecf\\u5178\\u7684\\u9898\\u76ee\\uff0c\\u53ef\\u4ee5\\u8bf4\\u662f\\u51e0\\u4e4e\\u662f\\u6bcf\\u4e2aOIER\\u63a5\\u89e6\\u7684\\u7b2c\\u4e00\\u9053\\u52a8\\u89c4\\u9898\\u3002\\n(\\u7531\\u4e8e\\u4e24\\u4e2a\\u4ee3\\u7801\\u662f\\u5206\\u4e24\\u6b21\\u5199\\u7684\\uff0c\\u6240\\u4ee5\\u53ef\\u80fd\\u98ce\\u683c\\u4e0d\\u592a\\u4e00\\u6837\\u2026\\u2026)\\n\\u5148\\u6765\\u770b\\u770b\\u8bb2\\u7684\\u6700\\u591a\\u7684\\u4e00\\u4e2a\\u65b9\\u6cd5\\uff1a\\n\\u4ece\\u5e95\\u5c42\\u5411\\u4e0a\\u63a8\\u51fa\\u6700\\u4f18\\u89e3\\n\\u7528dp[i][j]\\u8868\\u793a\\u4ece(i,j)\\u5f00\\u59cb\\u7684\\u6700\\u4f18\\u89e3\\uff0c\\u90a3\\u4e48\\u7b54\\u6848\\u5373\\u662fdp[1][1]\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"ajil\"},\"datePublished\":\"2017-07-22T13:18:48+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1216 【[USACO1.5]数字三角形 Number Triangles】\" />\n    <meta property=\"og:description\" content=\"一个特别特别经典的题目，可以说是几乎是每个OIER接触的第一道动规题。\n(由于两个代码是分两次写的，所以可能风格不太一样……)\n先来看看讲的最多的一个方法：\n从底层向上推出最优解\n用dp[i][j]表示从(i,j)开始的最优解，那么答案即是dp[1][1]…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"ajil\" />\n    <meta property=\"article:published_time\" content=\"2017-07-22T13:18:48+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/ove5v8ck\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1216 【[USACO1.5]数字三角形 Number Triangles】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">ajil</a>\n            ·\n            <time datetime=\"2017-07-22T13:18:48+08:00\">2017-07-22 13:18:48</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>一个特别特别经典的题目，可以说是几乎是每个OIER接触的第一道动规题。</p>\n<p><strong>(由于两个代码是分两次写的，所以可能风格不太一样……)</strong></p>\n<p>先来看看讲的最多的一个方法：</p>\n<h2>从底层向上推出最优解</h2>\n<p>用dp[i][j]表示从(i,j)开始的最优解，那么答案即是dp[1][1]</p>\n<p>状态转移方程: <strong>dp[i][j] = max(dp[i+1][j], dp[i+1][j+1]) + map[i][j]</strong></p>\n<pre><code class=\"language-cpp\">#include &lt;iostream&gt;\nusing namespace std;\nconst int MR(1001);    //n(即题目中的r)的最大值\nint map[MR][MR];    //保存输入数据\nint dp[MR][MR];    //最优解\nint n;\ninline int dmax(const int&amp; a,const int&amp; b)    //返回最大值\n{ return (a&gt;b ? a : b); }\nint main()\n{\n    cin &gt;&gt; n;    //输入n\n    for(int i(1);i&lt;=n;++i)\n        for(int j(1);j&lt;=i;++j)\n            cin &gt;&gt; map[i][j];    //输入数据\n    for(int i(1);i&lt;=n;++i)    dp[n][i] = map[n][i];   //初始化，最后一行数据的最优值即为其本身\n    for(int i(n-1);i&gt;0;--i)\n        for(int j(1);j&lt;=n;++j)\n        {\n            dp[i][j] = map[i][j] + dmax(dp[i+1][j], dp[i+1][j+1]);    //向上递推求出最优解\n        }\n    cout &lt;&lt; dp[1][1];    //输出最优解\n    return 0;\n}</code></pre>\n<p>优点是最优解的表示比较容易，但由于是逆向思考可能不太好写</p>\n<p>然后是第二个方法：</p>\n<h2>从顶层往下推出最优解</h2>\n<p>用dp[i][j]表示以(i,j)结束的最优解，则最优解为最后一行中dp的最大值</p>\n<p>状态转移方程: <strong>dp[i][j] = max(dp[i-1][j-1],dp[i-1][j]) + map[i][j]</strong></p>\n<pre><code class=\"language-cpp\">using namespace std;\nconst int Mn(1002);    //n的最大值(定义成1002是为了便于处理边界)\nint dp[Mn][Mn];    //最优解\n/*边读边求所以省去了map数组*/\nint main()\n{\n    int n;\n    cin &gt;&gt; n;    //输入n\n    for(int i(1);i&lt;=n;++i)\n        for(int j(1);j&lt;=i;++j)\n        {\n            int tn; cin &gt;&gt; tn;    //输入数据\n            dp[i][j] = max(dp[i-1][j-1],dp[i-1][j]) + tn;    //求解最优解\n        }\n    int max(0);\n    for(int i(1);i&lt;=n;++i)\n    if(dp[n][i] &gt; max) max = dp[n][i];    //寻找最优解\n    cout &lt;&lt; max;    //输出最优解\n    return 0;\n}</code></pre>\n<p>优点是可以边读边求解，但最优解的表示比较麻烦</p>\n<p>所以写动规题时要注意状态的表示和递推顺序，因为对于一道题状态定义的不同会导致代码上的较大差别</p>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6028bc67d56cf26',t:'MTc5NTYyOTU1Mw=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6028bc67d56cf26',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
