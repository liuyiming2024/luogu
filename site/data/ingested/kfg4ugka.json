 "code_blocks": [
  "#include<bits/stdc++.h>\nusing namespace std;\n\nchar j;\nlong long int a,b,c,d,e,f,g,h,i,k,l;\n\nint main()\n{\n    scanf(\"%1d-%1d%1d%1d-%1d%1d%1d%1d%1d-%c\",&a,&b,&c,&d,&e,&f,&g,&h,&i,&j);\n\n\n    k=(a*1+b*2+c*3+d*4+e*5+f*6+g*7+h*8+i*9)%11;\n    if(j=='X')\n        l=10;\n    else\n        l=j-'0';\n\n\n    if(k==l)\n    cout<<\"Right\";\n    else if(k==10)\n        cout<<a<<\"-\"<<b<<c<<d<<\"-\"<<e<<f<<g<<h<<i<<\"-X\";\n    else\n        cout<<a<<\"-\"<<b<<c<<d<<\"-\"<<e<<f<<g<<h<<i<<\"-\"<<k;\n\n\n    return 0;\n}"
 ],
 "sha256": "513ea0b59c81efe6",
 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <meta name=\"csrf-token\" content=\"1795679521:DqRZt8+R8SxTimjs3D1LcT4hmt2dKNZB4ulJnxrTveg=\">\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112514'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>题解P1055 [NOIP 2008 普及组] ISBN 号码 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"kfg4ugka\",\"title\":\"\\u9898\\u89e3P1055 [NOIP 2008 \\u666e\\u53ca\\u7ec4] ISBN \\u53f7\\u7801\",\"category\":2,\"time\":1739182651,\"author\":{\"uid\":1413309,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/1413309.png\",\"name\":\"makeway\",\"slogan\":\"\\u7b7e\\u540d\\uff1a\\u6211\\u4ecd\\u672a\\u77e5\\u9053C++\\u7684\\u6837\\u5b50|\\u5e7f\\u544a\\uff1a\\u6c42\\u4e92\\u5173\\u2757QAQ Hello world!\\u5168\\u6d1b\\u8c37\\u5012\\u6570\\u7b2c\\u4e00C++\\u4e00\\u584c\\u7cca\\u6d82\\u2016\\u849f\\u84bb\\u4e00\\u53ea\\uff0c\\u6c42\\u52a0\\u56e2https:\\/\\/www.luogu.com.cn\\/team\\/87533 and99368|yuruoxin001\\u9001\\u7684\\u9ad8\\u7ea7\\u56e2\\u961f\\u4e48\\u4e48\\u54d2\\u3002\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Blue\",\"ccfLevel\":0,\"xcpcLevel\":0,\"background\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/image_hosting\\/a4yva54e.png\"},\"upvote\":1,\"replyCount\":1,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1055\",\"type\":\"P\",\"name\":\"[NOIP 2008 \\u666e\\u53ca\\u7ec4] ISBN \\u53f7\\u7801\",\"difficulty\":2,\"fullScore\":100},\"promoteStatus\":0,\"collection\":null,\"content\":\"#### makeway\\u849f\\u84bb\\u96be\\u5ea6\\u8bc4\\u4f30\\uff1a\\u8fd9\\u662f\\u4e00\\u9053\\u4ee4\\u4eba\\u5410\\u8840\\u7684\\u5206\\u652f\\u9898\\u3002\\n# \\u7b2c\\u4e00\\u90e8\\u5206[\\u9898\\u76ee\\u5206\\u6790]\\n##### 1. \\u8f93\\u5165\\uff1a\\u4e00\\u4e32ISBN\\u53f7\\u7801|\\u683c\\u5f0f\\u4e3ax-xxx-xxxxx-x\\n##### 2. \\u8f93\\u51fa\\uff1a\\n\\n```cpp\\n if(\\u7b26\\u5408\\u8981\\u6c42)cout\\u003C\\u003C\\u0022Right\\u0022;\\n else cout\\u003C\\u003C\\u0022\\u6b63\\u786e\\u53f7\\u7801\\u0022;\\n```\\n\\n##### 3.\\u8981\\u6c42\\uff1a\\n- ##### \\u9996\\u4f4d\\u6570\\u5b57\\u4e58\\u4ee51\\u52a0\\u7b2c2\\u4f4d\\u6570\\u5b57\\u4e58\\u4ee52\\u2026\\u2026\\u4ee5\\u6b64\\u7c7b\\u63a8\\uff0c\\u7528\\u6240\\u5f97\\u7684\\u7ed3\\u679c\\u53d6\\u4f5911\\u6240\\u5f97\\u7684\\u4f59\\u6570\\u5373\\u4e3a\\u8bc6\\u522b\\u7801\\u3002\\n- #####  \\u5982\\u679c\\u4f59\\u6570\\u4e3a 10\\uff0c\\u5219\\u8bc6\\u522b\\u7801\\u4e3a\\u5927\\u5199\\u5b57\\u6bcdX\\u3002\\n# \\u7b2c\\u4e8c\\u90e8\\u5206[coding\\u601d\\u8def]\\n1. ##### \\u5b9a\\u4e49\\u4e00\\u4e9bshort int\\u6570\\u636e\\u6765\\u5b58\\u6bcf\\u4e2a\\u6570\\u5b57\\uff0c\\u4e00\\u4e2achar\\u6765\\u5b58\\u6700\\u540e\\u4e00\\u4e2a\\u6570\\u636e\\uff0c\\u4e0d\\u5fc5\\u7528string\\u3002\\n1. #### \\uff08most important\\uff1a\\u53ef\\u4ee5\\u6309\\u89c4\\u5219\\u5148\\u7b97\\u51fa\\u6b63\\u786e\\u7684\\u8bc6\\u522b\\u7801\\uff0c\\u7136\\u540e\\u4e0e\\u5b9e\\u9645\\u7684\\u8bc6\\u522b\\u7801\\u6bd4\\u5bf9\\uff0c\\u5982\\u679c\\u4e00\\u81f4\\u8bf4\\u660e\\u662f\\u5bf9\\u7684\\u8f93\\u51fa\\u201cRight\\u201d\\u3002\\u5426\\u5219\\u9519\\u8bef\\uff0c\\u628a\\u539f\\u6765\\u7684\\u7684\\u8bc6\\u522b\\u7801\\u6362\\u6210\\u6b63\\u786e\\u7684\\u8bc6\\u522b\\u7801\\uff0c\\u8f93\\u51fa\\u3002|\\u5b8c\\u4e8b~~~~\\uff09\\n# \\u7b2c\\u4e09\\u90e8\\u5206[\\u7f16\\u5199\\u4ee3\\u7801]\\n\\n#### makeway\\u559c\\u6b22\\u7528\\u6570\\u5b66\\u601d\\u7ef4\\u89e3\\u51b3\\u95ee\\u9898\\uff0c\\u6070\\u597dC++\\u662f\\u7ed3\\u6784\\u5316\\u7f16\\u7a0b\\u3002\\u628a\\u529f\\u80fd\\u533a\\u5206\\u5f00\\u867d\\u7136\\u5728OI\\u4e2d\\u4e0d\\u600e\\u4e48\\u6d41\\u884c\\uff0c\\u4f46\\u8fd9\\u7684\\u786e\\u53ef\\u4ee5\\u8ba9\\u4ee3\\u7801\\u66f4\\u597d\\u3002\\n#### \\n### \\u8f93\\u5165\\n\\n```cpp\\nscanf(\\u0022%1d-%1d%1d%1d-%1d%1d%1d%1d%1d-%c\\u0022,\\u0026a,\\u0026b,\\u0026c,\\u0026d,\\u0026e,\\u0026f,\\u0026g,\\u0026h,\\u0026i,\\u0026j);\\n\\/\\/or\\n\\/\\/\\u5b9a\\u4e49\\u4e00\\u4e2achar\\u6765\\u5438\\u6536\\u591a\\u4f59\\u7684\\u201c-\\u201d,\\u6ce8\\u610f\\u4f4d\\u7f6e\\u653e\\u5bf9\\u3002\\n```\\n### \\u6700\\u540e\\u4e00\\u4f4d\\u5b57\\u7b26\\u7684\\u5904\\u7406\\u4e0e\\u8ba1\\u7b97\\u6b63\\u786e\\u7684\\u8bc6\\u522b\\u7801\\uff1a\\n\\n```cpp\\n    k=(a*1+b*2+c*3+d*4+e*5+f*6+g*7+h*8+i*9)%11;\\/\\/\\u8ba1\\u7b97\\u8bc6\\u522b\\u7801\\n    if(j==\\u0027X\\u0027)\\n         l=10;\\/\\/\\u0027X\\u0027\\u65f6\\u8bc6\\u522b\\u7801\\u4e3a10\\n    else\\n         l=j-\\u00270\\u0027;\\/\\/\\u5426\\u5219\\u628achar\\u91cc\\u7684\\u6570\\u636e\\u8f6c\\u6210int\\u518d\\u5b58\\u8fdb\\u8bc6\\u522b\\u7801\\u91cc\\n\\nPS:X-\\u00270\\u0027\\u53ef\\u4ee5\\u628achar\\u91cc\\u7684\\u6570\\u5b57\\u8f6c\\u6210int\\u3002\\n```\\n### \\u5224\\u65ad\\u6b63\\u8bef\\u4e0e\\u8f93\\u51fa\\uff1a\\n\\n```cpp\\n if(k==l)\\n    cout\\u003C\\u003C\\u0022Right\\u0022;\\/\\/\\u8bc6\\u522b\\u7801\\u4e00\\u81f4\\uff0c\\u8f93\\u51fa\\u6b63\\u786e\\n \\/\\/\\u4ee5\\u4e0b\\u662f\\u9519\\u8bef\\u65f6\\u3002\\n    else if(k==10)cout\\u003C\\u003Ca\\u003C\\u003C\\u0022-\\u0022\\u003C\\u003Cb\\u003C\\u003Cc\\u003C\\u003Cd\\u003C\\u003C\\u0022-\\u0022\\u003C\\u003Ce\\u003C\\u003Cf\\u003C\\u003Cg\\u003C\\u003Ch\\u003C\\u003Ci\\u003C\\u003C\\u0022-X\\u0022;\\/\\/\\u8bc6\\u522b\\u7801\\u662f10\\u65f6\\u6539\\u5199\\u6210X\\n    else cout\\u003C\\u003Ca\\u003C\\u003C\\u0022-\\u0022\\u003C\\u003Cb\\u003C\\u003Cc\\u003C\\u003Cd\\u003C\\u003C\\u0022-\\u0022\\u003C\\u003Ce\\u003C\\u003Cf\\u003C\\u003Cg\\u003C\\u003Ch\\u003C\\u003Ci\\u003C\\u003C\\u0022-\\u0022\\u003C\\u003Ck;\\/\\/\\u5176\\u4ed6\\u60c5\\u51b5\\n```\\n# \\u7b2c\\u56db\\u90e8\\u5206[\\u7ec4\\u88c5\\u4ee3\\u7801]\\n#### \\u88c5\\u5728\\u4e00\\u8d77\\u5b8c\\u4e8b......\\n\\n## AC\\u4ee3\\u7801\\u5949\\u4e0a\\uff1a\\n\\n```cpp\\n#include\\u003Cbits\\/stdc++.h\\u003E\\nusing namespace std;\\n\\nchar j;\\nlong long int a,b,c,d,e,f,g,h,i,k,l;\\n\\nint main()\\n{\\n    scanf(\\u0022%1d-%1d%1d%1d-%1d%1d%1d%1d%1d-%c\\u0022,\\u0026a,\\u0026b,\\u0026c,\\u0026d,\\u0026e,\\u0026f,\\u0026g,\\u0026h,\\u0026i,\\u0026j);\\n\\n\\n\\tk=(a*1+b*2+c*3+d*4+e*5+f*6+g*7+h*8+i*9)%11;\\n\\tif(j==\\u0027X\\u0027)\\n\\t\\tl=10;\\n    else\\n\\t\\tl=j-\\u00270\\u0027;\\n\\n\\n\\tif(k==l)\\n    cout\\u003C\\u003C\\u0022Right\\u0022;\\n    else if(k==10)\\n\\t    cout\\u003C\\u003Ca\\u003C\\u003C\\u0022-\\u0022\\u003C\\u003Cb\\u003C\\u003Cc\\u003C\\u003Cd\\u003C\\u003C\\u0022-\\u0022\\u003C\\u003Ce\\u003C\\u003Cf\\u003C\\u003Cg\\u003C\\u003Ch\\u003C\\u003Ci\\u003C\\u003C\\u0022-X\\u0022;\\n    else\\n\\t    cout\\u003C\\u003Ca\\u003C\\u003C\\u0022-\\u0022\\u003C\\u003Cb\\u003C\\u003Cc\\u003C\\u003Cd\\u003C\\u003C\\u0022-\\u0022\\u003C\\u003Ce\\u003C\\u003Cf\\u003C\\u003Cg\\u003C\\u003Ch\\u003C\\u003Ci\\u003C\\u003C\\u0022-\\u0022\\u003C\\u003Ck;\\n\\n\\n\\treturn 0;\\n}\\n```\\n# \\u7b2c\\u56db\\u90e8\\u5206\\u3010\\u5c3e\\u58f0\\u3011\\n#### \\u6709\\u671b\\u5404\\u8def\\u5927\\u4f6c\\u5e2e\\u52a9\\u6211\\u5b66C++\\u3002\\u3002\\u3002\\n#### \\u770b\\u5230\\u6b64\\u7bc7\\u9898\\u89e3\\u8bf4\\u660e\\u4f60\\u6211\\u6709\\u7f18\\u5206\\uff0c\\u8fa3\\u4e48\\u5173\\u6ce8\\u4e00\\u4e0b\\u6211\\u5427\\uff0cqwq\\u3002\\n#### I am makeway.\\u6211\\u5728C++\\u7684\\u6d77\\u6d0b\\u91cc\\u7b49\\u4f60\\u54e6\\u3002\\u3002\\u3002\\n\\n## \\u5b8c\\u7ed3\\u6492\\u82b1~~~~~~~~return 0;\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795593121.206431}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/kfg4ugka\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3P1055 [NOIP 2008 \\u666e\\u53ca\\u7ec4] ISBN \\u53f7\\u7801\",\"description\":\"makeway\\u849f\\u84bb\\u96be\\u5ea6\\u8bc4\\u4f30\\uff1a\\u8fd9\\u662f\\u4e00\\u9053\\u4ee4\\u4eba\\u5410\\u8840\\u7684\\u5206\\u652f\\u9898\\u3002\\n\\u7b2c\\u4e00\\u90e8\\u5206[\\u9898\\u76ee\\u5206\\u6790]\\n1. \\u8f93\\u5165\\uff1a\\u4e00\\u4e32ISBN\\u53f7\\u7801|\\u683c\\u5f0f\\u4e3ax-xxx-xxxxx-x\\n2. \\u8f93\\u51fa\\uff1a\\n if(\\u7b26\\u5408\\u8981\\u6c42)cout&lt;&lt;\\\"Right\\\";\\n else cout&lt;&lt;\\\"\\u6b63\\u786e\\u53f7\\u7801\\\";\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"makeway\"},\"datePublished\":\"2025-02-10T18:17:31+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解P1055 [NOIP 2008 普及组] ISBN 号码\" />\n    <meta property=\"og:description\" content=\"makeway蒟蒻难度评估：这是一道令人吐血的分支题。\n第一部分[题目分析]\n1. 输入：一串ISBN号码|格式为x-xxx-xxxxx-x\n2. 输出：\n if(符合要求)cout&amp;lt;&amp;lt;&quot;Right&quot;;\n else cout&amp;lt;&amp;lt;&quot;正确号码&quot;;…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"makeway\" />\n    <meta property=\"article:published_time\" content=\"2025-02-10T18:17:31+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/kfg4ugka\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解P1055 [NOIP 2008 普及组] ISBN 号码</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">makeway</a>\n            ·\n            <time datetime=\"2025-02-10T18:17:31+08:00\">2025-02-10 18:17:31</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <h4>makeway蒟蒻难度评估：这是一道令人吐血的分支题。</h4>\n<h1>第一部分[题目分析]</h1>\n<h5>1. 输入：一串ISBN号码|格式为x-xxx-xxxxx-x</h5>\n<h5>2. 输出：</h5>\n<pre><code class=\"language-cpp\"> if(符合要求)cout&lt;&lt;\"Right\";\n else cout&lt;&lt;\"正确号码\";</code></pre>\n<h5>3.要求：</h5>\n<ul>\n<li>\n<h5>首位数字乘以1加第2位数字乘以2……以此类推，用所得的结果取余11所得的余数即为识别码。</h5>\n</li>\n<li>\n<h5>如果余数为 10，则识别码为大写字母X。</h5>\n<h1>第二部分[coding思路]</h1>\n</li>\n</ul>\n<ol>\n<li>\n<h5>定义一些short int数据来存每个数字，一个char来存最后一个数据，不必用string。</h5>\n</li>\n<li>\n<h4>（most important：可以按规则先算出正确的识别码，然后与实际的识别码比对，如果一致说明是对的输出“Right”。否则错误，把原来的的识别码换成正确的识别码，输出。|完事~~~~）</h4>\n<h1>第三部分[编写代码]</h1>\n</li>\n</ol>\n<h4>makeway喜欢用数学思维解决问题，恰好C++是结构化编程。把功能区分开虽然在OI中不怎么流行，但这的确可以让代码更好。</h4>\n<h4></h4>\n<h3>输入</h3>\n<pre><code class=\"language-cpp\">scanf(\"%1d-%1d%1d%1d-%1d%1d%1d%1d%1d-%c\",&amp;a,&amp;b,&amp;c,&amp;d,&amp;e,&amp;f,&amp;g,&amp;h,&amp;i,&amp;j);\n//or\n//定义一个char来吸收多余的“-”,注意位置放对。</code></pre>\n<h3>最后一位字符的处理与计算正确的识别码：</h3>\n<pre><code class=\"language-cpp\">    k=(a*1+b*2+c*3+d*4+e*5+f*6+g*7+h*8+i*9)%11;//计算识别码\n    if(j=='X')\n         l=10;//'X'时识别码为10\n    else\n         l=j-'0';//否则把char里的数据转成int再存进识别码里\n\nPS:X-'0'可以把char里的数字转成int。</code></pre>\n<h3>判断正误与输出：</h3>\n<pre><code class=\"language-cpp\"> if(k==l)\n    cout&lt;&lt;\"Right\";//识别码一致，输出正确\n //以下是错误时。\n    else if(k==10)cout&lt;&lt;a&lt;&lt;\"-\"&lt;&lt;b&lt;&lt;c&lt;&lt;d&lt;&lt;\"-\"&lt;&lt;e&lt;&lt;f&lt;&lt;g&lt;&lt;h&lt;&lt;i&lt;&lt;\"-X\";//识别码是10时改写成X\n    else cout&lt;&lt;a&lt;&lt;\"-\"&lt;&lt;b&lt;&lt;c&lt;&lt;d&lt;&lt;\"-\"&lt;&lt;e&lt;&lt;f&lt;&lt;g&lt;&lt;h&lt;&lt;i&lt;&lt;\"-\"&lt;&lt;k;//其他情况</code></pre>\n<h1>第四部分[组装代码]</h1>\n<h4>装在一起完事......</h4>\n<h2>AC代码奉上：</h2>\n<pre><code class=\"language-cpp\">#include&lt;bits/stdc++.h&gt;\nusing namespace std;\n\nchar j;\nlong long int a,b,c,d,e,f,g,h,i,k,l;\n\nint main()\n{\n    scanf(\"%1d-%1d%1d%1d-%1d%1d%1d%1d%1d-%c\",&amp;a,&amp;b,&amp;c,&amp;d,&amp;e,&amp;f,&amp;g,&amp;h,&amp;i,&amp;j);\n\n\n    k=(a*1+b*2+c*3+d*4+e*5+f*6+g*7+h*8+i*9)%11;\n    if(j=='X')\n        l=10;\n    else\n        l=j-'0';\n\n\n    if(k==l)\n    cout&lt;&lt;\"Right\";\n    else if(k==10)\n        cout&lt;&lt;a&lt;&lt;\"-\"&lt;&lt;b&lt;&lt;c&lt;&lt;d&lt;&lt;\"-\"&lt;&lt;e&lt;&lt;f&lt;&lt;g&lt;&lt;h&lt;&lt;i&lt;&lt;\"-X\";\n    else\n        cout&lt;&lt;a&lt;&lt;\"-\"&lt;&lt;b&lt;&lt;c&lt;&lt;d&lt;&lt;\"-\"&lt;&lt;e&lt;&lt;f&lt;&lt;g&lt;&lt;h&lt;&lt;i&lt;&lt;\"-\"&lt;&lt;k;\n\n\n    return 0;\n}</code></pre>\n<h1>第四部分【尾声】</h1>\n<h4>有望各路大佬帮助我学C++。。。</h4>\n<h4>看到此篇题解说明你我有缘分，辣么关注一下我吧，qwq。</h4>\n<h4>I am makeway.我在C++的海洋里等你哦。。。</h4>\n<h2>完结撒花<del>~</del>~~~return 0;</h2>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a5ff124eba3ef29d',t:'MTc5NTU5MzEyMQ=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a5ff124eba3ef29d',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
