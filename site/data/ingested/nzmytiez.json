 "code_blocks": [
  "for (int i = 1; i <= n; i++) {\n    long long ans2 = 0;\n    for (int j = 0; j < k; j++) {\n        ans2 += cxk[i + j];\n    }\n    maxx = max(maxx, ans2);\n}",
  "a = 0, b = a + k;\nfor (int i = a; i < b; i++)\n    ans2 += cxk[i];\nfor (int i = 1; i <= n - k; i++) {\n    ans2 = ans2 + cxk[b] - cxk[a];\n    maxx = max(maxx, ans2);\n    a++, b++;\n}",
  "cout << ans - maxx;",
  "#include <bits/stdc++.h>\nusing namespace std;\nint n, k, a, b;\nlong long cxk[1000010], ans, maxx, ans2;",
  "ios::sync_with_stdio(false);\ncin >> n >> k;\nfor (int i = 1; i <= n - 1; i++)\n   cin >> cxk[i], ans += cxk[i];"
 ],
 "sha256": "6e470d6974144829",
 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <!-- 匿名页面令牌已移除（公开归档不保留） -->\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112609'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>题解 P5638 【【CSGRound2】光骓者的荣耀】 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"nzmytiez\",\"title\":\"\\u9898\\u89e3 P5638 \\u3010\\u3010CSGRound2\\u3011\\u5149\\u9a93\\u8005\\u7684\\u8363\\u8000\\u3011\",\"category\":2,\"time\":1573342914,\"author\":{\"uid\":156934,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/156934.png\",\"name\":\"Anyexyz\",\"slogan\":\"\\u81ea\\u5df1\\u9009\\u7684\\u8def\\uff0c\\u54ea\\u6015\\u4e00\\u8def\\u90fd\\u662f\\u6697\\u591c\\u4e5f\\u8981\\u8d70\\u5230\\u5e95\\u3002\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Gray\",\"ccfLevel\":0,\"xcpcLevel\":0,\"background\":\"\"},\"upvote\":3,\"replyCount\":2,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P5638\",\"type\":\"P\",\"name\":\"\\u3010CSGRound2\\u3011\\u5149\\u9a93\\u8005\\u7684\\u8363\\u8000\",\"difficulty\":2,\"fullScore\":100},\"promoteStatus\":0,\"collection\":null,\"content\":\"### \\u9898\\u89e3\\u539f\\u56e0\\n\\u8fd9\\u7bc7\\u9898\\u89e3\\u65e8\\u5728\\u5e2e\\u52a9\\u7406\\u89e3\\uff0cdalao\\u8bf7\\u5ffd\\u89c6\\u3002\\n\\n\\u56e0\\u4e3a\\u8fd9\\u662f\\u4e00\\u9053$\\\\color{red}\\\\text{\\u7ea2\\u9898}$\\uff0c~~\\u6240\\u4ee5\\u6211\\u5728\\u8fd9\\u91cc\\u8bb2\\u8ff0\\u7684\\u8be6\\u7ec6\\u4e00\\u70b9\\u3002~~\\n\\n## \\u9898\\u76ee\\u7b80\\u4ecb\\n\\n\\u6709 $n$ \\u4e2a\\u57ce\\u5e02\\uff0c\\u6bcf\\u4e24\\u4e2a\\u57ce\\u5e02\\u4e4b\\u95f4\\u6709\\u53cc\\u5411\\u901a\\u8def\\uff0c\\u8017\\u8d39\\u65f6\\u95f4 $a_{i}$ **(\\u5176\\u5b9e\\u53ef\\u4ee5\\u7406\\u89e3\\u4e3a\\u957f\\u5ea6\\u4e3a $a_{i}$ )** \\uff0c\\u5c0fK\\u4ece ${1-n}$ \\u8d70\\u8bbf **(\\u53ef\\u4ee5\\u7406\\u89e3\\u4e3a\\u4ece1\\u8d70\\u5230 n )**\\u3002\\n\\n\\u4f46\\u662f\\u5c0fK\\u53ef\\u4ee5\\u4ece\\u7b2c $i$ \\u4e2a\\u57ce\\u5e02\\u76f4\\u63a5\\u8df3\\u8f6c\\u5230\\u7b2c $i-k$ \\u6216 $i+k$ \\u3002(\\u53ea\\u53ef\\u4f7f\\u7528\\u4e00\\u6b21)\\n\\n~~\\u6ce8\\u610f\\uff1a\\u4ed6\\u53ef\\u4ee5\\u4e0d\\u8bbf\\u95ee\\u6240\\u6709\\u7684\\u57ce\\u5e02\\uff0c\\u4f7f\\u7528\\u4f20\\u9001\\u5668\\u4e0d\\u8017\\u8d39\\u65f6\\u95f4~~ **(\\u8fd9\\u53e5\\u8bdd\\u610f\\u5473\\u7740\\u4e0a\\u9762\\u7684\\u8df3\\u8f6c\\u65b9\\u6848\\u7684\\u601d\\u8def\\u662f\\u6b63\\u786e\\u7684\\uff0c\\u6bd4\\u5982\\u6211\\u5b8c\\u5168\\u53ef\\u4ee5\\u4ece\\u57ce\\u5e02 1 \\u8df3\\u5230\\u57ce\\u5e02 4 \\uff0c\\u53ea\\u8981\\u4f7f\\u5c0fK\\u8d70\\u8fc7\\u7684\\u603b\\u957f\\u5ea6\\u6700\\u77ed\\u5c31\\u53ef\\u4ee5)**\\n\\n\\u6c42\\u6700\\u5feb\\u7684\\u7528\\u65f6 **(\\u5373\\u6c42\\u6700\\u77ed\\u7684\\u8d70\\u8def\\u957f\\u5ea6)**\\u3002\\n\\n## \\u601d\\u8def\\u5206\\u6790\\n\\n\\u7ed3\\u5408\\u6837\\u4f8b\\uff0c\\u6211\\u4eec\\u53ef\\u4ee5\\u53d1\\u73b0\\uff0c\\u6211\\u4eec\\u6700\\u7ec8\\u8d70\\u8fc7\\u7684\\u957f\\u5ea6\\u5c31\\u662f$\\\\color{red}\\\\text{\\u603b\\u957f\\u5ea6-\\u8df3\\u8f6c\\u7684\\u957f\\u5ea6}$\\uff0c\\u8f93\\u5165\\u7684 $k$ \\u5373\\u4e3a\\u6211\\u4eec\\u8df3\\u8f6c\\u7684\\u8303\\u56f4\\u3002\\n\\n\\u603b\\u957f\\u5ea6\\u4f7f\\u4e00\\u4e2a\\u56fa\\u5b9a\\u503c\\uff0c\\u5373\\u6240\\u6709\\u8def\\u5f84\\u7684\\u957f\\u5ea6\\u548c\\u3002\\n\\n\\u90a3\\u4e48\\u8981\\u4f7f\\u5f97\\u6700\\u7ec8\\u8d70\\u8fc7\\u7684\\u957f\\u5ea6\\u6700\\u77ed\\uff0c\\u53ea\\u9700\\u4f7f\\u8df3\\u8f6c\\u7684\\u957f\\u5ea6\\u6700\\u5927\\u3002\\n\\n\\u6211\\u4eec\\u53ea\\u9700\\u8981\\u5728\\u6240\\u7ed9\\u7684 $a_{i}$ \\u4e2d\\u9009\\u53d6 $k$ \\u4e2a\\u6570\\uff0c\\u4f7f\\u5f97 $\\\\sum\\\\limits_{i=x}^{x+k}a_i$ \\u7684\\u503c\\u6700\\u5927\\u5373\\u53ef\\u3002\\n\\n\\u6211\\u4eec\\u53ef\\u4ee5\\u679a\\u4e3e\\u6bcf\\u4e00\\u4e2a $k$ \\u7684\\u8303\\u56f4\\uff0c\\u6c42 \\u2211 \\uff0c\\u5728\\u8fd9\\u91cc\\u653e\\u4e00\\u4efd\\u5b9e\\u73b0\\u4ee3\\u7801\\uff1a\\n```cpp\\nfor (int i = 1; i \\u003C= n; i++) {\\n\\tlong long ans2 = 0;\\n\\tfor (int j = 0; j \\u003C k; j++) {\\n\\t\\tans2 += cxk[i + j];\\n\\t}\\n\\tmaxx = max(maxx, ans2);\\n}\\n```\\n\\u4f46\\u662f\\u6211\\u4eec\\u4f1a\\u53d1\\u73b0\\u8fd9\\u4e2a\\u6bd2\\u7624\\u6570\\u636e\\u8303\\u56f4\\uff08\\u6ce8\\u610f\\u770b21~25\\uff09\\n![](https:\\/\\/s2.ax1x.com\\/2019\\/11\\/04\\/Kvrl34.jpg)\\n\\n\\u663e\\u7136\\u8fd9\\u6837\\u5faa\\u73af\\u4f1a\\u91cd\\u590d\\u8ba1\\u7b97\\u4e2d\\u95f4\\u7684\\u4e00\\u4e9b\\u503c\\uff0c21~25\\u90fd\\u4f1a\\u8d85\\u65f6\\u3002\\n\\n\\u90a3\\u4e48\\u6211\\u4eec\\u600e\\u4e48\\u4f18\\u5316\\u5462\\uff1f\\n\\n## \\u4f18\\u5316\\n\\n\\u6211\\u4eec\\u53ef\\u4ee5\\u5728\\u5faa\\u73af\\u7684\\u57fa\\u7840\\u4e0a\\uff0c\\u53bb\\u6389\\u91cd\\u590d\\u8ba1\\u7b97\\u7684\\u503c\\u3002\\n\\n\\u5728\\u4ece $a_{1}$ \\u5230 $a_{k}$ \\u6c42\\u548c\\u7684\\u57fa\\u7840\\u4e0a\\uff0c\\u52a0\\u4e0a\\u7b2c $a_{k+1}$ \\u4e2a\\u6570\\uff0c\\u51cf\\u53bb $a_{1}$ \\uff0c\\u662f\\u4e0d\\u662f\\u5c31\\u53ef\\u4ee5\\u53bb\\u6389\\u91cd\\u590d\\u8ba1\\u7b97\\u7684\\u503c\\u4e86\\uff1f \\u4f9d\\u7136\\u53d6\\u5176\\u6700\\u5927\\uff0c\\u6211\\u4eec\\u53ef\\u4ee5\\u8fd9\\u6837\\u5199\\uff1a\\n```cpp\\na = 0, b = a + k;\\nfor (int i = a; i \\u003C b; i++)\\n\\tans2 += cxk[i];\\nfor (int i = 1; i \\u003C= n - k; i++) {\\n\\tans2 = ans2 + cxk[b] - cxk[a];\\n\\tmaxx = max(maxx, ans2);\\n\\ta++, b++;\\n}\\n```\\n\\u5f53\\u7136\\u8f93\\u51fa\\u65f6\\u5e94\\u8be5\\u8f93\\u51fa**\\u603b\\u957f\\u5ea6-\\u8df3\\u8f6c\\u7684\\u957f\\u5ea6**\\uff0c\\n\\n```cpp\\ncout \\u003C\\u003C ans - maxx;\\n```\\n\\n\\u8fd9\\u5c31\\u662f\\u6838\\u5fc3\\u4ee3\\u7801\\u4e86\\uff0c\\u6700\\u540e\\u628a\\n\\u5934\\u6587\\u4ef6\\u53ca\\u521d\\u59cb\\u5316\\u4e00\\u5199\\uff1a\\n```cpp\\n#include \\u003Cbits\\/stdc++.h\\u003E\\nusing namespace std;\\nint n, k, a, b;\\nlong long cxk[1000010], ans, maxx, ans2;\\n```\\n\\u6570\\u636e\\u8bfb\\u5165\\uff1a\\n```cpp\\nios::sync_with_stdio(false);\\ncin \\u003E\\u003E n \\u003E\\u003E k;\\nfor (int i = 1; i \\u003C= n - 1; i++)\\n   cin \\u003E\\u003E cxk[i], ans += cxk[i];\\n```\\n\\n\\u6700\\u540e\\n```cpp\\nreturn 0;\\n```\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795659297.184544}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/nzmytiez\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P5638 \\u3010\\u3010CSGRound2\\u3011\\u5149\\u9a93\\u8005\\u7684\\u8363\\u8000\\u3011\",\"description\":\"\\u9898\\u89e3\\u539f\\u56e0\\n\\u8fd9\\u7bc7\\u9898\\u89e3\\u65e8\\u5728\\u5e2e\\u52a9\\u7406\\u89e3\\uff0cdalao\\u8bf7\\u5ffd\\u89c6\\u3002\\n\\u56e0\\u4e3a\\u8fd9\\u662f\\u4e00\\u9053\\\\color{red}\\\\text{\\u7ea2\\u9898}\\uff0c\\u6240\\u4ee5\\u6211\\u5728\\u8fd9\\u91cc\\u8bb2\\u8ff0\\u7684\\u8be6\\u7ec6\\u4e00\\u70b9\\u3002\\n\\u9898\\u76ee\\u7b80\\u4ecb\\n\\u6709 n \\u4e2a\\u57ce\\u5e02\\uff0c\\u6bcf\\u4e24\\u4e2a\\u57ce\\u5e02\\u4e4b\\u95f4\\u6709\\u53cc\\u5411\\u901a\\u8def\\uff0c\\u8017\\u8d39\\u65f6\\u95f4 a_{i} (\\u5176\\u5b9e\\u53ef\\u4ee5\\u7406\\u89e3\\u4e3a\\u957f\\u5ea6\\u4e3a a_{i}\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"Anyexyz\"},\"datePublished\":\"2019-11-10T07:41:54+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P5638 【【CSGRound2】光骓者的荣耀】\" />\n    <meta property=\"og:description\" content=\"题解原因\n这篇题解旨在帮助理解，dalao请忽视。\n因为这是一道\\color{red}\\text{红题}，所以我在这里讲述的详细一点。\n题目简介\n有 n 个城市，每两个城市之间有双向通路，耗费时间 a_{i} (其实可以理解为长度为 a_{i}…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"Anyexyz\" />\n    <meta property=\"article:published_time\" content=\"2019-11-10T07:41:54+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/nzmytiez\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P5638 【【CSGRound2】光骓者的荣耀】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">Anyexyz</a>\n            ·\n            <time datetime=\"2019-11-10T07:41:54+08:00\">2019-11-10 07:41:54</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <h3>题解原因</h3>\n<p>这篇题解旨在帮助理解，dalao请忽视。</p>\n<p>因为这是一道<la-tex display=\"inline\">\\color{red}\\text{红题}</la-tex>，<del>所以我在这里讲述的详细一点。</del></p>\n<h2>题目简介</h2>\n<p>有 <la-tex display=\"inline\">n</la-tex> 个城市，每两个城市之间有双向通路，耗费时间 <la-tex display=\"inline\">a_{i}</la-tex> <strong>(其实可以理解为长度为 <la-tex display=\"inline\">a_{i}</la-tex> )</strong> ，小K从 <la-tex display=\"inline\">{1-n}</la-tex> 走访 <strong>(可以理解为从1走到 n )</strong>。</p>\n<p>但是小K可以从第 <la-tex display=\"inline\">i</la-tex> 个城市直接跳转到第 <la-tex display=\"inline\">i-k</la-tex> 或 <la-tex display=\"inline\">i+k</la-tex> 。(只可使用一次)</p>\n<p><del>注意：他可以不访问所有的城市，使用传送器不耗费时间</del> <strong>(这句话意味着上面的跳转方案的思路是正确的，比如我完全可以从城市 1 跳到城市 4 ，只要使小K走过的总长度最短就可以)</strong></p>\n<p>求最快的用时 <strong>(即求最短的走路长度)</strong>。</p>\n<h2>思路分析</h2>\n<p>结合样例，我们可以发现，我们最终走过的长度就是<la-tex display=\"inline\">\\color{red}\\text{总长度-跳转的长度}</la-tex>，输入的 <la-tex display=\"inline\">k</la-tex> 即为我们跳转的范围。</p>\n<p>总长度使一个固定值，即所有路径的长度和。</p>\n<p>那么要使得最终走过的长度最短，只需使跳转的长度最大。</p>\n<p>我们只需要在所给的 <la-tex display=\"inline\">a_{i}</la-tex> 中选取 <la-tex display=\"inline\">k</la-tex> 个数，使得 <la-tex display=\"inline\">\\sum\\limits_{i=x}^{x+k}a_i</la-tex> 的值最大即可。</p>\n<p>我们可以枚举每一个 <la-tex display=\"inline\">k</la-tex> 的范围，求 ∑ ，在这里放一份实现代码：</p>\n<pre><code class=\"language-cpp\">for (int i = 1; i &lt;= n; i++) {\n    long long ans2 = 0;\n    for (int j = 0; j &lt; k; j++) {\n        ans2 += cxk[i + j];\n    }\n    maxx = max(maxx, ans2);\n}</code></pre>\n<p>但是我们会发现这个毒瘤数据范围（注意看21~25）\n</p>\n<p>显然这样循环会重复计算中间的一些值，21~25都会超时。</p>\n<p>那么我们怎么优化呢？</p>\n<h2>优化</h2>\n<p>我们可以在循环的基础上，去掉重复计算的值。</p>\n<p>在从 <la-tex display=\"inline\">a_{1}</la-tex> 到 <la-tex display=\"inline\">a_{k}</la-tex> 求和的基础上，加上第 <la-tex display=\"inline\">a_{k+1}</la-tex> 个数，减去 <la-tex display=\"inline\">a_{1}</la-tex> ，是不是就可以去掉重复计算的值了？ 依然取其最大，我们可以这样写：</p>\n<pre><code class=\"language-cpp\">a = 0, b = a + k;\nfor (int i = a; i &lt; b; i++)\n    ans2 += cxk[i];\nfor (int i = 1; i &lt;= n - k; i++) {\n    ans2 = ans2 + cxk[b] - cxk[a];\n    maxx = max(maxx, ans2);\n    a++, b++;\n}</code></pre>\n<p>当然输出时应该输出<strong>总长度-跳转的长度</strong>，</p>\n<pre><code class=\"language-cpp\">cout &lt;&lt; ans - maxx;</code></pre>\n<p>这就是核心代码了，最后把\n头文件及初始化一写：</p>\n<pre><code class=\"language-cpp\">#include &lt;bits/stdc++.h&gt;\nusing namespace std;\nint n, k, a, b;\nlong long cxk[1000010], ans, maxx, ans2;</code></pre>\n<p>数据读入：</p>\n<pre><code class=\"language-cpp\">ios::sync_with_stdio(false);\ncin &gt;&gt; n &gt;&gt; k;\nfor (int i = 1; i &lt;= n - 1; i++)\n   cin &gt;&gt; cxk[i], ans += cxk[i];</code></pre>\n<p>最后</p>\n<pre><code class=\"language-cpp\">return 0;</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a60561ee3df69ab6',t:'MTc5NTY1OTI5Ng=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a60561ee3df69ab6',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
