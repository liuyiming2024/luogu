.cn\\/upload\\/usericon\\/658740.png\",\"name\":\"GaryGao0503\",\"slogan\":\"AFOed\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Green\",\"ccfLevel\":4,\"xcpcLevel\":0,\"background\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/image_hosting\\/f9ygknj1.png\"},\"upvote\":1,\"replyCount\":0,\"favorCount\":1,\"status\":2,\"solutionFor\":{\"pid\":\"P1152\",\"type\":\"P\",\"name\":\"\\u6b22\\u4e50\\u7684\\u8df3\",\"difficulty\":1,\"fullScore\":100},\"promoteStatus\":0,\"collection\":null,\"content\":\"# P1152 \\u6b22\\u4e50\\u7684\\u8df3 \\u9898\\u89e3\\n\\u5bf9\\u4e8e\\u672c\\u9898\\uff0c\\u8003\\u8651\\u8ba1\\u7b97\\u6bcf\\u4e24\\u4e2a\\u76f8\\u90bb\\u5143\\u7d20\\u7684\\u5dee\\u503c\\uff0c\\u7136\\u540e\\u8fdb\\u884c\\u6392\\u5e8f\\uff0c\\u5bf9\\u6bcf\\u4e2a\\u51fa\\u73b0\\u7684\\u5dee\\u503c\\u8fdb\\u884c\\u6807\\u8bb0\\uff0c\\u6700\\u540e\\u904d\\u5386\\u5dee\\u503c\\u6570\\u7ec4\\u4e2d\\u662f\\u5426\\u5305\\u62ec $[1, n - 1]$ \\u4e4b\\u95f4\\u7684\\u6240\\u6709\\u6574\\u6570\\u3002\\n\\n\\u4ee3\\u7801\\uff1a\\n```cpp\\n#include \\u003Ciostream\\u003E\\n#include \\u003Ccmath\\u003E\\n#include \\u003Calgorithm\\u003E\\nusing namespace std;\\nint main() {\\n    int n, a[1005];\\n    cin \\u003E\\u003E n;\\n    if (n == 1) { \\/\\/\\u7279\\u5224\\u53ea\\u6709\\u4e00\\u4e2a\\u6570\\u7684\\u60c5\\u51b5\\n        cout \\u003C\\u003C \\u0022Jolly\\u0022;\\n        return 0;\\n    }\\n    for (int i = 1; i \\u003C= n; i++) {\\n        cin \\u003E\\u003E a[i];\\n    }\\n    int dif[1005];\\n    for (int i = 1; i \\u003C= n - 1; i++) {\\n        dif[i] = abs(a[i + 1] - a[i]); \\/\\/\\u8ba1\\u7b97\\u6570\\u7ec4\\u4e2d\\u8fde\\u7eed\\u4e24\\u4e2a\\u5143\\u7d20\\u4e4b\\u95f4\\u5dee\\u7684\\u7edd\\u5bf9\\u503c\\n    }\\n    sort(dif + 1, dif + n); \\/\\/\\u5bf9\\u5b58\\u50a8\\u5dee\\u7684\\u7edd\\u5bf9\\u503c\\u7684\\u6570\\u7ec4\\u8fdb\\u884c\\u6392\\u5e8f\\n    bool vis[10000005] = { 0 };\\n    for (int i = 1; i \\u003C= n - 1; i++) {\\n        vis[dif[i]] = 1; \\/\\/\\u904d\\u5386dif\\u6570\\u7ec4\\uff0c\\u5bf9\\u51fa\\u73b0\\u8fc7\\u7684\\u5dee\\u8fdb\\u884c\\u6807\\u8bb0\\n    }\\n    for (int i = 1; i \\u003C= n - 1; i++) { \\/\\/\\u68c0\\u67e5\\u662f\\u5426\\u4ece1~n-1\\u7684\\u6bcf\\u4e2a\\u5dee\\u90fd\\u51fa\\u73b0\\u8fc7\\n        if (!vis[i]) {\\n            cout \\u003C\\u003C \\u0022Not jolly\\u0022 \\u003C\\u003C endl;\\n            return 0;\\n        }\\n    }\\n    cout \\u003C\\u003C \\u0022Jolly\\u0022 \\u003C\\u003C endl;\\n    return 0;\\n}\\n```\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795629527.123565}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/h7y41tog\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3\\uff1aP1152 \\u6b22\\u4e50\\u7684\\u8df3\",\"description\":\"P1152 \\u6b22\\u4e50\\u7684\\u8df3 \\u9898\\u89e3\\n\\u5bf9\\u4e8e\\u672c\\u9898\\uff0c\\u8003\\u8651\\u8ba1\\u7b97\\u6bcf\\u4e24\\u4e2a\\u76f8\\u90bb\\u5143\\u7d20\\u7684\\u5dee\\u503c\\uff0c\\u7136\\u540e\\u8fdb\\u884c\\u6392\\u5e8f\\uff0c\\u5bf9\\u6bcf\\u4e2a\\u51fa\\u73b0\\u7684\\u5dee\\u503c\\u8fdb\\u884c\\u6807\\u8bb0\\uff0c\\u6700\\u540e\\u904d\\u5386\\u5dee\\u503c\\u6570\\u7ec4\\u4e2d\\u662f\\u5426\\u5305\\u62ec [1, n - 1] \\u4e4b\\u95f4\\u7684\\u6240\\u6709\\u6574\\u6570\\u3002\\n\\u4ee3\\u7801\\uff1a\\n#include &lt;iostream&gt;\\n#include\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"GaryGao0503\"},\"datePublished\":\"2025-08-10T16:55:12+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解：P1152 欢乐的跳\" />\n    <meta property=\"og:description\" content=\"P1152 欢乐的跳 题解\n对于本题，考虑计算每两个相邻元素的差值，然后进行排序，对每个出现的差值进行标记，最后遍历差值数组中是否包括 [1, n - 1] 之间的所有整数。\n代码：\n#include &amp;lt;iostream&amp;gt;\n#include…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"GaryGao0503\" />\n    <meta property=\"article:published_time\" content=\"2025-08-10T16:55:12+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/h7y41tog\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解：P1152 欢乐的跳</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">GaryGao0503</a>\n            ·\n            <time datetime=\"2025-08-10T16:55:12+08:00\">2025-08-10 16:55:12</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <h1>P1152 欢乐的跳 题解</h1>\n<p>对于本题，考虑计算每两个相邻元素的差值，然后进行排序，对每个出现的差值进行标记，最后遍历差值数组中是否包括 <la-tex display=\"inline\">[1, n - 1]</la-tex> 之间的所有整数。</p>\n<p>代码：</p>\n<pre><code class=\"language-cpp\">#include &lt;iostream&gt;\n#include &lt;cmath&gt;\n#include &lt;algorithm&gt;\nusing namespace std;\nint main() {\n    int n, a[1005];\n    cin &gt;&gt; n;\n    if (n == 1) { //特判只有一个数的情况\n        cout &lt;&lt; \"Jolly\";\n        return 0;\n    }\n    for (int i = 1; i &lt;= n; i++) {\n        cin &gt;&gt; a[i];\n    }\n    int dif[1005];\n    for (int i = 1; i &lt;= n - 1; i++) {\n        dif[i] = abs(a[i + 1] - a[i]); //计算数组中连续两个元素之间差的绝对值\n    }\n    sort(dif + 1, dif + n); //对存储差的绝对值的数组进行排序\n    bool vis[10000005] = { 0 };\n    for (int i = 1; i &lt;= n - 1; i++) {\n        vis[dif[i]] = 1; //遍历dif数组，对出现过的差进行标记\n    }\n    for (int i = 1; i &lt;= n - 1; i++) { //检查是否从1~n-1的每个差都出现过\n        if (!vis[i]) {\n            cout &lt;&lt; \"Not jolly\" &lt;&lt; endl;\n            return 0;\n        }\n    }\n    cout &lt;&lt; \"Jolly\" &lt;&lt; endl;\n    return 0;\n}</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6028b1faae2c8bd',t:'MTc5NTYyOTUyNg=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6028b1faae2c8bd',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
