 "is_article": "是",
 "code_blocks": [
  "#include <iostream>\n#include <cmath>\n#include <algorithm>\nusing namespace std;\nint main() {\n    int n, a[1005];\n    cin >> n;\n    if (n == 1) { //特判只有一个数的情况\n        cout << \"Jolly\";\n        return 0;\n    }\n    for (int i = 1; i <= n; i++) {\n        cin >> a[i];\n    }\n    int dif[1005];\n    for (int i = 1; i <= n - 1; i++) {\n        dif[i] = abs(a[i + 1] - a[i]); //计算数组中连续两个元素之间差的绝对值\n    }\n    sort(dif + 1, dif + n); //对存储差的绝对值的数组进行排序\n    bool vis[10000005] = { 0 };\n    for (int i = 1; i <= n - 1; i++) {\n        vis[dif[i]] = 1; //遍历dif数组，对出现过的差进行标记\n    }\n    for (int i = 1; i <= n - 1; i++) { //检查是否从1~n-1的每个差都出现过\n        if (!vis[i]) {\n            cout << \"Not jolly\" << endl;\n            return 0;\n        }\n    }\n    cout << \"Jolly\" << endl;\n    return 0;\n}"
 ],
