 "code_blocks": [
  "#include <iostream>\n#include <vector>\nusing namespace std;\n\nint countPaths(int n, int m, int horse_x, int horse_y) {\n    vector<vector<int>> dp(n+1, vector<int>(m+1, 0));\n    dp[0][0] = 1;\n\n    for (int i = 0; i <= n; i++) {\n        for (int j = 0; j <= m; j++) {\n            if ((i-2 == horse_x && j-1 == horse_y) || (i-1 == horse_x && j-2 == horse_y)) {\n                dp[i][j] = 0;\n            } else {\n                dp[i][j] = (i > 0 ? dp[i-1][j] : 0) + (j > 0 ? dp[i][j-1] : 0);\n            }\n        }\n    }\n\n    return dp[n][m];\n}\n\nint main() {\n    int n, m, horse_x, horse_y;\n    cin >> n >> m >> horse_x >> horse_y;\n\n    int paths = countPaths(n, m, horse_x, horse_y);\n    cout << paths << endl;\n\n    return 0;\n}",
  "def countPaths(n, m, horse_x, horse_y):\n    dp = [[0] * (m+1) for _ in range(n+1)]\n    dp[0][0] = 1\n\n    for i in range(n+1):\n        for j in range(m+1):\n            if (i-2 == horse_x and j-1 == horse_y) or (i-1 == horse_x and j-2 == horse_y):\n                dp[i][j] = 0\n            else:\n                dp[i][j] = (dp[i-1][j] if i > 0 else 0) + (dp[i][j-1] if j > 0 else 0)\n\n    return dp[n][m]\n\nn, m, horse_x, horse_y = map(int, input().split())\npaths = countPaths(n, m, horse_x, horse_y)\nprint(paths)"
 ],
 "sha256": "fb9fc5e4846e32d7",
 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <!-- 匿名页面令牌已移除（公开归档不保留） -->\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112514'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>P1002 [NOIP2002 普及组] 过河卒（题解） - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"sfifnfaa\",\"title\":\"P1002 [NOIP2002 \\u666e\\u53ca\\u7ec4] \\u8fc7\\u6cb3\\u5352\\uff08\\u9898\\u89e3\\uff09\",\"category\":2,\"time\":1689586549,\"author\":{\"uid\":1029074,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/1029074.png\",\"name\":\"yangmengcheng1103\",\"slogan\":\"\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Green\",\"ccfLevel\":4,\"xcpcLevel\":0,\"background\":\"\"},\"upvote\":0,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":null,\"promoteStatus\":0,\"collection\":null,\"content\":\"\\u6839\\u636e\\u9898\\u76ee\\u63cf\\u8ff0\\uff0c\\u6211\\u4eec\\u9700\\u8981\\u8ba1\\u7b97\\u5352\\u4ece\\u8d77\\u70b9A\\u8d70\\u5230\\u76ee\\u6807\\u70b9$B$\\u7684\\u8def\\u5f84\\u6761\\u6570\\uff0c\\u540c\\u65f6\\u8fd8\\u6709\\u4e00\\u4e2a\\u56fa\\u5b9a\\u7684\\u9a6c\\u7684\\u4f4d\\u7f6e\\u9700\\u8981\\u8003\\u8651\\uff0c\\u8be5\\u9a6c\\u7684\\u4f4d\\u7f6e\\u53ca\\u5176\\u63a7\\u5236\\u70b9\\u4f1a\\u5f71\\u54cd\\u5352\\u7684\\u884c\\u8d70\\u3002\\n\\n\\u5bf9\\u4e8e\\u8fd9\\u79cd\\u8def\\u5f84\\u8ba1\\u6570\\u95ee\\u9898\\uff0c\\u5e38\\u7528\\u7684\\u65b9\\u6cd5\\u662f\\u4f7f\\u7528\\u52a8\\u6001\\u89c4\\u5212\\u3002\\u6211\\u4eec\\u53ef\\u4ee5\\u5b9a\\u4e49\\u4e00\\u4e2a\\u4e8c\\u7ef4\\u6570\\u7ec4$dp$\\uff0c\\u5176\\u4e2d$dp[i][j]$\\u8868\\u793a\\u5352\\u4ece\\u8d77\\u70b9A\\u5230\\u8fbe\\u70b9$(i, j)$\\u7684\\u8def\\u5f84\\u6761\\u6570\\u3002\\n\\n\\u6839\\u636e\\u9898\\u76ee\\u8981\\u6c42\\uff0c\\u5352\\u53ea\\u80fd\\u5411\\u4e0b\\u6216\\u5411\\u53f3\\u8d70\\uff0c\\u90a3\\u4e48\\u5352\\u53ea\\u80fd\\u4ece\\u4e0a\\u65b9\\u6216\\u5de6\\u65b9\\u5230\\u8fbe\\u5f53\\u524d\\u70b9$(i, j)$\\uff0c\\u56e0\\u6b64\\u6709\\u4ee5\\u4e0b\\u51e0\\u79cd\\u60c5\\u51b5\\uff1a\\n\\n1. \\u70b9$(x+1, y+2)$\\n2. \\u70b9$(x+2, y+1)$\\n3. \\u70b9$(x+2, y-1)$\\n4. \\u70b9$(x+1, y-2)$\\n5. \\u70b9$(x-1, y-2)$\\n6. \\u70b9$(x-2, y-1)$\\n7. \\u70b9$(x-2, y+1)$\\n8. \\u70b9$(x-1, y+2)$\\n\\n\\u5728\\u9884\\u5904\\u7406$control$\\u6570\\u7ec4\\u540e\\uff0c\\u6211\\u4eec\\u53ef\\u4ee5\\u6309\\u7167\\u4ee5\\u4e0b\\u601d\\u8def\\u8fdb\\u884c\\u52a8\\u6001\\u89c4\\u5212\\u8ba1\\u7b97\\uff1a\\n\\n1. \\u521d\\u59cb\\u5316$dp$\\u6570\\u7ec4\\uff0c\\u5c06\\u8d77\\u70b9A\\u7684\\u8def\\u5f84\\u6761\\u6570\\u8bbe\\u4e3a$1$\\uff0c\\u5373$p[0][0] = 1$\\u3002\\n2. \\u4ece\\u5de6\\u5230\\u53f3\\u3001\\u4ece\\u4e0a\\u5230\\u4e0b\\u4f9d\\u6b21\\u904d\\u5386\\u68cb\\u76d8\\u4e0a\\u7684\\u70b9$(i, j)$\\uff0c\\u8ba1\\u7b97$dp[i][j]$\\u7684\\u503c\\u3002\\n   - \\u5982\\u679c\\u70b9$(i, j)$\\u662f\\u9a6c\\u7684\\u63a7\\u5236\\u70b9\\uff0c\\u5c06$dp[i][j$]\\u8bbe\\u4e3a$0$\\u3002\\n   - \\u5426\\u5219\\uff0c\\u70b9$(i, j)$\\u53ef\\u4ee5\\u4ece\\u4e0a\\u65b9\\u70b9$(i-1, j)$\\u6216\\u5de6\\u65b9\\u70b9$(i, j-1)$\\u5230\\u8fbe\\uff0c\\u8def\\u5f84\\u6761\\u6570\\u5373\\u4e3a$dp[i-1][j] + dp[i][j-1]$\\u3002\\n\\n\\u6700\\u7ec8\\uff0c$dp[n][m]$\\u5373\\u4e3a\\u5352\\u4ece\\u8d77\\u70b9$A$\\u5230\\u8fbe\\u76ee\\u6807\\u70b9$B$\\u7684\\u8def\\u5f84\\u6761\\u6570\\u3002\\u6211\\u4eec\\u5c06\\u5176\\u8f93\\u51fa\\u5373\\u53ef\\u5f97\\u5230\\u7b54\\u6848\\u3002\\n\\n\\u4ee5\\u4e0b\\u662f\\u5b9e\\u73b0\\u7684\\u793a\\u4f8b\\u4ee3\\u7801\\uff1a\\n\\nc++:\\n\\n```cpp\\n#include \\u003Ciostream\\u003E\\n#include \\u003Cvector\\u003E\\nusing namespace std;\\n\\nint countPaths(int n, int m, int horse_x, int horse_y) {\\n    vector\\u003Cvector\\u003Cint\\u003E\\u003E dp(n+1, vector\\u003Cint\\u003E(m+1, 0));\\n    dp[0][0] = 1;\\n\\n    for (int i = 0; i \\u003C= n; i++) {\\n        for (int j = 0; j \\u003C= m; j++) {\\n            if ((i-2 == horse_x \\u0026\\u0026 j-1 == horse_y) || (i-1 == horse_x \\u0026\\u0026 j-2 == horse_y)) {\\n                dp[i][j] = 0;\\n            } else {\\n                dp[i][j] = (i \\u003E 0 ? dp[i-1][j] : 0) + (j \\u003E 0 ? dp[i][j-1] : 0);\\n            }\\n        }\\n    }\\n\\n    return dp[n][m];\\n}\\n\\nint main() {\\n    int n, m, horse_x, horse_y;\\n    cin \\u003E\\u003E n \\u003E\\u003E m \\u003E\\u003E horse_x \\u003E\\u003E horse_y;\\n\\n    int paths = countPaths(n, m, horse_x, horse_y);\\n    cout \\u003C\\u003C paths \\u003C\\u003C endl;\\n\\n    return 0;\\n}\\n```\\n\\npython\\uff1a\\n\\n```python\\ndef countPaths(n, m, horse_x, horse_y):\\n    dp = [[0] * (m+1) for _ in range(n+1)]\\n    dp[0][0] = 1\\n\\n    for i in range(n+1):\\n        for j in range(m+1):\\n            if (i-2 == horse_x and j-1 == horse_y) or (i-1 == horse_x and j-2 == horse_y):\\n                dp[i][j] = 0\\n            else:\\n                dp[i][j] = (dp[i-1][j] if i \\u003E 0 else 0) + (dp[i][j-1] if j \\u003E 0 else 0)\\n\\n    return dp[n][m]\\n\\nn, m, horse_x, horse_y = map(int, input().split())\\npaths = countPaths(n, m, horse_x, horse_y)\\nprint(paths)\\n```\\n\\n\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795593071.142651}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/sfifnfaa\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"P1002 [NOIP2002 \\u666e\\u53ca\\u7ec4] \\u8fc7\\u6cb3\\u5352\\uff08\\u9898\\u89e3\\uff09\",\"description\":\"\\u6839\\u636e\\u9898\\u76ee\\u63cf\\u8ff0\\uff0c\\u6211\\u4eec\\u9700\\u8981\\u8ba1\\u7b97\\u5352\\u4ece\\u8d77\\u70b9A\\u8d70\\u5230\\u76ee\\u6807\\u70b9B\\u7684\\u8def\\u5f84\\u6761\\u6570\\uff0c\\u540c\\u65f6\\u8fd8\\u6709\\u4e00\\u4e2a\\u56fa\\u5b9a\\u7684\\u9a6c\\u7684\\u4f4d\\u7f6e\\u9700\\u8981\\u8003\\u8651\\uff0c\\u8be5\\u9a6c\\u7684\\u4f4d\\u7f6e\\u53ca\\u5176\\u63a7\\u5236\\u70b9\\u4f1a\\u5f71\\u54cd\\u5352\\u7684\\u884c\\u8d70\\u3002\\n\\u5bf9\\u4e8e\\u8fd9\\u79cd\\u8def\\u5f84\\u8ba1\\u6570\\u95ee\\u9898\\uff0c\\u5e38\\u7528\\u7684\\u65b9\\u6cd5\\u662f\\u4f7f\\u7528\\u52a8\\u6001\\u89c4\\u5212\\u3002\\u6211\\u4eec\\u53ef\\u4ee5\\u5b9a\\u4e49\\u4e00\\u4e2a\\u4e8c\\u7ef4\\u6570\\u7ec4dp\\uff0c\\u5176\\u4e2ddp[i][j]\\u8868\\u793a\\u5352\\u4ece\\u8d77\\u70b9A\\u5230\\u8fbe\\u70b9(i,\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"yangmengcheng1103\"},\"datePublished\":\"2023-07-17T17:35:49+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"P1002 [NOIP2002 普及组] 过河卒（题解）\" />\n    <meta property=\"og:description\" content=\"根据题目描述，我们需要计算卒从起点A走到目标点B的路径条数，同时还有一个固定的马的位置需要考虑，该马的位置及其控制点会影响卒的行走。\n对于这种路径计数问题，常用的方法是使用动态规划。我们可以定义一个二维数组dp，其中dp[i][j]表示卒从起点A到达点(i,…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"yangmengcheng1103\" />\n    <meta property=\"article:published_time\" content=\"2023-07-17T17:35:49+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/sfifnfaa\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>P1002 [NOIP2002 普及组] 过河卒（题解）</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">yangmengcheng1103</a>\n            ·\n            <time datetime=\"2023-07-17T17:35:49+08:00\">2023-07-17 17:35:49</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>根据题目描述，我们需要计算卒从起点A走到目标点<la-tex display=\"inline\">B</la-tex>的路径条数，同时还有一个固定的马的位置需要考虑，该马的位置及其控制点会影响卒的行走。</p>\n<p>对于这种路径计数问题，常用的方法是使用动态规划。我们可以定义一个二维数组<la-tex display=\"inline\">dp</la-tex>，其中<la-tex display=\"inline\">dp[i][j]</la-tex>表示卒从起点A到达点<la-tex display=\"inline\">(i, j)</la-tex>的路径条数。</p>\n<p>根据题目要求，卒只能向下或向右走，那么卒只能从上方或左方到达当前点<la-tex display=\"inline\">(i, j)</la-tex>，因此有以下几种情况：</p>\n<ol>\n<li>点<la-tex display=\"inline\">(x+1, y+2)</la-tex></li>\n<li>点<la-tex display=\"inline\">(x+2, y+1)</la-tex></li>\n<li>点<la-tex display=\"inline\">(x+2, y-1)</la-tex></li>\n<li>点<la-tex display=\"inline\">(x+1, y-2)</la-tex></li>\n<li>点<la-tex display=\"inline\">(x-1, y-2)</la-tex></li>\n<li>点<la-tex display=\"inline\">(x-2, y-1)</la-tex></li>\n<li>点<la-tex display=\"inline\">(x-2, y+1)</la-tex></li>\n<li>点<la-tex display=\"inline\">(x-1, y+2)</la-tex></li>\n</ol>\n<p>在预处理<la-tex display=\"inline\">control</la-tex>数组后，我们可以按照以下思路进行动态规划计算：</p>\n<ol>\n<li>初始化<la-tex display=\"inline\">dp</la-tex>数组，将起点A的路径条数设为<la-tex display=\"inline\">1</la-tex>，即<la-tex display=\"inline\">p[0][0] = 1</la-tex>。</li>\n<li>从左到右、从上到下依次遍历棋盘上的点<la-tex display=\"inline\">(i, j)</la-tex>，计算<la-tex display=\"inline\">dp[i][j]</la-tex>的值。<ul>\n<li>如果点<la-tex display=\"inline\">(i, j)</la-tex>是马的控制点，将<la-tex display=\"inline\">dp[i][j</la-tex>]设为<la-tex display=\"inline\">0</la-tex>。</li>\n<li>否则，点<la-tex display=\"inline\">(i, j)</la-tex>可以从上方点<la-tex display=\"inline\">(i-1, j)</la-tex>或左方点<la-tex display=\"inline\">(i, j-1)</la-tex>到达，路径条数即为<la-tex display=\"inline\">dp[i-1][j] + dp[i][j-1]</la-tex>。</li>\n</ul>\n</li>\n</ol>\n<p>最终，<la-tex display=\"inline\">dp[n][m]</la-tex>即为卒从起点<la-tex display=\"inline\">A</la-tex>到达目标点<la-tex display=\"inline\">B</la-tex>的路径条数。我们将其输出即可得到答案。</p>\n<p>以下是实现的示例代码：</p>\n<p>c++:</p>\n<pre><code class=\"language-cpp\">#include &lt;iostream&gt;\n#include &lt;vector&gt;\nusing namespace std;\n\nint countPaths(int n, int m, int horse_x, int horse_y) {\n    vector&lt;vector&lt;int&gt;&gt; dp(n+1, vector&lt;int&gt;(m+1, 0));\n    dp[0][0] = 1;\n\n    for (int i = 0; i &lt;= n; i++) {\n        for (int j = 0; j &lt;= m; j++) {\n            if ((i-2 == horse_x &amp;&amp; j-1 == horse_y) || (i-1 == horse_x &amp;&amp; j-2 == horse_y)) {\n                dp[i][j] = 0;\n            } else {\n                dp[i][j] = (i &gt; 0 ? dp[i-1][j] : 0) + (j &gt; 0 ? dp[i][j-1] : 0);\n            }\n        }\n    }\n\n    return dp[n][m];\n}\n\nint main() {\n    int n, m, horse_x, horse_y;\n    cin &gt;&gt; n &gt;&gt; m &gt;&gt; horse_x &gt;&gt; horse_y;\n\n    int paths = countPaths(n, m, horse_x, horse_y);\n    cout &lt;&lt; paths &lt;&lt; endl;\n\n    return 0;\n}</code></pre>\n<p>python：</p>\n<pre><code class=\"language-python\">def countPaths(n, m, horse_x, horse_y):\n    dp = [[0] * (m+1) for _ in range(n+1)]\n    dp[0][0] = 1\n\n    for i in range(n+1):\n        for j in range(m+1):\n            if (i-2 == horse_x and j-1 == horse_y) or (i-1 == horse_x and j-2 == horse_y):\n                dp[i][j] = 0\n            else:\n                dp[i][j] = (dp[i-1][j] if i &gt; 0 else 0) + (dp[i][j-1] if j &gt; 0 else 0)\n\n    return dp[n][m]\n\nn, m, horse_x, horse_y = map(int, input().split())\npaths = countPaths(n, m, horse_x, horse_y)\nprint(paths)</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a5ff1115bc659013',t:'MTc5NTU5MzA3MA=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a5ff1115bc659013',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
