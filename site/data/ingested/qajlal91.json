bits\\/stdc++.h\\u003E\\nusing namespace std;\\nstring n;\\nint main(){\\n\\tint cnt=0;\\n\\tgetline(cin,n,\\u0027\\\\n\\u0027);\\n\\tfor(int i=0;i\\u003Cn.size();i++){\\n\\t\\tif(n[i]!=\\u0027 \\u0027){\\n\\t\\t\\tcnt++;\\n\\t\\t}\\n\\t}\\n\\tcout\\u003C\\u003Ccnt;\\n\\treturn 0;\\n}  \\n```\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795659293.327236}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/qajlal91\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"P5015\\u9898\\u89e3\",\"description\":\"\\u535a\\u6587T2\\u822a\\u7ad9\\u697c \\u2708 P5015\\u6807\\u9898\\u7edf\\u8ba1\\n\\u6570\\u7ec4\\u53ca\\u53d8\\u91cf\\u51c6\\u5907\\n\\u53d8\\u91cf\\nstring n \\u8f93\\u5165\\u7684\\u6807\\u9898\\nint cnt=0 \\u8ba1\\u6570\\u5668\\n\\u9884\\u5148\\u51c6\\u5907\\ngetline\\u51fd\\u6570\\uff1a\\n\\u53ef\\u7528\\u4e8e\\u8f93\\u5165\\u5e26\\u7a7a\\u683c\\u7684\\u5b57\\u7b26\\u4e32\\uff0c\\u683c\\u5f0f\\u5982\\u4e0b\\ngetline(cin,\\u5b57\\u7b26\\u4e32\\u540d,\\u7ed3\\u675f\\u5b57\\u7b26);\\n\\u601d\\u8def\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"RayLiuLiu\"},\"datePublished\":\"2023-06-08T20:04:53+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"P5015题解\" />\n    <meta property=\"og:description\" content=\"博文T2航站楼 ✈ P5015标题统计\n数组及变量准备\n变量\nstring n 输入的标题\nint cnt=0 计数器\n预先准备\ngetline函数：\n可用于输入带空格的字符串，格式如下\ngetline(cin,字符串名,结束字符);\n思路…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"RayLiuLiu\" />\n    <meta property=\"article:published_time\" content=\"2023-06-08T20:04:53+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/qajlal91\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>P5015题解</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">RayLiuLiu</a>\n            ·\n            <time datetime=\"2023-06-08T20:04:53+08:00\">2023-06-08 20:04:53</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <h3>博文T2航站楼 ✈ P5015标题统计</h3>\n<h1>数组及变量准备</h1>\n<h2>变量</h2>\n<p><code>string n</code> 输入的标题</p>\n<p><code>int cnt=0</code> 计数器</p>\n<h1>预先准备</h1>\n<p><code>getline</code>函数：</p>\n<p>可用于输入带空格的字符串，格式如下</p>\n<p><code>getline(cin,字符串名,结束字符);</code></p>\n<h1>思路</h1>\n<ol>\n<li>\n<p><code>getline</code>输入字符串<la-tex display=\"inline\">n</la-tex></p>\n<pre><code class=\"language-cpp\">getline(cin,n,'\\n');</code></pre>\n</li>\n<li>\n<p>遍历字符串<la-tex display=\"inline\">n</la-tex>，判断是否为空格</p>\n<ol>\n<li>不是</li>\n</ol>\n<p>计数器自增</p>\n<ol start=\"2\">\n<li>是</li>\n</ol>\n<p>不执行任何操作</p>\n<pre><code class=\"language-cpp\">for(int i=0;i&lt;n.size();i++){\n     if(n[i]!=' '){\n         cnt++;\n     }\n}</code></pre>\n</li>\n<li>\n<p>输出<la-tex display=\"inline\">cnt</la-tex></p>\n<pre><code class=\"language-cpp\">cout&lt;&lt;cnt;</code></pre>\n</li>\n</ol>\n<p><strong>至此，这道题就做完了，完整代码看下面</strong></p>\n\n<h1><la-tex display=\"inline\">AC \\ Code</la-tex></h1>\n<pre><code class=\"language-cpp\">#include&lt;bits/stdc++.h&gt;\nusing namespace std;\nstring n;\nint main(){\n    int cnt=0;\n    getline(cin,n,'\\n');\n    for(int i=0;i&lt;n.size();i++){\n        if(n[i]!=' '){\n            cnt++;\n        }\n    }\n    cout&lt;&lt;cnt;\n    return 0;\n}  </code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a60561d2f92088bd',t:'MTc5NTY1OTI5Mg=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a60561d2f92088bd',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
