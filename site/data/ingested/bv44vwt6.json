6,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/668906.png\",\"name\":\"infinite2021\",\"slogan\":\"\\u5982\\u9732\\u4ea6\\u5982\\u7535 \\u5e94\\u4f5c\\u5982\\u662f\\u89c2\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Green\",\"ccfLevel\":7,\"xcpcLevel\":0,\"background\":\"\"},\"upvote\":0,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":null,\"promoteStatus\":0,\"collection\":null,\"content\":\"## \\u90e8\\u5206\\u80cc\\u5305\\u95ee\\u9898\\uff08\\u8c8c\\u4f3c\\u5f88\\u591a\\u4eba\\u7684\\u7b2c\\u4e00\\u611f\\u89c9\\u662fDP\\uff09\\n### \\u6e29\\u99a8\\u63d0\\u793a:\\n1 .\\u672c\\u4f53\\u5b9e\\u9645\\u662f\\u8d2a\\u5fc3(\\u6c35\\u9898)\\uff0c\\u4ece\\u539f\\u9898\\u201c\\u6240\\u6709\\u91d1\\u5e01\\u90fd\\u53ef\\u4ee5\\u968f\\u610f\\u5206\\u5272\\u201d\\u53ef\\u4ee5\\u770b\\u51fa\\n\\n2 .\\u5176\\u4f59\\u7684\\u6570\\u5b66\\u8ba1\\u7b97\\u5373\\u53ef\\n\\n3 .\\u6ce8\\u610f\\u5f00double,\\u4fdd\\u7559\\u4e24\\u4f4d\\u5c0f\\u6570\\n\\n4 .\\u4ee5\\u4e0a\\u4e09\\u70b9\\u5982\\u679c\\u90fd\\u6ce8\\u610f\\u4e86\\u7684\\u8bdd\\uff0c\\u4e00\\u904d\\u8fc7\\u8fd8\\u662f\\u5f88\\u5bb9\\u6613\\u6ef4~~~\\n\\n### \\u5927\\u4f53\\u601d\\u8def\\n\\n\\u65e2\\u7136\\u662f\\u8d2a\\u5fc3\\uff0c\\u5c31\\u7528\\u5230\\u4e86\\u8d2a\\u5fc3\\u5e7f\\u6cdb\\u4f7f\\u7528\\u7684\\u4e00\\u79cd\\u8d2a\\u6cd5\\uff1a\\u7b97\\u4ef7\\u503c\\n\\n\\u7b97\\u4ef7\\u503c\\u5b9e\\u9645\\u5c31\\u662f\\u7528\\u603b\\u4ef7\\u503c\\u2797\\u6570\\u91cf(\\u4f53\\u79ef)\\n\\n\\u7136\\u540e\\u6309\\u7167\\u4ef7\\u503c\\u4ece\\u5927\\u5230\\u5c0f\\u6392\\u5e8f\\uff0c\\u518d\\u6a21\\u62df\\u8ba1\\u7b97\\n\\n\\u6700\\u540e\\u6765\\u8bf4\\u6a21\\u62df\\u8ba1\\u7b97\\n\\n\\u5206\\u4e3a\\u4e09\\u79cd\\u60c5\\u51b5\\n\\n\\u7b2c\\u4e00\\u79cd\\uff1a\\u80cc\\u5305\\u7684\\u5bb9\\u91cf\\u8db3\\u591f\\u88c5\\u4e0b\\u4e00\\u6574\\u5806\\u91d1\\u5b50\\uff08\\u6ca1\\u5565\\u597d\\u8bf4\\u7684\\uff0c\\u76f4\\u63a5\\u7b97\\u5373\\u53ef\\uff09\\n\\n\\u7b2c\\u4e8c\\u79cd\\uff1a\\u80cc\\u5305\\u7684\\u5bb9\\u91cf\\u53ea\\u80fd\\u88c5\\u4e0b\\u4e00\\u5806\\u91d1\\u5b50\\u4e2d\\u7684\\u4e00\\u90e8\\u5206\\n\\n\\u8fd9\\u4e00\\u9700\\u8981\\u8bf4\\u4e00\\u4e0b\\uff0c\\u7528\\u5f53\\u524d\\u80cc\\u5305\\u5269\\u4f59\\u7684\\u4f53\\u79ef\\u2797\\u8fd9\\u4e00\\u5806\\u91d1\\u5b50\\u7684\\u4f53\\u79ef\\uff0c\\u6c42\\u51fa\\u5f53\\u524d\\u80cc\\u5305\\u5bb9\\u91cf\\u8fd8\\u80fd\\u5bb9\\u7eb3\\u51e0\\u5206\\u4e4b\\u51e0\\u7684\\u91d1\\u5b50\\uff0c\\u518d\\u7528\\u5355\\u4f4d\\u00221\\u0022\\u00d7\\u5bf9\\u5e94\\u5206\\u7387\\u5373\\u53ef(\\u5c0f\\u5b66\\u6570\\u5b66)\\n\\n### \\u4ee3\\u7801\\u5b9e\\u73b0(\\u559c\\u95fb\\u4e50\\u89c1\\u7684\\u90e8\\u5206)\\n\\n```cpp\\n#include \\u003Cbits\\/stdc++.h\\u003E\\nusing namespace std;\\nint n,m;\\nstruct node\\/\\/\\u5b9a\\u4e49\\u7ed3\\u6784\\u4f53\\uff0cv\\u662f\\u91cd\\u91cf\\uff0cw\\u662f\\u4ef7\\u503c,x\\u662f\\u5355\\u4ef7\\n{\\n    double v,w,x;\\n}a[110];\\nint cmp(node a,node b)\\n{\\n    return a.x\\u003Eb.x;\\n}\\nint main()\\n{\\n    cin\\u003E\\u003En\\u003E\\u003Em;\\n    for(int i=1;i\\u003C=n;i++)\\n        cin\\u003E\\u003Ea[i].v\\u003E\\u003Ea[i].w,a[i].x=a[i].w\\/a[i].v;\\/\\/\\u8f93\\u5165\\n    sort(a+1,a+n+1,cmp);\\/\\/\\u6392\\u5e8f\\uff0c\\u8d2a\\u5fc3\\u601d\\u60f3\\n    double res=0,weigh=m;\\/\\/\\u4e4b\\u540e\\u6309\\u6570\\u5b66\\u65b9\\u6cd5\\u6a21\\u62df\\u8ba1\\u7b97\\u5373\\u53ef\\n    for(int i=1;i\\u003C=n;i++)\\n    {\\n        if(weigh)\\n        {\\n            if(weigh\\u003E=a[i].v){res+=a[i].w,weigh-=a[i].v;}\\n            else {res+=(weigh\\/a[i].v)*a[i].w,weigh=0;}\\n        }\\n    }\\n    cout\\u003C\\u003Cfixed\\u003C\\u003Csetprecision(2)\\u003C\\u003Cres\\u003C\\u003Cendl;\\/\\/\\u6ce8\\u610f\\u4fdd\\u7559\\u4e24\\u4f4d\\u5c0f\\u6570\\n    return 0;\\n}\\n```\",\"categoryOld\":\"\\u7b97\\u6cd5\\u57fa\\u7840\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795659249.841441}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/bv44vwt6\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"P2240 \\u3010\\u6df1\\u57fa12.\\u4f8b1\\u3011\\u90e8\\u5206\\u80cc\\u5305\\u95ee\\u9898\",\"description\":\"\\u90e8\\u5206\\u80cc\\u5305\\u95ee\\u9898\\uff08\\u8c8c\\u4f3c\\u5f88\\u591a\\u4eba\\u7684\\u7b2c\\u4e00\\u611f\\u89c9\\u662fDP\\uff09\\n\\u6e29\\u99a8\\u63d0\\u793a:\\n1 .\\u672c\\u4f53\\u5b9e\\u9645\\u662f\\u8d2a\\u5fc3(\\u6c35\\u9898)\\uff0c\\u4ece\\u539f\\u9898\\u201c\\u6240\\u6709\\u91d1\\u5e01\\u90fd\\u53ef\\u4ee5\\u968f\\u610f\\u5206\\u5272\\u201d\\u53ef\\u4ee5\\u770b\\u51fa\\n2 .\\u5176\\u4f59\\u7684\\u6570\\u5b66\\u8ba1\\u7b97\\u5373\\u53ef\\n3 .\\u6ce8\\u610f\\u5f00double,\\u4fdd\\u7559\\u4e24\\u4f4d\\u5c0f\\u6570\\n4 .\\u4ee5\\u4e0a\\u4e09\\u70b9\\u5982\\u679c\\u90fd\\u6ce8\\u610f\\u4e86\\u7684\\u8bdd\\uff0c\\u4e00\\u904d\\u8fc7\\u8fd8\\u662f\\u5f88\\u5bb9\\u6613\\u6ef4~~~\\u2026\",\"genre\":\"\\u4e2a\\u4eba\\u8bb0\\u5f55\",\"author\":{\"@type\":\"Person\",\"name\":\"infinite2021\"},\"datePublished\":\"2022-10-27T21:37:38+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"P2240 【深基12.例1】部分背包问题\" />\n    <meta property=\"og:description\" content=\"部分背包问题（貌似很多人的第一感觉是DP）\n温馨提示:\n1 .本体实际是贪心(氵题)，从原题“所有金币都可以随意分割”可以看出\n2 .其余的数学计算即可\n3 .注意开double,保留两位小数\n4 .以上三点如果都注意了的话，一遍过还是很容易滴~~~…\" />\n    <meta property=\"article:section\" content=\"个人记录\" />\n    <meta property=\"article:author\" content=\"infinite2021\" />\n    <meta property=\"article:published_time\" content=\"2022-10-27T21:37:38+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/bv44vwt6\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>P2240 【深基12.例1】部分背包问题</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">infinite2021</a>\n            ·\n            <time datetime=\"2022-10-27T21:37:38+08:00\">2022-10-27 21:37:38</time>\n            ·\n            <a href=\"/article?category=1\">个人记录</a>\n        </p>\n\n        <h2>部分背包问题（貌似很多人的第一感觉是DP）</h2>\n<h3>温馨提示:</h3>\n<p>1 .本体实际是贪心(氵题)，从原题“所有金币都可以随意分割”可以看出</p>\n<p>2 .其余的数学计算即可</p>\n<p>3 .注意开double,保留两位小数</p>\n<p>4 .以上三点如果都注意了的话，一遍过还是很容易滴~~~</p>\n<h3>大体思路</h3>\n<p>既然是贪心，就用到了贪心广泛使用的一种贪法：算价值</p>\n<p>算价值实际就是用总价值➗数量(体积)</p>\n<p>然后按照价值从大到小排序，再模拟计算</p>\n<p>最后来说模拟计算</p>\n<p>分为三种情况</p>\n<p>第一种：背包的容量足够装下一整堆金子（没啥好说的，直接算即可）</p>\n<p>第二种：背包的容量只能装下一堆金子中的一部分</p>\n<p>这一需要说一下，用当前背包剩余的体积➗这一堆金子的体积，求出当前背包容量还能容纳几分之几的金子，再用单位\"1\"×对应分率即可(小学数学)</p>\n<h3>代码实现(喜闻乐见的部分)</h3>\n<pre><code class=\"language-cpp\">#include &lt;bits/stdc++.h&gt;\nusing namespace std;\nint n,m;\nstruct node//定义结构体，v是重量，w是价值,x是单价\n{\n    double v,w,x;\n}a[110];\nint cmp(node a,node b)\n{\n    return a.x&gt;b.x;\n}\nint main()\n{\n    cin&gt;&gt;n&gt;&gt;m;\n    for(int i=1;i&lt;=n;i++)\n        cin&gt;&gt;a[i].v&gt;&gt;a[i].w,a[i].x=a[i].w/a[i].v;//输入\n    sort(a+1,a+n+1,cmp);//排序，贪心思想\n    double res=0,weigh=m;//之后按数学方法模拟计算即可\n    for(int i=1;i&lt;=n;i++)\n    {\n        if(weigh)\n        {\n            if(weigh&gt;=a[i].v){res+=a[i].w,weigh-=a[i].v;}\n            else {res+=(weigh/a[i].v)*a[i].w,weigh=0;}\n        }\n    }\n    cout&lt;&lt;fixed&lt;&lt;setprecision(2)&lt;&lt;res&lt;&lt;endl;//注意保留两位小数\n    return 0;\n}</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a60560c638a7e3ae',t:'MTc5NTY1OTI0OQ=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a60560c638a7e3ae',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
