 "code_blocks": [
  "#include<bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\nconst int N = 1e6+5;//可以按实际的数据范围进行调整 \nint ans;\nint n,a[N],b[N];\nint main(){\n    cin>>n;//scanf(\"%d\",&n);\n    for(int i=1;i<=n;i++){\n        cin>>a[i];//scanf(\"%d\",&a[i]);\n    }\n    sort(a+1,a+1+n);//sort默认从小到大排序 \n    for(int i=1;i<=n;i++){//这里下标最好从1开始。从0开始可能会越界 \n        if(a[i]!=a[i-1]){\n            b[++j]=a[i];\n        }\n    }\n    cout<<j<<\"\\n\";//printf(\"%d\\n\",j);\n    for(int i=1;i<=j;i++){\n        cout<<b[i]<<\" \";//printf(\"%d \",b[i]);\n    }\n    return 0;\n}"
