 "code_blocks": [
  "#include<iostream>\nusing namespace std;\nint main(){\n   int n,a1,a2,b1,b2,c1,c2,da,db,dc,ans;\n   /*需要铅笔数(n)，最少要花的钱(ans)\n   a~c包装单包铅笔数(a1,b1,c1)，a~c包装单价    (a2,b2,c2)\n   每个包装的总价(da,db,dc)*/\n   cin>>n>>a1>>a2>>b1>>b2>>c1>>c2;\n   //a包装 \n   if(n%a1!=0) da=(n/a1+1)*a2;\n   else da=(n/a1)*a2;\n   //b包装\n   if(n%b1!=0) db=(n/b1+1)*b2;\n   else db=(n/b1)*b2;\n   //c包装\n   if(n%c1!=0) dc=(n/c1+1)*c2;\n   else dc=(n/c1)*c2;\n   //比较\n   if(da<db) ans=da;\n   else ans=db;\n   if(dc<ans) ans=dc;\n   cout<<ans;\n   return 0;\n}"
 ],
 "sha256": "06212b2ff557edb6",
 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <meta name=\"csrf-token\" content=\"1795745634:txdDyi9rCbn0uHMLXJVqgVEBECRuUmoDXs16LxjlgeY=\">\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112609'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>题解 P1909 【买铅笔】 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"h8ic4o0m\",\"title\":\"\\u9898\\u89e3 P1909 \\u3010\\u4e70\\u94c5\\u7b14\\u3011\",\"category\":2,\"time\":1541921458,\"author\":{\"uid\":153148,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/153148.png\",\"name\":\"\\u51b0\\u5cf0\",\"slogan\":\"\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Gray\",\"ccfLevel\":0,\"xcpcLevel\":0,\"background\":\"\"},\"upvote\":22,\"replyCount\":6,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1909\",\"type\":\"P\",\"name\":\"[NOIP 2016 \\u666e\\u53ca\\u7ec4] \\u4e70\\u94c5\\u7b14\",\"difficulty\":1,\"fullScore\":100},\"promoteStatus\":0,\"collection\":null,\"content\":\"\\n\\u86e4\\u86e4\\u5927\\u5bb6\\u597d\\u9e2d\\uff0c\\u8fd9\\u91cc\\u662fC++\\u5bb6\\u7684\\u67d0\\u5c0f\\u767d\\u7ed9\\u5927\\u5bb6\\u5199\\u9898\\u89e3\\u3002\\n\\n\\u5982\\u4f55\\u5b9a\\u4e49\\u6211\\u8fd9\\u4e2a\\u5c0f\\u767d\\u5462\\uff1f\\u5c31\\u662f\\uff1a\\u2460\\u6211\\u8bf4\\u7684\\u8bdd\\u4f60\\u542c\\u4e0d\\u61c2\\u2461\\u4e0d\\u4f1a\\u5199\\u7a0b\\u5e8f\\u3002\\n\\n\\u5728\\u987a\\u5e8f\\u4e0e\\u5206\\u652f\\u8fd9\\u4e00\\u680f\\u76ee\\u91cc\\u51fa\\u73b0\\u4e86\\u5faa\\u73af\\u8bed\\u53e5For\\u7684 \\u9898\\uff0c\\u597d\\u50cf\\u6709\\u70b9\\u513f\\u4e0d\\u5bfb\\u5e38\\u3002\\u6240\\u4ee5\\u6b63\\u89e3\\u5e94\\u8be5\\u662f\\u628aFor\\u8bed\\u53e5\\u8d76\\u51fa\\u95e8\\u7684\\u3002\\n\\n\\u8fd9\\u9898**\\u597d\\u50cf\\u5e76\\u6ca1\\u6709\\u4ec0\\u4e48\\u96be\\u70b9**\\uff08\\u867d\\u7136\\u8bf4\\u6211\\u63d0\\u4ea4\\u4e86\\u56db\\u6b21\\u624d\\u5168\\u90e8AC\\uff09\\u3002\\n\\n\\u4e00\\u5171\\u4e09\\u79cd\\u5305\\u88c5\\uff0c\\u8001\\u5e08\\u53ea\\u7edf\\u4e00\\u4e70\\u4e00\\u79cd\\u5305\\u88c5\\u3002\\u56e0\\u4e3a\\u201c\\u9700\\u8981\\u7684\\u94c5\\u7b14\\u6570\\u521a\\u597d\\u662f\\u8be5\\u5305\\u88c5\\u5185\\u542b\\u7684\\u94c5\\u7b14\\u6570\\u7684\\u500d\\u6570\\u201d\\u8fd9\\u79cd\\u60c5\\u51b5\\u4e0d\\u4f1a\\u767e\\u5206\\u767e\\u51fa\\u73b0\\uff0c\\u6240\\u4ee5\\uff0c\\u5982\\u679cn%a\\u4e0d\\u7b49\\u4e8e0\\uff0c\\u6211\\u4eec\\u9700\\u8981\\u8d2d\\u4e70\\u7684\\u5305\\u88c5\\u6570\\u5c31\\u662fn\\/a+1\\u3002\\uff08\\u672c\\u6bb5\\u8bdd\\u5b9a\\u4e49n\\u4e3a\\u9700\\u8981\\u8d2d\\u4e70\\u7684\\u94c5\\u7b14\\u6570\\uff0ca\\u4e3a\\u8be5\\u5305\\u88c5\\u5185\\u542b\\u6709\\u7684\\u94c5\\u7b14\\u6570\\u3002\\uff09\\n\\n\\u5e9f\\u8bdd\\u4e0d\\u591a\\u8bf4\\uff0c\\u6765\\u770b\\u6211\\u7684\\u8fc7\\u7a0b\\u3002\\n\\n------------\\n\\n    #include\\u003Ciostream\\u003E\\n    using namespace std;\\n    int main(){\\n       int n,a1,a2,b1,b2,c1,c2,da,db,dc,ans;\\n\\t   \\/*\\u9700\\u8981\\u94c5\\u7b14\\u6570(n)\\uff0c\\u6700\\u5c11\\u8981\\u82b1\\u7684\\u94b1(ans)\\n       a~c\\u5305\\u88c5\\u5355\\u5305\\u94c5\\u7b14\\u6570(a1,b1,c1)\\uff0ca~c\\u5305\\u88c5\\u5355\\u4ef7    (a2,b2,c2)\\n       \\u6bcf\\u4e2a\\u5305\\u88c5\\u7684\\u603b\\u4ef7(da,db,dc)*\\/\\n       cin\\u003E\\u003En\\u003E\\u003Ea1\\u003E\\u003Ea2\\u003E\\u003Eb1\\u003E\\u003Eb2\\u003E\\u003Ec1\\u003E\\u003Ec2;\\n       \\/\\/a\\u5305\\u88c5 \\n       if(n%a1!=0) da=(n\\/a1+1)*a2;\\n       else da=(n\\/a1)*a2;\\n       \\/\\/b\\u5305\\u88c5\\n       if(n%b1!=0) db=(n\\/b1+1)*b2;\\n       else db=(n\\/b1)*b2;\\n       \\/\\/c\\u5305\\u88c5\\n       if(n%c1!=0) dc=(n\\/c1+1)*c2;\\n       else dc=(n\\/c1)*c2;\\n       \\/\\/\\u6bd4\\u8f83\\n       if(da\\u003Cdb) ans=da;\\n       else ans=db;\\n       if(dc\\u003Cans) ans=dc;\\n       cout\\u003C\\u003Cans;\\n       return 0;\\n    }\\n------------\\n\\u518d\\u8bf4\\u4e00\\u4e0b\\u6bd4\\u8f83\\u90a3\\u91cc\\u3002\\n\\n\\u82e5da\\u003Cdb\\u4e14db\\u003Cdc\\uff0c\\u5219\\u8f93\\u51fada\\uff1b\\u82e5db\\u003Cda\\u4e14da\\u003Cdc\\uff0c\\u5219\\u8f93\\u51fadb\\u2026\\u2026\\u7136\\u540e\\u4f60\\u4f1a\\u53d1\\u73b0\\u2014\\u2014\\u54ce\\u5440\\uff01\\u597d\\u591a\\u79cd\\u60c5\\u51b5\\u5440\\uff01\\u4e0d\\u5199\\u4e86\\u4e0d\\u5199\\u4e86\\uff01\\n\\n\\u7136\\u800c\\u6211\\u4eec\\u53ef\\u4ee5\\u62c6\\u5206\\u5f00\\u6765\\uff0c\\u5148\\u6bd4\\u8f83da\\u4e0edb\\u3002\\n\\n\\u6bd4\\u8f83\\u5b8c\\u4e86\\u5462\\uff0c\\u5c31\\u628a\\u8f83\\u5c0f\\u7684\\u4e00\\u4e2a\\u8bbe\\u4e3aans(\\u5373\\u5c06\\u8f93\\u51fa\\u7684\\u6570)\\u3002\\n\\n\\u522b\\u6025\\uff0c\\u8fd8\\u6ca1\\u5b8c\\uff01\\u4f60\\u6f0f\\u6389\\u4e86dc\\uff01\\n\\n\\u518d\\u6bd4\\u8f83ans\\u548cdc\\u3002\\n\\n\\u7136\\u540e\\u4f60\\u53d1\\u73b0\\uff0c\\u54ce\\u5440\\uff0cdc\\u8981\\u6bd4ans\\u5c0f\\uff01\\u5e78\\u4e8f\\u6ca1\\u6709\\u6025\\u7740\\u8f93\\u51fa\\u3002\\n\\n\\u7136\\u540e\\u6211\\u4eec\\u91cd\\u65b0\\u7ed9ans\\u8d4b\\u503c\\u3002ans=dc\\u3002\\n\\n\\u7136\\u540e\\u8f93\\u51faans\\uff0c\\u5b8c\\u6bd5\\uff01\\n\\n**\\u5c0f\\u767d\\u9898\\u89e3\\uff0c\\u4ec5\\u4f9b\\u53c2\\u8003\\u3002**\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795659234.527215}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/h8ic4o0m\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1909 \\u3010\\u4e70\\u94c5\\u7b14\\u3011\",\"description\":\"\\u86e4\\u86e4\\u5927\\u5bb6\\u597d\\u9e2d\\uff0c\\u8fd9\\u91cc\\u662fC++\\u5bb6\\u7684\\u67d0\\u5c0f\\u767d\\u7ed9\\u5927\\u5bb6\\u5199\\u9898\\u89e3\\u3002\\n\\u5982\\u4f55\\u5b9a\\u4e49\\u6211\\u8fd9\\u4e2a\\u5c0f\\u767d\\u5462\\uff1f\\u5c31\\u662f\\uff1a\\u2460\\u6211\\u8bf4\\u7684\\u8bdd\\u4f60\\u542c\\u4e0d\\u61c2\\u2461\\u4e0d\\u4f1a\\u5199\\u7a0b\\u5e8f\\u3002\\n\\u5728\\u987a\\u5e8f\\u4e0e\\u5206\\u652f\\u8fd9\\u4e00\\u680f\\u76ee\\u91cc\\u51fa\\u73b0\\u4e86\\u5faa\\u73af\\u8bed\\u53e5For\\u7684 \\u9898\\uff0c\\u597d\\u50cf\\u6709\\u70b9\\u513f\\u4e0d\\u5bfb\\u5e38\\u3002\\u6240\\u4ee5\\u6b63\\u89e3\\u5e94\\u8be5\\u662f\\u628aFor\\u8bed\\u53e5\\u8d76\\u51fa\\u95e8\\u7684\\u3002\\n\\u8fd9\\u9898\\u597d\\u50cf\\u5e76\\u6ca1\\u6709\\u4ec0\\u4e48\\u96be\\u70b9\\uff08\\u867d\\u7136\\u8bf4\\u6211\\u63d0\\u4ea4\\u4e86\\u56db\\u6b21\\u624d\\u5168\\u90e8AC\\uff09\\u3002\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"\\u51b0\\u5cf0\"},\"datePublished\":\"2018-11-11T15:30:58+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1909 【买铅笔】\" />\n    <meta property=\"og:description\" content=\"蛤蛤大家好鸭，这里是C++家的某小白给大家写题解。\n如何定义我这个小白呢？就是：①我说的话你听不懂②不会写程序。\n在顺序与分支这一栏目里出现了循环语句For的 题，好像有点儿不寻常。所以正解应该是把For语句赶出门的。\n这题好像并没有什么难点（虽然说我提交了四次才全部AC）。…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"冰峰\" />\n    <meta property=\"article:published_time\" content=\"2018-11-11T15:30:58+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/h8ic4o0m\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1909 【买铅笔】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">冰峰</a>\n            ·\n            <time datetime=\"2018-11-11T15:30:58+08:00\">2018-11-11 15:30:58</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>蛤蛤大家好鸭，这里是C++家的某小白给大家写题解。</p>\n<p>如何定义我这个小白呢？就是：①我说的话你听不懂②不会写程序。</p>\n<p>在顺序与分支这一栏目里出现了循环语句For的 题，好像有点儿不寻常。所以正解应该是把For语句赶出门的。</p>\n<p>这题<strong>好像并没有什么难点</strong>（虽然说我提交了四次才全部AC）。</p>\n<p>一共三种包装，老师只统一买一种包装。因为“需要的铅笔数刚好是该包装内含的铅笔数的倍数”这种情况不会百分百出现，所以，如果n%a不等于0，我们需要购买的包装数就是n/a+1。（本段话定义n为需要购买的铅笔数，a为该包装内含有的铅笔数。）</p>\n<p>废话不多说，来看我的过程。</p>\n\n<pre><code>#include&lt;iostream&gt;\nusing namespace std;\nint main(){\n   int n,a1,a2,b1,b2,c1,c2,da,db,dc,ans;\n   /*需要铅笔数(n)，最少要花的钱(ans)\n   a~c包装单包铅笔数(a1,b1,c1)，a~c包装单价    (a2,b2,c2)\n   每个包装的总价(da,db,dc)*/\n   cin&gt;&gt;n&gt;&gt;a1&gt;&gt;a2&gt;&gt;b1&gt;&gt;b2&gt;&gt;c1&gt;&gt;c2;\n   //a包装 \n   if(n%a1!=0) da=(n/a1+1)*a2;\n   else da=(n/a1)*a2;\n   //b包装\n   if(n%b1!=0) db=(n/b1+1)*b2;\n   else db=(n/b1)*b2;\n   //c包装\n   if(n%c1!=0) dc=(n/c1+1)*c2;\n   else dc=(n/c1)*c2;\n   //比较\n   if(da&lt;db) ans=da;\n   else ans=db;\n   if(dc&lt;ans) ans=dc;\n   cout&lt;&lt;ans;\n   return 0;\n}</code></pre>\n\n<p>再说一下比较那里。</p>\n<p>若da&lt;db且db&lt;dc，则输出da；若db&lt;da且da&lt;dc，则输出db……然后你会发现——哎呀！好多种情况呀！不写了不写了！</p>\n<p>然而我们可以拆分开来，先比较da与db。</p>\n<p>比较完了呢，就把较小的一个设为ans(即将输出的数)。</p>\n<p>别急，还没完！你漏掉了dc！</p>\n<p>再比较ans和dc。</p>\n<p>然后你发现，哎呀，dc要比ans小！幸亏没有急着输出。</p>\n<p>然后我们重新给ans赋值。ans=dc。</p>\n<p>然后输出ans，完毕！</p>\n<p><strong>小白题解，仅供参考。</strong></p>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a605606689d8e3ae',t:'MTc5NTY1OTIzNA=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a605606689d8e3ae',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
