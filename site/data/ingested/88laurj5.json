 "code_blocks": [
  "#include<bits/stdc++.h>\nusing namespace std;\nint p1,p2,p3;\nchar a[101];\nint main()\n{\n    scanf(\"%d%d%d\",&p1,&p2,&p3);\n    cin>>a;//输入\n    for(int i=0;i<strlen(a);i++)\n    {\n        if(a[i]!='-')\n        {\n            cout<<a[i];\n            continue;\n        }//如果不是'-'直接输出\n        if(a[i-1]>='0'&&a[i-1]<='9'&&(a[i+1]<'0'||a[i+1]>'9'))\n        {\n            printf(\"-\");\n            continue;\n        }\n        if(a[i+1]>='0'&&a[i+1]<='9'&&(a[i-1]<'0'||a[i-1]>'9'))\n        {\n            printf(\"-\");\n            continue;\n        }//第一个坑点：如果数据类型不同直接输出\n        if(a[i-1]>=a[i+1])\n        {\n            printf(\"-\");\n            continue;\n        }\n        if(a[i+1]=='-'||a[i-1]=='-')\n        {\n            printf(\"-\");\n            continue;\n        }//第二个坑点：有可能会有两个'-'连在一起\n        if(i==0)\n        {\n            printf(\"-\");\n            continue;\n        }第三个坑点：有可能第一个字符就是'-'\n        if(p1==3&&i!=0)\n        {\n            for(char j=a[i-1]+1;j<a[i+1];j++)\n                for(int k=1;k<=p2;k++)\n                    printf(\"*\");\n            continue;\n        }//第四个坑点：和第三个差不多\n      //填完坑后，就可以按照题意来了\n        if(p3==1)\n        {\n            if(p1==1)\n                for(char j=a[i-1]+1;j<a[i+1];j++)\n                    for(int k=1;k<=p2;k++)\n                        cout<<char(j);\n            if(p1==2)\n                for(char j=a[i-1]-31;j<a[i+1]-32;j++)\n                    for(int k=1;k<=p2;k++)\n                    {\n                        if((a[i+1]>='0'&&a[i+1]<='9')||(a[i-1]>='0'&&a[i-1]<='9'))\n                        cout<<char(j+30);\n                //哦，还有一个坑：数字不要大写，不然会蹦出来一些符号\n                        else\n                        cout<<char(j);\n                    }\n        }\n        if(p3==2)\n        {\n            if(p1==1)\n                for(char j=a[i+1]-1;j>a[i-1];j--)\n                    for(int k=1;k<=p2;k++)\n                        cout<<char(j);\n            if(p1==2)\n                for(char j=a[i+1]-33;j>a[i-1]-32;j--)\n                    for(int k=1;k<=p2;k++)\n                    {\n                        if((a[i+1]>='0'&&a[i+1]<='9')||(a[i-1]>='0'&&a[i-1]<='9'))\n                        cout<<char(j+32);\n                        else\n                        cout<<char(j);                      \n                    }\n        }\n    }\n    return 0;\n   //珍爱生命，远离抄袭\n}"
