 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <!-- 匿名页面令牌已移除（公开归档不保留） -->\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112514'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>题解 P1098 【字符串的展开】 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"88laurj5\",\"title\":\"\\u9898\\u89e3 P1098 \\u3010\\u5b57\\u7b26\\u4e32\\u7684\\u5c55\\u5f00\\u3011\",\"category\":2,\"time\":1568985974,\"author\":{\"uid\":121086,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/121086.png\",\"name\":\"\\u6211\\u7684\\u7236\\u4eb2\",\"slogan\":\"\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Gray\",\"ccfLevel\":0,\"xcpcLevel\":0,\"background\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/image_hosting\\/aqb3l757.png\"},\"upvote\":32,\"replyCount\":12,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1098\",\"type\":\"P\",\"name\":\"[NOIP 2007 \\u63d0\\u9ad8\\u7ec4] \\u5b57\\u7b26\\u4e32\\u7684\\u5c55\\u5f00\",\"difficulty\":2,\"fullScore\":100},\"promoteStatus\":0,\"collection\":null,\"content\":\"# \\u4e00\\u9053\\u8d85\\u5751\\u7684\\u9898\\uff08~~\\u8c03\\u4e86\\u5341\\u51e0\\u6b21~~\\uff09\\n\\n\\u8fd9\\u9053\\u9898\\u601d\\u8def\\u5f88\\u7b80\\u5355\\uff1a\\u4ece\\u5934\\u5230\\u5c3e\\u67e5\\u4e00\\u904d\\uff0c\\u5982\\u679c\\u662f\\u0027-\\u0027\\uff0c\\u6839\\u636e\\u5de6\\u53f3\\u4e24\\u8fb9\\u7684\\u5b57\\u7b26\\u6765\\u8f93\\u51fa\\u3002\\u5982\\u679c\\u4e0d\\u662f\\uff0c\\u76f4\\u63a5\\u8f93\\u51fa\\u3002\\n\\n\\u4f46\\u662f\\u4e8b\\u60c5\\u6ca1\\u6709\\u8fd9\\u4e48\\u7b80\\u5355\\uff01\\uff01\\uff01\\n\\n\\u5177\\u4f53\\u5751\\u70b9\\u770b\\u4ee3\\u7801\\n```\\n#include\\u003Cbits\\/stdc++.h\\u003E\\nusing namespace std;\\nint p1,p2,p3;\\nchar a[101];\\nint main()\\n{\\n\\tscanf(\\u0022%d%d%d\\u0022,\\u0026p1,\\u0026p2,\\u0026p3);\\n\\tcin\\u003E\\u003Ea;\\/\\/\\u8f93\\u5165\\n\\tfor(int i=0;i\\u003Cstrlen(a);i++)\\n\\t{\\n\\t\\tif(a[i]!=\\u0027-\\u0027)\\n\\t\\t{\\n\\t\\t\\tcout\\u003C\\u003Ca[i];\\n\\t\\t\\tcontinue;\\n\\t\\t}\\/\\/\\u5982\\u679c\\u4e0d\\u662f\\u0027-\\u0027\\u76f4\\u63a5\\u8f93\\u51fa\\n\\t\\tif(a[i-1]\\u003E=\\u00270\\u0027\\u0026\\u0026a[i-1]\\u003C=\\u00279\\u0027\\u0026\\u0026(a[i+1]\\u003C\\u00270\\u0027||a[i+1]\\u003E\\u00279\\u0027))\\n\\t\\t{\\n\\t\\t\\tprintf(\\u0022-\\u0022);\\n\\t\\t\\tcontinue;\\n\\t\\t}\\n\\t\\tif(a[i+1]\\u003E=\\u00270\\u0027\\u0026\\u0026a[i+1]\\u003C=\\u00279\\u0027\\u0026\\u0026(a[i-1]\\u003C\\u00270\\u0027||a[i-1]\\u003E\\u00279\\u0027))\\n\\t\\t{\\n\\t\\t\\tprintf(\\u0022-\\u0022);\\n\\t\\t\\tcontinue;\\n\\t\\t}\\/\\/\\u7b2c\\u4e00\\u4e2a\\u5751\\u70b9\\uff1a\\u5982\\u679c\\u6570\\u636e\\u7c7b\\u578b\\u4e0d\\u540c\\u76f4\\u63a5\\u8f93\\u51fa\\n\\t\\tif(a[i-1]\\u003E=a[i+1])\\n\\t\\t{\\n\\t\\t\\tprintf(\\u0022-\\u0022);\\n\\t\\t\\tcontinue;\\n\\t\\t}\\n\\t\\tif(a[i+1]==\\u0027-\\u0027||a[i-1]==\\u0027-\\u0027)\\n\\t\\t{\\n\\t\\t\\tprintf(\\u0022-\\u0022);\\n\\t\\t\\tcontinue;\\n\\t\\t}\\/\\/\\u7b2c\\u4e8c\\u4e2a\\u5751\\u70b9\\uff1a\\u6709\\u53ef\\u80fd\\u4f1a\\u6709\\u4e24\\u4e2a\\u0027-\\u0027\\u8fde\\u5728\\u4e00\\u8d77\\n\\t\\tif(i==0)\\n\\t\\t{\\n\\t\\t\\tprintf(\\u0022-\\u0022);\\n\\t\\t\\tcontinue;\\n\\t\\t}\\u7b2c\\u4e09\\u4e2a\\u5751\\u70b9\\uff1a\\u6709\\u53ef\\u80fd\\u7b2c\\u4e00\\u4e2a\\u5b57\\u7b26\\u5c31\\u662f\\u0027-\\u0027\\n\\t\\tif(p1==3\\u0026\\u0026i!=0)\\n\\t\\t{\\n\\t\\t\\tfor(char j=a[i-1]+1;j\\u003Ca[i+1];j++)\\n\\t\\t\\t\\tfor(int k=1;k\\u003C=p2;k++)\\n\\t\\t\\t\\t\\tprintf(\\u0022*\\u0022);\\n\\t\\t\\tcontinue;\\n\\t\\t}\\/\\/\\u7b2c\\u56db\\u4e2a\\u5751\\u70b9\\uff1a\\u548c\\u7b2c\\u4e09\\u4e2a\\u5dee\\u4e0d\\u591a\\n      \\/\\/\\u586b\\u5b8c\\u5751\\u540e\\uff0c\\u5c31\\u53ef\\u4ee5\\u6309\\u7167\\u9898\\u610f\\u6765\\u4e86\\n\\t\\tif(p3==1)\\n\\t\\t{\\n\\t\\t\\tif(p1==1)\\n\\t\\t\\t\\tfor(char j=a[i-1]+1;j\\u003Ca[i+1];j++)\\n\\t\\t\\t\\t\\tfor(int k=1;k\\u003C=p2;k++)\\n\\t\\t\\t\\t\\t\\tcout\\u003C\\u003Cchar(j);\\n\\t\\t\\tif(p1==2)\\n\\t\\t\\t\\tfor(char j=a[i-1]-31;j\\u003Ca[i+1]-32;j++)\\n\\t\\t\\t\\t\\tfor(int k=1;k\\u003C=p2;k++)\\n\\t\\t\\t\\t\\t{\\n\\t\\t\\t\\t\\t\\tif((a[i+1]\\u003E=\\u00270\\u0027\\u0026\\u0026a[i+1]\\u003C=\\u00279\\u0027)||(a[i-1]\\u003E=\\u00270\\u0027\\u0026\\u0026a[i-1]\\u003C=\\u00279\\u0027))\\n\\t\\t\\t\\t\\t\\tcout\\u003C\\u003Cchar(j+30);\\n                \\/\\/\\u54e6\\uff0c\\u8fd8\\u6709\\u4e00\\u4e2a\\u5751\\uff1a\\u6570\\u5b57\\u4e0d\\u8981\\u5927\\u5199\\uff0c\\u4e0d\\u7136\\u4f1a\\u8e66\\u51fa\\u6765\\u4e00\\u4e9b\\u7b26\\u53f7\\n\\t\\t\\t\\t\\t\\telse\\n\\t\\t\\t\\t\\t\\tcout\\u003C\\u003Cchar(j);\\n\\t\\t\\t\\t\\t}\\n\\t\\t}\\n\\t\\tif(p3==2)\\n\\t\\t{\\n\\t\\t\\tif(p1==1)\\n\\t\\t\\t\\tfor(char j=a[i+1]-1;j\\u003Ea[i-1];j--)\\n\\t\\t\\t\\t\\tfor(int k=1;k\\u003C=p2;k++)\\n\\t\\t\\t\\t\\t\\tcout\\u003C\\u003Cchar(j);\\n\\t\\t\\tif(p1==2)\\n\\t\\t\\t\\tfor(char j=a[i+1]-33;j\\u003Ea[i-1]-32;j--)\\n\\t\\t\\t\\t\\tfor(int k=1;k\\u003C=p2;k++)\\n\\t\\t\\t\\t\\t{\\n\\t\\t\\t\\t\\t\\tif((a[i+1]\\u003E=\\u00270\\u0027\\u0026\\u0026a[i+1]\\u003C=\\u00279\\u0027)||(a[i-1]\\u003E=\\u00270\\u0027\\u0026\\u0026a[i-1]\\u003C=\\u00279\\u0027))\\n\\t\\t\\t\\t\\t\\tcout\\u003C\\u003Cchar(j+32);\\n\\t\\t\\t\\t\\t\\telse\\n\\t\\t\\t\\t\\t\\tcout\\u003C\\u003Cchar(j);\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\treturn 0;\\n   \\/\\/\\u73cd\\u7231\\u751f\\u547d\\uff0c\\u8fdc\\u79bb\\u6284\\u88ad\\n}\\n```\\nAC\\uff01\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795593176.501148}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/88laurj5\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1098 \\u3010\\u5b57\\u7b26\\u4e32\\u7684\\u5c55\\u5f00\\u3011\",\"description\":\"\\u4e00\\u9053\\u8d85\\u5751\\u7684\\u9898\\uff08\\u8c03\\u4e86\\u5341\\u51e0\\u6b21\\uff09\\n\\u8fd9\\u9053\\u9898\\u601d\\u8def\\u5f88\\u7b80\\u5355\\uff1a\\u4ece\\u5934\\u5230\\u5c3e\\u67e5\\u4e00\\u904d\\uff0c\\u5982\\u679c\\u662f'-'\\uff0c\\u6839\\u636e\\u5de6\\u53f3\\u4e24\\u8fb9\\u7684\\u5b57\\u7b26\\u6765\\u8f93\\u51fa\\u3002\\u5982\\u679c\\u4e0d\\u662f\\uff0c\\u76f4\\u63a5\\u8f93\\u51fa\\u3002\\n\\u4f46\\u662f\\u4e8b\\u60c5\\u6ca1\\u6709\\u8fd9\\u4e48\\u7b80\\u5355\\uff01\\uff01\\uff01\\n\\u5177\\u4f53\\u5751\\u70b9\\u770b\\u4ee3\\u7801\\n#include&lt;bits\\/stdc++.h&gt;\\nusing\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"\\u6211\\u7684\\u7236\\u4eb2\"},\"datePublished\":\"2019-09-20T21:26:14+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1098 【字符串的展开】\" />\n    <meta property=\"og:description\" content=\"一道超坑的题（调了十几次）\n这道题思路很简单：从头到尾查一遍，如果是&#039;-&#039;，根据左右两边的字符来输出。如果不是，直接输出。\n但是事情没有这么简单！！！\n具体坑点看代码\n#include&amp;lt;bits/stdc++.h&amp;gt;\nusing…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"我的父亲\" />\n    <meta property=\"article:published_time\" content=\"2019-09-20T21:26:14+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/88laurj5\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1098 【字符串的展开】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">我的父亲</a>\n            ·\n            <time datetime=\"2019-09-20T21:26:14+08:00\">2019-09-20 21:26:14</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <h1>一道超坑的题（<del>调了十几次</del>）</h1>\n<p>这道题思路很简单：从头到尾查一遍，如果是'-'，根据左右两边的字符来输出。如果不是，直接输出。</p>\n<p>但是事情没有这么简单！！！</p>\n<p>具体坑点看代码</p>\n<pre><code>#include&lt;bits/stdc++.h&gt;\nusing namespace std;\nint p1,p2,p3;\nchar a[101];\nint main()\n{\n    scanf(\"%d%d%d\",&amp;p1,&amp;p2,&amp;p3);\n    cin&gt;&gt;a;//输入\n    for(int i=0;i&lt;strlen(a);i++)\n    {\n        if(a[i]!='-')\n        {\n            cout&lt;&lt;a[i];\n            continue;\n        }//如果不是'-'直接输出\n        if(a[i-1]&gt;='0'&amp;&amp;a[i-1]&lt;='9'&amp;&amp;(a[i+1]&lt;'0'||a[i+1]&gt;'9'))\n        {\n            printf(\"-\");\n            continue;\n        }\n        if(a[i+1]&gt;='0'&amp;&amp;a[i+1]&lt;='9'&amp;&amp;(a[i-1]&lt;'0'||a[i-1]&gt;'9'))\n        {\n            printf(\"-\");\n            continue;\n        }//第一个坑点：如果数据类型不同直接输出\n        if(a[i-1]&gt;=a[i+1])\n        {\n            printf(\"-\");\n            continue;\n        }\n        if(a[i+1]=='-'||a[i-1]=='-')\n        {\n            printf(\"-\");\n            continue;\n        }//第二个坑点：有可能会有两个'-'连在一起\n        if(i==0)\n        {\n            printf(\"-\");\n            continue;\n        }第三个坑点：有可能第一个字符就是'-'\n        if(p1==3&amp;&amp;i!=0)\n        {\n            for(char j=a[i-1]+1;j&lt;a[i+1];j++)\n                for(int k=1;k&lt;=p2;k++)\n                    printf(\"*\");\n            continue;\n        }//第四个坑点：和第三个差不多\n      //填完坑后，就可以按照题意来了\n        if(p3==1)\n        {\n            if(p1==1)\n                for(char j=a[i-1]+1;j&lt;a[i+1];j++)\n                    for(int k=1;k&lt;=p2;k++)\n                        cout&lt;&lt;char(j);\n            if(p1==2)\n                for(char j=a[i-1]-31;j&lt;a[i+1]-32;j++)\n                    for(int k=1;k&lt;=p2;k++)\n                    {\n                        if((a[i+1]&gt;='0'&amp;&amp;a[i+1]&lt;='9')||(a[i-1]&gt;='0'&amp;&amp;a[i-1]&lt;='9'))\n                        cout&lt;&lt;char(j+30);\n                //哦，还有一个坑：数字不要大写，不然会蹦出来一些符号\n                        else\n                        cout&lt;&lt;char(j);\n                    }\n        }\n        if(p3==2)\n        {\n            if(p1==1)\n                for(char j=a[i+1]-1;j&gt;a[i-1];j--)\n                    for(int k=1;k&lt;=p2;k++)\n                        cout&lt;&lt;char(j);\n            if(p1==2)\n                for(char j=a[i+1]-33;j&gt;a[i-1]-32;j--)\n                    for(int k=1;k&lt;=p2;k++)\n                    {\n                        if((a[i+1]&gt;='0'&amp;&amp;a[i+1]&lt;='9')||(a[i-1]&gt;='0'&amp;&amp;a[i-1]&lt;='9'))\n                        cout&lt;&lt;char(j+32);\n                        else\n                        cout&lt;&lt;char(j);                      \n                    }\n        }\n    }\n    return 0;\n   //珍爱生命，远离抄袭\n}</code></pre>\n<p>AC！</p>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a5ff13a8586d9013',t:'MTc5NTU5MzE3Ng=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a5ff13a8586d9013',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
