ory\":2,\"time\":1555567236,\"author\":{\"uid\":115923,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/115923.png\",\"name\":\"Substitute0329\",\"slogan\":\"\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Blue\",\"ccfLevel\":0,\"xcpcLevel\":0,\"background\":\"\"},\"upvote\":0,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1098\",\"type\":\"P\",\"name\":\"[NOIP 2007 \\u63d0\\u9ad8\\u7ec4] \\u5b57\\u7b26\\u4e32\\u7684\\u5c55\\u5f00\",\"difficulty\":2,\"fullScore\":100},\"promoteStatus\":0,\"collection\":null,\"content\":\"# P1098\\u3010\\u5b57\\u7b26\\u4e32\\u7684\\u5c55\\u5f00\\u3011\\n\\u8bc4\\u6d4b\\u51fa\\u6765\\u7684\\u96be\\u5ea6\\u662f\\u9ec4\\u9898![](https:\\/\\/cdn.luogu.com.cn\\/upload\\/pic\\/56864.png)\\uff0c\\u4f46\\u5176\\u5b9e\\u6211\\u4e2a\\u4eba\\u8ba4\\u4e3a\\uff0c\\u8fd9\\u662f\\u4e00\\u9053\\u6a59\\u9898![](https:\\/\\/cdn.luogu.com.cn\\/upload\\/pic\\/56865.png)\\u3002\\n## \\u8d85\\u7ea7\\u65e0\\u654c\\u5927\\u66b4\\u529b\\u9898\\u76ee\\uff01\\uff01\\n### \\u5ba1\\u9898\\u5341\\u5206\\u91cd\\u8981\\uff0c\\u5148\\u770b\\u770b\\u9898\\n\\u5177\\u4f53\\u7ea6\\u5b9a\\u5982\\u4e0b\\uff1a\\n\\n\\uff081\\uff09\\u9047\\u5230\\u4e0b\\u9762\\u7684\\u60c5\\u51b5\\u9700\\u8981\\u505a\\u5b57\\u7b26\\u4e32\\u7684\\u5c55\\u5f00\\uff1a\\u5728\\u8f93\\u5165\\u7684\\u5b57\\u7b26\\u4e32\\u4e2d\\uff0c\\u51fa\\u73b0\\u4e86\\u51cf\\u53f7\\u201c-\\u201d\\uff0c\\u51cf\\u53f7\\u4e24\\u4fa7\\u540c\\u4e3a\\u5c0f\\u5199\\u5b57\\u6bcd\\u6216\\u540c\\u4e3a\\u6570\\u5b57\\uff0c\\u4e14\\u6309\\u7167ASCII\\u7801\\u7684\\u987a\\u5e8f\\uff0c\\u51cf\\u53f7\\u53f3\\u8fb9\\u7684\\u5b57\\u7b26\\u4e25\\u683c\\u5927\\u4e8e\\u5de6\\u8fb9\\u7684\\u5b57\\u7b26\\u3002\\n\\n\\uff082\\uff09\\u53c2\\u6570p1\\uff1a\\u5c55\\u5f00\\u65b9\\u5f0f\\u3002p1=1\\u65f6\\uff0c\\u5bf9\\u4e8e\\u5b57\\u6bcd\\u5b50\\u4e32\\uff0c\\u586b\\u5145\\u5c0f\\u5199\\u5b57\\u6bcd\\uff1bp1=2\\u65f6\\uff0c\\u5bf9\\u4e8e\\u5b57\\u6bcd\\u5b50\\u4e32\\uff0c\\u586b\\u5145\\u5927\\u5199\\u5b57\\u6bcd\\u3002\\u8fd9\\u4e24\\u79cd\\u60c5\\u51b5\\u4e0b\\u6570\\u5b57\\u5b50\\u4e32\\u7684\\u586b\\u5145\\u65b9\\u5f0f\\u76f8\\u540c\\u3002p1=3\\u65f6\\uff0c\\u4e0d\\u8bba\\u662f\\u5b57\\u6bcd\\u5b50\\u4e32\\u8fd8\\u662f\\u6570\\u5b57\\u5b50\\u4e32\\uff0c\\u90fd\\u7528\\u4e0e\\u8981\\u586b\\u5145\\u7684\\u5b57\\u6bcd\\u4e2a\\u6570\\u76f8\\u540c\\u7684\\u661f\\u53f7\\u201c*\\u201d\\u6765\\u586b\\u5145\\u3002\\n\\n\\uff083\\uff09\\u53c2\\u6570p2\\uff1a\\u586b\\u5145\\u5b57\\u7b26\\u7684\\u91cd\\u590d\\u4e2a\\u6570\\u3002p2=k\\u8868\\u793a\\u540c\\u4e00\\u4e2a\\u5b57\\u7b26\\u8981\\u8fde\\u7eed\\u586b\\u5145k\\u4e2a\\u3002\\u4f8b\\u5982\\uff0c\\u5f53p2=3\\u65f6\\uff0c\\u5b50\\u4e32\\u201cd-h\\u201d\\u5e94\\u6269\\u5c55\\u4e3a\\u201cdeeefffgggh\\u201d\\u3002\\u51cf\\u53f7\\u4e24\\u4fa7\\u7684\\u5b57\\u7b26\\u4e0d\\u53d8\\u3002\\n\\n\\uff084\\uff09\\u53c2\\u6570p3\\uff1a\\u662f\\u5426\\u6539\\u4e3a\\u9006\\u5e8f\\uff1ap3=1\\u8868\\u793a\\u7ef4\\u6301\\u539f\\u6709\\u987a\\u5e8f\\uff0cp3=2\\u8868\\u793a\\u91c7\\u7528\\u9006\\u5e8f\\u8f93\\u51fa\\uff0c\\u6ce8\\u610f\\u8fd9\\u65f6\\u4ecd\\u7136\\u4e0d\\u5305\\u62ec\\u51cf\\u53f7\\u4e24\\u7aef\\u7684\\u5b57\\u7b26\\u3002\\u4f8b\\u5982\\u5f53p1=1\\u3001p2=2\\u3001p3=2\\u65f6\\uff0c\\u5b50\\u4e32\\u201cd-h\\u201d\\u5e94\\u6269\\u5c55\\u4e3a\\u201cdggffeeh\\u201d\\u3002\\n\\n\\uff085\\uff09\\u5982\\u679c\\u51cf\\u53f7\\u53f3\\u8fb9\\u7684\\u5b57\\u7b26\\u6070\\u597d\\u662f\\u5de6\\u8fb9\\u5b57\\u7b26\\u7684\\u540e\\u7ee7\\uff0c\\u53ea\\u5220\\u9664\\u4e2d\\u95f4\\u7684\\u51cf\\u53f7\\uff0c\\u4f8b\\u5982\\uff1a\\u201cd-e\\u201d\\u5e94\\u8f93\\u51fa\\u4e3a\\u201cde\\u201d\\uff0c\\u201c3-4\\u201d\\u5e94\\u8f93\\u51fa\\u4e3a\\u201c34\\u201d\\u3002\\u5982\\u679c\\u51cf\\u53f7\\u53f3\\u8fb9\\u7684\\u5b57\\u7b26\\u6309\\u7167ASCII\\u7801\\u7684\\u987a\\u5e8f\\u5c0f\\u4e8e\\u6216\\u7b49\\u4e8e\\u5de6\\u8fb9\\u5b57\\u7b26\\uff0c\\u8f93\\u51fa\\u65f6\\uff0c\\u8981\\u4fdd\\u7559\\u4e2d\\u95f4\\u7684\\u51cf\\u53f7\\uff0c\\u4f8b\\u5982\\uff1a\\u201cd-d\\u201d\\u5e94\\u8f93\\u51fa\\u4e3a\\u201cd-d\\u201d\\uff0c\\u201c3-1\\u201d\\u5e94\\u8f93\\u51fa\\u4e3a\\u201c3-1\\u201d\\u3002\\n\\u76f4\\u63a5\\u4e0a\\u4ee3\\u7801\\u5427\\uff01\\uff01\\n```cpp\\n#include\\u003Ccstdio\\u003E\\n#include\\u003Ccstring\\u003E\\nusing namespace std;\\nint d[101],top;\\nint p1,p2,p3;\\nchar a[101];\\nint main(){\\n\\tscanf(\\u0022%d%d%d\\\\n\\u0022,\\u0026p1,\\u0026p2,\\u0026p3);\\n\\tscanf(\\u0022%s\\u0022,a);\\n\\tint lena=strlen(a);                                      \\/\\/\\u4ee5\\u4e0a\\u8bfb\\u5165\\n\\tfor(register int i=0;i\\u003Clena;i++){\\n\\t\\tif(a[i]==\\u0027-\\u0027\\u0026\\u0026(a[i+1]==\\u0027-\\u0027||a[i-1]==\\u0027-\\u0027)){           \\/\\/\\u5f53\\u524d\\u5b57\\u7b26\\u82e5\\u4e3a   \\u0027-\\u0027   \\uff0c\\u5c31\\u5224\\u65ad\\u4e24\\u8fb9\\u7684\\u5b57\\u7b26\\u8fbe\\u5230\\u201c\\u662f\\u5426\\u9700\\u8981\\u5c55\\u5f00\\u5b57\\u7b26\\u4e32\\u201d\\u7684\\u8981\\u6c42\\n\\t\\t\\tputchar(\\u0027-\\u0027);\\n\\t\\t\\tcontinue;\\n\\t\\t}\\n\\t\\tif(a[i]==\\u0027-\\u0027\\u0026\\u0026((a[i-1]\\u003E=\\u00270\\u0027\\u0026\\u0026a[i-1]\\u003C=\\u00279\\u0027\\u0026\\u0026a[i+1]\\u003E=\\u0027a\\u0027\\u0026\\u0026a[i+1]\\u003C=\\u0027z\\u0027)||(a[i+1]\\u003E=\\u00270\\u0027\\u0026\\u0026a[i+1]\\u003C=\\u00279\\u0027\\u0026\\u0026a[i-1]\\u003E=\\u0027a\\u0027\\u0026\\u0026a[i-1]\\u003C=\\u0027z\\u0027))){    \\/\\/\\u540c\\u4e0a\\n\\t\\t\\tputchar(\\u0027-\\u0027);\\n\\t\\t\\tcontinue;\\n\\t\\t}\\n\\t\\tif(a[i]==\\u0027-\\u0027\\u0026\\u0026a[i+1]\\u003Ca[i-1]){              \\/\\/\\u6761\\u4ef6\\uff081\\uff09\\n\\t\\t\\tputchar(\\u0027-\\u0027);\\n\\t\\t\\tcontinue;\\n\\t\\t}\\n\\t\\tif(a[i]==\\u0027-\\u0027\\u0026\\u0026i==0){                \\/\\/\\u5982\\u679c\\u0027-\\u0027 \\u5728\\u5b57\\u7b26\\u4e32\\u5f00\\u5934\\uff0c\\u540c\\u6837\\uff0c\\u4e0d\\u9700\\u8981\\u5c55\\u5f00 \\n\\t\\t\\tputchar(\\u0027-\\u0027);\\n\\t\\t\\tcontinue;\\n\\t\\t}\\n\\t\\tif(a[i]!=\\u0027-\\u0027){                      \\/\\/\\u5982\\u679c\\u4e0d\\u0027-\\u0027\\uff0c\\u76f4\\u63a5\\u8f93\\u51fa\\n\\t\\t\\tputchar(a[i]);\\n\\t\\t\\tcontinue;\\n\\t\\t}\\n\\t\\tif(a[i]==\\u0027-\\u0027\\u0026\\u0026a[i-1]+1==a[i+1])continue;       \\/\\/\\u6761\\u4ef6\\uff085\\uff09\\n\\t\\tif(a[i]==\\u0027-\\u0027\\u0026\\u0026a[i-1]==a[i+1]){\\n\\t\\t\\tputchar(\\u0027-\\u0027);\\n\\t\\t\\tcontinue;\\n\\t\\t}\\n\\t\\tif(a[i]==\\u0027-\\u0027\\u0026\\u0026((a[i-1]\\u003C=\\u0027z\\u0027\\u0026\\u0026a[i-1]\\u003E=\\u0027a\\u0027\\u0026\\u0026a[i+1]\\u003E=\\u0027a\\u0027\\u0026\\u0026a[i-1]\\u003C=\\u0027z\\u0027)||(a[i-1]\\u003C=\\u00279\\u0027\\u0026\\u0026a[i-1]\\u003E=\\u00270\\u0027\\u0026\\u0026a[i+1]\\u003C=\\u00279\\u0027\\u0026\\u0026a[i+1]\\u003E=\\u00270\\u0027))){   \\/\\/\\u5982\\u679c\\u9700\\u8981\\u5c55\\u5f00\\n\\t\\t\\tif(p1==3)\\n\\t\\t\\t\\tfor(register int j=a[i-1]+1;j\\u003C=a[i+1]-1;j++)\\n\\t\\t\\t\\t\\tfor(register int k=1;k\\u003C=p2;k++)\\n\\t\\t\\t\\t\\tputchar(\\u0027*\\u0027);\\n\\t\\t\\telse if(p1==2){\\n\\t\\t\\t\\tif(a[i-1]\\u003E=\\u0027a\\u0027\\u0026\\u0026a[i+1]\\u003C=\\u0027z\\u0027){\\n\\t\\t\\t\\t\\tif(p3==1)\\n\\t\\t\\t\\t\\t\\tfor(register int j=a[i-1]+1;j\\u003C=a[i+1]-1;j++)\\n\\t\\t\\t\\t\\t\\t\\tfor(register int k=1;k\\u003C=p2;k++)\\n\\t\\t\\t\\t\\t\\t\\tputchar(j-\\u0027a\\u0027+\\u0027A\\u0027);\\n\\t\\t\\t\\t\\telse if(p3==2)\\n\\t\\t\\t\\t\\t\\tfor(register int j=a[i+1]-1;j\\u003Ea[i-1];j--)\\n\\t\\t\\t\\t\\t\\t\\tfor(register int k=1;k\\u003C=p2;k++)\\n\\t\\t\\t\\t\\t\\t\\tputchar(j-\\u0027a\\u0027+\\u0027A\\u0027);\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\telse for(register int j=a[i-1]+1;j\\u003C=a[i+1]-1;j++)\\n\\t\\t\\t\\t\\t\\tfor(register int k=1;k\\u003C=p2;k++)\\n\\t\\t\\t\\t\\t\\tputchar(j);        \\/\\/             \\u8fd9\\u91cc\\u9700\\u8981\\u7279\\u5224\\u4e00\\u4e0b\\uff0c\\u5c55\\u5f00\\u5f97\\u5230\\u65b0\\u7684\\u5b57\\u7b26\\u662f\\u5426\\u4e3a\\u6570\\u5b57\\uff0c\\u6216\\u8005\\u5b57\\u6bcd\\u3002\\u8fd9\\u4e24\\u79cd\\u60c5\\u51b5\\u4e0d\\u4e00\\u6837\\u3002\\n\\t\\t\\t}\\n\\t\\t\\telse if(p1==1){\\n\\t\\t\\t\\tif(p3==1)\\n\\t\\t\\t\\t\\tfor(register int j=a[i-1]+1;j\\u003C=a[i+1]-1;j++)\\n\\t\\t\\t\\t\\t\\tfor(register int k=1;k\\u003C=p2;k++)\\n\\t\\t\\t\\t\\t\\tputchar(j);\\n\\t\\t\\t\\telse if(p3==2)\\n\\t\\t\\t\\t\\tfor(register int j=a[i+1]-1;j\\u003Ea[i-1];j--)\\n\\t\\t\\t\\t\\t\\tfor(register int k=1;k\\u003C=p2;k++)\\n\\t\\t\\t\\t\\t\\tputchar(j);\\n\\t\\t\\t}\\n\\t\\t\\tcontinue;\\n\\t\\t}\\n\\t}\\n\\treturn 0;                            \\/\\/\\u517b\\u6210\\u597d\\u4e60\\u60ef\\n}\\n```\\n\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795629511.70047}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/zcy00qo9\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1098 \\u3010\\u5b57\\u7b26\\u4e32\\u7684\\u5c55\\u5f00\\u3011\",\"description\":\"P1098\\u3010\\u5b57\\u7b26\\u4e32\\u7684\\u5c55\\u5f00\\u3011\\n\\u8bc4\\u6d4b\\u51fa\\u6765\\u7684\\u96be\\u5ea6\\u662f\\u9ec4\\u9898\\uff0c\\u4f46\\u5176\\u5b9e\\u6211\\u4e2a\\u4eba\\u8ba4\\u4e3a\\uff0c\\u8fd9\\u662f\\u4e00\\u9053\\u6a59\\u9898\\u3002\\n\\u8d85\\u7ea7\\u65e0\\u654c\\u5927\\u66b4\\u529b\\u9898\\u76ee\\uff01\\uff01\\n\\u5ba1\\u9898\\u5341\\u5206\\u91cd\\u8981\\uff0c\\u5148\\u770b\\u770b\\u9898\\n\\u5177\\u4f53\\u7ea6\\u5b9a\\u5982\\u4e0b\\uff1a\\n\\uff081\\uff09\\u9047\\u5230\\u4e0b\\u9762\\u7684\\u60c5\\u51b5\\u9700\\u8981\\u505a\\u5b57\\u7b26\\u4e32\\u7684\\u5c55\\u5f00\\uff1a\\u5728\\u8f93\\u5165\\u7684\\u5b57\\u7b26\\u4e32\\u4e2d\\uff0c\\u51fa\\u73b0\\u4e86\\u51cf\\u53f7\\u201c-\\u201d\\uff0c\\u51cf\\u53f7\\u4e24\\u4fa7\\u540c\\u4e3a\\u5c0f\\u5199\\u5b57\\u6bcd\\u6216\\u540c\\u4e3a\\u6570\\u5b57\\uff0c\\u4e14\\u6309\\u7167ASCII\\u7801\\u7684\\u987a\\u5e8f\\uff0c\\u51cf\\u53f7\\u53f3\\u8fb9\\u7684\\u5b57\\u7b26\\u4e25\\u683c\\u5927\\u4e8e\\u5de6\\u8fb9\\u7684\\u5b57\\u7b26\\u3002\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"Substitute0329\"},\"datePublished\":\"2019-04-18T14:00:36+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1098 【字符串的展开】\" />\n    <meta property=\"og:description\" content=\"P1098【字符串的展开】\n评测出来的难度是黄题，但其实我个人认为，这是一道橙题。\n超级无敌大暴力题目！！\n审题十分重要，先看看题\n具体约定如下：\n（1）遇到下面的情况需要做字符串的展开：在输入的字符串中，出现了减号“-”，减号两侧同为小写字母或同为数字，且按照ASCII码的顺序，减号右边的字符严格大于左边的字符。…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"Substitute0329\" />\n    <meta property=\"article:published_time\" content=\"2019-04-18T14:00:36+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/zcy00qo9\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1098 【字符串的展开】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">Substitute0329</a>\n            ·\n            <time datetime=\"2019-04-18T14:00:36+08:00\">2019-04-18 14:00:36</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <h1>P1098【字符串的展开】</h1>\n<p>评测出来的难度是黄题，但其实我个人认为，这是一道橙题。</p>\n<h2>超级无敌大暴力题目！！</h2>\n<h3>审题十分重要，先看看题</h3>\n<p>具体约定如下：</p>\n<p>（1）遇到下面的情况需要做字符串的展开：在输入的字符串中，出现了减号“-”，减号两侧同为小写字母或同为数字，且按照ASCII码的顺序，减号右边的字符严格大于左边的字符。</p>\n<p>（2）参数p1：展开方式。p1=1时，对于字母子串，填充小写字母；p1=2时，对于字母子串，填充大写字母。这两种情况下数字子串的填充方式相同。p1=3时，不论是字母子串还是数字子串，都用与要填充的字母个数相同的星号“*”来填充。</p>\n<p>（3）参数p2：填充字符的重复个数。p2=k表示同一个字符要连续填充k个。例如，当p2=3时，子串“d-h”应扩展为“deeefffgggh”。减号两侧的字符不变。</p>\n<p>（4）参数p3：是否改为逆序：p3=1表示维持原有顺序，p3=2表示采用逆序输出，注意这时仍然不包括减号两端的字符。例如当p1=1、p2=2、p3=2时，子串“d-h”应扩展为“dggffeeh”。</p>\n<p>（5）如果减号右边的字符恰好是左边字符的后继，只删除中间的减号，例如：“d-e”应输出为“de”，“3-4”应输出为“34”。如果减号右边的字符按照ASCII码的顺序小于或等于左边字符，输出时，要保留中间的减号，例如：“d-d”应输出为“d-d”，“3-1”应输出为“3-1”。\n直接上代码吧！！</p>\n<pre><code class=\"language-cpp\">#include&lt;cstdio&gt;\n#include&lt;cstring&gt;\nusing namespace std;\nint d[101],top;\nint p1,p2,p3;\nchar a[101];\nint main(){\n    scanf(\"%d%d%d\\n\",&amp;p1,&amp;p2,&amp;p3);\n    scanf(\"%s\",a);\n    int lena=strlen(a);                                      //以上读入\n    for(register int i=0;i&lt;lena;i++){\n        if(a[i]=='-'&amp;&amp;(a[i+1]=='-'||a[i-1]=='-')){           //当前字符若为   '-'   ，就判断两边的字符达到“是否需要展开字符串”的要求\n            putchar('-');\n            continue;\n        }\n        if(a[i]=='-'&amp;&amp;((a[i-1]&gt;='0'&amp;&amp;a[i-1]&lt;='9'&amp;&amp;a[i+1]&gt;='a'&amp;&amp;a[i+1]&lt;='z')||(a[i+1]&gt;='0'&amp;&amp;a[i+1]&lt;='9'&amp;&amp;a[i-1]&gt;='a'&amp;&amp;a[i-1]&lt;='z'))){    //同上\n            putchar('-');\n            continue;\n        }\n        if(a[i]=='-'&amp;&amp;a[i+1]&lt;a[i-1]){              //条件（1）\n            putchar('-');\n            continue;\n        }\n        if(a[i]=='-'&amp;&amp;i==0){                //如果'-' 在字符串开头，同样，不需要展开 \n            putchar('-');\n            continue;\n        }\n        if(a[i]!='-'){                      //如果不'-'，直接输出\n            putchar(a[i]);\n            continue;\n        }\n        if(a[i]=='-'&amp;&amp;a[i-1]+1==a[i+1])continue;       //条件（5）\n        if(a[i]=='-'&amp;&amp;a[i-1]==a[i+1]){\n            putchar('-');\n            continue;\n        }\n        if(a[i]=='-'&amp;&amp;((a[i-1]&lt;='z'&amp;&amp;a[i-1]&gt;='a'&amp;&amp;a[i+1]&gt;='a'&amp;&amp;a[i-1]&lt;='z')||(a[i-1]&lt;='9'&amp;&amp;a[i-1]&gt;='0'&amp;&amp;a[i+1]&lt;='9'&amp;&amp;a[i+1]&gt;='0'))){   //如果需要展开\n            if(p1==3)\n                for(register int j=a[i-1]+1;j&lt;=a[i+1]-1;j++)\n                    for(register int k=1;k&lt;=p2;k++)\n                    putchar('*');\n            else if(p1==2){\n                if(a[i-1]&gt;='a'&amp;&amp;a[i+1]&lt;='z'){\n                    if(p3==1)\n                        for(register int j=a[i-1]+1;j&lt;=a[i+1]-1;j++)\n                            for(register int k=1;k&lt;=p2;k++)\n                            putchar(j-'a'+'A');\n                    else if(p3==2)\n                        for(register int j=a[i+1]-1;j&gt;a[i-1];j--)\n                            for(register int k=1;k&lt;=p2;k++)\n                            putchar(j-'a'+'A');\n                }\n                else for(register int j=a[i-1]+1;j&lt;=a[i+1]-1;j++)\n                        for(register int k=1;k&lt;=p2;k++)\n                        putchar(j);        //             这里需要特判一下，展开得到新的字符是否为数字，或者字母。这两种情况不一样。\n            }\n            else if(p1==1){\n                if(p3==1)\n                    for(register int j=a[i-1]+1;j&lt;=a[i+1]-1;j++)\n                        for(register int k=1;k&lt;=p2;k++)\n                        putchar(j);\n                else if(p3==2)\n                    for(register int j=a[i+1]-1;j&gt;a[i-1];j--)\n                        for(register int k=1;k&lt;=p2;k++)\n                        putchar(j);\n            }\n            continue;\n        }\n    }\n    return 0;                            //养成好习惯\n}</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6028abc7a20cf26',t:'MTc5NTYyOTUxMQ=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6028abc7a20cf26',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
