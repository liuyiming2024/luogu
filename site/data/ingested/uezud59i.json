 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <meta name=\"csrf-token\" content=\"1795715961:c1NWnLv9Xhmy5kmdOzJlXzJ9LRki8k7X3H3cGnemFdo=\">\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112601'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>题解 P1220 【关路灯 】 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"uezud59i\",\"title\":\"\\u9898\\u89e3 P1220 \\u3010\\u5173\\u8def\\u706f \\u3011\",\"category\":2,\"time\":1553940094,\"author\":{\"uid\":48989,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/48989.png\",\"name\":\"\\u6768\\u5955\\u8f89\",\"slogan\":\"\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Blue\",\"ccfLevel\":0,\"xcpcLevel\":0,\"background\":\"\"},\"upvote\":0,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1220\",\"type\":\"P\",\"name\":\"\\u5173\\u8def\\u706f\",\"difficulty\":4,\"fullScore\":100},\"promoteStatus\":3,\"collection\":null,\"content\":\"#### \\u8fd9\\u9898\\u6570\\u636e\\u4e0d\\u662f\\u5f88\\u5927\\uff0c\\u7528dfs\\u641c\\u7d22\\u4e0b\\u53bb\\u52a0\\u4e0a\\u4e00\\u4e9b\\u4f18\\u5316\\u5c31\\u53ef\\u4ee5\\u8fc7\\uff0c\\u8be6\\u89c1\\u6279\\u6ce8\\n\\n------------\\n\\n _1. ```cpp\\n\\/\\/ luogu-judger-enable-o2\\n\\n#include\\u003Cbits\\/stdc++.h\\u003E\\n\\nusing namespace std;\\n\\nlong long n,m,minn,s;\\n\\nlong long a[100001],b[100001];\\n\\nvoid dfs(int i,int j,int k,int v,int x) \\/\\/i\\u4e3a\\u5de6\\u4fa7\\u8ddd\\u79bb\\u6700\\u8fd1\\u7684\\uff0cj\\u4e3a\\u53f3\\u4fa7\\u8ddd\\u79bb\\u6700\\u8fd1\\u7684\\uff0ck\\u4e3a\\u4e0a\\u4e00\\u6b21\\u5411\\u54ea\\u4e00\\u4fa7\\u8d70\\uff0cv\\u4e3a\\u603b\\u8017\\u7535\\u91cf\\uff0cx\\u4e3a\\u5f53\\u524d\\u6bcf\\u79d2\\u8017\\u7535\\u91cf\\n\\n{\\n\\n    if (v\\u003Eminn) return; \\/\\/\\u5f53\\u5df2\\u7ecf\\u4e0d\\u662f\\u6700\\u4f18\\u89e3\\u65f6\\u9000\\u51fa\\uff0c\\u4f18\\u5316\\u65f6\\u95f4\\n    if (i==1 \\u0026\\u0026 j==n) \\n    {\\n        if (v\\u003Cminn) minn=v;\\n        return;\\n    }\\n    if (k==0) \\/\\/k=0\\u8868\\u793a\\u4ece\\u5de6\\u8fb9\\u8fc7\\u6765\\n    {\\n        if (i\\u003E1) dfs(i-1,j,0,v+x*abs(a[i-1]-a[i]),x-b[i-1]);\\n        if (j\\u003Cn) dfs(i,j+1,1,v+x*abs(a[i]-a[j+1]),x-b[j+1]);\\n    }\\n    if (k==1) \\/\\/k=1\\u8868\\u793a\\u4ece\\u53f3\\u8fb9\\u8fc7\\u6765\\n    {\\n        if (j\\u003Cn) dfs(i,j+1,1,v+x*abs(a[j]-a[j+1]),x-b[j+1]);\\n        if (i\\u003E1) dfs(i-1,j,0,v+x*abs(a[j]-a[i-1]),x-b[i-1]);\\n    }\\n    return;\\n\\n}\\n\\nint main()\\n\\n{\\n   \\n    cin\\u003E\\u003En\\u003E\\u003Em;\\n    \\n    minn=1000000000;\\n    for (int i=1; i\\u003C=n; ++i)\\n    {\\n        cin\\u003E\\u003Ea[i]\\u003E\\u003Eb[i];\\n        s+=b[i];\\n    }\\n    s-=b[m]; \\/\\/s\\u4e3a\\u521d\\u59cb\\u65f6\\u6bcf\\u79d2\\u8017\\u7535\\u91cf\\n    dfs(m,m,0,0,s);\\n    cout\\u003C\\u003Cminn;\\n    return 0;\\n}_ \\n```\\n\\/\\/luogu\\u8fd9\\u9898\\u89e3\\u7684\\u683c\\u5f0f\\u771f\\u7684\\u6709\\u4e00\\u4e9b\\u70e6\\u4eba\\uff0c\\u4f1a\\u957f\\u5f97\\u5f88\\u4e11\\u3002\\u3002\\u3002\\u3002\\n\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795629561.103777}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/uezud59i\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1220 \\u3010\\u5173\\u8def\\u706f \\u3011\",\"description\":\"\\u8fd9\\u9898\\u6570\\u636e\\u4e0d\\u662f\\u5f88\\u5927\\uff0c\\u7528dfs\\u641c\\u7d22\\u4e0b\\u53bb\\u52a0\\u4e0a\\u4e00\\u4e9b\\u4f18\\u5316\\u5c31\\u53ef\\u4ee5\\u8fc7\\uff0c\\u8be6\\u89c1\\u6279\\u6ce8\\n\\n_1. ```cpp\\n\\/\\/ luogu-judger-enable-o2\\ninclude&lt;bits\\/stdc++.h&gt;\\nusing namespace std;\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"\\u6768\\u5955\\u8f89\"},\"datePublished\":\"2019-03-30T18:01:34+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1220 【关路灯 】\" />\n    <meta property=\"og:description\" content=\"这题数据不是很大，用dfs搜索下去加上一些优化就可以过，详见批注\n\n_1. ```cpp\n// luogu-judger-enable-o2\ninclude&amp;lt;bits/stdc++.h&amp;gt;\nusing namespace std;…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"杨奕辉\" />\n    <meta property=\"article:published_time\" content=\"2019-03-30T18:01:34+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/uezud59i\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1220 【关路灯 】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">杨奕辉</a>\n            ·\n            <time datetime=\"2019-03-30T18:01:34+08:00\">2019-03-30 18:01:34</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <h4>这题数据不是很大，用dfs搜索下去加上一些优化就可以过，详见批注</h4>\n\n<p>_1. ```cpp\n// luogu-judger-enable-o2</p>\n<h1>include&lt;bits/stdc++.h&gt;</h1>\n<p>using namespace std;</p>\n<p>long long n,m,minn,s;</p>\n<p>long long a[100001],b[100001];</p>\n<p>void dfs(int i,int j,int k,int v,int x) //i为左侧距离最近的，j为右侧距离最近的，k为上一次向哪一侧走，v为总耗电量，x为当前每秒耗电量</p>\n<p>{</p>\n<pre><code>if (v&gt;minn) return; //当已经不是最优解时退出，优化时间\nif (i==1 &amp;&amp; j==n) \n{\n    if (v&lt;minn) minn=v;\n    return;\n}\nif (k==0) //k=0表示从左边过来\n{\n    if (i&gt;1) dfs(i-1,j,0,v+x*abs(a[i-1]-a[i]),x-b[i-1]);\n    if (j&lt;n) dfs(i,j+1,1,v+x*abs(a[i]-a[j+1]),x-b[j+1]);\n}\nif (k==1) //k=1表示从右边过来\n{\n    if (j&lt;n) dfs(i,j+1,1,v+x*abs(a[j]-a[j+1]),x-b[j+1]);\n    if (i&gt;1) dfs(i-1,j,0,v+x*abs(a[j]-a[i-1]),x-b[i-1]);\n}\nreturn;</code></pre>\n<p>}</p>\n<p>int main()</p>\n<p>{</p>\n<pre><code>cin&gt;&gt;n&gt;&gt;m;\n\nminn=1000000000;\nfor (int i=1; i&lt;=n; ++i)\n{\n    cin&gt;&gt;a[i]&gt;&gt;b[i];\n    s+=b[i];\n}\ns-=b[m]; //s为初始时每秒耗电量\ndfs(m,m,0,0,s);\ncout&lt;&lt;minn;\nreturn 0;</code></pre>\n<p>}_ </p>\n<pre><code>\n//luogu这题解的格式真的有一些烦人，会长得很丑。。。。</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6028bf1883cface',t:'MTc5NTYyOTU2MA=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6028bf1883cface',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
