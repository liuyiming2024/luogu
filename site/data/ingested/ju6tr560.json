48)\\u3011\",\"category\":2,\"time\":1516584934,\"author\":{\"uid\":54691,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/54691.png\",\"name\":\"woshiluo\",\"slogan\":\"\\u300c\\u6c38\\u8fdc\\u76f8\\u4fe1\\uff0c\\u4e4c\\u4e91\\u80cc\\u540e\\u603b\\u6709\\u5f69\\u8679\\u300d\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Orange\",\"ccfLevel\":9,\"xcpcLevel\":0,\"background\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/image_hosting\\/tlmemf2p.png\"},\"upvote\":0,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1424\",\"type\":\"P\",\"name\":\"\\u5c0f\\u9c7c\\u7684\\u822a\\u7a0b\\uff08\\u6539\\u8fdb\\u7248\\uff09\",\"difficulty\":1,\"fullScore\":100},\"promoteStatus\":3,\"collection\":null,\"content\":\"\\u8fd9\\u9053\\u9898\\u76ee\\u6b63\\u513f\\u516b\\u7ecf\\u6ca1\\u5565\\u96be\\u5ea6\\uff0c\\u4e0d\\u8fc7\\u6211\\u770b\\u9898\\u89e3\\u91cc\\u6ca1\\u6709\\u548c\\u6211\\u65b9\\u6cd5\\u76f8\\u540c\\u7684\\uff0c\\u90a3\\u4e48\\u6211\\u5c31\\u6765\\u8bf4\\u4e00\\u4e0b\\u5427\\n\\n### \\u601d\\u8def\\n\\n***\\n\\u56e0\\u4e3a `n` \\u7684\\u6700\\u5927\\u503c\\u4e3a `long int` \\u6240\\u4ee5\\u5faa\\u73af\\u52a0\\u6709\\u8d85\\u65f6\\u7684\\u98ce\\u9669\\n\\n~~\\u867d\\u7136\\u540e\\u9762\\u53d1\\u73b0\\u6570\\u636e\\u6c34\\u6ca1\\u8fd9\\u4e2a\\u5fc5\\u8981~~\\n\\n\\u6240\\u4ee5\\u5bf9n\\u8981\\u8fdb\\u884c\\u5904\\u7406\\n\\n` \\u5b83\\u4e0a\\u5348\\u6e38\\u6cf3 150 \\u516c\\u91cc\\uff0c\\u4e0b\\u5348\\u6e38\\u6cf3 100 \\u516c\\u91cc`\\n\\n\\u8fd9\\u53e5\\u8bdd\\u53ef\\u4ee5\\u5408\\u5e76\\u4e3a`\\u5b83\\u4e00\\u5929\\u6e38 250 \\u516c\\u91cc`\\n\\n\\u5e76\\u4e14\\u9898\\u76ee\\u4e2d\\u6709\\u8bb2`\\u665a\\u4e0a\\u548c\\u5468\\u672b\\u90fd\\u4f11\\u606f\\uff08\\u5b9e\\u884c\\u53cc\\u4f11\\u65e5)`\\n\\n\\u6240\\u4ee5\\u5b83\\u4e00\\u5468\\u6e38 5 \\u5929\\uff0c\\u6bcf\\u5468\\u6e385\\\\*250=1250\\uff08\\u516c\\u91cc\\uff09\\n\\n\\u90a3\\u4e48\\u6211\\u4eec\\u6765\\u770b\\u770b\\u4ee3\\u7801\\n\\n\\n### \\u4ee3\\u7801\\n\\n***\\n\\n```cpp\\n#include \\u003Ccstdio\\u003E\\nusing namespace std;\\n\\nint a[8]={0,250,250,250,250,250,0,0};\\/\\/\\u5bf9\\u6bcf\\u5929\\u6e38\\u7684\\u516c\\u91cc\\u6570\\u6253\\u4e2a\\u8868\\nint x,n,cnt;\\n\\nint main(){\\n    scanf(\\u0022%d%d\\u0022,\\u0026x,\\u0026n);\\/\\/\\u4ece\\u5468 x \\u5f00\\u59cb\\u6e38\\uff0c\\u6e38 n \\u5929 \\n    int temp=n\\/7;\\n    n%=7;\\/\\/\\u6e38\\u4e86 temp \\u5468\\uff0c\\u53c8 n \\u5929\\n    cnt+=1250*temp;\\n    \\/\\/\\u76ee\\u524d\\u5df2\\u77e5\\u7684\\u8def\\u6570\\u52a0\\u8d77\\u6765\\uff0c\\u4e5f\\u5c31\\u662f\\u5468\\u6570(temp)*\\u6bcf\\u5468\\u6e38\\u7684\\u516c\\u91cc\\u6570(1250)\\n    for(int i=1;i\\u003C=n;i++){\\/\\/ \\u5faa\\u73af\\u89e3\\u51b3\\u5269\\u4e0b\\u7684n\\u5929\\n        cnt+=a[x];\\/\\/\\u52a0\\u4e0a\\u76ee\\u524d\\u5929\\u6e38\\u7684\\u516c\\u91cc\\u6570\\n        x++;\\/\\/\\u52a0\\u4e00\\u5929\\n        if(x\\u003E7)x-=7;\\/\\/\\u5982\\u679c\\u5927\\u4e8e\\u5468\\u5929\\u5c31\\u5230\\u5468\\u4e00\\n    }\\n    printf(\\u0022%d\\u0022,cnt);\\/\\/\\u8f93\\u51fa\\n}\\n\\n```\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795629601.766913}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/ju6tr560\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1424 \\u3010\\u5c0f\\u9c7c\\u7684\\u822a\\u7a0b(\\u6539\\u8fdb\\u7248)\\u3011\",\"description\":\"\\u8fd9\\u9053\\u9898\\u76ee\\u6b63\\u513f\\u516b\\u7ecf\\u6ca1\\u5565\\u96be\\u5ea6\\uff0c\\u4e0d\\u8fc7\\u6211\\u770b\\u9898\\u89e3\\u91cc\\u6ca1\\u6709\\u548c\\u6211\\u65b9\\u6cd5\\u76f8\\u540c\\u7684\\uff0c\\u90a3\\u4e48\\u6211\\u5c31\\u6765\\u8bf4\\u4e00\\u4e0b\\u5427\\n\\u601d\\u8def\\n\\n\\u56e0\\u4e3a n \\u7684\\u6700\\u5927\\u503c\\u4e3a long int \\u6240\\u4ee5\\u5faa\\u73af\\u52a0\\u6709\\u8d85\\u65f6\\u7684\\u98ce\\u9669\\n\\u867d\\u7136\\u540e\\u9762\\u53d1\\u73b0\\u6570\\u636e\\u6c34\\u6ca1\\u8fd9\\u4e2a\\u5fc5\\u8981\\n\\u6240\\u4ee5\\u5bf9n\\u8981\\u8fdb\\u884c\\u5904\\u7406\\n\\u5b83\\u4e0a\\u5348\\u6e38\\u6cf3 150 \\u516c\\u91cc\\uff0c\\u4e0b\\u5348\\u6e38\\u6cf3 100\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"woshiluo\"},\"datePublished\":\"2018-01-22T09:35:34+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1424 【小鱼的航程(改进版)】\" />\n    <meta property=\"og:description\" content=\"这道题目正儿八经没啥难度，不过我看题解里没有和我方法相同的，那么我就来说一下吧\n思路\n\n因为 n 的最大值为 long int 所以循环加有超时的风险\n虽然后面发现数据水没这个必要\n所以对n要进行处理\n它上午游泳 150 公里，下午游泳 100…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"woshiluo\" />\n    <meta property=\"article:published_time\" content=\"2018-01-22T09:35:34+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/ju6tr560\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1424 【小鱼的航程(改进版)】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">woshiluo</a>\n            ·\n            <time datetime=\"2018-01-22T09:35:34+08:00\">2018-01-22 09:35:34</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>这道题目正儿八经没啥难度，不过我看题解里没有和我方法相同的，那么我就来说一下吧</p>\n<h3>思路</h3>\n\n<p>因为 <code>n</code> 的最大值为 <code>long int</code> 所以循环加有超时的风险</p>\n<p><del>虽然后面发现数据水没这个必要</del></p>\n<p>所以对n要进行处理</p>\n<p><code>它上午游泳 150 公里，下午游泳 100 公里</code></p>\n<p>这句话可以合并为<code>它一天游 250 公里</code></p>\n<p>并且题目中有讲<code>晚上和周末都休息（实行双休日)</code></p>\n<p>所以它一周游 5 天，每周游5*250=1250（公里）</p>\n<p>那么我们来看看代码</p>\n<h3>代码</h3>\n\n<pre><code class=\"language-cpp\">#include &lt;cstdio&gt;\nusing namespace std;\n\nint a[8]={0,250,250,250,250,250,0,0};//对每天游的公里数打个表\nint x,n,cnt;\n\nint main(){\n    scanf(\"%d%d\",&amp;x,&amp;n);//从周 x 开始游，游 n 天 \n    int temp=n/7;\n    n%=7;//游了 temp 周，又 n 天\n    cnt+=1250*temp;\n    //目前已知的路数加起来，也就是周数(temp)*每周游的公里数(1250)\n    for(int i=1;i&lt;=n;i++){// 循环解决剩下的n天\n        cnt+=a[x];//加上目前天游的公里数\n        x++;//加一天\n        if(x&gt;7)x-=7;//如果大于周天就到周一\n    }\n    printf(\"%d\",cnt);//输出\n}\n</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6028cf16855cf26',t:'MTc5NTYyOTYwMQ=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6028cf16855cf26',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
