 "code_blocks": [
  "#include <iostream>\n󠄲󠅩󠄐󠄽󠅙󠅓󠅘󠅑󠅕󠅜󠄠󠄧󠄢󠄧#include <algorithm>\nusing󠄲󠅩󠄐󠄽󠅙󠅓󠅘󠅑󠅕󠅜󠄠󠄧󠄢󠄧 namespace std;\nint main󠄲󠅩󠄐󠄽󠅙󠅓󠅘󠅑󠅕󠅜󠄠󠄧󠄢󠄧()\n{\n    int n ;\n    cin >> n ;\n    i󠄲󠅩󠄐󠄽󠅙󠅓󠅘󠅑󠅕󠅜󠄠󠄧󠄢󠄧nt m = 0 ;\n    if ( n < 0 )\n    {\n        󠄲󠅩󠄐󠄽󠅙󠅓󠅘󠅑󠅕󠅜󠄠󠄧󠄢󠄧cout << \"-\" ;\n        n *= -1 ;\n    }󠄲󠅩󠄐󠄽󠅙󠅓󠅘󠅑󠅕󠅜󠄠󠄧󠄢󠄧\n    while ( n != 0 )\n 󠄲󠅩󠄐󠄽󠅙󠅓󠅘󠅑󠅕󠅜󠄠󠄧󠄢󠄧   {\n        m = n % 10 + m 󠄲󠅩󠄐󠄽󠅙󠅓󠅘󠅑󠅕󠅜󠄠󠄧󠄢󠄧* 10 ;\n        n /= 10 ;󠄲󠅩󠄐󠄽󠅙󠅓󠅘󠅑󠅕󠅜󠄠󠄧󠄢󠄧\n    }\n    cout << m << endl ;\n    return 0;\n󠄲󠅩󠄐󠄽󠅙󠅓󠅘󠅑󠅕󠅜󠄠󠄧󠄢󠄧}"
 ],
