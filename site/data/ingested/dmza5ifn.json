 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <meta name=\"csrf-token\" content=\"1795745631:gn7uAVmlEVnngwQEI44ZDlCxBSMTUi5EJ0LyBILDKKM=\">\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112609'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>题解 P1803 【凌乱的yyy / 线段覆盖】 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"dmza5ifn\",\"title\":\"\\u9898\\u89e3 P1803 \\u3010\\u51cc\\u4e71\\u7684yyy \\/ \\u7ebf\\u6bb5\\u8986\\u76d6\\u3011\",\"category\":2,\"time\":1554636002,\"author\":{\"uid\":189467,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/189467.png\",\"name\":\"\\u5317\\u5317\\u5317\\u5317\",\"slogan\":\"\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Gray\",\"ccfLevel\":0,\"xcpcLevel\":0,\"background\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/image_hosting\\/pijez7rv.png\"},\"upvote\":0,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1803\",\"type\":\"P\",\"name\":\"\\u51cc\\u4e71\\u7684yyy \\/ \\u7ebf\\u6bb5\\u8986\\u76d6\",\"difficulty\":2,\"fullScore\":100},\"promoteStatus\":3,\"collection\":null,\"content\":\"- \\u60f3\\u8981\\u53c2\\u52a0\\u66f4\\u591a\\u7684\\u6bd4\\u8d5b\\u5219\\u9700\\u6309\\u65f6\\u95f4\\u5dee\\u4ece\\u5c0f\\u5230\\u5927\\u6765\\u53c2\\u52a0\\u6bd4\\u8d5b\\uff0c\\u4e14\\u5f53\\u524d\\u6bd4\\u8d5b\\u7684\\u65f6\\u95f4\\u6bb5\\u4e0e\\u4e0a\\u4e00\\u573a\\u6bd4\\u8d5b\\u7684\\u65f6\\u95f4\\u6bb5\\u4e4b\\u95f4\\u6ca1\\u6709\\u91cd\\u53e0\\u7684\\u5b50\\u65f6\\u95f4\\u6bb5\\uff0c\\u4e5f\\u5c31\\u662f\\u9898\\u76ee\\u91cc\\u6240\\u8bf4\\u7684\\u0022\\u5584\\u59cb\\u5584\\u7ec8\\uff08\\u8111\\u8865\\u4e0b\\u5c31\\u597d\\uff09\\u0022\\uff0c\\u5b9e\\u5728\\u8111\\u8865\\u4e0d\\u51fa\\uff0c\\u53ef\\u4ee5\\u501f\\u52a9\\u6570\\u8f74\\u6765\\u5e2e\\u52a9\\u7406\\u89e3\\u4e0b\\u5462\\uff08\\u7136\\u800c\\u6211\\u4e0d\\u77e5\\u9053\\u8be5\\u600e\\u4e48\\u628a\\u56fe\\u7247\\u7ed9\\u63d2\\u4e0a\\u6765emmm\\uff09\\uff0c\\u6240\\u4ee5\\u6570\\u8f74\\u6211\\u5c31\\u4e0d\\u753b\\u4e86\\uff0c\\u5927\\u5bb6\\u81ea\\u5df1\\u53bb\\u753b\\u4e00\\u4e0b\\u5c31\\u53ef\\u4ee5\\u4e86\\uff0c\\u6570\\u8f74\\u753b\\u51fa\\u6765\\u540e\\u6211\\u76f8\\u4fe1\\u4f60\\u4e00\\u5b9a\\u4f1a\\u6bd4\\u4e4b\\u524d\\u6e05\\u6670\\u7684\\u591a\\uff0c\\u6700\\u540e\\u6211\\u4eec\\u5c31\\u53ef\\u4ee5\\u57fa\\u4e8e\\u4ee5\\u4e0a\\u8fd9\\u4e2a\\u601d\\u8def\\u6765\\u64b8\\u4ee3\\u7801\\u5566\\n\\n\\n------------\\n\\n\\n```c\\n#include \\u003Cstdio.h\\u003E\\n#include \\u003Cstdlib.h\\u003E\\n\\nint time[1000000][2];\\n\\nint cmp1(const void *a,const void *b){ \\/\\/\\u6309\\u5f00\\u59cb\\u65f6\\u95f4\\u505a\\u5347\\u5e8f\\u6392\\u5e8f \\n\\treturn ((int*)a)[0]-((int*)b)[0];\\n}\\n\\nint cmp2(const void *a,const void *b){ \\/\\/\\u6309\\u7ed3\\u675f\\u65f6\\u95f4\\u505a\\u5347\\u5e8f\\u6392\\u5e8f \\n\\treturn ((int*)a)[1]-((int*)b)[1];\\n}\\n\\nint main(){\\n\\tint n,flag,pos = 0,count = 1; \\/\\/flag\\u4e3a0\\u5219\\u5f53\\u524d\\u65f6\\u95f4\\u6bb5\\u5728\\u4e0a\\u4e00\\u4e2a\\u65f6\\u95f4\\u6bb5\\u91cc\\u6709\\u91cd\\u53e0\\u7684\\u5b50\\u65f6\\u95f4\\u6bb5,\\u53cd\\u4e4b\\u5c31\\u6ca1\\u6709,pos\\u662f\\u4e0a\\u4e00\\u6b21\\u6bd4\\u8d5b\\u7684\\u65f6\\u95f4\\u6bb5\\u7684\\u4e0b\\u6807,count\\u662f\\u6700\\u591a\\u53c2\\u52a0\\u7684\\u6bd4\\u8d5b\\u6b21\\u6570 \\n\\tint i,j;\\n\\t\\n\\tscanf(\\u0022%d\\u0022, \\u0026n);\\n\\tfor(i = 0; i \\u003C n; i++){\\n\\t\\tscanf(\\u0022%d %d\\u0022, \\u0026time[i][0],\\u0026time[i][1]);\\n\\t}\\n\\tqsort(time,n,sizeof(int)*2,cmp1);\\n\\tqsort(time,n,sizeof(int)*2,cmp2);\\n\\t\\/\\/\\u901a\\u8fc7\\u4ee5\\u4e0a\\u7684\\u4e24\\u4e2a\\u6392\\u5e8f,\\u6211\\u4eec\\u5c31\\u80fd\\u5f97\\u5230\\u6309\\u65f6\\u95f4\\u5dee\\u4ece\\u5c0f\\u5230\\u5927\\u7684\\u4e00\\u4e2a\\u6bd4\\u8d5b\\u987a\\u5e8f \\n\\tfor(i = 1; i \\u003C n; i++){\\n\\t\\tflag = 1; \\/\\/\\u5f53\\u524d\\u65f6\\u95f4\\u6bb5\\u4e0e\\u4e0a\\u4e00\\u4e2a\\u65f6\\u95f4\\u6bb5\\u6ca1\\u6709\\u91cd\\u53e0\\u7684\\u5b50\\u65f6\\u95f4\\u6bb5 \\n\\t\\tif((time[i][0]\\u003E=time[pos][0]\\u0026\\u0026time[i][1]\\u003C=time[pos][1]) || (time[i][1]\\u003Etime[pos][0]\\u0026\\u0026time[i][1]\\u003C=time[pos][1]) || (time[i][0]\\u003E=time[pos][0]\\u0026\\u0026time[i][0]\\u003Ctime[pos][1]) || (time[pos][0]\\u003Etime[i][0]\\u0026\\u0026time[pos][1]\\u003Ctime[i][1])){\\n\\t\\t\\t\\/\\/\\u4e0a\\u8ff0\\u7684\\u5224\\u65ad\\u6761\\u4ef6\\u5305\\u542b\\u4e86\\u5404\\u4e2a\\u60c5\\u51b5\\u4e0b\\u65f6\\u95f4\\u6bb5\\u4f1a\\u91cd\\u53e0\\u7684\\u73b0\\u8c61\\n\\t\\t\\tflag = 0;\\n\\t\\t}\\n\\t\\tif(flag == 1){\\n\\t\\t\\tpos = i; \\/\\/\\u66f4\\u65b0\\u4e0a\\u4e00\\u6b21\\u6bd4\\u8d5b\\u7684\\u65f6\\u95f4\\u6bb5\\u7684\\u4e0b\\u6807 \\n\\t\\t\\tcount++; \\n\\t\\t}\\n\\t}\\n\\tprintf(\\u0022%d\\u0022, count);\\n\\t\\n\\treturn 0;\\n}\\n```\\n\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795659231.841848}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/dmza5ifn\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1803 \\u3010\\u51cc\\u4e71\\u7684yyy \\/ \\u7ebf\\u6bb5\\u8986\\u76d6\\u3011\",\"description\":\"\\n\\u60f3\\u8981\\u53c2\\u52a0\\u66f4\\u591a\\u7684\\u6bd4\\u8d5b\\u5219\\u9700\\u6309\\u65f6\\u95f4\\u5dee\\u4ece\\u5c0f\\u5230\\u5927\\u6765\\u53c2\\u52a0\\u6bd4\\u8d5b\\uff0c\\u4e14\\u5f53\\u524d\\u6bd4\\u8d5b\\u7684\\u65f6\\u95f4\\u6bb5\\u4e0e\\u4e0a\\u4e00\\u573a\\u6bd4\\u8d5b\\u7684\\u65f6\\u95f4\\u6bb5\\u4e4b\\u95f4\\u6ca1\\u6709\\u91cd\\u53e0\\u7684\\u5b50\\u65f6\\u95f4\\u6bb5\\uff0c\\u4e5f\\u5c31\\u662f\\u9898\\u76ee\\u91cc\\u6240\\u8bf4\\u7684\\\"\\u5584\\u59cb\\u5584\\u7ec8\\uff08\\u8111\\u8865\\u4e0b\\u5c31\\u597d\\uff09\\\"\\uff0c\\u5b9e\\u5728\\u8111\\u8865\\u4e0d\\u51fa\\uff0c\\u53ef\\u4ee5\\u501f\\u52a9\\u6570\\u8f74\\u6765\\u5e2e\\u52a9\\u7406\\u89e3\\u4e0b\\u5462\\uff08\\u7136\\u800c\\u6211\\u4e0d\\u77e5\\u9053\\u8be5\\u600e\\u4e48\\u628a\\u56fe\\u7247\\u7ed9\\u63d2\\u4e0a\\u6765emmm\\uff09\\uff0c\\u6240\\u4ee5\\u6570\\u8f74\\u6211\\u5c31\\u4e0d\\u753b\\u4e86\\uff0c\\u5927\\u5bb6\\u81ea\\u5df1\\u53bb\\u753b\\u4e00\\u4e0b\\u5c31\\u53ef\\u4ee5\\u4e86\\uff0c\\u6570\\u8f74\\u753b\\u51fa\\u6765\\u540e\\u6211\\u76f8\\u4fe1\\u4f60\\u4e00\\u5b9a\\u4f1a\\u6bd4\\u4e4b\\u524d\\u6e05\\u6670\\u7684\\u591a\\uff0c\\u6700\\u540e\\u6211\\u4eec\\u5c31\\u53ef\\u4ee5\\u57fa\\u4e8e\\u4ee5\\u4e0a\\u8fd9\\u4e2a\\u601d\\u8def\\u6765\\u64b8\\u4ee3\\u7801\\u5566\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"\\u5317\\u5317\\u5317\\u5317\"},\"datePublished\":\"2019-04-07T19:20:02+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1803 【凌乱的yyy / 线段覆盖】\" />\n    <meta property=\"og:description\" content=\"\n想要参加更多的比赛则需按时间差从小到大来参加比赛，且当前比赛的时间段与上一场比赛的时间段之间没有重叠的子时间段，也就是题目里所说的&quot;善始善终（脑补下就好）&quot;，实在脑补不出，可以借助数轴来帮助理解下呢（然而我不知道该怎么把图片给插上来emmm），所以数轴我就不画了，大家自己去画一下就可以了，数轴画出来后我相信你一定会比之前清晰的多，最后我们就可以基于以上这个思路来撸代码啦…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"北北北北\" />\n    <meta property=\"article:published_time\" content=\"2019-04-07T19:20:02+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/dmza5ifn\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1803 【凌乱的yyy / 线段覆盖】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">北北北北</a>\n            ·\n            <time datetime=\"2019-04-07T19:20:02+08:00\">2019-04-07 19:20:02</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <ul>\n<li>想要参加更多的比赛则需按时间差从小到大来参加比赛，且当前比赛的时间段与上一场比赛的时间段之间没有重叠的子时间段，也就是题目里所说的\"善始善终（脑补下就好）\"，实在脑补不出，可以借助数轴来帮助理解下呢（然而我不知道该怎么把图片给插上来emmm），所以数轴我就不画了，大家自己去画一下就可以了，数轴画出来后我相信你一定会比之前清晰的多，最后我们就可以基于以上这个思路来撸代码啦</li>\n</ul>\n\n<pre><code class=\"language-c\">#include &lt;stdio.h&gt;\n#include &lt;stdlib.h&gt;\n\nint time[1000000][2];\n\nint cmp1(const void *a,const void *b){ //按开始时间做升序排序 \n    return ((int*)a)[0]-((int*)b)[0];\n}\n\nint cmp2(const void *a,const void *b){ //按结束时间做升序排序 \n    return ((int*)a)[1]-((int*)b)[1];\n}\n\nint main(){\n    int n,flag,pos = 0,count = 1; //flag为0则当前时间段在上一个时间段里有重叠的子时间段,反之就没有,pos是上一次比赛的时间段的下标,count是最多参加的比赛次数 \n    int i,j;\n\n    scanf(\"%d\", &amp;n);\n    for(i = 0; i &lt; n; i++){\n        scanf(\"%d %d\", &amp;time[i][0],&amp;time[i][1]);\n    }\n    qsort(time,n,sizeof(int)*2,cmp1);\n    qsort(time,n,sizeof(int)*2,cmp2);\n    //通过以上的两个排序,我们就能得到按时间差从小到大的一个比赛顺序 \n    for(i = 1; i &lt; n; i++){\n        flag = 1; //当前时间段与上一个时间段没有重叠的子时间段 \n        if((time[i][0]&gt;=time[pos][0]&amp;&amp;time[i][1]&lt;=time[pos][1]) || (time[i][1]&gt;time[pos][0]&amp;&amp;time[i][1]&lt;=time[pos][1]) || (time[i][0]&gt;=time[pos][0]&amp;&amp;time[i][0]&lt;time[pos][1]) || (time[pos][0]&gt;time[i][0]&amp;&amp;time[pos][1]&lt;time[i][1])){\n            //上述的判断条件包含了各个情况下时间段会重叠的现象\n            flag = 0;\n        }\n        if(flag == 1){\n            pos = i; //更新上一次比赛的时间段的下标 \n            count++; \n        }\n    }\n    printf(\"%d\", count);\n\n    return 0;\n}</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6056055ff6dd7ac',t:'MTc5NTY1OTIzMQ=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6056055ff6dd7ac',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
