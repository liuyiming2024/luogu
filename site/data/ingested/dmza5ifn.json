 "code_blocks": [
  "#include <stdio.h>\n#include <stdlib.h>\n\nint time[1000000][2];\n\nint cmp1(const void *a,const void *b){ //按开始时间做升序排序 \n    return ((int*)a)[0]-((int*)b)[0];\n}\n\nint cmp2(const void *a,const void *b){ //按结束时间做升序排序 \n    return ((int*)a)[1]-((int*)b)[1];\n}\n\nint main(){\n    int n,flag,pos = 0,count = 1; //flag为0则当前时间段在上一个时间段里有重叠的子时间段,反之就没有,pos是上一次比赛的时间段的下标,count是最多参加的比赛次数 \n    int i,j;\n\n    scanf(\"%d\", &n);\n    for(i = 0; i < n; i++){\n        scanf(\"%d %d\", &time[i][0],&time[i][1]);\n    }\n    qsort(time,n,sizeof(int)*2,cmp1);\n    qsort(time,n,sizeof(int)*2,cmp2);\n    //通过以上的两个排序,我们就能得到按时间差从小到大的一个比赛顺序 \n    for(i = 1; i < n; i++){\n        flag = 1; //当前时间段与上一个时间段没有重叠的子时间段 \n        if((time[i][0]>=time[pos][0]&&time[i][1]<=time[pos][1]) || (time[i][1]>time[pos][0]&&time[i][1]<=time[pos][1]) || (time[i][0]>=time[pos][0]&&time[i][0]<time[pos][1]) || (time[pos][0]>time[i][0]&&time[pos][1]<time[i][1])){\n            //上述的判断条件包含了各个情况下时间段会重叠的现象\n            flag = 0;\n        }\n        if(flag == 1){\n            pos = i; //更新上一次比赛的时间段的下标 \n            count++; \n        }\n    }\n    printf(\"%d\", count);\n\n    return 0;\n}"
 ],
