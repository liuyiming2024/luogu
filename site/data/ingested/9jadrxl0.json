u65ad\\u4e5f\\u662f\\u8fd9\\u6837\\u3002\\n\\tscanf(\\u0022%d %d\\u0022, \\u0026x, \\u0026y);\\n\\tfor (int i = n; i \\u003E= 1; --i) {\\t\\/\\/\\u9006\\u5e8f\\n\\t\\tif (im[i][0] + im[i][2] \\u003E= x \\u0026\\u0026\\n        \\tim[i][1] + im[i][3] \\u003E= y \\u0026\\u0026\\n\\t\\t\\tim[i][0] \\u003C= x \\u0026\\u0026 im[i][1] \\u003C= y) {\\t\\/\\/\\u6838\\u5fc3\\u90e8\\u5206\\uff0c\\u4e0a\\u6587\\u63d0\\u53ca\\u7684\\u201c\\u6700\\u5173\\u952e\\u7684\\u4e00\\u70b9\\u201d\\u3002\\n\\t\\t\\t\\tans = i; break;\\n\\t\\t\\t}\\n\\t}\\n\\tprintf(\\u0022%d\\u0022, ans); \\n\\treturn 0;\\n}\\n```\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795593077.123879}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/9jadrxl0\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1003 \\u3010\\u94fa\\u5730\\u6bef\\u3011\",\"description\":\"\\u672c\\u9898\\u53ea\\u752819\\u884c\\u4ee3\\u7801\\n\\u7528\\u9006\\u5e8f\\u7b49\\u4e1c\\u897f\\uff08\\u8fd9\\u4e9b\\u90fd\\u4e0d\\u7528\\u8bf4\\u4e86\\uff09\\u3002\\u6700\\u5173\\u952e\\u7684\\u4e00\\u70b9\\u662f\\uff0c\\u5224\\u65ad\\u53ea\\u7528\\u5224\\u4e24\\u4e2a\\u70b9\\uff0c\\u5373\\u5de6\\u4e0b\\u89d2\\u548c\\u53f3\\u4e0a\\u89d2\\uff0c\\u5de6\\u4e0b\\u89d2\\u4e0d\\u7528\\u8bf4\\u4e86\\uff0c\\u5c31\\u662f(a, b)\\u90fd\\u8981\\u5206\\u522b\\u5c0f\\u4e8ex\\u548cy\\uff1b\\u53f3\\u4e0a\\u89d2\\u662f(a + g, b + k),\\u90fd\\u8981\\u5206\\u522b\\u5927\\u4e8ex\\u548cy\\uff0c\\u4e0b\\u9762\\u7ed9\\u51fa\\u4ee3\\u7801\\u3002\\n#include\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"Sikiru\"},\"datePublished\":\"2018-07-07T17:06:48+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1003 【铺地毯】\" />\n    <meta property=\"og:description\" content=\"本题只用19行代码\n用逆序等东西（这些都不用说了）。最关键的一点是，判断只用判两个点，即左下角和右上角，左下角不用说了，就是(a, b)都要分别小于x和y；右上角是(a + g, b + k),都要分别大于x和y，下面给出代码。\n#include…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"Sikiru\" />\n    <meta property=\"article:published_time\" content=\"2018-07-07T17:06:48+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/9jadrxl0\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1003 【铺地毯】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">Sikiru</a>\n            ·\n            <time datetime=\"2018-07-07T17:06:48+08:00\">2018-07-07 17:06:48</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <h2>本题只用19行代码</h2>\n<p>用逆序等东西<del>（这些都不用说了）</del>。最关键的一点是，判断只用判两个点，即左下角和右上角，左下角不用说了，就是(a, b)都要分别小于x和y；右上角是(a + g, b + k),都要分别大于x和y，下面给出代码。</p>\n<pre><code class=\"language-cpp\">#include &lt;cstdio&gt;\nint im[10020][4];   //都先存起来没啥毛病。\nint main() {    //问一下哈，还有谁这么写代码，举个爪，我们是同胞……\n    int n, x, y, ans = -1;\n    scanf(\"%d\", &amp;n);\n    for (int i = 1; i &lt;= n; ++i)    //存储信息。\n        scanf(\"%d %d %d %d\", &amp;im[i][0], \n            &amp;im[i][1], &amp;im[i][2], &amp;im[i][3]);   //为了好看我换了一行，下面的判断也是这样。\n    scanf(\"%d %d\", &amp;x, &amp;y);\n    for (int i = n; i &gt;= 1; --i) {  //逆序\n        if (im[i][0] + im[i][2] &gt;= x &amp;&amp;\n            im[i][1] + im[i][3] &gt;= y &amp;&amp;\n            im[i][0] &lt;= x &amp;&amp; im[i][1] &lt;= y) {   //核心部分，上文提及的“最关键的一点”。\n                ans = i; break;\n            }\n    }\n    printf(\"%d\", ans); \n    return 0;\n}</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a5ff113b18a16949',t:'MTc5NTU5MzA3Ng=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a5ff113b18a16949',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
