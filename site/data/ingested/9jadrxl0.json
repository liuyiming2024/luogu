 "code_blocks": [
  "#include <cstdio>\nint im[10020][4];   //都先存起来没啥毛病。\nint main() {    //问一下哈，还有谁这么写代码，举个爪，我们是同胞……\n    int n, x, y, ans = -1;\n    scanf(\"%d\", &n);\n    for (int i = 1; i <= n; ++i)    //存储信息。\n        scanf(\"%d %d %d %d\", &im[i][0], \n            &im[i][1], &im[i][2], &im[i][3]);   //为了好看我换了一行，下面的判断也是这样。\n    scanf(\"%d %d\", &x, &y);\n    for (int i = n; i >= 1; --i) {  //逆序\n        if (im[i][0] + im[i][2] >= x &&\n            im[i][1] + im[i][3] >= y &&\n            im[i][0] <= x && im[i][1] <= y) {   //核心部分，上文提及的“最关键的一点”。\n                ans = i; break;\n            }\n    }\n    printf(\"%d\", ans); \n    return 0;\n}"
