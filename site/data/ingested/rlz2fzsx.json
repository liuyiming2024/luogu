f(1);\\n\\tcout\\u003C\\u003Cans;\\n\\treturn 0;\\n}\\n```\\n\\u4f46\\u4f1a\\u53d1\\u73b0\\u65f6\\u95f4\\u590d\\u6742\\u5ea6\\u4f1a\\u8d85\\u9650\\uff08\\u6700\\u540e\\u4e00\\u4e2a\\u6d4b\\u8bd5\\u70b9TLE\\uff09\\u4e8e\\u662f\\u6211\\u4eec\\u53ef\\u4ee5\\u5c06\\u5b83\\u4f18\\u5316\\uff08\\u8bb0\\u5fc6\\u5316\\u641c\\u7d22\\uff09\\n\\n```cpp\\n#include\\u003Cbits\\/stdc++.h\\u003E\\nusing namespace std;\\nint n;\\nint a[36][18];\\nint f(int p,int s){\\/\\/p\\u8868\\u793a\\u904d\\u5386\\u6b21\\u6570\\uff0cs\\u4ee3\\u8868\\u6808\\u5185\\u5143\\u7d20\\u4e2a\\u6570\\n\\tint aa=0;\\n\\tif(p==n*2){\\/\\/\\u6700\\u591a\\u5165\\u6808n\\u6b21\\uff0c\\u51fa\\u6808n\\u6b21\\n\\t\\tif(s!=0){\\/\\/\\u5982\\u679c\\u6808\\u5185\\u5143\\u7d20\\u4e0d\\u4e3a0\\uff0c\\u8bf4\\u660e\\u6b64\\u65b9\\u6cd5\\u4e0d\\u5408\\u6cd5\\n\\t\\t\\treturn 0;\\n\\t\\t}else{\\n\\t\\t\\treturn 1;\\n\\t\\t}\\n\\t}\\n\\tif(a[p][s]!=0){\\/\\/\\u8bb0\\u5fc6\\u5316\\u641c\\u7d22\\n\\t\\treturn a[p][s];\\n\\t}\\n\\tif(s\\u003E0){\\/\\/\\u6808\\u5185\\u5143\\u7d20\\u4e2a\\u6570\\u5927\\u4e8e0\\u8bf4\\u660e\\u6709\\u5143\\u7d20\\uff0c\\u53ef\\u4ee5\\u51fa\\u6808\\n\\t\\taa+=f(p+1,s-1);\\n\\t}\\n\\taa+=f(p+1,s+1);\\/\\/\\u5165\\u6808\\n\\ta[p][s]=aa;\\n\\treturn a[p][s];\\n}\\nint main(){\\n\\tcin\\u003E\\u003En;\\n\\tcout\\u003C\\u003Cf(0,0);\\n\\treturn 0;\\n}\\n\\n\\n```\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795593103.820872}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/rlz2fzsx\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3\\uff1aP1044 [NOIP 2003 \\u666e\\u53ca\\u7ec4] \\u6808\",\"description\":\"\\u7531\\u9898\\u53ef\\u5f97\\u6bcf\\u6b21\\u64cd\\u4f5c\\u53ea\\u6709\\u4e24\\u79cd\\u53ef\\u80fd\\uff1a\\u51fa\\u6808\\u548c\\u5165\\u6808\\uff08pop\\u4ece\\u6808\\u9876\\u5f39\\u51fa\\u4e00\\u4e2a\\u5143\\u7d20\\u548cpush\\u5c06\\u4e00\\u4e2a\\u5143\\u7d20\\u8fdb\\u6808\\uff09\\uff0c\\u4e8e\\u662f\\u6211\\u4eec\\u53ef\\u4ee5\\u7528\\u9012\\u5f52\\u6765\\u5b8c\\u6210\\u8fd9\\u4e00\\u64cd\\u4f5c\\n#include&lt;bits\\/stdc++.h&gt;\\nusing namespace std;\\nint n,ans;\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"zhanyifan\"},\"datePublished\":\"2025-03-22T13:45:48+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解：P1044 [NOIP 2003 普及组] 栈\" />\n    <meta property=\"og:description\" content=\"由题可得每次操作只有两种可能：出栈和入栈（pop从栈顶弹出一个元素和push将一个元素进栈），于是我们可以用递归来完成这一操作\n#include&amp;lt;bits/stdc++.h&amp;gt;\nusing namespace std;\nint n,ans;…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"zhanyifan\" />\n    <meta property=\"article:published_time\" content=\"2025-03-22T13:45:48+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/rlz2fzsx\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解：P1044 [NOIP 2003 普及组] 栈</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">zhanyifan</a>\n            ·\n            <time datetime=\"2025-03-22T13:45:48+08:00\">2025-03-22 13:45:48</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>由题可得每次操作只有两种可能：出栈和入栈（pop从栈顶弹出一个元素和push将一个元素进栈），于是我们可以用递归来完成这一操作</p>\n<pre><code class=\"language-cpp\">#include&lt;bits/stdc++.h&gt;\nusing namespace std;\nint n,ans;\nint s;\nvoid f(int p){\n    if(p&gt;n){\n        ans++;\n        return;\n    }\n    if(s&gt;0){\n        s--;\n        f(p);\n        s++;\n    }\n    s++;\n    f(p+1);\n    s--;\n}\nint main(){\n    cin&gt;&gt;n;\n    f(1);\n    cout&lt;&lt;ans;\n    return 0;\n}</code></pre>\n<p>但会发现时间复杂度会超限（最后一个测试点TLE）于是我们可以将它优化（记忆化搜索）</p>\n<pre><code class=\"language-cpp\">#include&lt;bits/stdc++.h&gt;\nusing namespace std;\nint n;\nint a[36][18];\nint f(int p,int s){//p表示遍历次数，s代表栈内元素个数\n    int aa=0;\n    if(p==n*2){//最多入栈n次，出栈n次\n        if(s!=0){//如果栈内元素不为0，说明此方法不合法\n            return 0;\n        }else{\n            return 1;\n        }\n    }\n    if(a[p][s]!=0){//记忆化搜索\n        return a[p][s];\n    }\n    if(s&gt;0){//栈内元素个数大于0说明有元素，可以出栈\n        aa+=f(p+1,s-1);\n    }\n    aa+=f(p+1,s+1);//入栈\n    a[p][s]=aa;\n    return a[p][s];\n}\nint main(){\n    cin&gt;&gt;n;\n    cout&lt;&lt;f(0,0);\n    return 0;\n}\n\n</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a5ff11e20d2ed9ed',t:'MTc5NTU5MzEwMw=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a5ff11e20d2ed9ed',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
