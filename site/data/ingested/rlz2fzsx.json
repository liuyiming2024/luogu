 "code_blocks": [
  "#include<bits/stdc++.h>\nusing namespace std;\nint n,ans;\nint s;\nvoid f(int p){\n    if(p>n){\n        ans++;\n        return;\n    }\n    if(s>0){\n        s--;\n        f(p);\n        s++;\n    }\n    s++;\n    f(p+1);\n    s--;\n}\nint main(){\n    cin>>n;\n    f(1);\n    cout<<ans;\n    return 0;\n}",
  "#include<bits/stdc++.h>\nusing namespace std;\nint n;\nint a[36][18];\nint f(int p,int s){//p表示遍历次数，s代表栈内元素个数\n    int aa=0;\n    if(p==n*2){//最多入栈n次，出栈n次\n        if(s!=0){//如果栈内元素不为0，说明此方法不合法\n            return 0;\n        }else{\n            return 1;\n        }\n    }\n    if(a[p][s]!=0){//记忆化搜索\n        return a[p][s];\n    }\n    if(s>0){//栈内元素个数大于0说明有元素，可以出栈\n        aa+=f(p+1,s-1);\n    }\n    aa+=f(p+1,s+1);//入栈\n    a[p][s]=aa;\n    return a[p][s];\n}\nint main(){\n    cin>>n;\n    cout<<f(0,0);\n    return 0;\n}"
 ],
