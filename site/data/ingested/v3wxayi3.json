]=max(f[j],f[j-w[i]]+w[i]);\\nf[j] \\u4e3a\\uff1a\\u5f53\\u603b\\u5bb9\\u91cf\\u4e3a j \\u65f6\\uff0c\\u4e0d\\u653e\\u7b2c i \\u4ef6\\u7269\\u54c1\\uff0c\\u6240\\u80fd\\u88c5\\u7684\\u6700\\u5927\\u4f53\\u79ef\\u3002\\n\\nf[j-w[i]]+w[i] \\u4e3a\\uff1a\\u5f53\\u603b\\u5bb9\\u91cf\\u4e3a j \\u65f6\\uff0c\\u653e\\u4e86\\u7b2c i \\u4ef6\\u7269\\u54c1\\u540e\\uff0c\\u6240\\u80fd\\u88c5\\u7684\\u6700\\u5927\\u4f53\\u79ef\\u3002\\uff08\\u5373 j\\u51cf\\u53bb\\u7b2c i \\u4ef6\\u7269\\u54c1\\u4f53\\u79ef \\u7684\\u5bb9\\u91cf\\u80fd\\u88c5\\u7684\\u6700\\u5927\\u4f53\\u79ef+\\u7b2c i \\u4ef6\\u7269\\u54c1\\u7684\\u4f53\\u79ef\\u3002w[i] \\u4e3a\\u7b2c i \\u4ef6\\u7269\\u54c1\\u4f53\\u79ef\\uff09\\n\\n\\u4e0b\\u9762\\u8d34\\u4e0a\\u4ee3\\u7801\\n```cpp\\n#include\\u003Ciostream\\u003E\\n#include\\u003Ccstdio\\u003E\\nusing namespace std;\\nint f[20005],w[35];\\nint main()\\n{\\n    int v,n;\\n    cin\\u003E\\u003Ev\\u003E\\u003En;\\n    for(int i=1;i\\u003C=n;i++)cin\\u003E\\u003Ew[i];\\n    for(int i=1;i\\u003C=n;i++)\\n        for(int j=v;j\\u003E=w[i];j--)\\n            f[j]=max(f[j],f[j-w[i]]+w[i]);\\n    cout\\u003C\\u003Cv-f[v];\\n    return 0;\\n}\\n```\\n\\nok\\uff5e\\u770b\\u5b8c\\u4e86\\u672c\\u9898\\u6b63\\u89e3\\uff0c\\u4e0b\\u9762\\u6211\\u518d\\u6765\\u8bb2\\u4e00\\u4e0b\\u672c\\u9898\\u7684~~\\u4e71\\u641e\\u505a\\u6cd5~~\\uff1a\\n\\n\\u4e0a\\u9762\\u63d0\\u5230\\uff0c\\u5982\\u679c\\u7528\\u8d2a\\u5fc3\\u6765\\u89e3\\u8fd9\\u9053\\u9898\\uff0c\\u56e0\\u4e3a\\u5c40\\u90e8\\u6700\\u4f18\\u89e3\\u4e0d\\u4e00\\u5b9a\\u662f\\u5168\\u5c40\\u6700\\u4f18\\u89e3\\uff0c\\u6240\\u4ee5\\u6700\\u7ec8\\u5f97\\u4e0d\\u5230\\u6b63\\u786e\\u7ed3\\u679c\\u3002\\u4f46\\u662f\\uff0c\\u6211\\u4eec\\u53d1\\u73b0\\u5927\\u90e8\\u5206\\u60c5\\u51b5\\u4e0b\\uff0c\\u80fd\\u5f97\\u5230\\u5168\\u5c40\\u6700\\u4f18\\u89e3\\u7684\\u7269\\u54c1\\u9009\\u62e9\\u65b9\\u6848\\u4e0e\\u8d2a\\u5fc3\\u7684\\u7269\\u54c1\\u9009\\u62e9\\u65b9\\u6848\\u5dee\\u522b\\u5e76\\u4e0d\\u662f\\u5f88\\u5927\\uff0c\\u5e76\\u4e14\\uff0c\\u7531\\u4e8e\\u8fd9\\u9053\\u9898\\u7269\\u54c1\\u6570\\u91cfn\\u003C=30\\uff0c\\u6570\\u636e\\u8303\\u56f4\\u6bd4\\u8f83\\u5c0f\\uff0c\\u56e0\\u6b64\\u6211\\u4eec\\u53ef\\u4ee5\\u8fd9\\u6837\\u505a\\uff1a\\n\\n\\u5728\\u6bcf\\u6b21\\u9009\\u62e9\\u4e0b\\u4e00\\u4ef6\\u8981\\u88c5\\u5165\\u7684\\u7269\\u54c1\\u7684\\u65f6\\u5019\\uff0c\\u6709\\u4e00\\u5b9a\\u7684\\u6982\\u7387\\u653e\\u5f03\\u5f53\\u524d\\u6700\\u4f18\\u89e3\\uff08\\u4f53\\u79ef\\u6700\\u5927\\u7684\\uff09\\uff0c\\u800c\\u9009\\u62e9\\u6b21\\u4f18\\u89e3\\uff08\\u4f53\\u79ef\\u5927\\u4e8e\\u5927\\u90e8\\u5206\\u7684\\u5176\\u4ed6\\u7269\\u54c1\\uff0c\\u4f46\\u5c0f\\u4e8e\\u6700\\u5927\\u7269\\u54c1\\u7684\\uff09\\uff0c\\u540c\\u65f6\\u5c06\\u653e\\u5f03\\u7684\\u7269\\u54c1\\u91cd\\u65b0\\u653e\\u56de\\u672a\\u9009\\u62e9\\u7684\\u7269\\u54c1\\u4e2d\\uff0c\\u4e0b\\u4e00\\u6b21\\u4f9d\\u7136\\u6709\\u51e0\\u7387\\u88ab\\u9009\\u62e9\\uff08\\u8fd9\\u91cc\\u5f88\\u5173\\u952e\\uff1a\\u628a\\u8fd9\\u4e00\\u6b21\\u653e\\u5f03\\u7684\\u7269\\u54c1\\u653e\\u56de\\u672a\\u9009\\u62e9\\u7684\\u7269\\u54c1\\u4e2d\\uff0c\\u8fd9\\u6837\\u53ef\\u4ee5\\u4f7f\\u4f53\\u79ef\\u8d8a\\u5927\\u7684\\u7269\\u54c1\\u6700\\u7ec8\\u88ab\\u9009\\u62e9\\u7684\\u6982\\u7387\\u8d8a\\u9ad8\\uff09\\u3002\\u8fd9\\u6837\\u6211\\u4eec\\u53ef\\u4ee5\\u83b7\\u5f97\\u4e00\\u4e2a\\u4e0e\\u8d2a\\u5fc3\\u9009\\u62e9\\u7684\\u65b9\\u6848\\u5dee\\u4e0d\\u591a\\u7684\\u65b9\\u6848\\u3002\\u8fd9\\u6837\\u8fd0\\u884c\\u4e00\\u904d\\u5f97\\u5230\\u7684\\u65b9\\u6848\\u4e0d\\u4e00\\u5b9a\\u662f\\u6700\\u4f18\\u65b9\\u6848\\uff0c\\u56e0\\u6b64\\u6211\\u4eec\\u91cd\\u590d\\u8fd0\\u884c\\u591a\\u6b21\\uff0c\\u5f88\\u6709\\u53ef\\u80fd\\u67d0\\u4e00\\u6b21\\u5c31\\u80fd\\u5f97\\u5230\\u6700\\u4f18\\u65b9\\u6848\\uff0c\\u53ea\\u9700\\u8981\\u4f7f\\u7528\\u6bcf\\u4e00\\u6b21\\u5f97\\u5230\\u7684\\u7ed3\\u679c\\u53bb\\u66f4\\u65b0\\u7b54\\u6848\\u5c31\\u597d\\u5566\\u3002\\n\\n```cpp\\n#include\\u003Ciostream\\u003E\\n#include\\u003Ccstdio\\u003E\\n#include\\u003Calgorithm\\u003E\\n#include\\u003Ccstring\\u003E\\nusing namespace std;\\nint n,v,a[40];\\nint f()\\n{\\n    int vv=v;\\n    int st[40],top=0;\\n    int q[40],head=1;\\n    memcpy(q,a,sizeof(a));\\n    while(head\\u003C=n\\u0026\\u0026vv\\u003E0)\\n        {\\n            while(head\\u003C=n\\u0026\\u0026((rand()%9==0)||vv-q[head]\\u003C0))\\/\\/\\u5982\\u679c\\u7bb1\\u5b50\\u5269\\u4f59\\u4f53\\u79ef\\u653e\\u4e0d\\u5f00\\uff0c\\u5c31\\u4e00\\u5b9a\\u8981\\u820d\\u5f03\\u8be5\\u7269\\u54c1\\uff0c\\u5982\\u679c\\u653e\\u5f97\\u5f00\\uff0c\\u5c31\\u6709\\u6982\\u7387\\u820d\\u5f03\\u3002\\n                if(vv-q[head]\\u003E=0)st[top++]=q[head++];\\/\\/\\u5c06\\u820d\\u5f03\\u7684\\u7269\\u54c1\\u6682\\u5b58\\u5230\\u6808\\u91cc\\uff0c\\u5f85\\u8fd9\\u6b21\\u9009\\u62e9\\u5b8c\\u6bd5\\u540e\\u518d\\u653e\\u56de\\u672a\\u9009\\u62e9\\u7684\\u7269\\u54c1\\u4e2d\\n                else head++;\\/\\/\\u5982\\u679c\\u662f\\u56e0\\u4e3a\\u7a7a\\u95f4\\u4e0d\\u8db3\\u800c\\u820d\\u5f03\\u7684\\u7269\\u54c1\\u4e0d\\u518d\\u653e\\u56de\\n            if(head\\u003C=n)vv-=q[head++];\\n            while(top)q[--head]=st[--top];\\/\\/\\u5c06\\u6682\\u5b58\\u5728\\u6808\\u91cc\\u7684\\u7269\\u54c1\\u653e\\u56de\\u672a\\u9009\\u62e9\\u7269\\u54c1\\u4e2d\\n        }\\n    return vv;\\n}\\nint main()\\n{\\n    cin\\u003E\\u003Ev\\u003E\\u003En;\\n    for(int i=1;i\\u003C=n;i++)\\n        cin\\u003E\\u003Ea[i];\\n    sort(a+1,a+n+1,greater\\u003Cint\\u003E());\\n    int ans=v;\\n    for(int i=1;i\\u003C=100;i++)\\n        ans=min(ans,f());\\/\\/\\u591a\\u6b21\\u8fd0\\u884c\\uff0c\\u66f4\\u65b0\\u7b54\\u6848\\n    cout\\u003C\\u003Cans;\\n    return 0;\\n}\\n```\\n\\nrand()%9==0 \\u8fd9\\u53e5\\u4e3a\\u771f\\u7684\\u6982\\u7387\\u4e3a1\\/9\\uff0c\\u5373\\u653e\\u5f03\\u5f53\\u524d\\u6700\\u4f18\\u89e3\\u7684\\u6982\\u7387\\u4e3a1\\/9\\u3002\\uff08\\u8fd9\\u91cc1\\/9\\u7684\\u6982\\u7387\\u662f\\u6211\\u4eba\\u4e3a\\u8bbe\\u5b9a\\u7684\\uff0c\\u5dee\\u4e0d\\u591a\\u5c31\\u53ef\\u4ee5\\uff09\\n\\n\\u600e\\u4e48\\u6837\\uff1f~~\\u64cd\\u4f5c\\u9a9a\\u4e0d\\u9a9a~~\\uff1f\\u76ae\\u8fd9\\u4e00\\u4e0b\\u5f88\\u5f00\\u5fc3\\uff5e\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795593117.454594}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/v3wxayi3\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1049 \\u3010\\u88c5\\u7bb1\\u95ee\\u9898\\u3011\",\"description\":\"\\u5728\\u6211\\u4eec\\u5b66\\u4e60\\u52a8\\u6001\\u89c4\\u5212\\u4e4b\\u524d\\uff0c\\u62ff\\u5230\\u8fd9\\u9053\\u9898\\uff0c\\u5927\\u90e8\\u5206\\u4eba\\u9996\\u5148\\u7684\\u601d\\u8def\\u662f\\u8d2a\\u5fc3\\uff0c\\u5373\\u6bcf\\u6b21\\u9009\\u62e9\\u4f53\\u79ef\\u6700\\u5927\\u7684\\u88c5\\u5165\\u7bb1\\u4e2d\\u3002\\n\\u4f46\\u662f\\uff0c\\u8d2a\\u5fc3\\u5b58\\u5728\\u8fd9\\u6837\\u4e00\\u4e2a\\u95ee\\u9898\\uff1a\\u5c40\\u90e8\\u6700\\u4f18\\u89e3\\u4e0d\\u4e00\\u5b9a\\u662f\\u5168\\u5c40\\u6700\\u4f18\\u89e3\\u3002\\u4f8b\\u5982\\uff1a\\n\\u7bb1\\u5b50\\u4f53\\u79ef\\u4e3a4\\uff0c\\u7269\\u54c1\\u67093\\u4ef6\\uff0c\\u4f53\\u79ef\\u5206\\u522b\\u4e3a3\\uff0c2\\uff0c2\\n\\u5982\\u679c\\u6211\\u4eec\\u6bcf\\u4e00\\u6b21\\u9009\\u62e9\\u4f53\\u79ef\\u6700\\u5927\\u7684\\uff0c\\u53ea\\u80fd\\u9009\\u62e9\\u4f53\\u79ef\\u4e3a3\\u7684\\u90a3\\u4e00\\u4ef6\\uff0c\\u8fd9\\u6837\\u6700\\u540e\\u5269\\u4f59\\u4f53\\u79ef\\u4e3a1\\u3002\\u7136\\u800c\\u6b63\\u786e\\u7b54\\u6848\\u5374\\u662f\\u9009\\u62e9\\u4e24\\u4ef6\\u4f53\\u79ef\\u4e3a2\\u7684\\uff0c\\u5269\\u4f59\\u4f53\\u79ef\\u4e3a0\\u3002\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"lhhccc\"},\"datePublished\":\"2018-10-07T23:25:37+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1049 【装箱问题】\" />\n    <meta property=\"og:description\" content=\"在我们学习动态规划之前，拿到这道题，大部分人首先的思路是贪心，即每次选择体积最大的装入箱中。\n但是，贪心存在这样一个问题：局部最优解不一定是全局最优解。例如：\n箱子体积为4，物品有3件，体积分别为3，2，2\n如果我们每一次选择体积最大的，只能选择体积为3的那一件，这样最后剩余体积为1。然而正确答案却是选择两件体积为2的，剩余体积为0。…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"lhhccc\" />\n    <meta property=\"article:published_time\" content=\"2018-10-07T23:25:37+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/v3wxayi3\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1049 【装箱问题】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">lhhccc</a>\n            ·\n            <time datetime=\"2018-10-07T23:25:37+08:00\">2018-10-07 23:25:37</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>在我们学习动态规划之前，拿到这道题，大部分人首先的思路是贪心，即每次选择体积最大的装入箱中。</p>\n<p>但是，贪心存在这样一个问题：局部最优解不一定是全局最优解。例如：</p>\n<h5>箱子体积为4，物品有3件，体积分别为3，2，2</h5>\n<p>如果我们每一次选择体积最大的，只能选择体积为3的那一件，这样最后剩余体积为1。然而正确答案却是选择两件体积为2的，剩余体积为0。</p>\n<p>因此，我们来看一看如何用<strong>动态规划</strong>解决此题：</p>\n<p>因为每个物体，都有装与不装两种选择，所以我们得到状态转移方程：</p>\n<h3>f[j]=max(f[j],f[j-w[i]]+w[i]);</h3>\n<p>f[j] 为：当总容量为 j 时，不放第 i 件物品，所能装的最大体积。</p>\n<p>f[j-w[i]]+w[i] 为：当总容量为 j 时，放了第 i 件物品后，所能装的最大体积。（即 j减去第 i 件物品体积 的容量能装的最大体积+第 i 件物品的体积。w[i] 为第 i 件物品体积）</p>\n<p>下面贴上代码</p>\n<pre><code class=\"language-cpp\">#include&lt;iostream&gt;\n#include&lt;cstdio&gt;\nusing namespace std;\nint f[20005],w[35];\nint main()\n{\n    int v,n;\n    cin&gt;&gt;v&gt;&gt;n;\n    for(int i=1;i&lt;=n;i++)cin&gt;&gt;w[i];\n    for(int i=1;i&lt;=n;i++)\n        for(int j=v;j&gt;=w[i];j--)\n            f[j]=max(f[j],f[j-w[i]]+w[i]);\n    cout&lt;&lt;v-f[v];\n    return 0;\n}</code></pre>\n<p>ok～看完了本题正解，下面我再来讲一下本题的<del>乱搞做法</del>：</p>\n<p>上面提到，如果用贪心来解这道题，因为局部最优解不一定是全局最优解，所以最终得不到正确结果。但是，我们发现大部分情况下，能得到全局最优解的物品选择方案与贪心的物品选择方案差别并不是很大，并且，由于这道题物品数量n&lt;=30，数据范围比较小，因此我们可以这样做：</p>\n<p>在每次选择下一件要装入的物品的时候，有一定的概率放弃当前最优解（体积最大的），而选择次优解（体积大于大部分的其他物品，但小于最大物品的），同时将放弃的物品重新放回未选择的物品中，下一次依然有几率被选择（这里很关键：把这一次放弃的物品放回未选择的物品中，这样可以使体积越大的物品最终被选择的概率越高）。这样我们可以获得一个与贪心选择的方案差不多的方案。这样运行一遍得到的方案不一定是最优方案，因此我们重复运行多次，很有可能某一次就能得到最优方案，只需要使用每一次得到的结果去更新答案就好啦。</p>\n<pre><code class=\"language-cpp\">#include&lt;iostream&gt;\n#include&lt;cstdio&gt;\n#include&lt;algorithm&gt;\n#include&lt;cstring&gt;\nusing namespace std;\nint n,v,a[40];\nint f()\n{\n    int vv=v;\n    int st[40],top=0;\n    int q[40],head=1;\n    memcpy(q,a,sizeof(a));\n    while(head&lt;=n&amp;&amp;vv&gt;0)\n        {\n            while(head&lt;=n&amp;&amp;((rand()%9==0)||vv-q[head]&lt;0))//如果箱子剩余体积放不开，就一定要舍弃该物品，如果放得开，就有概率舍弃。\n                if(vv-q[head]&gt;=0)st[top++]=q[head++];//将舍弃的物品暂存到栈里，待这次选择完毕后再放回未选择的物品中\n                else head++;//如果是因为空间不足而舍弃的物品不再放回\n            if(head&lt;=n)vv-=q[head++];\n            while(top)q[--head]=st[--top];//将暂存在栈里的物品放回未选择物品中\n        }\n    return vv;\n}\nint main()\n{\n    cin&gt;&gt;v&gt;&gt;n;\n    for(int i=1;i&lt;=n;i++)\n        cin&gt;&gt;a[i];\n    sort(a+1,a+n+1,greater&lt;int&gt;());\n    int ans=v;\n    for(int i=1;i&lt;=100;i++)\n        ans=min(ans,f());//多次运行，更新答案\n    cout&lt;&lt;ans;\n    return 0;\n}</code></pre>\n<p>rand()%9==0 这句为真的概率为1/9，即放弃当前最优解的概率为1/9。（这里1/9的概率是我人为设定的，差不多就可以）</p>\n<p>怎么样？<del>操作骚不骚</del>？皮这一下很开心～</p>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a5ff12372ca3f7ff',t:'MTc5NTU5MzExNw=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a5ff12372ca3f7ff',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
