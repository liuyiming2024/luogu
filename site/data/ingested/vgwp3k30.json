 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <meta name=\"csrf-token\" content=\"1795745643:fkwznUiYmQNk9hEK4htwLfFHH9I57fBPgfA3/SarGYc=\">\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112609'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>深基第10章暴力枚举：P2089 烤鸡 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"vgwp3k30\",\"title\":\"\\u6df1\\u57fa\\u7b2c10\\u7ae0\\u66b4\\u529b\\u679a\\u4e3e\\uff1aP2089 \\u70e4\\u9e21\",\"category\":2,\"time\":1678070119,\"author\":{\"uid\":176706,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/176706.png\",\"name\":\"crystallee\",\"slogan\":\"\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Blue\",\"ccfLevel\":0,\"xcpcLevel\":0,\"background\":\"\"},\"upvote\":0,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":null,\"promoteStatus\":0,\"collection\":null,\"content\":\"# P2089 \\u70e4\\u9e21\\n\\u6211\\u4eec\\u5c31\\u7528\\u6700\\u76f4\\u63a5\\u7684\\u679a\\u4e3e\\uff0c\\u628a\\u8fd910\\u4e2d\\u914d\\u65991\\u514b~3\\u514b\\u5168\\u90e8\\u679a\\u4e3e\\u4e00\\u904d\\uff0c3\\u768410\\u6b21\\u65b9=59049\\u6b21\\uff0c\\u8fd9\\u5c31\\u662f\\u66b4\\u529b\\u679a\\u4e3e\\u6700\\u5178\\u578b\\u7684\\u7528\\u6cd5\\u3002\\n```\\n\\/\\/ P2089 \\u70e4\\u9e21\\n#include \\u003Cbits\\/stdc++.h\\u003E  \\/\\/\\u4e07\\u80fd\\u5934\\u6587\\u4ef6\\nusing namespace std;\\nint zl[50000][10];\\/\\/zl\\u4e8c\\u7ef4\\u6570\\u7ec4\\u5b58\\u50a8\\u7b2ci\\u79cd\\u642d\\u914d\\u65b9\\u6848\\u768410\\u79cd\\u914d\\u6599\\u7684\\u8d28\\u91cf\\uff0c\\u6ce8\\u610f\\u8fd9\\u91cc\\u768450000\\u79cd\\u65b9\\u6848\\u662f\\u81ea\\u5df1\\u4f30\\u7b97\\u7684\\uff0c\\u53ef\\u80fd\\u4e0d\\u591f\\u4e5f\\u53ef\\u80fd\\u8fbe\\u4e0d\\u5230\\u8fd9\\u4e48\\u591a\\u79cd\\nint main(){\\n    int n,ans=0;\\/\\/ans\\u8868\\u793a\\u642d\\u914d\\u65b9\\u6848\\u7684\\u603b\\u6570 \\n    cin\\u003E\\u003En;\\/\\/\\u8bfb\\u5165\\u7f8e\\u5473\\u7a0b\\u5ea6n\\n    \\/\\/\\u5d4c\\u595710\\u5c42\\u5faa\\u73af\\u8868\\u793a10\\u79cd\\u914d\\u6599\\u7684\\u8d28\\u91cf\\n    for (int a=1;a\\u003C=3;a++){ \\/\\/\\u7b2c\\u4e00\\u79cd\\u914d\\u6599\\u8d28\\u91cf\\u4ece1\\u514b\\u52303\\u514b \\n        for (int b=1;b\\u003C=3;b++){\\/\\/\\u7b2c\\u4e8c\\u79cd\\u914d\\u6599 \\n            for (int c=1;c\\u003C=3;c++){\\/\\/\\u7b2c\\u4e09\\u79cd\\u914d\\u6599\\n                for (int d=1;d\\u003C=3;d++){\\/\\/\\u7b2c\\u56db\\u79cd\\u914d\\u6599\\n                    for (int e=1;e\\u003C=3;e++){\\/\\/\\u7b2c\\u4e94\\u79cd\\u914d\\u6599\\n                        for (int f=1;f\\u003C=3;f++){\\/\\/\\u7b2c\\u516d\\u79cd\\u914d\\u6599\\n                            for (int g=1;g\\u003C=3;g++){\\/\\/\\u7b2c\\u4e03\\u79cd\\u914d\\u6599\\n                                for (int h=1;h\\u003C=3;h++){\\/\\/\\u7b2c\\u516b\\u79cd\\u914d\\u6599\\n                                    for  (int i=1;i\\u003C=3;i++){\\/\\/\\u7b2c\\u4e5d\\u79cd\\u914d\\u6599\\n                                        for  (int j=1;j\\u003C=3;j++){\\/\\/\\u7b2c\\u5341\\u79cd\\u914d\\u6599\\n                                            if (a+b+c+d+e+f+g+h+i+j==n) {\\n                                                ans++;\\n                                                zl[ans][0]=a;zl[ans][1]=b; zl[ans][2]=c; zl[ans][3]=d; \\n                                                zl[ans][4]=e; zl[ans][5]=f; zl[ans][6]=g; zl[ans][7]=h; \\n                                                zl[ans][8]=i; zl[ans][9]=j;  \\n                                            }\\n                                        }\\n                                    }\\n                                }\\n                            }\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n    } \\n    \\/\\/\\u8f93\\u51fa\\u5b58\\u50a8\\u5728\\u6570\\u7ec4\\u91cc\\u6bcf\\u4e00\\u79cd\\u65b9\\u6848\\u7684\\u914d\\u6599\\u8d28\\u91cf\\n    cout\\u003C\\u003Cans\\u003C\\u003Cendl;\\/\\/\\u5148\\u8f93\\u51fa\\u65b9\\u6848\\u603b\\u6570 \\n    for (int i=1;i\\u003C=ans;i++){\\n        cout\\u003C\\u003Czl[i][0]\\u003C\\u003C\\u0022 \\u0022;\\n        cout\\u003C\\u003Czl[i][1]\\u003C\\u003C\\u0022 \\u0022;\\n        cout\\u003C\\u003Czl[i][2]\\u003C\\u003C\\u0022 \\u0022;\\n        cout\\u003C\\u003Czl[i][3]\\u003C\\u003C\\u0022 \\u0022;\\n        cout\\u003C\\u003Czl[i][4]\\u003C\\u003C\\u0022 \\u0022;\\n        cout\\u003C\\u003Czl[i][5]\\u003C\\u003C\\u0022 \\u0022;\\n        cout\\u003C\\u003Czl[i][6]\\u003C\\u003C\\u0022 \\u0022;\\n        cout\\u003C\\u003Czl[i][7]\\u003C\\u003C\\u0022 \\u0022;\\n        cout\\u003C\\u003Czl[i][8]\\u003C\\u003C\\u0022 \\u0022;\\n        cout\\u003C\\u003Czl[i][9]\\u003C\\u003Cendl;\\/\\/\\u8f93\\u51fa\\u5b8c10\\u79cd\\u914d\\u6599\\u8d28\\u91cf\\u8868\\u793a\\u6b64\\u65b9\\u6848\\u7ed3\\u675f\\uff0c\\u9700\\u8981\\u6362\\u884c \\n    } \\n    return 0;\\n} \\n```\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795659243.737243}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/vgwp3k30\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u6df1\\u57fa\\u7b2c10\\u7ae0\\u66b4\\u529b\\u679a\\u4e3e\\uff1aP2089 \\u70e4\\u9e21\",\"description\":\"P2089 \\u70e4\\u9e21\\n\\u6211\\u4eec\\u5c31\\u7528\\u6700\\u76f4\\u63a5\\u7684\\u679a\\u4e3e\\uff0c\\u628a\\u8fd910\\u4e2d\\u914d\\u65991\\u514b~3\\u514b\\u5168\\u90e8\\u679a\\u4e3e\\u4e00\\u904d\\uff0c3\\u768410\\u6b21\\u65b9=59049\\u6b21\\uff0c\\u8fd9\\u5c31\\u662f\\u66b4\\u529b\\u679a\\u4e3e\\u6700\\u5178\\u578b\\u7684\\u7528\\u6cd5\\u3002\\n\\/\\/ P2089 \\u70e4\\u9e21\\n#include &lt;bits\\/stdc++.h&gt;  \\/\\/\\u4e07\\u80fd\\u5934\\u6587\\u4ef6\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"crystallee\"},\"datePublished\":\"2023-03-06T10:35:19+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"深基第10章暴力枚举：P2089 烤鸡\" />\n    <meta property=\"og:description\" content=\"P2089 烤鸡\n我们就用最直接的枚举，把这10中配料1克~3克全部枚举一遍，3的10次方=59049次，这就是暴力枚举最典型的用法。\n// P2089 烤鸡\n#include &amp;lt;bits/stdc++.h&amp;gt;  //万能头文件…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"crystallee\" />\n    <meta property=\"article:published_time\" content=\"2023-03-06T10:35:19+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/vgwp3k30\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>深基第10章暴力枚举：P2089 烤鸡</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">crystallee</a>\n            ·\n            <time datetime=\"2023-03-06T10:35:19+08:00\">2023-03-06 10:35:19</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <h1>P2089 烤鸡</h1>\n<p>我们就用最直接的枚举，把这10中配料1克~3克全部枚举一遍，3的10次方=59049次，这就是暴力枚举最典型的用法。</p>\n<pre><code>// P2089 烤鸡\n#include &lt;bits/stdc++.h&gt;  //万能头文件\nusing namespace std;\nint zl[50000][10];//zl二维数组存储第i种搭配方案的10种配料的质量，注意这里的50000种方案是自己估算的，可能不够也可能达不到这么多种\nint main(){\n    int n,ans=0;//ans表示搭配方案的总数 \n    cin&gt;&gt;n;//读入美味程度n\n    //嵌套10层循环表示10种配料的质量\n    for (int a=1;a&lt;=3;a++){ //第一种配料质量从1克到3克 \n        for (int b=1;b&lt;=3;b++){//第二种配料 \n            for (int c=1;c&lt;=3;c++){//第三种配料\n                for (int d=1;d&lt;=3;d++){//第四种配料\n                    for (int e=1;e&lt;=3;e++){//第五种配料\n                        for (int f=1;f&lt;=3;f++){//第六种配料\n                            for (int g=1;g&lt;=3;g++){//第七种配料\n                                for (int h=1;h&lt;=3;h++){//第八种配料\n                                    for  (int i=1;i&lt;=3;i++){//第九种配料\n                                        for  (int j=1;j&lt;=3;j++){//第十种配料\n                                            if (a+b+c+d+e+f+g+h+i+j==n) {\n                                                ans++;\n                                                zl[ans][0]=a;zl[ans][1]=b; zl[ans][2]=c; zl[ans][3]=d; \n                                                zl[ans][4]=e; zl[ans][5]=f; zl[ans][6]=g; zl[ans][7]=h; \n                                                zl[ans][8]=i; zl[ans][9]=j;  \n                                            }\n                                        }\n                                    }\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    } \n    //输出存储在数组里每一种方案的配料质量\n    cout&lt;&lt;ans&lt;&lt;endl;//先输出方案总数 \n    for (int i=1;i&lt;=ans;i++){\n        cout&lt;&lt;zl[i][0]&lt;&lt;\" \";\n        cout&lt;&lt;zl[i][1]&lt;&lt;\" \";\n        cout&lt;&lt;zl[i][2]&lt;&lt;\" \";\n        cout&lt;&lt;zl[i][3]&lt;&lt;\" \";\n        cout&lt;&lt;zl[i][4]&lt;&lt;\" \";\n        cout&lt;&lt;zl[i][5]&lt;&lt;\" \";\n        cout&lt;&lt;zl[i][6]&lt;&lt;\" \";\n        cout&lt;&lt;zl[i][7]&lt;&lt;\" \";\n        cout&lt;&lt;zl[i][8]&lt;&lt;\" \";\n        cout&lt;&lt;zl[i][9]&lt;&lt;endl;//输出完10种配料质量表示此方案结束，需要换行 \n    } \n    return 0;\n} </code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a60560a06fc49ab6',t:'MTc5NTY1OTI0Mw=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a60560a06fc49ab6',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
