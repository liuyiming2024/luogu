,\"author\":{\"uid\":186488,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/186488.png\",\"name\":\"\\u5927\\u9b54\\u9b3c\\u707f\\u707f\",\"slogan\":\"\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Blue\",\"ccfLevel\":0,\"xcpcLevel\":0,\"background\":\"\"},\"upvote\":2,\"replyCount\":1,\"favorCount\":0,\"status\":2,\"solutionFor\":{\"pid\":\"P1328\",\"type\":\"P\",\"name\":\"[NOIP 2014 \\u63d0\\u9ad8\\u7ec4] \\u751f\\u6d3b\\u5927\\u7206\\u70b8\\u7248\\u77f3\\u5934\\u526a\\u5200\\u5e03\",\"difficulty\":2,\"fullScore\":100},\"promoteStatus\":0,\"collection\":null,\"content\":\"\\u8fd9\\u9898\\u662f\\u9053\\u6a21\\u62df\\u9898\\uff0c\\u4e00\\u5f00\\u59cb\\u89c9\\u5f97\\u5e94\\u8be5\\u5c31\\u662f\\u6253\\u8868\\uff0c\\u4f46\\u662f\\u540e\\u6765\\u60f3\\u60f3\\uff0c\\u5176\\u5b9e\\u6709\\u89c4\\u5f8b\\u53ef\\u5faa  \\n\\u4e3b\\u8981\\u601d\\u8def\\uff1a \\n\\n    \\u5148\\u4f7f\\u4ece1\\u5230n\\u7684\\u6570\\u7ec4\\u90fd\\u6709\\u6570\\uff0c\\u8fd9\\u4e2a\\u5e94\\u8be5\\u6bd4\\u8f83\\u5bb9\\u6613\\uff0c\\u7136\\u540e\\u4ece1\\u5230n\\n    \\u80dc\\u8d1f\\uff0c\\u7a0d\\u5fae\\u65b0\\u9c9c\\u7684\\u662f\\uff0c\\u5224\\u65ad\\u80dc\\u8d1f\\u91c7\\u7528\\u662f\\u5224\\u65adb[i]\\u662f\\u4e0d\\u662f\\u80fd\\u6218\\n    \\u80dca[i]\\u7684\\u65b9\\u6cd5\\uff0c\\u7136\\u540e\\u5224\\u65ad\\u5b8c\\u8f93\\u8d62\\uff0c\\u80dc\\u65b9ans++\\uff0c\\u6700\\u540e\\u8f93\\u51faansa\\uff0c\\n    ansb\\u5c31\\u884c\\u4e86\\n``` \\n\\/\\/\\u7b97\\u6cd5\\uff1a\\u6a21\\u62df \\n#include\\u003Ccstdio\\u003E\\nint a[201],b[201];\\nint ansa=0,ansb=0;\\/\\/a\\uff0cb\\u7684\\u5206\\u6570\\u7d2f\\u52a0\\u5668 \\nint n,na,nb,ma,mb;\\nint w[5][2]={{1,4},{2,4},{0,3},{0,1},{2,3}};\\n\\/\\/w\\u6570\\u7ec4\\u4e3a\\u8d62\\u6bcf\\u4e2a\\u7684\\u6570 \\nint main()\\n{\\n\\tscanf(\\u0022%d%d%d\\u0022,\\u0026n,\\u0026na,\\u0026nb);\\/\\/\\u8f93\\u5165 \\n\\tma=1,mb=1;\\/\\/ma\\uff0cmb\\u7528\\u6765\\u628a1\\u5230n\\u7684\\u6240\\u6709a\\uff0cb\\u6570\\u7ec4\\u52a0\\u4e0a\\u6570 \\n\\tfor(int i=1;i\\u003C=na;i++) scanf(\\u0022%d\\u0022,\\u0026a[i]);\\n\\tfor(int i=1;i\\u003C=nb;i++) scanf(\\u0022%d\\u0022,\\u0026b[i]);\\n\\tfor(int i=na+1;i\\u003C=n;i++)\\n    \\/\\/\\u4e00\\u4e2a\\u73af\\u7684\\u5f62\\u5f0f\\u4f7f\\u6570\\u7ec4\\u52a0\\u4e0a\\u6570 \\n\\t{\\n\\t    a[i]=a[ma];ma++;\\n\\t\\tif(ma==na+1) ma=1;\\/\\/\\u5982\\u679c\\u5230\\u4e86\\u6700\\u5927\\u5c31\\u53d81 \\n\\t}\\n\\tfor(int i=nb+1;i\\u003C=n;i++)\\/\\/b\\u540c\\u7406 \\n\\t{\\n\\t\\tb[i]=b[mb];mb++;\\n\\t\\tif(mb==nb+1) mb=1;\\n\\t}\\n\\tfor(int i=1;i\\u003C=n;i++)\\/\\/\\u5224\\u65ad\\u80dc\\u8d1f \\n\\t{\\n\\t\\tif(a[i]==b[i])\\/\\/\\u5982\\u679c\\u5e73\\u5c31\\u7ee7\\u7eed \\n\\t\\t  continue;\\n       \\/\\/\\u5426\\u5219 \\n\\t\\tfor(int j=0;j\\u003C=1;j++)\\n        \\/\\/\\u5148\\u5224\\u65adb\\u662f\\u4e0d\\u662f\\u80fd\\u8d62a \\n\\t\\t  if(b[i]==w[a[i]][j])\\n          \\/\\/\\u5982\\u679cb[i]\\u5728\\u8d62a[i]\\u7684\\u6570\\u7ec4\\u91cc\\uff0cansb++ \\n\\t\\t\\tansb++;\\n\\t\\tfor(int j=0;j\\u003C=1;j++)\\/\\/\\u76f8\\u53cd\\uff0c\\u540c\\u7406 \\n\\t\\t  if(a[i]==w[b[i]][j])\\n\\t\\t\\tansa++;\\n\\t}\\n\\tprintf(\\u0022%d %d\\u0022,ansa,ansb);\\/\\/\\u8f93\\u51faa\\uff0cb\\u7684\\u5206\\u6570 \\n\\treturn 0;\\n}\\n\\n```\",\"categoryOld\":\"\\u9898\\u89e3\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795629569.385656}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/0z8yhoc0\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"\\u9898\\u89e3 P1328 \\u3010\\u751f\\u6d3b\\u5927\\u7206\\u70b8\\u7248\\u77f3\\u5934\\u526a\\u5200\\u5e03\\u3011\",\"description\":\"\\u8fd9\\u9898\\u662f\\u9053\\u6a21\\u62df\\u9898\\uff0c\\u4e00\\u5f00\\u59cb\\u89c9\\u5f97\\u5e94\\u8be5\\u5c31\\u662f\\u6253\\u8868\\uff0c\\u4f46\\u662f\\u540e\\u6765\\u60f3\\u60f3\\uff0c\\u5176\\u5b9e\\u6709\\u89c4\\u5f8b\\u53ef\\u5faa\\n\\u4e3b\\u8981\\u601d\\u8def\\uff1a \\n\\u5148\\u4f7f\\u4ece1\\u5230n\\u7684\\u6570\\u7ec4\\u90fd\\u6709\\u6570\\uff0c\\u8fd9\\u4e2a\\u5e94\\u8be5\\u6bd4\\u8f83\\u5bb9\\u6613\\uff0c\\u7136\\u540e\\u4ece1\\u5230n\\n\\u80dc\\u8d1f\\uff0c\\u7a0d\\u5fae\\u65b0\\u9c9c\\u7684\\u662f\\uff0c\\u5224\\u65ad\\u80dc\\u8d1f\\u91c7\\u7528\\u662f\\u5224\\u65adb[i]\\u662f\\u4e0d\\u662f\\u80fd\\u6218\\n\\u80dca[i]\\u7684\\u65b9\\u6cd5\\uff0c\\u7136\\u540e\\u5224\\u65ad\\u5b8c\\u8f93\\u8d62\\uff0c\\u80dc\\u65b9ans++\\uff0c\\u6700\\u540e\\u8f93\\u51faansa\\uff0c\\u2026\",\"genre\":\"\\u9898\\u89e3\",\"author\":{\"@type\":\"Person\",\"name\":\"\\u5927\\u9b54\\u9b3c\\u707f\\u707f\"},\"datePublished\":\"2019-05-12T10:31:39+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"题解 P1328 【生活大爆炸版石头剪刀布】\" />\n    <meta property=\"og:description\" content=\"这题是道模拟题，一开始觉得应该就是打表，但是后来想想，其实有规律可循\n主要思路： \n先使从1到n的数组都有数，这个应该比较容易，然后从1到n\n胜负，稍微新鲜的是，判断胜负采用是判断b[i]是不是能战\n胜a[i]的方法，然后判断完输赢，胜方ans++，最后输出ansa，…\" />\n    <meta property=\"article:section\" content=\"题解\" />\n    <meta property=\"article:author\" content=\"大魔鬼灿灿\" />\n    <meta property=\"article:published_time\" content=\"2019-05-12T10:31:39+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/0z8yhoc0\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>题解 P1328 【生活大爆炸版石头剪刀布】</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">大魔鬼灿灿</a>\n            ·\n            <time datetime=\"2019-05-12T10:31:39+08:00\">2019-05-12 10:31:39</time>\n            ·\n            <a href=\"/article?category=2\">题解</a>\n        </p>\n\n        <p>这题是道模拟题，一开始觉得应该就是打表，但是后来想想，其实有规律可循<br />\n主要思路： </p>\n<pre><code>先使从1到n的数组都有数，这个应该比较容易，然后从1到n\n胜负，稍微新鲜的是，判断胜负采用是判断b[i]是不是能战\n胜a[i]的方法，然后判断完输赢，胜方ans++，最后输出ansa，\nansb就行了</code></pre>\n<pre><code>//算法：模拟 \n#include&lt;cstdio&gt;\nint a[201],b[201];\nint ansa=0,ansb=0;//a，b的分数累加器 \nint n,na,nb,ma,mb;\nint w[5][2]={{1,4},{2,4},{0,3},{0,1},{2,3}};\n//w数组为赢每个的数 \nint main()\n{\n    scanf(\"%d%d%d\",&amp;n,&amp;na,&amp;nb);//输入 \n    ma=1,mb=1;//ma，mb用来把1到n的所有a，b数组加上数 \n    for(int i=1;i&lt;=na;i++) scanf(\"%d\",&amp;a[i]);\n    for(int i=1;i&lt;=nb;i++) scanf(\"%d\",&amp;b[i]);\n    for(int i=na+1;i&lt;=n;i++)\n    //一个环的形式使数组加上数 \n    {\n        a[i]=a[ma];ma++;\n        if(ma==na+1) ma=1;//如果到了最大就变1 \n    }\n    for(int i=nb+1;i&lt;=n;i++)//b同理 \n    {\n        b[i]=b[mb];mb++;\n        if(mb==nb+1) mb=1;\n    }\n    for(int i=1;i&lt;=n;i++)//判断胜负 \n    {\n        if(a[i]==b[i])//如果平就继续 \n          continue;\n       //否则 \n        for(int j=0;j&lt;=1;j++)\n        //先判断b是不是能赢a \n          if(b[i]==w[a[i]][j])\n          //如果b[i]在赢a[i]的数组里，ansb++ \n            ansb++;\n        for(int j=0;j&lt;=1;j++)//相反，同理 \n          if(a[i]==w[b[i]][j])\n            ansa++;\n    }\n    printf(\"%d %d\",ansa,ansb);//输出a，b的分数 \n    return 0;\n}\n</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6028c27bc2acf1b',t:'MTc5NTYyOTU2OQ=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6028c27bc2acf1b',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
