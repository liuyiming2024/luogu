 "code_blocks": [
  "#include<bits/stdc++.h>\n#define N 1010\n\nint n,m;\nint map[N][N],d[N][N];\n\nstruct node {\n    int x1,y1,x2,y2;\n};\n\nnode a[N];\n\nnamespace WalkerV {\n    void Read() {\n        scanf(\"%d%d\",&n,&m);\n        for(int i=1;i<=m;i++) {\n            scanf(\"%d%d%d%d\",&a[i].x1,&a[i].y1,&a[i].x2,&a[i].y2);\n        }\n        return;\n    }\n\n    void Solve() {\n        for(int i=1;i<=m;i++) {\n            d[a[i].x1][a[i].y1]++;\n            d[a[i].x2+1][a[i].y1]--;\n            d[a[i].x1][a[i].y2+1]--;\n            d[a[i].x2+1][a[i].y2+1]++;\n        }\n        for(int i=1;i<=n;i++) {\n            for(int j=1;j<=n;j++) {\n                map[i][j]=map[i][j-1]+map[i-1][j]-map[i-1][j-1]+d[i][j];\n            }\n        }\n        return;\n    }\n\n    void Print() {\n        for(int i=1;i<=n;i++) {\n            for(int j=1;j<=n;j++) {\n                printf(\"%d%c\",map[i][j],j==n?'\\n':' ');\n            }\n        }\n        return;\n    }\n}\n\nint main()\n{\n    WalkerV::Read();\n    WalkerV::Solve();\n    WalkerV::Print();\n    return 0;\n}"
 ],
 "sha256": "2bb6a5d4318575e5",
 "body": "<!DOCTYPE html>\n<html lang=\"zh-CN\" class=\"no-js\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n    <!-- 匿名页面令牌已移除（公开归档不保留） -->\n    <meta name=\"renderer\" content=\"webkit\">\n    <script>\n        window.__feInitLocalTime = new Date().getTime() / 1000;\n        window.__feConfigVersion = '74d532c6c7861bfe'; window.__feConfigRequest = '\\/_lfe\\/config'; window.__fePhoneHomeCall = 'https\\u003A\\/\\/moshimoshi\\u003Aagltb3noatpwohhuenb5ag1tc2jsnnl3\\u0040errtrack.luogu.com.cn\\/lotlp1';        window.__luoguTagVersion = 'zh\\u002DCN\\/2026112609'; window.__luoguTagRequest = '\\/_lfe\\/tags';\n    </script>\n    <title>Luogu P3397 地毯 - 洛谷专栏</title>\n    <link rel=\"icon\" href=\"https://fecdn.luogu.com.cn/favicon.ico\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'unsafe-eval' 'unsafe-inline' luogu.com *.luogu.com luogu.com.cn *.luogu.com.cn luogu.org *.luogu.org wss: blob: luoguprivate.oss-cn-hangzhou.aliyuncs.com luogu.oss-cn-hangzhou.aliyuncs.com https://challenges.cloudflare.com https://*.dun.163yun.com https://*.dun.163.com https://*.nosdn.126.net https://*.nosdn.127.net https://nos.netease.com https://cstaticdun.126.net https://cstaticdun1.126.net https://cstaticdun-v6.126.net https://acstatic-dun.126.net; img-src * data:; font-src * data:; worker-src data: blob:; frame-src https://fecdn.luogu.com.cn https://player.bilibili.com https://www.bilibili.com https://challenges.cloudflare.com\">\n        <script id=\"lentille-context\" type=\"application/json\">{\"instance\":\"main\",\"template\":\"article.show\",\"status\":200,\"locale\":\"zh-CN\",\"data\":{\"article\":{\"lid\":\"smtoxvvs\",\"title\":\"Luogu P3397 \\u5730\\u6bef\",\"category\":1,\"time\":1629108006,\"author\":{\"uid\":161364,\"avatar\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/usericon\\/161364.png\",\"name\":\"Walker_V\",\"slogan\":\"\\u8981\\u5728\\u6e29\\u5ba4\\u548c\\u66b4\\u98ce\\u4e4b\\u4e2d\\u53d6\\u820d\\uff0c\\u6211\\u5fd8\\u8bb0\\u4e86\\u9000\\u7f29\\u3002\",\"badge\":null,\"isAdmin\":false,\"isBanned\":false,\"color\":\"Blue\",\"ccfLevel\":0,\"xcpcLevel\":0,\"background\":\"https:\\/\\/cdn.luogu.com.cn\\/upload\\/image_hosting\\/rmim2ek9.png\"},\"upvote\":0,\"replyCount\":0,\"favorCount\":0,\"status\":2,\"solutionFor\":null,\"promoteStatus\":0,\"collection\":null,\"content\":\"# Luogu P3397 \\u5730\\u6bef\\n\\n\\u4e00\\u9053\\u4e8c\\u7ef4\\u5dee\\u5206\\u7684\\u677f\\u5b50\\u9898\\u3002\\n\\n\\u56e0\\u4e3a\\u4e8c\\u7ef4\\u5dee\\u5206\\u6bd4\\u8d77\\u4e00\\u7ef4\\u7684\\u6765\\u8bf4\\u5e76\\u4e0d\\u90a3\\u4e48\\u76f4\\u89c2\\uff0c\\u6240\\u4ee5\\u8fd9\\u91cc\\u4e3b\\u8981\\u8bb2\\u4e00\\u4e0b\\u4e8c\\u7ef4\\u5dee\\u5206\\u7684\\u5b9e\\u73b0\\u601d\\u8def\\u3002\\n\\n\\u9996\\u5148\\uff0c\\u8bb0\\u4e8c\\u7ef4\\u524d\\u7f00\\u548c\\u4e3a $S_{a_{x,y}}= \\\\sum^{x}_{i=1} \\\\sum^{y}_{j=1} a_{i,j}$\\uff1b\\u4e8c\\u7ef4\\u5dee\\u5206\\u4e3a $D_{x,y}$\\u3002\\n\\n\\u663e\\u7136\\uff0c$S_{a_{x,y}}$ \\u6ee1\\u8db3\\u5982\\u4e0b\\u9012\\u63a8\\u5f0f\\uff1a\\n\\n$S_{a_{x,y}}=S_{a_{x,y-1}}+S_{a_{x-1,y}}-S_{a_{x-1,y-1}}+a_{x,y}$\\n\\n\\u8fd9\\u91cc\\uff0c\\u6211\\u4eec\\u8981\\u7528\\u5230\\u4e00\\u4e2a\\u6027\\u8d28\\uff1a**\\u5dee\\u5206\\u7684\\u524d\\u7f00\\u548c\\u4e3a\\u539f\\u6570**\\uff0c\\u5373 **$S_{D_{x,y}}=a_{x,y}$**\\u3002\\n\\n\\u5219\\u4ee3\\u5165\\u4e8c\\u7ef4\\u524d\\u7f00\\u548c\\u7684\\u9012\\u63a8\\u5f0f\\uff0c\\u53ef\\u4ee5\\u5f97\\u5230\\u4e8c\\u7ef4\\u5dee\\u5206\\u6ee1\\u8db3\\u7684\\u5173\\u7cfb\\u5f0f\\uff1a\\n\\n$a_{x,y}=a_{x,y-1}+a_{x-1,y}-a_{x-1,y-1}+D_{x,y}$\\n\\n\\u53d8\\u5f62\\u4e00\\u4e0b\\u5f97\\u5230\\u4e8c\\u7ef4\\u5dee\\u5206\\u7684\\u8ba1\\u7b97\\u5f0f\\uff1a\\n\\n$D_{x,y}=a_{x,y}-a_{x,y-1}-a_{x-1,y}+a_{x-1,y-1}$\\n\\n\\u6700\\u540e\\u6211\\u4eec\\u518d\\u6765\\u8003\\u8651\\u5982\\u4f55\\u5b9e\\u73b0\\u9898\\u76ee\\u4e2d\\uff0c\\u4fee\\u6539\\u4e00\\u4e2a\\u5de6\\u4e0a\\u89d2\\u662f $(x_1,y_1)$\\uff0c\\u53f3\\u4e0b\\u89d2\\u662f $(x_2,y_2)$ \\u7684\\u77e9\\u5f62\\u533a\\u95f4\\u3002\\n\\n\\u7c7b\\u6bd4\\u524d\\u7f00\\u548c\\u7684\\u8ba1\\u7b97\\uff0c\\u4e0d\\u96be\\u5f97\\u5230\\uff1a\\n\\n* $D_{x_1,y_1} \\\\gets D_{x_1,y_1}+1$\\n* $D_{x_1,y_2+1} \\\\gets D_{x_1,y_2+1}-1$\\n* $D_{x_2+1,y_1} \\\\gets D_{x_2+1,y_1}-1$\\n* $D_{x_2+1,y_2+1} \\\\gets D_{x_2+1,y_2+1}+1$\\n\\n\\u5373\\u53ef\\u3002\\n\\n\\u4ee3\\u7801\\u5b9e\\u73b0\\u5982\\u4e0b\\uff1a\\n\\n```cpp\\n#include\\u003Cbits\\/stdc++.h\\u003E\\n#define N 1010\\n\\nint n,m;\\nint map[N][N],d[N][N];\\n\\nstruct node {\\n\\tint x1,y1,x2,y2;\\n};\\n\\nnode a[N];\\n\\nnamespace WalkerV {\\n\\tvoid Read() {\\n\\t\\tscanf(\\u0022%d%d\\u0022,\\u0026n,\\u0026m);\\n\\t\\tfor(int i=1;i\\u003C=m;i++) {\\n\\t\\t\\tscanf(\\u0022%d%d%d%d\\u0022,\\u0026a[i].x1,\\u0026a[i].y1,\\u0026a[i].x2,\\u0026a[i].y2);\\n\\t\\t}\\n\\t\\treturn;\\n\\t}\\n\\n\\tvoid Solve() {\\n\\t\\tfor(int i=1;i\\u003C=m;i++) {\\n\\t\\t\\td[a[i].x1][a[i].y1]++;\\n\\t\\t\\td[a[i].x2+1][a[i].y1]--;\\n\\t\\t\\td[a[i].x1][a[i].y2+1]--;\\n\\t\\t\\td[a[i].x2+1][a[i].y2+1]++;\\n\\t\\t}\\n\\t\\tfor(int i=1;i\\u003C=n;i++) {\\n\\t\\t\\tfor(int j=1;j\\u003C=n;j++) {\\n\\t\\t\\t\\tmap[i][j]=map[i][j-1]+map[i-1][j]-map[i-1][j-1]+d[i][j];\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\treturn;\\n\\t}\\n\\n\\tvoid Print() {\\n\\t\\tfor(int i=1;i\\u003C=n;i++) {\\n\\t\\t\\tfor(int j=1;j\\u003C=n;j++) {\\n\\t\\t\\t\\tprintf(\\u0022%d%c\\u0022,map[i][j],j==n?\\u0027\\\\n\\u0027:\\u0027 \\u0027);\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\treturn;\\n\\t}\\n}\\n\\nint main()\\n{\\n\\tWalkerV::Read();\\n\\tWalkerV::Solve();\\n\\tWalkerV::Print();\\n\\treturn 0;\\n}\\n```\",\"categoryOld\":\"\\u9898\\u76ee\",\"contentFull\":true,\"adminNote\":null},\"favored\":false,\"voted\":null,\"canReply\":false,\"canEdit\":false},\"user\":null,\"time\":1795659280.489923}</script>            <script src=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js\" charset=\"utf-8\" defer></script>\n    <link rel=\"stylesheet\" href=\"https://fecdn.luogu.com.cn/columba/loader.20261113-2335.css\" />\n    <script src=\"https://fecdn.luogu.com.cn/columba/vendor.20261113-2335.js\" charset=\"utf-8\" defer></script>\n        <link rel=\"canonical\" href=\"https://www.luogu.com/article/smtoxvvs\" />\n    <script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"Article\",\"name\":\"Luogu P3397 \\u5730\\u6bef\",\"description\":\"Luogu P3397 \\u5730\\u6bef\\n\\u4e00\\u9053\\u4e8c\\u7ef4\\u5dee\\u5206\\u7684\\u677f\\u5b50\\u9898\\u3002\\n\\u56e0\\u4e3a\\u4e8c\\u7ef4\\u5dee\\u5206\\u6bd4\\u8d77\\u4e00\\u7ef4\\u7684\\u6765\\u8bf4\\u5e76\\u4e0d\\u90a3\\u4e48\\u76f4\\u89c2\\uff0c\\u6240\\u4ee5\\u8fd9\\u91cc\\u4e3b\\u8981\\u8bb2\\u4e00\\u4e0b\\u4e8c\\u7ef4\\u5dee\\u5206\\u7684\\u5b9e\\u73b0\\u601d\\u8def\\u3002\\n\\u9996\\u5148\\uff0c\\u8bb0\\u4e8c\\u7ef4\\u524d\\u7f00\\u548c\\u4e3a S_{a_{x,y}}= \\\\sum^{x}_{i=1} \\\\sum^{y}_{j=1}\\u2026\",\"genre\":\"\\u4e2a\\u4eba\\u8bb0\\u5f55\",\"author\":{\"@type\":\"Person\",\"name\":\"Walker_V\"},\"datePublished\":\"2021-08-16T18:00:06+08:00\"}</script>\n    <meta property=\"og:type\" content=\"article\" />\n    <meta property=\"og:title\" content=\"Luogu P3397 地毯\" />\n    <meta property=\"og:description\" content=\"Luogu P3397 地毯\n一道二维差分的板子题。\n因为二维差分比起一维的来说并不那么直观，所以这里主要讲一下二维差分的实现思路。\n首先，记二维前缀和为 S_{a_{x,y}}= \\sum^{x}_{i=1} \\sum^{y}_{j=1}…\" />\n    <meta property=\"article:section\" content=\"个人记录\" />\n    <meta property=\"article:author\" content=\"Walker_V\" />\n    <meta property=\"article:published_time\" content=\"2021-08-16T18:00:06+08:00\" />\n    <meta property=\"og:url\" content=\"https://www.luogu.com/article/smtoxvvs\" />\n    <meta property=\"og:site_name\" content=\"洛谷专栏\" />\n        <script id=\"luogu-theme\" type=\"application/json\">{\"id\":1,\"lNavi\":{\"back\":\"#ffffff\",\"fore\":\"#262626\",\"logo\":null},\"lBody\":{\"back\":\"#f0f4fa\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-l.jpg\",\"midOpts\":{\"size\":\"cover\"}},\"dNavi\":{\"back\":\"#1d2025\",\"fore\":\"#ffffff\",\"logo\":\"#ffffff\"},\"dBody\":{\"back\":\"#0d1018\",\"blur\":1000,\"fade\":1000,\"image\":\"https:\\/\\/cdn.luogu.com.cn\\/images\\/bg\\/fe\\/luogu4-bg-d.jpg\",\"midOpts\":{\"size\":\"cover\"}}}</script>\n    <style></style>\n</head>\n<body>\n<div id=\"app\">\n    <noscript>\n        <h3>请<b style=\"color:#f00;\">不要禁用</b>脚本，否则网页无法正常加载</h3>\n    </noscript>\n        <article>\n        <h1>Luogu P3397 地毯</h1>\n        <p style=\"font-size: .75em;\">\n            <a rel=\"author\">Walker_V</a>\n            ·\n            <time datetime=\"2021-08-16T18:00:06+08:00\">2021-08-16 18:00:06</time>\n            ·\n            <a href=\"/article?category=1\">个人记录</a>\n        </p>\n\n        <h1>Luogu P3397 地毯</h1>\n<p>一道二维差分的板子题。</p>\n<p>因为二维差分比起一维的来说并不那么直观，所以这里主要讲一下二维差分的实现思路。</p>\n<p>首先，记二维前缀和为 <la-tex display=\"inline\">S_{a_{x,y}}= \\sum^{x}_{i=1} \\sum^{y}_{j=1} a_{i,j}</la-tex>；二维差分为 <la-tex display=\"inline\">D_{x,y}</la-tex>。</p>\n<p>显然，<la-tex display=\"inline\">S_{a_{x,y}}</la-tex> 满足如下递推式：</p>\n<la-tex display=\"block\">S_{a_{x,y}}=S_{a_{x,y-1}}+S_{a_{x-1,y}}-S_{a_{x-1,y-1}}+a_{x,y}</la-tex>\n<p>这里，我们要用到一个性质：<strong>差分的前缀和为原数</strong>，即 <strong><la-tex display=\"inline\">S_{D_{x,y}}=a_{x,y}</la-tex></strong>。</p>\n<p>则代入二维前缀和的递推式，可以得到二维差分满足的关系式：</p>\n<la-tex display=\"block\">a_{x,y}=a_{x,y-1}+a_{x-1,y}-a_{x-1,y-1}+D_{x,y}</la-tex>\n<p>变形一下得到二维差分的计算式：</p>\n<la-tex display=\"block\">D_{x,y}=a_{x,y}-a_{x,y-1}-a_{x-1,y}+a_{x-1,y-1}</la-tex>\n<p>最后我们再来考虑如何实现题目中，修改一个左上角是 <la-tex display=\"inline\">(x_1,y_1)</la-tex>，右下角是 <la-tex display=\"inline\">(x_2,y_2)</la-tex> 的矩形区间。</p>\n<p>类比前缀和的计算，不难得到：</p>\n<ul>\n<li>\n<la-tex display=\"block\">D_{x_1,y_1} \\gets D_{x_1,y_1}+1</la-tex>\n</li>\n<li>\n<la-tex display=\"block\">D_{x_1,y_2+1} \\gets D_{x_1,y_2+1}-1</la-tex>\n</li>\n<li>\n<la-tex display=\"block\">D_{x_2+1,y_1} \\gets D_{x_2+1,y_1}-1</la-tex>\n</li>\n<li>\n<la-tex display=\"block\">D_{x_2+1,y_2+1} \\gets D_{x_2+1,y_2+1}+1</la-tex>\n</li>\n</ul>\n<p>即可。</p>\n<p>代码实现如下：</p>\n<pre><code class=\"language-cpp\">#include&lt;bits/stdc++.h&gt;\n#define N 1010\n\nint n,m;\nint map[N][N],d[N][N];\n\nstruct node {\n    int x1,y1,x2,y2;\n};\n\nnode a[N];\n\nnamespace WalkerV {\n    void Read() {\n        scanf(\"%d%d\",&amp;n,&amp;m);\n        for(int i=1;i&lt;=m;i++) {\n            scanf(\"%d%d%d%d\",&amp;a[i].x1,&amp;a[i].y1,&amp;a[i].x2,&amp;a[i].y2);\n        }\n        return;\n    }\n\n    void Solve() {\n        for(int i=1;i&lt;=m;i++) {\n            d[a[i].x1][a[i].y1]++;\n            d[a[i].x2+1][a[i].y1]--;\n            d[a[i].x1][a[i].y2+1]--;\n            d[a[i].x2+1][a[i].y2+1]++;\n        }\n        for(int i=1;i&lt;=n;i++) {\n            for(int j=1;j&lt;=n;j++) {\n                map[i][j]=map[i][j-1]+map[i-1][j]-map[i-1][j-1]+d[i][j];\n            }\n        }\n        return;\n    }\n\n    void Print() {\n        for(int i=1;i&lt;=n;i++) {\n            for(int j=1;j&lt;=n;j++) {\n                printf(\"%d%c\",map[i][j],j==n?'\\n':' ');\n            }\n        }\n        return;\n    }\n}\n\nint main()\n{\n    WalkerV::Read();\n    WalkerV::Solve();\n    WalkerV::Print();\n    return 0;\n}</code></pre>\n    </article>\n</div>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a6056182de27d7ac',t:'MTc5NTY1OTI3OQ=='};var l=window.parent.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/jsd/main.js?ray=a6056182de27d7ac',a=document.createElement('script');a.src=o?new URL(u,o).href:u;document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
