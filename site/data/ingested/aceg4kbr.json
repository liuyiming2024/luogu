 "code_blocks": [
  "#include <iostream>\n\nusing namespace std;\n\nint main() {\n    int n, k;\n    scanf(\"%d %d\",&n,&k);\n    int count = 0;  // 统计总共的抽烟数\n    int end = 0;  // 统计当前的烟蒂数\n    do {\n        count += n;  // 先抽n根烟\n        end += n;  // 新增n根烟蒂\n        n = end / k;  // 换烟\n        end %= k;  // 计算还剩下的烟蒂数\n    } while (n > 0);  // 只要还有烟抽，就继续循环\n    printf(\"%d\\n\",count);\n    return 0;\n}",
  "#include <stdio.h>\n\nint main(){\n    int n,k;\n    scanf(\"%d%d\",&n,&k);\n    printf(\"%d\",n+(n-1)/(k-1));\n}"
